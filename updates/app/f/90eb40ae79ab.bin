  "inlineSchema": "generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"sqlite\"\n  url      = env(\"DATABASE_URL\")\n}\n\n// ─── حساب کاربری ─────────────────────────────────────────────────────────────\n// سیاست حریم داده: پس از ثبت‌نام، هیچ دادهٔ کاربری هرگز حذف نمی‌شود.\n// تمام نوشتن‌ها «ادغامی» هستند (حداکثرها حفظ می‌شوند) و هیچ مسیر حذفی وجود ندارد.\n\nmodel User {\n  id           String    @id @default(cuid())\n  username     String    @unique\n  passwordHash String\n  role         String    @default(\"user\") // \"user\" | \"admin\" | \"teacher\"\n  displayName  String? // نام نمایشی استاد (برای وبلاگ و پیشنهادها)\n  bio          String? // معرفی کوتاه استاد\n  avatarUrl    String? // آدرس نسبی آواتار آپلودشده (فقط استاد/مدیر) مثل /api/media/…\n  createdAt    DateTime  @default(now())\n  updatedAt    DateTime  @updatedAt\n  lastSeenAt   DateTime?\n\n  sessions       Session[]\n  lessonStates   LessonState[]\n  quizAttempts   QuizAttempt[]\n  activityDays   ActivityDay[]\n  notes          Note[]\n  blob           UserBlob?\n  feedbacks      LessonFeedback[]\n  posts          Post[]\n  comments       Comment[]\n  ratings        Rating[]\n  following      Follow[]         @relation(\"FollowStudent\")\n  followers      Follow[]         @relation(\"FollowTeacher\")\n  teacherCourses TeacherCourse[]\n  library        LibraryEntry[]\n  builtinHidden  BuiltinHidden[]\n}\n\n// ─── بازخورد و انتقاد از تدریس هر جلسه ────────────────────────────────────────\n// گفت‌وگوی کاربر با استاد دربارهٔ کیفیت تدریس جلسه؛ تحلیل AI نسبت به جزوه،\n// درصد تطابق گفتهٔ کاربر با جزوه و پیشنهاد اصلاح — مدیر تایید/رد می‌کند.\n// فقط افزودنی: هیچ مسیر حذفی وجود ندارد؛ وضعیت تنها تغییر می‌کند.\nmodel LessonFeedback {\n  id           String    @id @default(cuid())\n  userId       String\n  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  courseId     String // شناسهٔ دوره (m4 / t3 / md7 / …)\n  chapterTitle String\n  lessonId     String\n  lessonTitle  String\n  conversation Json // آرایهٔ کامل پیام‌ها [{role, content, ts}]\n  matchPercent Int       @default(0) // درصد تطابق حرف کاربر با جزوه (۰–۱۰۰)\n  needsChange  Boolean   @default(false)\n  severity     String    @default(\"minor\") // minor | moderate | major\n  analysis     String // تحلیل هوش مصنوعی دربارهٔ انتقادها\n  suggestion   String // پیشنهاد مشخص برای مدیر\n  status       String    @default(\"pending\") // pending | approved | rejected\n  adminNote    String?\n  reviewedAt   DateTime?\n  createdAt    DateTime  @default(now())\n  updatedAt    DateTime  @updatedAt\n\n  @@index([userId])\n  @@index([status])\n  @@index([lessonId])\n}\n\n// نشست‌های فعال (توکن هش‌شده) — تنها این جدول قابلیت پاکسازی منقضی‌ها دارد\nmodel Session {\n  id        String   @id @default(cuid())\n  tokenHash String   @unique\n  userId    String\n  user      User     @relation(fields: [userId], references: [id])\n  createdAt DateTime @default(now())\n  expiresAt DateTime\n\n  @@index([userId])\n}\n\n// وضعیت پیشرفت هر جلسه برای هر کاربر — ادغام حداکثری\nmodel LessonState {\n  id           String   @id @default(cuid())\n  userId       String\n  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  lessonId     String\n  status       String // in-progress | completed\n  sectionsSeen Int      @default(1)\n  quizBest     Int? // بهترین نمره از ۱۰۰\n  markedReview Boolean  @default(false)\n  updatedAt    DateTime @updatedAt\n\n  @@unique([userId, lessonId])\n  @@index([lessonId])\n}\n\n// تاریخچهٔ کامل همهٔ آزمون‌ها — فقط افزودنی (append-only)\nmodel QuizAttempt {\n  id        String   @id @default(cuid())\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  lessonId  String\n  date      String // ISO روز مطالعه (مبنای تحلیل)\n  score     Int\n  createdAt DateTime @default(now())\n\n  @@index([userId, createdAt])\n  @@index([lessonId])\n}\n\n// روزهای دارای مطالعه (هیتمپ و استریک)\nmodel ActivityDay {\n  id     String @id @default(cuid())\n  userId String\n  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)\n  day    String // YYYY-MM-DD\n\n  @@unique([userId, day])\n}\n\n// یادداشت‌های هر کاربر روی دروس — فقط افزودنی، سرور هیچ‌گاه حذف نمی‌کند\nmodel Note {\n  id        String   @id @default(cuid()) // شناسهٔ تولیدشده در کلاینت\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  lessonId  String\n  text      String\n  quote     String?\n  createdAt DateTime @default(now())\n\n  @@unique([userId, id])\n  @@index([userId, lessonId])\n}\n\n// داده‌های سنگین/JSON مانند کتاب‌های واردشدهٔ اختصاصی کاربر و آخرین مکان مطالعه\nmodel UserBlob {\n  id                String   @id @default(cuid())\n  userId            String   @unique\n  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  customCoursesJson String   @default(\"[]\")\n  lastLocationJson  String   @default(\"{}\")\n  streakJson        String   @default(\"{}\")\n  // نشان‌های (هایلایت) درس‌ها — JSON: { [lessonId]: LessonMark[] }\n  marksJson         String   @default(\"{}\")\n  // سیاست جدید: حساب تازه با کتابخانهٔ خالی شروع می‌کند (همهٔ دوره‌های آماده در BuiltinHidden ثبت\n  // می‌شوند و کاربر خودش از «دوره‌های آماده» اضافه می‌کند). حساب‌های قدیمی seeded=false می‌مانند\n  // و همان رفتار قبلی (همه‌پیش‌فرض) دارند.\n  builtinSeeded     Boolean  @default(false)\n  updatedAt         DateTime @updatedAt\n}\n\n// ─── شبکهٔ اجتماعی اساتید و دانشجویان ─────────────────────────────────────────\n// مطالب وبلاگی استاد از همان المان‌های تدریس (LessonSection) ساخته می‌شود تا\n// «موقع نوشتن» هم بتواند از طراحی اپ استفاده کند. دانشجوها فالو می‌کنند،\n// کامنت می‌گذارند و دورهٔ استاد را به‌عنوان کتاب به بخش مطالعه می‌افزایند.\n\nmodel Post {\n  id         String    @id @default(cuid())\n  authorId   String\n  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)\n  title      String\n  summary    String    @default(\"\") // خلاصهٔ کوتاه برای فید\n  tags       String    @default(\"\")\n  category   String    @default(\"\") // شاخهٔ اصلی (سازگاری با نسخه‌های قبل)\n  categories String    @default(\"[]\") // شاخه‌های چندگانهٔ کتابخانهٔ عمومی — JSON آرایه‌ای از slug\n  thumbnail  String    @default(\"\") // تصویر شاخص دلخواه مطلب (آپلودی یا لینک)\n  quizJson   String    @default(\"[]\") // آزمون پایان مبحث — JSON آرایهٔ QuizQuestion\n  blocks     Json // آرایهٔ LessonSection — همان المان‌های صفحهٔ تدریس\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n  comments   Comment[]\n\n  @@index([authorId])\n}\n\nmodel Comment {\n  id        String    @id @default(cuid())\n  postId    String\n  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  text      String\n  replyToId String?\n  replyTo   Comment?  @relation(\"CommentThread\", fields: [replyToId], references: [id], onDelete: Cascade)\n  replies   Comment[] @relation(\"CommentThread\")\n  createdAt DateTime  @default(now())\n\n  @@index([postId])\n}\n\nmodel Follow {\n  id        String   @id @default(cuid())\n  studentId String\n  student   User     @relation(\"FollowStudent\", fields: [studentId], references: [id], onDelete: Cascade)\n  teacherId String\n  teacher   User     @relation(\"FollowTeacher\", fields: [teacherId], references: [id], onDelete: Cascade)\n  createdAt DateTime @default(now())\n\n  @@unique([studentId, teacherId])\n  @@index([teacherId])\n}\n\n// دورهٔ خودساختهٔ استاد؛ ساختار chapters دقیقاً مثل Course داخلی است تا موتور\n// مطالعه بدون تغییر کار کند (شناسه جلسه‌ها tc-{courseId}-{n})\nmodel TeacherCourse {\n  id           String    @id @default(cuid())\n  teacherId    String\n  teacher      User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)\n  title        String\n  tagline      String    @default(\"\")\n  description  String    @default(\"\")\n  icon         String    @default(\"\")\n  accent       String    @default(\"bronze\")\n  category     String    @default(\"other\") // شاخهٔ اصلی (سازگاری با نسخه‌های قبل)\n  categories   String    @default(\"[]\") // شاخه‌های چندگانه — استاد می‌تواند چند شاخه انتخاب کند\n  status       String    @default(\"published\") // draft فقط استاد | prep در حال آماده‌سازی | published منتشر شده\n  thumbnail    String    @default(\"\") // تصویر شاخص دلخواه دوره (آپلودی یا لینک)\n  chaptersJson String    @default(\"[]\") // آزمون هر فصل/جلسه داخل همین JSON ذخیره می‌شود\n  publishedAt  DateTime?\n  createdAt    DateTime  @default(now())\n  updatedAt    DateTime  @updatedAt\n\n  libraryEntries LibraryEntry[]\n\n  @@index([teacherId])\n}\n\n// کتابخانهٔ هر دانشجو: دوره‌های اساتیدی که به عنوان کتاب افزوده است\n// حذف، ردیف را پاک می‌کند ولی پیشرفت/تست‌ها مستقل در LessonState می‌مانند؛\n// افزودن دوباره همه را برمی‌گرداند.\nmodel LibraryEntry {\n  id       String        @id @default(cuid())\n  userId   String\n  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  courseId String\n  course   TeacherCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  addedAt  DateTime      @default(now())\n\n  @@unique([userId, courseId])\n}\n\n// دوره‌های داخلی اپ (مدنی ۱/۴/۷ و تجارت ۳) به‌صورت پیش‌فرض در «کتابخانهٔ من» همه هستند؛\n// اگر کاربر آن را از کتابخانه حذف کند اینجا ثبت می‌شود تا در هیچ دستگاهی دوباره\n// پیدا نیاید — ولی پیشرفت، تست‌ها و یادداشت‌های همان جلسات کاملاً سر جایش می‌ماند\n// و افزودن دوباره از «کتابخانهٔ عمومی ← دوره‌های آماده» همه را برمی‌گرداند.\nmodel BuiltinHidden {\n  id        String   @id @default(cuid())\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  courseId  String // مثل \"madani-1\"\n  createdAt DateTime @default(now())\n\n  @@unique([userId, courseId])\n  @@index([userId])\n}\n\n// امتیاز ستاره‌ای کاربر به مطلب یا دوره — قابل تغییر ولی بدون حذف تاریخچه;\n// میانگین امتیاز بالاتر، در فیدها و کتابخانهٔ عمومی جلوتر دیده می‌شود.\nmodel Rating {\n  id         String   @id @default(cuid())\n  userId     String\n  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  targetType String // \"post\" | \"tcourse\"\n  targetId   String\n  stars      Int // ۱ تا ۵\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n\n  @@unique([userId, targetType, targetId])\n  @@index([targetType, targetId])\n}\n",
  "inlineSchemaHash": "baf4d9b2ecd565315b7d4d876eb7aa7910820fb3cd88cdd61632295482d41bec",
  "copyEngine": true
