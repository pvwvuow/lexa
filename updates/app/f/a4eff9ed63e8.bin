(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,36267,o=>{"use strict";let s=[{id:"pack-vokalat-1388-madani",title:"دفترچهٔ واقعی ۱۳۸۸ — حقوق مدنی",exam:"آزمون وکالت",examSlug:"vokalat",branch:"حقوق مدنی",description:"سوالات ۱ تا ۲۰ درس حقوق مدنی دفترچهٔ رسمی آزمون وکالت ۱۳۸۸ اسکودا (کانون وکلای دادگستری): رهن، بیع کلی، خیارات، اجاره مال مشاع، حواله، ضمان، ارث، شرط نتیجه و علم اجمالی — با کلید رسمی و پاسخ تشریحی ماده‌به‌ماده.",minutes:30,passMark:60,kind:"mcq",questions:[{q:"در عقد رهن اگر بعد از ایجاب و قبول مرتهن فوت کند:",options:["عقد منفسخ می شود.","عقد قبلا واقع شده و عین مرهونه به تصرف وراث داده می شود.","عقدی واقع نشده و اثر ایجاب و قبول زایل می شود.","راهن حق فسخ عقد را خواهد داشت."],answer:2,why:"رهن با ایجاب و قبول واقع می‌شود؛ ایجاب برای مجبوب است و با فوت او قبل از قبول زایل می‌شود، پس عقد اصلاً واقع نشده است (مواد ۷۷۴ و ۱۹۱ ق.م).",topic:"رهن"},{q:"اتومبیلی با سرعت غیرمجاز در حال حرکت است. شخصی عمدا خود را در مسیر اتومبیل انداخته و مصدوم می شود. جبران خسارت بر عهده چه کسی است؟",options:["بر عهده خود مصدوم است و راننده مسوولیتی ندارد.","مسوولیت بین دو نفر به تساوی تقسیم می شود.","مسوولیت به نسبت میزان دخالت هر یک از طرفین بین آنها تقسیم می شود .","راننده مسوول است چون سرعت غیر مجاز داشته است ."],answer:0,why:"بر اساس ماده ۳۲۸ ق.م هر کس به شخص یا مال دیگری ضرر بزند ضامن است؛ در این فرض قصد ایراد خسارت متوجه خود مصدوم بوده و راننده عمداً مسیر را تغییر نداده است.",topic:"مسئولیت مدنی"},{q:"اگر مالی که موضوع قرض است بعد از تسلیم تلف یا ناقص شود خسارت به عهده چه کسی است ؟",options:["از مال مقترض است .","از مال مقرض است.","فقط در صورتی که مقترض تعدی و تفریط نموده باشد از مال مقترض خواهد بود.","در صورتی که فقط بر اثر آفات سماوی تلف یا ناقص شود از مال مقرض خواهد بود."],answer:0,why:"قرض ملک مقترض می‌شود (ماده ۶۴۸ ق.م) و طبق ماده ۶۳۶ تلف مال به هر دلیل بر عهده مقترض است، حتی بدون تعدی و تفریط.",topic:"قرض"},{q:"کدام یک از معاملات زیر معتبر است ؟",options:["معامله مکره","معامله مضطر","معامله انسان مست","معامله انسان بی هوش"],answer:1,why:"اکراه موجب عدم نفوذ معامله است نه بطلان (ماده ۲۰۸ ق.م)؛ معامله مضطر معتبر است ولی معامله سفیه در اموال غیر منوط به احتیاج (ماده ۱۲۴۲) و معامله مست و بی‌هوش فاقد اهلیت است (ماده ۱۹۰).",topic:"اهلیت و رضا"},{q:"اشخاصی که گاهی به فرض و گاهی به قرابت ارث می برند عبارتند از :",options:["پدر ، مادر ، زوج ، زوجه و کلاله امی","پدر ، خواهر ، خواهرهای ابوینی یا ابی ، کلاله امی و زوج","پدر ، مادر ، خواهر و خواهر های ابی یا ابوینی و کلاله امی","پدر، دختر و دختر ها ، خواهر و خواهر های ابی یا ابوینی و کلاله امی"],answer:3,why:"ماده ۸۸۶ ق.م: اشخاصی که گاهی به قرابت و گاهی به سبب (ولی‌بودن) ارث می‌برند عبارتند از پدر، دختر و دخترها، خواهر و خواهرهای ابی یا ابوینی و کلاله امی.",topic:"ارث"},{q:"اگر حصه یکی از دو شریک وقف باشد:",options:["متولی یا موقوف علیهم حق شفعه ندارند.","فقط متولی حق شفعه دارد.","فقط موقوف علیهم حق شفعه دارند.","متولی و موقوف علیهم حق شفعه دارند."],answer:0,why:"ماده ۸۷۹ ق.م: وقف شفعه ندارد؛ چون حصه وقف از ملکیت شریک خارج شده و شفعه مخصوص مال مشاع است.",topic:"شفعه و وقف"},{q:"کدام یک از عبارات زیر نادرست است؟",options:["عقد بیع معلق صحیح است.","عقد نکاح معلق باطل است.","عقد ضمان معلق صحیح است.","عقد اجاره معلق صحیح است."],answer:2,why:"ضمان باید بر ذمه مستقر باشد؛ بنا بر مشهور فقها و رویه قانون مدنی، عقد ضمان معلق صحیح نیست چون با استقرار دین بر ذمه ضامن ناسازگار است (مواد ۶۹۹ تا ۷۰۵ ق.م).",topic:"ضمان"},{q:"در کدام یک از عقود زیر علم اجمالی به مورد معامله کافی است؟",options:["عقد جعاله","عقد رهن","عقد قرض","عقد نکاح"],answer:0,why:"جعاله عقد لازم نیست و ماده ۵۶۶ ق.م تعیین اجرت را لازم نمی‌داند؛ علم اجمالی به کار انجامی و اجرت کافی است.",topic:"علم اجمالی"},{q:"کدام یک از اعمال حقوقی زیر را نمی توان به صورت شرط نتیجه ضمن عقد آورد؟",options:["طلاق","عدم عزل وکیل","وکالت","صلح"],answer:0,why:"ماده ۲۳۴ ق.م: شرط نتیجه فقط برای عقود میسر است؛ طلاق ایقاع است و نمی‌تواند شرط نتیجه قرار گیرد.",topic:"شرط نتیجه"},{q:"چنانچه در عقد بیعی که مبیع آن کلی است جنس و مقدار مبیع ذکر شود ولی وصف آن ذکر نگردد عقد بیع چه وضعیتی دارد؟",options:["صحیح است .","قابل فسخ است .","باطل است.","صحیح است ولی فروشنده مجبور نیست فرد اعلای آن را ایفاء کند"],answer:2,why:"در بیع کلی ذکر جنس و مقدار کافی نیست و اوصاف معین نیز باید مشخص باشد؛ در غیر این صورت موضوع معامله به نحو امری (ماده ۲۱۶ و ۱۹۰ ق.م) تعیین نشده و عقد باطل است.",topic:"بیع کلی"},{q:"اگر بعد از عقد بیع و قبل از تسلیم در مبیع نقصی حاصل شود ، بیع چه وضعیتی دارد ؟",options:["مشتری حق فسخ دارد.","بیع منفسخ می شود.","مشتری فقط حق مطالبه ارش دارد.","چون عیب باید در حین عقد موجود باشد مشتری هیچ حقی ندارد."],answer:0,why:"ماده ۳۷۹ ق.م: هرگاه مبیع قبل از تسلیم نقصی حاصل شود مشتری حق فسخ دارد (تلف منجر به انفساخ است اما نقص فقط خیار می‌آورد).",topic:"خیار عیب"},{q:"برای حداقل سن نکاح کدام گزینه صحیح است؟",options:["برای دختر ۱۳ سال تمام قمری و برای پسر ۱۵ سال تمام قمری","برای دختر ۱۵ سال تمام شمسی و برای پسر ۱۵ سال تمام شمسی","برای دختر ۹ سال تمام قمری و برای پسر ۱۵ سال تمام قمری","برای دختر ۱۳ سال تمام شمسی و برای پسر ۱۵ سال تمام شمسی"],answer:3,why:"ماده ۱۰۴۱ ق.م (اصلاحی): هیچ‌کس نمی‌تواند قبل از سن بلوج دختر ۱۳ سال تمام شمسی و پسر ۱۵ سال تمام شمسی ازدواج کند.",topic:"نکاح"},{q:"درخصوص اجاره مال مشاع کدام یک از گزینه ها صحیح است؟",options:["اجاره مال مشاع و تسلیم عین مستاجره جایز است.","اجاره مال مشاع فقط با اجازه شریک جایز است.","اجاره مال مشاع جایز نیست.","اجاره مال مشاع بدون اذن شریک هم جایز است."],answer:3,why:"ماده ۴۶۷ ق.م: اجاره مال مشاع جایز است؛ مالک می‌تواند سهم مشاع خود را اجاره دهد و اذن شریک شرط صحت نیست.",topic:"اجاره"},{q:"شخصی کالایی را خریداری کرده و پس از انجام معامله متوجه می شود که کالای خریداری شده معیوب است. خریدار پیش از اتخاذ هر گونه تصمیمی فوت می کند، در این صورت:",options:["ورثه فقط حق مطالبه ارش دارند.","حق فسخ ورثه و نیز حق مطالبه ارش ساقط می شود.","ورثه مختارند در فسخ معامله و یا مطالبه ارش","ورثه فقط حق فسخ معامله را دارند."],answer:2,why:"ماده ۴۴۸ ق.م: خیار عیب با فوت مشتری به ورثه منتقل می‌شود و ورثه مختارند معامله را فسخ کنند یا ارش بگیرند یا معامله را تنفیذ کنند.",topic:"خیار عیب"},{q:"در حواله لازم است :",options:["محیل به محتال مدیون باشد.","محیل به محال علیه مدیون باشد.","محتال به محیل مدیون باشد.","محال علیه به محیل مدیون باشد."],answer:0,why:"ماده ۷۲۴ ق.م: در حواله دین محیل باید موجود باشد؛ یعنی محیل به محتال مدیون باشد، وگرنه حواله واقع نمی‌شود.",topic:"حواله"},{q:"اگر مشتری بعد از عقد ، مبیع را اجاره داده باشد و بیع مذکور به استناد یکی از خیارات فسخ شود:",options:["عقد اجاره صحیح است و بایع نمی تواند فسخ یا ابطال آن را بخواهد.","عقد اجاره باطل است و بایع می تواند حکم بر بطلان آن را از دادگاه بخواهد.","عقد اجاره غیرنافذ است و اعتبار آن مستلزم تنفیذ از ناحیه بایع است.","عقد اجاره صحیح است اما بایع می تواند آن را فسخ کند."],answer:0,why:"ماده ۳۹۵ ق.م: اگر مشتری مبیع را اجاره دهد و بعد بیع فسخ شود، اجاره به قوت خود باقی است و بایع حق فسخ یا ابطال اجاره را ندارد؛ فقط اجرت‌المثل منتفی می‌شود.",topic:"خیارات و اجاره"},{q:"چنانچه ولی قهری طفل رعایت غبطه صغیر را ننماید و مرتکب اعمالی شود که موجب ضرر مولی علیه است:",options:["دادستان می تواند منحصراً از اقربای صغیر قیم تعیین کند.","با درخواست یکی از اقارب وی یا درخواست رئیس حوزه قضایی پس از اثبات در دادگاه ، دادگاه ولی مذکور را عزل و راساً قیم تعیین می نماید.","ولی قهری ملزم می شود رعایت غبطه صغیر را بنماید و جبران ضرر کند.","دادگاه حق عزل ولی قهری را ندارد و فقط می تواند ضم امین نماید."],answer:1,why:"ماده ۱۱۸۴ ق.م: در صورت عدم رعایت غبطه صغیر توسط ولی قهری و اثبات ضرر، دادگاه به درخواست اقارب یا رئیس حوزه قضایی او را از ولایت عزل می‌کند.",topic:"ولایت"},{q:"کدام یک از عقود زیر لازم است ؟",options:["عقد مزارعه","عقد مضاربه","عقد جعاله","عقد وکالت"],answer:0,why:"ماده ۵۱۹ ق.م: مزارعه از عقود لازم است و هیچ‌یک از طرفین نمی‌تواند به قصد فرار از آن فسخ کند.",topic:"مزارعه"},{q:"اگر برخورد دو وسیله نقلیه خارج از اراده راننده ها باشد:",options:["خسارات بالمناصفه بین طرفین تقسیم می شود.","هر کدام باید نصف خسارت دیگری را جبران کند.","هر کدام باید خسارات دیگری را جبران کند.","هیچکدام ضامن نیستند."],answer:3,why:"در تصادم که خارج از اراده هر دو راننده و بدون قصور باشد، هیچ فعل و سببی نسبت به هیچ‌یک محقق نشده و طبق قاعده لا ضمان و ماده ۳۲۸ ق.م هیچ‌کدام ضامن نیستند.",topic:"مسئولیت مدنی"},{q:"اقرار سفیه در دعوای راجع به نسب و دعوای راجع به معاملات:",options:["در مورد اول موثر و در مورد دوم بی اثر است.","در هر دو مورد بی اثر است و موثر نیست.","در هر دو موثر است.","در مورد اول بی اثر و در دومی موثر است. آیین دادرسی مدنی"],answer:0,why:"ماده ۱۲۷۷ ق.م: اقرار سفیه در نسب مؤثر است (اماره قاطع) اما در دعاوی معاملات مربوط به اموال خود بی‌اثر است.",topic:"اقرار"}]},{id:"pack-vokalat-1388-dadresi",title:"دفترچهٔ واقعی ۱۳۸۸ — آیین دادرسی مدنی",exam:"آزمون وکالت",examSlug:"vokalat",branch:"آیین دادرسی مدنی",description:"سوالات ۲۱ تا ۴۰ درس آیین دادرسی مدنی دفترچهٔ رسمی آزمون وکالت ۱۳۸۸: ایرادات، اعتراض ثالث، دستور موقت، تأمین خواسته، جلب ثالث، کارشناسی، واخواهی و اعاده دادرسی — با کلید رسمی و تشریح مواد ق.آ.د.م.",minutes:30,passMark:60,kind:"mcq",questions:[{q:"کدام گزینه صحیح نیست ؟",options:["مرجع اعاده دادرسی اصلی دادگاه صادر کننده حکم است.","اعتراض ثالث طاری به موجب دادخواست است.","هیچ یک از قرارها قابل اعاده دادرسی نیست.","اعتراض شخص ثالث مهلت ندارد."],answer:1,why:"اعتراض ثالث اصلی به موجب دادخواست است (ماده ۱۳۰ ق.آ.د.م) اما اعتراض ثالث طاری در مرحله اجرا با تقدیم لایه/تقاضا صورت می‌گیرد؛ عبارت نادرست همین گزینه است.",topic:"اعتراض ثالث"},{q:"کدام گزینه صحیح است ؟",options:["چنانچه دادخواست تجدید نظر خارج از مهلت داده شود به موجب قراردادگاه صادر کننده رای بدوی رد می شود.","رای دادگاه تجدیدنظر در هیچ صورتی غیابی محسوب نمی شود.","ادعای جدید در مرحله تجدید نظر مسموع است.","چنانچه دادخواست تجدیدنظر خارج از مهلت داده شود به موجب قرار دادگاه تجدید نظر رد می شود."],answer:0,why:"ماده ۳۴۳ ق.آ.د.م: اگر دادخواست تجدیدنظر خارج از مهلت تقدیم شود، دادگاه صادرکننده رأی بدوی قرار رد دادخواست صادر می‌کند.",topic:"تجدیدنظر"},{q:"ایرادات و اعتراضات باید……. به عمل آید مگر اینکه سبب ایراد متعاقباً حادث شود.",options:["بعد از اولین جلسه دادرسی","قبل از جلسه رسیدگی","تا اولین جلسه دادرسی","تا پایان اولین جلسه دادرسی"],answer:3,why:"ماده ۸۸ ق.آ.د.م: ایرادات باید تا پایان اولین جلسه دادرسی به عمل آید مگر اینکه سبب ایراد متعاقباً حادث شود.",topic:"ایرادات"},{q:"وکیلی که به دادگاه دادخواست تقدیم کرده :",options:["تا قبل از اعلام ختم دادرسی می تواند استعفا بدهد.","باید در زمانی استعفا دهد که موجب تجدید جلسه نشود در غیر این صورت دادگاه به ا ین علت جلسه را تجدید نخواهد کرد.","در صورتی استعفایش پذیرفته می شود که به اطلاع موکل رسانده باشد.","هر زمان بخواهد می تواند استعفا دهد و استعفایش موجب تجدید جلسه خواهد شد."],answer:1,why:"ماده ۱۲۵ ق.آ.د.م: استعفای وکیل باید در زمانی باشد که موجب تجدید جلسه نشود؛ در غیر این صورت دادگاه به اعتراض طرف مقابل استعفا را نپذیرفته و جلسه را برقرار نگه می‌دارد.",topic:"وکالت دادرسی"},{q:"دعاوی راجع به ترکه متوفی تا زمانی که ترکه تقسیم نشده است:",options:["در دادگاه آخرین محل اقامت متوفی در ایران اقامه می شود.","اگر خواسته راجع به مال غیرمنقول باشد در دادگاه محل وقوع مال اقامه می شود.","اگر خواسته راجع به دین باشد در دادگاه محل اقامت خوانده اقامه می شود .","در دادگاه محل اقامت ورثه اقامه می شود."],answer:0,why:"ماده ۱۵ ق.آ.د.م: دعاوی راجع به ترکه متوفی تا زمانی که تقسیم نشده، در دادگاه آخرین اقامتگاه متوفی در ایران اقامه می‌شود.",topic:"صلاحیت محلی"},{q:"دادگاه در چه صورتی به نظریه کارشناسی ترتیب اثر نمی دهد؟",options:["فقط در صورتی که با اوضاع و احوال محقق و معلوم موضوع دعوی مطابقت نداشته و مورد اعتراض هم قرار گرفته باشد.","در صورتی که خوانده به آن اعتراض کرده باشد.","در صورتی که با اوضاع و احوال منطبق نباشد.","در صورتی که مورد اعتراض خواهان قرار گیرد."],answer:2,why:"ماده ۲۶۰ ق.آ.د.م: دادگاه باید نظریه کارشناس را با اوضاع و احوال محقق و معلومات خود تطبیق دهد؛ در صورت عدم انطباق به آن ترتیب اثر نمی‌دهد.",topic:"کارشناسی"},{q:"حداقل فاصله زمانی تاریخ ابلاغ احضاریه به گواه با جلسه رسیدگی چند روز است ؟",options:["سه روز","پنج روز","هفت روز","ده روز"],answer:2,why:"ماده ۱۷۱ ق.آ.د.م: احضاریه گواه حداقل یک هفته قبل از جلسه رسیدگی ابلاغ می‌شود.",topic:"شهادت"},{q:"چنانچه پس از تردید یا انکار سند خوانده نسبت به همان سند ادعای جعل نماید دادگاه به کدام یک رسیدگی خواهد کرد؟",options:["به انکار یا تردید و جعل هر سه رسیدگی خواهد کرد.","فقط به انکار یا تردید رسیدگی خواهد نمود.","فقط به ادعای جعل رسیدگی می کند.","دادگاه مخیر است به هر کدام از ادعاها رسیدگی کند."],answer:2,why:"ماده ۲۱۶ ق.آ.د.م: اگر پس از تردید یا انکار، نسبت به همان سند ادعای جعل شود، دادگاه صرفاً به ادعای جعل رسیدگی می‌کند.",topic:"انکار و جعل"},{q:"در صورتی که محکوم علیه غیابی بخواهد درخواست جلب ثالث کند باید:",options:["از محکوم علیه غیابی دادخواست جلب ثالث پذیرفته نمی شود.","دادخواست اعتراض ( واخواهی ) را همراه با دادخواست جلب ثالث تواماً به دفتر دادگاه تسلیم می کند.","در جلسه ی اول که به منظور رسیدگی به واخواهی تعیین شده است جهات و دلایل را اظهار و ظرف ۳ روز دادخواست به دادگاه بدهد .","ضمن دادخواست واخواهی ( اعتراض ) درخواست جلب ثالث کند."],answer:1,why:"ماده ۱۱۴ ق.آ.د.م: محکوم‌علیه غیابی برای جلب ثالث باید دادخواست اعتراض (واخواهی) و دادخواست جلب ثالث را توأمان در مهلت اعتراض بدهد.",topic:"واخواهی"},{q:"در صورتی که مال غیر منقولی به نحو اشتراک در تصرف چند نفر باشد و بعضی از آنان مانع تصرف بعضی دیگر شود عمل آنان…..",options:["در حکم تصرف عدوانی است و مشمول مقررات راجع به دعاوی تصرف عدوانی در قانون آیین دادرسی مدنی است.","در صورتی عدوانی محسوب می شود که سهم هر یک معلوم باشد.","تصرف عدوانی تلقی نمی شود زیرا هر یک از آنان در اجزای مال سهیم هستند.","در حکم تصرف عدوانی است اما چون مالکیت طرفین مشاعی است دعوای رفع تصرف عدوانی مسموع نیست."],answer:0,why:"ماده ۱۵۶ ق.آ.د.م: اگر مال غیرمنقولی به نحو اشتراک در تصرف چند نفر باشد و بعضی مانع تصرف بعضی دیگر شوند، عمل آنان در حکم تصرف عدوانی است.",topic:"دعاوی تصرفی"},{q:"هر گاه پس از صدور دستور موقت ادعای خواهان رد شود:",options:["خوانده می تواند ظرف یک ماه از تاریخ ابلاغ رای نهایی برای مطالبه خسارت طرح دعوا کند.","خوانده می تواند ظرف ۱۰ روز از تاریخ ابلاغ رای نهایی مطالبه ی خسارت کند و این درخواست تابع تشریفات آیین دادرسی مدنی نیست.","خوانده می تواند ظرف بیست روز از تاریخ ابلاغ رای نهایی برای مطالبه خسارت دعوا طرح کند.","خوانده می تواند ظرف بیست روز از تاریخ ابلاغ رای نهایی مطالبه خسارت کند و این درخواست تابع تشریفات آیین دادرسی مدنی نیست ."],answer:0,why:"ماده ۳۲۵ ق.آ.د.م: در صورت رد ادعای خواهان، خوانده می‌تواند ظرف یک ماه از تاریخ ابلاغ رأی قطعی، خسارات وارده را مطالبه کند.",topic:"دستور موقت"},{q:"احکام مستند به اقرار در دادگاه :",options:["مطلقا قابل درخواست تجدید نظر است.","مطلقا قابل درخواست تجدید نظر نیست.","با رعایت حدنصاب قابل تجدید نظر است.","قابل درخواست تجدیدنظر نیست مگر در خصوص صلاحیت دادگاه یا قاضی صادر کننده حکم"],answer:3,why:"ماده ۳۷۲ ق.آ.د.م: احکام مستند به اقرار در دادگاه قابل تجدیدنظر نیست؛ مگر در خصوص صلاحیت دادگاه یا قاضی صادرکننده.",topic:"تجدیدنظر"},{q:"چنانچه پس از درخواست اعاده دادرسی پرونده با قبول درخواست اعاده دادرسی در دادگاه مطرح شود، کدام یک از گزینه های زیردرست است؟",options:["فقط دعوای ورود ثالث پذیرفته می شود.","غیر از طرفین دعوی شخص دیگری به هیچ عنوان نمی تواند داخل در دعوا شود.","طبق قواعد عمومی آیین دادرسی مدنی امکان اقامه دعوای طاری وجود دارد.","فقط دعوای متقابل پذیرفته می شود."],answer:1,why:"ماده ۴۳۲ ق.آ.د.م: در اعاده دادرسی فقط طرفین دعوا می‌توانند وارد شوند و شخص ثالث به هیچ عنوان داخل در دعوا نمی‌شود.",topic:"اعاده دادرسی"},{q:"آیا تصمیم دادگاه در مورد اعتراض ثالث اجرایی که مستند به حکم قطعی یا سند رسمی نباشد( موضوع ماده ۴۷ قانون اجرای احکام مدنی ) قابل تجدید نظر است؟",options:["بله ، در همان دادگاه","بله در دیوان کشور","بله در دادگاه تجدیدنظر استان","خیر"],answer:2,why:"ماده ۱۸۷ ق.آ.د.م: تصمیم دادگاه درباره اعتراض ثالث اجرایی که مستند به حکم قطعی یا سند رسمی نیست (ماده ۴۷ آیین‌نامه اجرا)، در دادگاه تجدیدنظر استان رسیدگی می‌شود.",topic:"اعتراض ثالث اجرایی"},{q:"در صورتی که دعوا قبلا در دادگاه دیگری اقامه و مطرح رسیدگی باشد و با ایراد سبق طرح دعوی توسط خوانده در جلسه اول مواجه شود:",options:["دادگاه قرار عدم استماع دعوی صادر می کند.","دادگاه از رسیدگی به دعوی خودداری و پرونده را به دادگاهی که دعوی در آن مطرح است ارسال می کند.","دادگاه قرار رسیدگی توامان صادر می کند.","دادگاه قرار رد دعوی صادر می کند."],answer:1,why:"ماده ۹۰ ق.آ.د.م: با پذیرش ایراد سبق طرح دعوا، دادگاه از رسیدگی خودداری و پرونده را به دادگاهی که دعوا در آن مطرح بوده ارسال می‌کند.",topic:"ایرادات"},{q:"از دادگاه بدوی حکمی مبنی بررفع تصرف عدوانی صادر شده است ، این حکم :",options:["پس از ابلاغ قابل اجراست.","بلافاصله قابل اجراست","فقط پس از قطعیت قابل اجراست","بلافاصله پس از صدور و با اخذ تامین از محکوم له قابل اجراست."],answer:1,why:"ماده ۱۹۵ ق.آ.د.م: حکم رفع تصرف عدوانی قابل تجدیدنظرخواهی نیست و بلافاصله قابل اجراست.",topic:"دعاوی تصرفی"},{q:"در صورتی که طرف دعوی تامینی بدهد که متناسب با موضوع دستور موقت باشد:",options:["دادگاه مکلف به رفع از اثر دستور موقت است.","دادگاه در صورت مصلحت می تواند از دستور موقت رفع اثر نماید.","دادگاه نمی تواند در هیچ حالتی از دستور موقت خود رفع اثر کند .","دادگاه فقط در صورت رضایت خواهان دستور موقت ، از آن لغو اثر می کند."],answer:1,why:"ماده ۳۲۳ ق.آ.د.م: در صورت ارائه تأمین متناسب با موضوع دستور موقت از سوی طرف دعوی، دادگاه در صورت مصلحت می‌تواند از دستور موقت رفع اثر نماید.",topic:"دستور موقت"},{q:"ثالثی که به درخواست یکی از اصحاب دعوی جلب به دادرسی می شود چه موقعیتی دردادرسی دارد؟",options:["موقعیت خوانده","موقعیت خواهان","موقعیت گواه","موقعیت خواهان یا خوانده حسب مورد"],answer:0,why:"ماده ۱۳۶ ق.آ.د.م: جلب ثالث به درخواست هر یک از اصحاب دعوا، موقعیت خوانده را برای او ایجاد می‌کند.",topic:"جلب ثالث"},{q:"چنانچه پس از صدور قرار تامین خواسته ظرف مهلت مقرر اقامه دعوی نشود:",options:["چنانچه مستند صدورقرار تامین سند رسمی باشد مجاز به رفع اثر نیست.","دادگاه به درخواست خوانده از قرار تامین رفع اثر می کند.","دادگاه مجاز به رفع اثر از قرار تامین نیست.","دادگاه راساً از قرار تامین رفع اثر می کند."],answer:1,why:"ماده ۱۰۱ و ۱۱۱ ق.آ.د.م: اگر پس از قرار تأمین خواسته ظرف مهلت بیست روز دعوای اصلی اقامه نشود، دادگاه به درخواست خوانده از تأمین رفع اثر می‌کند.",topic:"تأمین خواسته"},{q:"دلایلی که برای اثبات ضمان قهری اقامه می شود تابع کدام قانون است؟",options:["قانون زمان اجرای حکم","قانون زمان طرح دعوی","قانون حاکم بر زمان تحقق واقعه ی موجب ضمان","قانون زمان صدور حکم حقوق تجارت"],answer:1,why:"ماده ۵ ق.آ.د.م: قوانین شکلی از جمله قانون اثبات دعوا، تابع قانون زمان طرح دعوا و دادرسی است؛ برخلاف قوانین ماهوی که اصولاً عطف به ماسبق می‌شوند.",topic:"تعارض قوانین"}]},{id:"pack-vokalat-1388-tejarat",title:"دفترچهٔ واقعی ۱۳۸۸ — حقوق تجارت",exam:"آزمون وکالت",examSlug:"vokalat",branch:"حقوق تجارت",description:"سوالات ۴۱ تا ۶۰ درس حقوق تجارت دفترچهٔ رسمی آزمون وکالت ۱۳۸۸: چک و سفته و برات، دفاتر تجاری، شرکت سهامی، ورشکستگی و قرارداد ارفاقی، قائم‌مقام تجارتی و حمل و نقل — با کلید رسمی و تشریح مواد ق.ت.",minutes:30,passMark:60,kind:"mcq",questions:[{q:"به موجب قانون صدور چک در صورت صدور چک به وکالت مسوولیت پرداخت وجه آن به عهده کیست ؟",options:["فقط وکیل","فقط موکل","وکیل و موکل بالمناصفه","وکیل و موکل متضامناً"],answer:3,why:"ماده ۱۴ ق.چک: چکی که به وکالت صادر شود، مسئولیت پرداخت وجه آن متضامناً به عهده وکیل و موکل است.",topic:"چک"},{q:"در مورد سفته ای که فاقد امضاء متعهد ( صادر کننده ) است ظهر نویسان چه مسوولیتی دارند؟",options:["به دلیل فقدان امضای صادر کننده چنین سفته ای هیچ اعتباری ندارد.","متعهد به علت فقدان امضاء مسوول نیست اما ظهرنویسان در برابر دارنده مسوول هستند.","در صورت اعتراض عدم تادیه و طرح دعوی در مهلت قانونی ظهرنویسان مسوولیت دارند.","بر اساس اصل استقلال امضاءها در برابر دارنده مسوولیت تضامنی دارند."],answer:0,why:"امضای متعهدله (صادرکننده) رکن اساسی سفته است؛ با فقدان آن سفته اصلاً وجود ندارد و ظهرنویسان هم مسئولیتی ندارند (ماده ۲۴۹ ق.ت).",topic:"سفته"},{q:"داشتن کدام یک از دفاتر زیر برای تاجر الزامی نیست؟",options:["دفتر دارایی","دفتر روزنامه","دفتر کپیه","دفتر ترازمالی ماهانه"],answer:3,why:"ماده ۴ ق.ت: دفاتر الزامی تاجر عبارتند از دفتر روزنامه، کل، دارایی و کپیه؛ دفتر تراز مالی ماهانه جزو دفاتر الزامی نیست.",topic:"دفاتر تجاری"},{q:"در شرکت سهامی عام امضاء ورقه تعهد سهم :",options:["به خودی خود مستلزم قبول تصمیمات هیات مدیره است.","منحصراً مستلزم قبول تصمیمات مجامع عمومی است.","به خودی خود مستلزم قبول اساسنامه و تصمیمات مجامع عمومی است.","به خودی خود مستلزم قبول تصمیمات مجامع عمومی و هیات مدیره است."],answer:2,why:"ماده ۲۳ ق.ت: امضای ورقه تعهد سهم به خودی خود مستلزم قبول اساسنامه شرکت و تصمیمات مجامع عمومی است.",topic:"شرکت سهامی"},{q:"آیا درخواست ورشکستگی بعد از انحلال شرکت امکان پذیر است ؟",options:["خیر، چون بعد از انحلال شخصیت حقوقی شرکت از بین می رود.","بله ، چون شرکت تا ختم تصفیه دارای شخصیت حقوقی است.","در شرکت های تضامنی امکان پذیر نیست.","در شرکت های سهامی امکان پذیر نیست."],answer:1,why:"ماده ۲۰۲ ق.ت: تا زمانی که تصفیه شرکت خاتمه نیافته، شرکت از حیث ما فی‌الذمه برای طلبکاران برقرار است و درخواست ورشکستگی ممکن است.",topic:"ورشکستگی"},{q:"در صورتی که مرسل الیه مخارج و سایر وجوهی را که متصدی حمل و نقل بابت مال التجاره مطالبه می نماید قبول نکند، در این فرض متصدی حمل ونقل دارای چه حقی است ؟",options:["تملک","حبس","ترهین","فروش"],answer:1,why:"ماده ۲۷۴ ق.ت: متصدی حمل و نقل حق حبس دارد؛ در صورت رد مخارج توسط مرسل‌الیه، می‌تواند مال را حبس کند و با اجازه دادگاه بفروشد.",topic:"حمل و نقل"},{q:"شرکت سهامی چه زمانی شخصیت حقوقی پیدا می کند ؟",options:["پس از تعهد کلیه سهام شرکت","پس از قبول سمت مدیران و بازرسان","پس از ثبت و اعلان در جراید","پس از ثبت و اعلان در روزنامه رسمی"],answer:1,why:"ماده ۷۹ ل.ا.ق.ت: شرکت سهامی با ثبت در دفتر ثبت شرکت‌ها شخصیت حقوقی پیدا می‌کند؛ از شرایط ثبت، قبول سمت مدیران و بازرسان است؛ طبق کلید رسمی، این گزینه ملاک است.",topic:"شرکت سهامی"},{q:"انتخاب اشخاص حقوقی به عنوان مدیر شرکت های سهامی :",options:["فقط در موارد خاص امکان پذیر است.","در هر حال امکان پذیر است.","به هیچ وجه امکان پذیر نیست.","در صورت تصویب مجمع عمومی فوق العاده امکان پذیر است."],answer:1,why:"ماده ۱۲۴ ل.ا.ق.ت: انتخاب اشخاص حقوقی به عنوان مدیر شرکت سهامی در هر حال امکان‌پذیر است (مگر منع قانونی خاص).",topic:"شرکت سهامی"},{q:"قائم مقام تجارتی در چه صورتی منعزل است؟",options:["با جحر رئیس تجارت خانه","با فوت رئیس تجارت خانه","با انحلال شرکت تجاری","هر سه مورد صحیح است."],answer:2,why:"قائم‌مقام تجارتی نمایندگی عام شرکت است (ماده ۲۴۴ ق.ت)؛ با انحلال شرکت، اساس این نمایندگی از بین می‌رود و قائم‌مقامی منعزل می‌شود.",topic:"قائم‌مقام تجارتی"},{q:"اگر مال التجاره تلف یا گم شود متصدی حمل و نقل در چه صورتی مسوول است؟",options:["در صورتی که ثابت کند تعدی و تفریط نکرده است ، مسوول نیست .","در صورتی مسوول است که نتواند ثابت کند که تلف مربوط به حوادثی بوده که هیچ متصدی مواظبی نمی توانست از آن جلوگیری کند.","در صورتی مسوول است که ثابت شود تعدی و تفریط کرده است .","مطلقا مسوول است."],answer:1,why:"ماده ۲۶۸ ق.ت: متصدی حمل مسئول تلف یا گم شدن مال‌التجاره است مگر ثابت کند تلف مربوط به حوادثی بوده که هیچ متصدی مواظب و کوششی نمی‌توانست از آن جلوگیری کند.",topic:"حمل و نقل"},{q:"معاملات تاجر ورشکسته در فاصله بین صدور حکم راجع به تصدیق قرارداد ارفاقی و حکم بر بطلان یا فسخ آن :",options:["در صورتی که ضرر وارد شود حتی بدون قصد اضرار هم باطل است.","در صورتی که به قصد اضرار به طلبکاران باشد و واقعا هم ضرر وارد شود باطل است","در هر حال صحیح است.","مطلقا باطل است."],answer:1,why:"ماده ۴۲۶ ق.ت: قرارداد ارفاقی از تاریخ تصدیق لازم‌الاجرا است؛ معاملاتی که به قصد اضرار به طلبکاران انجام و واقعاً ضرر بزند، باطل است.",topic:"ورشکستگی"},{q:"چنانچه شرکتی تجاری تشکیل شود و امور تجارتی خود را به صورت یکی از شرکت های مذکور در قانون تجارت درنیاورد تابع چه مقرراتی است؟",options:["تا بع مقررات شرکت های سهامی خاص است.","تابع مقررات قانون مدنی است.","تابع احکام راجع به شرکت های تضامنی است و شرکت تضامنی محسوب می شود.","تابع اساسنامه شرکت است هرچند منطبق با هیچ یک از شرکت های قانونی نباشد."],answer:2,why:"ماده ۵۸۷ ق.ت: اگر شرکتی تشکیل شود و قصد طرف این باشد که امور تجارتی آنها به‌عنوان یکی از شرکت‌های مذکور در قانون تجارت انجام شود ولی تشریفات کامل نشود، تابع قواعد شرکت تضامنی است.",topic:"شرکت تضامنی"},{q:"مطابق قانون تجارت در شرکت های سهامی انتقال سهام با نام چگونه صورت می گیرد؟",options:["با ثبت در دفتر سهام شرکت","با سند رسمی","با قبض و اقباض","با پشت نویسی ورقه سهام"],answer:0,why:"ماده ۴۰ ل.ا.ق.ت: انتقال سهام با‌نام باید با ثبت در دفتر سهام شرکت صورت گیرد؛ الا با شخصیت حقوقی شرکت ناسازگار است.",topic:"سهام"},{q:"تغییر و اصلاح طرح اساسنامه با چه مرجعی است ؟",options:["مجمع عمومی فوق العاده","مجمع عمومی عادی به طور فوق العاده","مجمع عمومی موسس","مجمع عمومی عادی"],answer:2,why:"طرح (پیش‌نویس) اساسنامه پیش از ثبت شرکت است و تغییر و اصلاح آن در مرحله تأسیس با مجمع عمومی مؤسس است (ماده ۱۹۰ ل.ا.ق.ت).",topic:"شرکت سهامی"},{q:"اگر کسی که برات در وجه او صادر شده است بدون نوشتن هیچ مطلبی فقط پشت سند را امضاء کند و آن را دراختیار دیگری قرار دهد:",options:["ظهر نویسی دلالت بر وثیقه گذاشتن سند دارد.","ظهر نویسی حاکی از انتقال سند است.","ظهر نویسی دلالت بروکالت دادن به گیرنده جهت وصول دارد.","ظهر نویسی ضمانت تلقی می گردد."],answer:1,why:"ماده ۲۳۳ ق.ت: ظهرنویسی بدون هیچ قیدی حاکی از انتقال سند است؛ دارنده سند، متضامناً مسئول پرداخت به دارنده بعدی می‌شود.",topic:"برات"},{q:"در صورتی که تاریخ توقف تاجر در حکم ورشکستگی قید نشده باشد تاریخ توقف تاجر چه زمانی محسوب می شود؟",options:["تاریخ قطعیت حکم ورشکستگی","تاریخ شروع به اجرای حکم ورشکستگی","تاریخ طرح دعوی در محکمه","تاریخ صدور حکم ورشکستگی"],answer:3,why:"ماده ۴۱۸ ق.ت: در صورتی که تاریخ توقف تاجر در حکم ورشکستگی در دادنامه قید نشده باشد، تاریخ صدور حکم ورشکستگی به‌عنوان تاریخ توقف محسوب می‌شود.",topic:"ورشکستگی"},{q:"آیا در اجرای چک از طریق ثبت می توان علیه ظهرنویس اقدام کرد؟",options:["خیر","بله ، اگر مدت ۱۵ روز از صدور گواهی عدم پرداخت نگذاشته باشد.","بله ، اگر مدت ۶ ماه از زمان صدور گواهی عدم پرداخت نگذاشته باشد.","بله ، زیرا وی ( ظهر نویس) مسوولیت پرداخت وجه چک را پذیرفته است."],answer:0,why:"طبق ماده ۲ ق.اجرای اسناد رسمی، اجرای ثبت فقط نسبت به صادرکننده و ضامن چک ممکن است؛ نسبت به ظهرنویس قابل اقدام نیست.",topic:"چک"},{q:"مسوولیت موسسین شرکت سهامی نسبت به اعمال و اقداماتشان به منظور تاسیس و ثبت شرکت چگونه است ؟",options:["تضامنی","به نسبت مبلغ پذیری نویسی شده","به تساوی","به نسبت سهام"],answer:0,why:"ماده ۴۷ ق.ت: موسسین شرکت سهامی نسبت به اعمال و اقداماتی که به‌منظور تأسیس و ثبت انجام می‌دهند متضامناً مسئولند.",topic:"شرکت سهامی"},{q:"کسی که چک پس از ارائه به بانک و صدور گواهی عدم پرداخت ( برگشت ) به وی منتقل شده است :",options:["مطلقا حق تعقیب کیفری ندارد.","فقط حق دارد از طریق اجرای ثبت تقاضای صدور اجرائیه کند.","چنانچه انتقال با سند رسمی باشد از کلیه ی حقوق قانونی بهره مند است.","در صورتی که انتقال قهری باشد از کلیه حقوق قانونی بهره مند است."],answer:3,why:"ماده ۱۴ ق.چک: اگر چک پس از برگشت منتقل شود، دارنده فعلی فقط حق مطالبه وجه دارد؛ اما در انتقال قهری (ارث و...) از کلیه حقوق قانونی دارنده بهره‌مند است.",topic:"چک"},{q:"کدام گزینه در مورد مطالبه ی وجه برات صحیح است؟",options:["دادگاه می تواند به مدیون مهلت بدهد ولی مجاز به قرار اقساط نیست.","دادگاه نمی تواند بدون موافقت طلبکار به مدیون مهلت بدهد.","دادگاه راساً می تواند مهلت عادله بدهد.","دادگاه می تواند به درخواست مدیون مهلت عادله یا قرار اقساط بدهد . اصول استنباط"],answer:1,why:"ماده ۳۱۲ ق.ت: دادگاه نمی‌تواند بدون موافقت دارنده برات، به مدیون برای پرداخت وجه برات مهلت یا اقساطی بدهد.",topic:"برات"}]},{id:"pack-vokalat-1388-osool",title:"دفترچهٔ واقعی ۱۳۸۸ — اصول استنباط",exam:"آزمون وکالت",examSlug:"vokalat",branch:"اصول فقه",description:"سوالات ۶۱ تا ۸۰ درس اصول استنباط حقوق اسلامی دفترچهٔ رسمی آزمون وکالت ۱۳۸۸: مخصص و تخصیص، حکم واقعی اولی و ثانوی، اصالة عدم و الصحه، مفهوم غایت و علم اجمالی — با کلید رسمی و تحلیل اصولی.",minutes:30,passMark:60,kind:"mcq",questions:[{q:"برابر ماده ۲۷۷ قانون مدنی :'' متعهد نمی تواند متعهدله را مجبور به قبول قسمتی از موضوع تعهد نماید ولی حاکم می تواند نظر به وضعیت مدیون مهلت عادله یا قرار اقساط بدهد'' ، عبارت '' ولی حاکم می تواند …'' چه عنوانی دارد؟",options:["مخصص منفصل لفظی","مخصص متصل استثنایی","مخصص منفصل شرطی","مخصص متصل شرطی"],answer:1,why:"ماده ۲۷۷ ق.م امتناع از اجبار به قبول جزء موضوع تعهد را مقرر می‌دارد و ذیل آن استثنا (اقدار) آورده است؛ این حکم از لحظه وضع متصل به قاعده و استثنایی است، پس مخصص متصل استثنایی است.",topic:"اصول"},{q:"ماده ۱۲۵۷ قانون مدنی که می گوید :'' هر کس مدعی حقی باشدباید آن را اثبات کند…'' ریشه در چه اصلی دارد؟",options:["استصحاب","اشتغال","صحت","عدم"],answer:3,why:"ماده ۱۲۵۷ ق.م مبتنی بر قاعده اماره «البینه علی المدعی» است و ریشه در اصالة عدم دارد؛ حق جدید تا با دلیل اثبات نشود، موجود فرض نمی‌شود.",topic:"اصول"},{q:"ماده ۳۷۷ قانون مدنی مقرر داشته :'' هر یک از بایع و مشتری حق دارد از تسلیم مبیع یا ثمن خودداری کند تا طرف دیگر حاضر به تسلیم شود…'' تسلیم هر یک از عوضین چه نوع واجبی است؟",options:["واجب مضیق","واجب مشروط","واجب عینی تعبدی","واجب عینی توصلی"],answer:1,why:"ماده ۳۷۷ ق.م: هر یک از بایع و مشتری حق حبس دارد؛ تعهد به تسلیم مبیع واجب است ولی مشروط به تسلیم ثمن (یا بالعکس) می‌باشد؛ لذا واجب مشروط است.",topic:"اصول"},{q:"هرگاه شخصی زوجه و پدری فقیر دارد که باید مخارج هر دو را مطابق مادتین ۱۱۰۶ و ۱۲۰۰ قانون مدنی بپردازد ولی تنها مخارج یک نفرشان را می تواند تامین کند . طبق ماده ۱۲۰۳ آن قانون پرداخت نفقه زوجه بر نفقه پدر مقدم است. این وضعیت مصداق چیست؟",options:["تعارض واقعی","تعارض ظاهری","تزاحم","تخصیص"],answer:2,why:"با نبودن توان کافی برای پرداخت هر دو نفقه، دو حکم واقعی با هم قابل جمع نیستند؛ این وضعیت تزاحم است و معیار ترجیح (اهم و مهم) جاری می‌شود.",topic:"اصول"},{q:"بند ۳ ماده۳۶۲ قانون مدنی می گوید:'' عقد بیع بایع را به تسلیم مبیع ملزم می نماید'' این الزام مصداق چه نوع واجبی است؟",options:["اصلی","تبعی","تخییری","تعبدی"],answer:0,why:"الزام بایع به تسلیم مبیع نتیجه ضمنی خود عقد بیع است؛ حکمی اصلی و اولی است که عیناً در ماده ۳۶۲ بند ۳ ق.م آمده است.",topic:"اصول"},{q:"ماده ۸۷۴ قانون مدنی گوید: '' اگر اشخاصی که بین آنها توارث باشد بمیرند و تاریخ فوت یکی از آنها معلوم و دیگری از حیث تقدم و تاخر مجهول باشد فقط آنکه فوتش مجهول است از آن دیگری ارث می برد '' حکم این ماده مبتنی بر چیست؟",options:["قاعده یقین با شک ساری","اصل استصحاب","اصل عدم قرینه","اصل تاخر حادث"],answer:3,why:"ماده ۸۷۴ ق.م در فرض فوت متواری با تاریخ فوت مجهول، مبنا «اصل تأخر حادث» است؛ هر دو حادث محسوب می‌شوند و تعیین مقدم و مؤخر ممکن نیست مگر با قرائن.",topic:"اصول"},{q:"ماده ۶۷ قانون مدنی گوید: '' مالی که قبض و اقباض آن ممکن نیست وقف آن باطل است'' از این ماده نتیجه می گیریم که قبض در عقد وقف :",options:["مقدمه صحت است.","مقدمه علم است.","مقدمه نفوذ است.","مقدمه وجود است."],answer:0,why:"ماده ۶۷ ق.م قبض را برای صحت وقف شرط می‌داند؛ پس قبض مقدمه‌ای است که بدون آن اثر شرعی (صحت وقف) حاصل نمی‌شود؛ یعنی مقدمه صحت.",topic:"اصول"},{q:"برابر مادتین ۶۰۷ و ۶۲ قانون مجازات اسلامی مقاومت در برابر مامورین دولت حین انجام وظیفه جرم ولی مقاومت درمقابل تعرضات آنان جایز است . هر یک از این دو قسمت به ترتیب مصداق کدام گزینه است؟",options:["حکم واقعی ثانوی – حکم واقعی اولی","حکم ظاهری – حکم واقعی","حکم واقعی- حکم ظاهری","حکم واقعی اولی – حکم واقعی ثانوی"],answer:3,why:"ماده ۶۰۷ ق.م.ا (تعزیرات) مقاومت در برابر مأمورین حین انجام وظیفه را منع کرده که حکم واقعی اولی است؛ ماده ۶۲ ناظر به مقاومت خارج از حدود وظیفه است که حکم واقعی ثانوی (با احراز خصوصیت قریب) است.",topic:"اصول"},{q:"اصل سیزدهم قانون اساسی که می گوید : '' ایرانیان زرتشتی ، کلیمی و مسیحی تنها اقلیت های دینی شناخته می شوند …'' بیانگر چه نوع مفهومی است؟",options:["غایت","وصف","شرط","حصر"],answer:3,why:"اصل سیزدهم ق.ا با واژه «تنها» حصر کرده است؛ در مورد امور حصری، صدور حکم در غیر مصادیق منصوص، جایز نیست (حکم حصری).",topic:"اصول"},{q:"عبارت '' غیر مسلم '' برای وصی در ماده ۱۱۹۲ قانون مدنی که می گوید: '' ولی مسلم نمی تواند برای امور مولی علیه خود وصی غیر مسلم معین کند '' مصداق کدام اصطلاح است ؟",options:["مقید","مخصص","خاص","ناسخ"],answer:0,why:"در ماده ۱۱۹۲ ق.م واژه «مسلم» قید وجودی/ذاتی است که به موضوع حکم (ولی) می‌چسبد؛ از سنخ قیود مقید است نه استثنایی.",topic:"اصول"},{q:"ماده ۸۷۶ قانون مدنی گوید: '' با شک در حیات حین ولادت حکم وراثت نمی شود '' مبنای حکم این ماده چیست ؟",options:["اصل عدم","اصل برائت","اصل استصحاب","اصل احتیاط"],answer:0,why:"ماده ۸۷۶ ق.م: با شک در حیاتِ حین ولادت، حکم به وراثت نمی‌شود؛ مبنای این حکم اصالة عدم است (شک در تحقق حیات سبب عدم احکام مترتب بر آن می‌شود).",topic:"اصول"},{q:"ماده ۲۴ قانون مدنی گوید: '' هیچ کس نمی تواند طرق و شوارع عامه و کوچه ها یی را که آخر آنها مسدود نیست تملک نماید'' ازاین ماده دو مطلب فهمیده می شود اول قابل تملک نبودن کوچه غیر مسدود ، دوم قابل تملک بودن کوچه مسدود . هر یک از این دو حکم به ترتیب مصداق کدام اصطلاح است؟",options:["مفهوم موافق و مفهوم مخالف","منطوق و مفهوم مخالف","مفهوم موافق و منطوق","منطوق و مفهوم موافق"],answer:1,why:"ماده ۲۴ ق.م از یک‌سو ابطال تملک طرق عامه را اعلام می‌کند (منطوق) و از سوی دیگر مفهوم مخالفش این است که در کوچه‌های مسدوده تملک ممکن است؛ پس هم منطوق و هم مفهوم مخالف دارد.",topic:"اصول"},{q:"ماده ۱۸ قانون تخلفات اداری که می گوید :'' کلیه وزارتخانه ها ،سازمان ها و موسسات ، شرکت های دولتی و … مشمول این قانون هستند'' واجد چه نوع عامی است ؟",options:["بدلی","مجموعی","استغراقی","موارد ۲ و۳"],answer:2,why:"ماده ۱۸ ق.تخلفات اداری با واژه «کلیه وزارتخانه‌ها و سازمان‌ها» تمامی مصادیق را می‌گیرد؛ عام استغراقی است (شامل موسسات وابسته نیز می‌شود).",topic:"اصول"},{q:"ماده ۹۶۱ قانون مدنی که بعضی از مواردی را که اتباع خارجه از حقوق مدنی متمتع نیستند بیان نموده ، نسبت به ماده ۹۵۸ آن قانون که می گوید: '' هر انسان متمتع از حقوق مدنی خواهد بود…'' مصداق کدام گزینه است؟",options:["ناسخ","مقید","مخصص منفصل","مخصص متصل"],answer:2,why:"ماده ۹۶۱ ق.م استثنائات اصل تساوی حقوق (ماده ۹۶۰) را برمی‌شمارد و خود نیز مستثنیاتی دارد (تبصره‌ها)؛ لذا مخصص منفصل است.",topic:"اصول"},{q:"کدام اصل در علم اجمالی جاری است ؟",options:["احتیاط","استصحاب","برائت","عدم"],answer:0,why:"در علم اجمالی به حرمت یا اباحه، عمومات و اصول عملیه کارایی ندارند و مقتضی، اصالة الاحتیاط است؛ لذا احتیاط جاری می‌شود.",topic:"اصول"},{q:"ماده ۸۳۳ قانون مدنی که گوید: '' ورثه موصی نمی تواند در موصی به تصرف کند مادام که موصی له رد یا قبول خود را به آنها اعلام نکرده است '' دارای چه نوع مفهومی است؟",options:["مفهوم حصر","مفهوم شرط","مفهوم غایت","مفهوم وصف"],answer:2,why:"ماده ۸۳۳ ق.م: «ورثه نمی‌توانند تصرف کنند مادام که موصی‌له رد یا قبول نکرده»؛ مفهوم غایت این است که پس از رد یا قبول، ورثه حق تصرف دارند.",topic:"اصول"},{q:"حکم ماده ۳۳۱ قانون آیین دادرسی مدنی که مصادیق آرای قابل تجدید نظرخواهی را مشخص کرده است ، چه حکمی است ؟",options:["تخصیص اکثر است.","مخصص منفصل عقلی است .","مخصص منفصل لفظی است .","مخصص متصل صفتی است ."],answer:0,why:"ماده ۳۶۷ ق.آ.د.م همه آرای حضوری را قابل تجدیدنظر می‌داند و ماده ۳۳۱ به صورت جزئی، آرای قابل تجدیدنظر را مشخص کرده؛ لذا تخصیص اکثر است.",topic:"اصول"},{q:"اصاله الصحه در ابواب معاملات به این معنی است که :",options:["اگر معامله ای عرفا واقع شود و تردید باشد که آیا دارای تمام شروط صحت بوده یا نه ، باید قائل به صحت شد.","اگر در شرطیت امری در صحت یکی از عقود و ایقاعات تردید شود، باید آن شرط رعایت نشود.","معاملات اعم از عقود و ایقاعات بر طبق اصاله الصحه باید دارای تمام شرایط و فاقد همه موانع صحت باشد .","معاملات اصولا صحیح انجام شود ودر صورت تردید در صحت آن ، اصل صحت رعایت نشده است."],answer:0,why:"اصالة الصحه در معاملات یعنی: هر معامله‌ای که عرفاً واقع شود و تردید باشد که آیا دارای تمام شرایط صحت بوده یا نه، اصل صحت جاری است (جز در مواردی که خلافش معلوم شود).",topic:"اصول"},{q:"شرط در '' اصطلاح علم اصول '' عبارت است از :",options:["مقدمه ای که عدم آن مستلزم عدم ذی المقدمه گردیده ولی وجودش ملازم وجود ذی المقدمه نیست .","جمله ای مرکب از دو جمله و ادات شرط","مقدمه ای که وجودش موجب پیدایش ذی المقدمه می گردد.","تعهدات تبعی که در ضمن عقد قرارداد درج می گردد."],answer:0,why:"در اصطلاح اصول، شرط یعنی مقدمه‌ای که عدم آن مستلزم عدم ذی‌المقدمه (اثر) است ولی وجودش ملازم وجود ذی‌المقدمه نیست؛ ملازمه بین مقدمه و ذی‌مقدمه در عدم است.",topic:"اصول"},{q:"ماده ۱۱۹۸ قانون مدنی گوید: '' کسی ملزم به انفاق است که متمکن از دادن نفقه باشد …'' تمکن منفق نسبت به وجوب انفاق مصداق چه مقدمه ای است؟",options:["مقدمه صحت","مقدمه وجوب","مقدمه وجود","مقدمه علم حقوق جزا"],answer:1,why:"ماده ۱۱۹۸ ق.م تمکن را شرط وجوب نفقه قرار داده؛ تمکن مقدمه‌ای است که بدون آن وجوب انفاق بر متمولیت خاص محقق نمی‌شود؛ پس مقدمه وجوب است.",topic:"اصول"}]},{id:"pack-vokalat-1388-jaza",title:"دفترچهٔ واقعی ۱۳۸۸ — حقوق جزا",exam:"آزمون وکالت",examSlug:"vokalat",branch:"حقوق جزا",description:"سوالات ۸۱ تا ۱۰۰ درس جزای عمومی و اختصاصی دفترچهٔ رسمی آزمون وکالت ۱۳۸۸: شبه‌عمد، معاذیر تخفیف، تعلیق، اختلاس، معامله معارض، ربا، سرقت مشدد و تخلیه اطلاعاتی — با کلید رسمی و تشریح مواد ق.م.ا.",minutes:30,passMark:60,kind:"mcq",questions:[{q:"انجام کدام یک از اقدامات توسط مرتکب فاقد وصف مجرمانه است ؟",options:["تحصیل نمودن مال مسروقه","حمل نمودن مال مسروقه","قبول نمودن مال مسروقه","مخفی نمودن مال مسروقه"],answer:1,why:"حمل مال مسروقه پس از وقوع سرقت (بدون سابقه تواطئ در خود سرقت) فاقد وصف مجرمانه است؛ سلب مالکیت در لحظه سرقت کامل شده و حمل بعدی مباشرت در سلب مالکیت نیست.",topic:"جرایم علیه اموال"},{q:"در کدام مورد معاذیر قانونی خاص تخفیف دهنده مجازات ها است ؟",options:["سرقت از مال مشترک","اخفاء متهم از سوی والدین","ضرورت","جعل سندی که وجود واقعی داشته و دارنده آن نسخه دیگری از آن جعل کرده است."],answer:1,why:"ماده ۶۶ ق.م.ا ۱۳۹۲: مخفی کردن متهم توسط والدین یا جد پدری، از معاذیر قانونی خاص تخفیف‌دهنده است (برخلاف معاذیر عام).",topic:"معاذیر کیفری"},{q:"کدام گزینه صحیح است؟",options:["عدم اعلام سرقت یا فقدان پلاک وسیله نقلیه موتوری جرم است.","عدم اعلام سرقت وسیله موتوری جرم است","عدم اعلام سرقت وسیله موتوری فقط از جانب مالک جرم است","موارد ۱و ۲ صحیح است"],answer:3,why:"ماده ۷۰۸ ق.م.ا (تعزیرات): عدم اعلام سرقت وسیله نقلیه موتوری یا فقدان پلاک آن توسط هر ذی‌نفعی (مالک یا متصرف) جرم است؛ لذا هر دو فرض گزینه‌های ۱ و ۲ صحیح است.",topic:"جرایم تعزیری"},{q:"عدم ثبت کدام یک از وقایع زیر به موجب قانون مجازات اسلامی جرم نیست ؟",options:["نکاح دائم و منقطع","نکاح دائم","نکاح منقطع و فسخ نکاح","طلاق و رجوع و نکاح دائم"],answer:2,why:"مواد ۱۰۸۷ و ۱۰۸۸ ق.م.ا عدم ثبت نکاح دائم و طلاق را جرم می‌داند؛ عدم ثبت نکاح منقطع و فسخ نکاح جرم نیست.",topic:"جرایم علیه خانواده"},{q:"در صورتی که شخصی یک مال غیر منقول را در دو مرحله با سند رسمی به دو شخص مختلف منتقل کند عمل او دارای کدام عنوان جزائی است؟",options:["خیانت در امانت","فروش مال غیر","معامله معارض","کلاهبرداری"],answer:2,why:"ماده ۱۱۷ ق.ثبت: انتقال یا معامله معارض نسبت به مال غیرمنقولی که قبلاً با سند رسمی منتقل شده، جرم است و مرتکب به حبس و جزای نقدی محکوم می‌شود.",topic:"جرایم ثبتی"},{q:"کدام یک از انواع ورشکستگی جنبه ی جزائی دارد؟",options:["منحصرا ورشکستگی به تقصیر","ورشکستگی به تقلب و به تقصیر","ورشکستگی عادی و به تقلب و به تقصیر","منحصراً ورشکستگی به تقلب"],answer:1,why:"ورشکستگی به تقلب (مواد ۶۶۷ تا ۶۷۰) و به تقصیر (ماده ۶۷۱) ق.ت مصادیق مجازات کیفری دارند؛ ورشکستگی به سبب تزلزل (عادی) جنبه مدنی دارد.",topic:"جرایم اقتصادی"},{q:"دادگاه برای چه کسانی می تواند مجازات تتمیمی تعیین کند؟",options:["محکومین به حد","محکومین به مجازات تعزیری","محکومین به مجازات تعزیری یا بازدارنده","محکومین به همه مجازات ها"],answer:2,why:"ماده ۶۲ ق.م.ا ۱۳۷۵: دادگاه می‌تواند برای محکومین به مجازات تعزیری یا بازدارنده، مجازات تتمیمی (علی‌الاصول حبس) تعیین کند؛ در حدود اجرا نمی‌شود.",topic:"مجازات‌ها"},{q:"کدام یک از سرقت های ذیل سرقت مشدد محسوب نمی شود؟",options:["سرقت در راه ها و شرارع","سرقت در مناطق طوفان زده","سرقت در شب","سرقت در محل تصادف رانندگی"],answer:1,why:"مواد ۶۴۹ تا ۶۶۴ ق.م.ا سرقت مشدد را احصا کرده‌اند؛ بر اساس کلید رسمی، سرقت در مناطق طوفان‌زده در شمار سرقت مشدد پیش‌بینی نشده است.",topic:"سرقت"},{q:"مهمترین تفاوت اختلاس و تصرف غیر قانونی در اموال دولتی در چیست ؟",options:["در نوع سپرده شدن اموال دولتی","منقول بودن یا نبودن اموال","در نوع اموال متعلق به سازمان ها","در وجود قصد تملک در اختلاس و عدم آن در تصرف غیر قانونی"],answer:3,why:"اختلاس (ماده ۱۴۱) تصرف با قصد تملک است؛ در تصرف غیرقانونی (استفاده غیرمجاز از اموال دولتی) قصد تملک وجود ندارد.",topic:"جرایم کارکنان دولت"},{q:"اگر الف با اسلحه پر و با تصور خالی بودن آن به طرف ب تیراندازی کند و او را به قتل رساند:",options:["قتل عمد است","قتل در حکم شبه عمد است","قتل در حکم عمد است","قتل شبه عمد است"],answer:1,why:"ماده ۲۹۶ ق.م.ا: اگر مرتکب اطلاع نداشته که سلاح پر است و قصد قتل نداشته، جنایت در حکم شبه‌عمد است و دیه به عهده اوست.",topic:"قصاص و دیه"},{q:"کدام عبارت صحیح نیست؟",options:["هرگاه بالغ نابالغ را بکشد قصاص نمی شود","قتل در حال مستی مستوجب قصاص است","اکراه در قتل مجوز قتل نیست","قتل عمدی توسط دیوانه موجب ضمان عاقله است"],answer:0,why:"عبارت نادرست همین است؛ هرگاه بالغ نابالغ را عمداً بکشد، قصاص می‌شود (ماده ۳۰۱ ق.م.ا؛ قتل عمدی نفس واجب‌القصاص است صرف‌نظر از سن مقتول).",topic:"قصاص"},{q:"عنوان قانونی اتهام مامور دولت که به واسطه بی مبالاتی ، اطلاعاتی را در اختیار دشمن قرار دهد، در حالی که او به آموزش لازم داده شده است عبارت است از :",options:["جاسوسی","تخلیه اطلاعاتی","خیانت به کشور","قرار دادن اطلاعات در اختیار دشمن"],answer:1,why:"ماده ۵۰۵ ق.م.ا: مأمور دولتی که به‌واسطه بی‌مبالاتی اطلاعاتی را در اختیار دشمن قرار دهد، به تخلیه اطلاعاتی محکوم می‌شود (نه جاسوسی که مستلزم عمد و تواطئ است).",topic:"جرایم امنیتی"},{q:"در کدام یک از جرایم زیر بدون شکایت شاکی تعقیب کیفری آغاز نمی شود؟",options:["ربودن غیر مشمول عنوان سرقت","سرقت آب و برق و گاز و تلفن","دخالت در اموال مسروقه","سرقت اموال تاریخی و فرهنگی"],answer:3,why:"بر اساس قانون آیین دادرسی کیفری ۱۳۷۸ (ماده ۱۰ و تبصره‌های آن) سرقت اموال تاریخی و فرهنگی جزو جرایم قابل گذشت بود و بدون شکایت شاکی تعقیب آغاز نمی‌شود.",topic:"قابل گذشت"},{q:"در قطع لاله گوش در جنایت که موجب زوال شنوایی شود:",options:["فقط دیه زوال شنوایی پرداخت می شود.","فقط دیه لاله گوش پرداخت می شود.","دو دیه کامل پرداخت می شود .","دو جنایت محسوب شده و برای هر جنایت دیه آن جنایت پرداخت می شود."],answer:3,why:"ماده ۴۷۰ ق.م.ا: قطع لاله گوش (عضو مستقل منفعت) در عین ایجاد زوال شنوایی (منفعت دیگر) دو جنایت محسوب می‌شود و دیه هر دو باید پرداخت شود.",topic:"قصاص و دیه"},{q:"کدام یک از جرایم زیر قابل تعلیق است؟",options:["در معرض فروش قراردادن مشروبات الکلی","معاونت در محاربه","صدور چک از حساب مسدود","ختلاس در صورتی مرتکب ، قبل از حکم مال را مسترد کند"],answer:3,why:"مواد ۲۵ تا ۳۱ ق.م.ا: تعلیق مجازات مستلزم عدم سابقه و جبران ضرر است؛ اختلاس در صورتی که مرتکب قبل از صدور حکم مال را مسترد کند قابل تعلیق است؛ محاربه و برخی جرایم خاص قابل تعلیق نیستند.",topic:"تعلیق مجازات"},{q:"دریافت ربا در چه صورتی قابل مجازات نیست؟",options:["مسلمان از مسلمان","مسلمان از کافر","کافر از مسلمان","کافراز کافر"],answer:1,why:"ماده ۵ ق.م.ا (مبحث ربا): ربای گرفتن مسلمان از کافر مشمول مجازات ربا نیست (قاعده فقهی جواز ربا از ذمی برای مسلمان).",topic:"ربا"},{q:"کدام یک از اعمال زیر فاقد وصف جزایی است؟",options:["قاچاق انسان","صدور چک وعده دار","قماربازی","تکدی گری"],answer:1,why:"ماده ۱۰ ق.چک: چک باید به‌عنوان وسیله پرداخت، نه تضمین انجام معامله استفاده شود؛ چک وعده‌دار فاقد وصف جزایی است.",topic:"چک"},{q:"کدام یک از موارد زیر از نظر قانون گذار ، در مبحث سرقت ، سلاح محسوب نمی شود:",options:["اسید","نارنجک","پنجه بوکس","تفنگ ساچمه زنی"],answer:0,why:"ماده ۶۵۷ ق.م.ا: سلاح شامل هرگونه وسیله‌ای است که بر قامت انسان نیزه/کارد/چاقو/هر نوع اسلحه گرم و سرد و آلت جراحت و ابزار سنگین (از جمله چوب چماق) یا هر وسیله دیگری باشد که بر اثر استعمال آن مقداری از مزاج آدمی مسموم یا منحل یا محترق یا مسوز شود... اسید نیز از مصادیق است اما بر اساس کلید رسمی در گزینه‌ها وسیله مذکور سلاح تلقی نشده است.",topic:"سرقت"},{q:"هر یک از مسوولین و مستخدمین دولتی که زیاده بر مقدار مقرر قانونی مال یا وجهی را به نفع دولت اخذ کند:",options:["علاوه بر اینکه باید وجوه اضافی مسترد شود مرتکب یا آمر مستوجب مجازات نیز می باشد","ملزم به استرداد وجوه اضافی به صاحب آن از مال خود است","ملزم به استرداد وجه به صاحب آن و معادل آن به دولت به عنوان جریمه است","دولت ملزم به استرداد وجوه اضافی است"],answer:0,why:"ماده ۱۵۴ ق.م.ا: هر مأمور دولتی که علاوه بر حقوق مقرر، مازادی به نفع دولت اخذ کند، علاوه بر استرداد، به حبس و جزای نقدی محکوم می‌شود.",topic:"جرایم کارکنان دولت"},{q:"چنانچه مجازات جرمی به موجب قانون لاحق تخفیف پیدا کند و کسی در زمان اعتبار قانون سابق محکوم شده باشد:",options:["فقط رئیس قوه قضاییه می تواند تقاضای تخفیف کند","دادگاه راساً تخفیف را اعمال خواهد کرد","محکوم علیه باید درخواست اعاده دادرسی کند","دادستان تقاضای تخفیف می کند و دادگاه مکلف به قبول تقاضاست آئین دادرسی کیفری"],answer:2,why:"ماده ۱۲ ق.م.ا: چنانچه مجازات جرمی به موجب قانون لاحق تخفیف یافته باشد و محکوم هنوز محکومیت را تحمل نکرده، باید از طریق اعاده دادرسی از دادگاه صادرکننده حکم تقاضای اعمال قانون جدید کند.",topic:"قوانین کیفری"}]},{id:"pack-vokalat-1388-keyfri",title:"دفترچهٔ واقعی ۱۳۸۸ — آیین دادرسی کیفری",exam:"آزمون وکالت",examSlug:"vokalat",branch:"آیین دادرسی کیفری",description:"سوالات درس آیین دادرسی کیفری دفترچهٔ رسمی آزمون وکالت ۱۳۸۸ (سوال ۱۱۲ که رسماً حذف شد، لحاظ نگردیده): قرارهای تأمین، صلاحیت دادگاه‌ها، هیئت منصفه، مرور زمان و تعقیب — با کلید رسمی و تشریح.",minutes:28,passMark:60,kind:"mcq",questions:[{q:"قرار عدم خروج متهم از کشور …",options:["ظرف مدت ۱۰ روز قابل اعتراض در دادگاه تجدید نظر استان است.","ظرف مدت ۲۰ روز قابل اعتراض دردادگاه صادر کننده قرار است.","قابل اعتراض نیست.","ظرف ۲۰ روز قابل اعتراض در دادگاه تجدید نظر استان است."],answer:3,why:"ماده ۱۳۵ ق.آ.د.ک ۱۳۷۸: قرار عدم خروج متهم از کشور ظرف بیست روز قابل اعتراض در دادگاه تجدیدنظر استان است.",topic:"قرارهای تأمین"},{q:"حضور هیات منصفه در جرایم مطبوعاتی…",options:["در تحقیقات مقدماتی و صدور قرارهای قانونی لازم است.","در تحقیقات مقدماتی لازم نیست ولی در صدور قرارهای قانونی لازم است","در تحقیقات مقدماتی و صدور قرارهای قانونی لازم نیست","در تحقیقات مقدماتی لازم است ولی در صدور قرارهای قانونی لازم نیست."],answer:2,why:"ماده ۸۶ ق.آ.د.ک ۱۳۷۸: حضور هیئت منصفه فقط در مرحله دادرسی جرایم مطبوعاتی لازم است؛ در تحقیقات مقدماتی و صدور قرارها حضورشان لازم نیست.",topic:"هیئت منصفه"},{q:"در مراکز استان چه کسی بر دادسرا نظارت و ریاست اداری دارد؟",options:["دادستان","دادستان کل کشور","رییس دادگستری شهرستان مرکز استان","رئیس کل دادگستری استان"],answer:3,why:"ماده ۲۳ ق.آ.د.ک ۱۳۷۸: در مراکز استان، رئیس کل دادگستری استان بر دادسراها نظارت و ریاست اداری دارد.",topic:"سازمان دادسرا"},{q:"درخواست صدور قرار ترک محاکمه از سوی چه کسی مقدور است؟",options:["از سوی دادستان","از سوی وکیل متهم","از سوی مدعی","از سوی متهم"],answer:2,why:"ماده ۱۷۹ ق.آ.د.ک ۱۳۷۸: صدور قرار ترک محاکمه به درخواست مدعی عمومی (دادستان) و با موافقت مقام قضایی مقدور است.",topic:"قرارهای تأمین"},{q:"قرار بازداشت موقت صادر شده از سوی بازپرس چه زمانی معتبر خواهد بود؟ زمانی که :",options:["به تایید دادستان محل برسد.","به تایید دادگاه عمومی برسد.","به تایید دادگاه کیفری استان برسد.","نیازی به تایید نمی باشد."],answer:0,why:"ماده ۱۴۶ ق.آ.د.ک ۱۳۷۸: قرار بازداشت موقت بازپرس باید ظرف ۲۴ ساعت به تأیید دادستان برسد؛ در غیر این صورت از خود باطل است.",topic:"قرارهای تأمین"},{q:"هرگاه فردی متهم به ارتکاب جرم زنای محصنه و آدم ربایی باشد به اتهامات وی در چه دادگاهی رسیدگی می شود و مرجع تجدیدنظر از آراء صادره کدام است؟",options:["به اتهام زنای محصنه در دادگاه کیفری استان و آدم ربایی در دادگاه عمومی – دیوان عالی کشور ودادگاه تجدید نظر استان","به اتهام زنای محصنه در دادگاه کیفری استان و آدم ربایی در دادگاه عمومی – دیوان عالی کشور","به هر دو اتهام در دادگاه کیفری استان – دیوان عالی کشور","به هردو اتهام دردادگاه کیفری استان – دیوان عالی کشور و دادگاه تجدید نظر استان"],answer:2,why:"ماده ۵ ق.آ.د.ک ۱۳۷۸: رسیدگی به هر دو اتهام در دادگاه کیفری استان است و تجدیدنظرخواهی در دیوان عالی کشور انجام می‌شود.",topic:"صلاحیت"},{q:"ضرر وزیان قابل مطالبه توسط مدعی خصوصی در قانون آیین دادرسی کیفری عبارت است از ک",options:["ضرر و زیان مادی و عدم النفع","ضرر و زیان مادی و معنوی","ضرر و زیان مادی و منافع ممکن الحصول","ضرر و زیان مادی ، عدم النفع و منافع ممکن الحصول"],answer:2,why:"ماده ۱۴ ق.آ.د.ک ۱۳۷۸: خسارت مادی و منافع ممکن‌الحصول مشمول مطالبه مدعی خصوصی است؛ خسارت معنوی پس از تصویب ماده ۱ (اصلاحی) به مبلغ حبس... ولی کلید رسمی خسارت مادی و منافع ممکن‌الحصول را ملاک قرار داده است.",topic:"دعوای کیفری"},{q:"رسیدگی به دعاوی مربوط به اصل ۴۹ قانون اساسی در صلاحیت کدام دادگاه است؟",options:["انقلاب","نظامی","عمومی","کیفری استان"],answer:0,why:"بر اساس ماده ۵ ق.آ.د.ک ۱۳۷۸ و ق.نحوه اجرای اصل ۴۹، رسیدگی به دعاوی مربوط به اصل ۴۹ ق.ا در صلاحیت دادگاه انقلاب است.",topic:"صلاحیت"},{q:"چنانچه وکیل تسخیری متهم که از طرف دادگاه تعیین شده برادرزاده متهم باشد…..:",options:["متهم حق درخواست تغییر او را ندارد","متهم حق درخواست تغییر او را دارد و در صورت موافقت ، دادگاه وکیل تسخیری دیگری تعیین خواهد کرد.","با موافقت وکیل تسخیری دادگاه وکیل دیگری برای متهم انتخاب خواهد کرد.","متهم حق در خواست تغییر او را دارد و در این صورت دادگاه مکلف است تقاضای او را بپذیرد و وکیل دیگری تعیین نماید."],answer:3,why:"ماده ۴۸ ق.آ.د.ک ۱۳۷۸: متهم می‌تواند درخواست تغییر وکیل تسخیری خویشاوند خود را داشته باشد و در این صورت دادگاه مکلف است تقاضای او را بپذیرد و وکیل دیگری تعیین کند.",topic:"وکالت کیفری"},{q:"کدام یک از موارد ذیل از موارد موقوفی تعقیب نیست ؟",options:["فوت متهم","گذشت شاکی یا مدعی خصوصی در جرایم غیرقابل گذشت","نسخ مجازات قانونی","مرور زمان در مجازاتهای بازدارنده"],answer:1,why:"ماده ۱۲ ق.آ.د.ک: گذشت شاکی مسبب موقوفی تعقیب است؛ اما گذشت در جرایم غیرقابل گذشت اثری ندارد و از موارد موقوفی تعقیب نیست.",topic:"موقوفی تعقیب"},{q:"قرار منع پیگرد صادر شده از جانب بازپرس ، مورد مخالفت دادستان قرار می گیرد ، مرجع حل اختلاف کدام است؟",options:["دیوان عالی کشور","دادگاه عمومی حقوقی","دادگاه عمومی جزائی","دادگاه تجدیدنظر استان"],answer:2,why:"ماده ۲۰ ق.آ.د.ک ۱۳۷۸: در صورت مخالفت دادستان با قرار منع پیگرد بازپرس، حل اختلاف با دادگاه عمومی جزایی است.",topic:"قرارهای مقدماتی"},{q:"فردی که متهم به ارتکاب قتل عمدی و سرقت تعزیری است :",options:["به هر دو اتهام دردادگاه عمومی رسیدگی می شود.","به هر دو اتهام وی در دادگاه کیفری استان رسیدگی می شود.","ابتداً به سرقت در دادگاه عمومی و به قتل در دادگاه کیفری استان رسیدگی می شود.","بدواً به قتل در دادگاه کیفری استان و سپس به سرقت در دادگاه عمومی رسیدگی می شود."],answer:1,why:"ماده ۵ و تبصره آن: در تعدد جرایم، اگر یکی از جرایم در صلاحیت دادگاه کیفری استان باشد، رسیدگی به همه اتهامات در همان دادگاه کیفری استان انجام می‌شود.",topic:"صلاحیت"},{q:"رسیدگی به جرایم اسید پاشی در صلاحیت کدام دادگاه است؟",options:["عمومی محل","کیفری استان","انقلاب","نظامی"],answer:1,why:"ماده ۶۶۴ ق.م.ا و ماده ۵ ق.آ.د.ک: اسیدپاشی از جرایمی است که رسیدگی به آن در صلاحیت دادگاه کیفری استان است.",topic:"صلاحیت"},{q:"اگر بیشتر متهمین در حوزه قضائی دادگاه کیفری دیگری مقیم باشند، چه قراری از دادگاه صالح به رسیدگی ممکن است صادر شود؟",options:["قرار احاله دادرسی","قرار اناطه","قرار عدم صلاحیت","قرار امتناع از رسیدگی"],answer:0,why:"ماده ۳۰ ق.آ.د.ک ۱۳۷۸: چنانچه متهمین مقیم حوزه قضایی دادگاه دیگری باشند، دادگاه می‌تواند با صدور قرار احاله، رسیدگی را به دادگاه محل اقامت اکثر متهمین ارجاع دهد.",topic:"صلاحیت"},{q:"رسیدگی به اتهام غیبت از خدمت وظیفه عمومی در صلاحیت کدام دادگاه است ؟",options:["انقلاب","نظامی ۲","نظامی ۱","عمومی جزایی"],answer:3,why:"غیبت از خدمت وظیفه عمومی برای مشمولین غیر نظامی جرمی عمومی است و رسیدگی به آن با دادگاه عمومی جزایی است (نه دادگاه نظامی).",topic:"صلاحیت"},{q:"در کدام یک از موارد زیر حکم نقض بلا ارجاع می شود؟",options:["اشتباه قاضی در تعیین مجازات","نقص تحقیقات","مرور زمان","عدم رعایت صلاحیت از سوی دادگاه صادر کننده رای"],answer:2,why:"ماده ۲۹ ق.آ.د.ک ۱۳۷۸: در فرض مرور زمان، دادگاه حکم به نقض دادنامه بلاارجاع می‌دهد (و رسیدگی مجدد انجام نمی‌شود).",topic:"مرور زمان"},{q:"مبدا مرور زمان کیفری در جرائم مشمول مرور زمان چه تاریخی است؟",options:["تاریخ صدور کیفرخواست","حسب مورد تاریخ وقوع جرم یا اولین اقدام تعقیبی","از تاریخ آخرین اقدام تعقیبی","تاریخ اعلام شکایت"],answer:1,why:"ماده ۲۸ ق.آ.د.ک: مبدأ مرور زمان، حسب مورد تاریخ وقوع جرم یا تاریخ اولین اقدام تعقیبی است (هر کدام زودتر واقع شده باشد).",topic:"مرور زمان"},{q:"در صورتی که بازپرس قرار اناطه کیفری صادر کند این قرار:",options:["از طرف دادستان، شاکی و متهم قابل اعتراض است.","فقط از طرف متهم قابل اعتراض است.","از طرف دادستان و شاکی قابل اعتراض است.","قابل اعتراض نیست."],answer:2,why:"ماده ۱۹ ق.آ.د.ک: قرار اناطه صادره از بازپرس از سوی دادستان و شاکی قابل اعتراض است.",topic:"قرارهای مقدماتی"},{q:"در محاکم کیفری متهم می تواند:",options:["هر چند نفر وکیل که بخواهد داشته باشد.","دو نفر وکیل مدافع داشته باشد.","منحصراً یک وکیل مدافع داشته باشد.","سه نفر وکیل مدافع داشته باشد."],answer:0,why:"ماده ۱۸۶ ق.آ.د.ک ۱۳۷۸: متهم می‌تواند در تمام مراحل دادرسی وکیل داشته باشد و در تعداد وکلای خود مختار است (محدودیت فقط در برخی آیین‌نامه‌های خاص بوده است).",topic:"وکالت کیفری"}]},{id:"pack-vokalat-madani-1399",title:"دفترچهٔ واقعی ۱۳۹۹ — حقوق مدنی",exam:"آزمون وکالت",examSlug:"vokalat",branch:"حقوق مدنی",description:"۲۰ سوال درس حقوق مدنی آزمون وکالت ۱۳۹۹ (اسکودا): بیمه اجباری، پیش‌فروش ساختمان، رد ترکه، تعارض اسناد، حق ارتفاق، طلاق بیماری و حق مولف — کلید بر اساس تحلیل مواد قانونی تنظیم شده است.",minutes:30,passMark:60,kind:"mcq",questions:[{q:"بر اساس قانون بیمه اجباری مسئولیت مدنی دارندگان وسایل نقلیه موتوری زمینی در مقابل شخص ثالث خسارت کدام یک از اشخاص زیر، جبران نخواهد شد؟",options:["دارنده وسیله نقلیه مسبب حادثه که با سپردن خودرو به شخص فاقد گواهینامه، سبب بروز حادثه و تحمل زیان بدنی شده باشد.","دامدار بی احتیاطی که با رها کردن دام ها در جاده عمومی، سبب بروز حادثه به میزان پنجاه درصد شده باشد.","زیان دیده ای که قصد ایراد خسارت به خود را داشته باشد.","سرنشین وسیله نقلیه که خود، مسبب حادثه باشد."],answer:2,why:"ماده ۴ قانون بیمه اجباری ۱۳۹۵: خسارت زیان‌دیدگانی که قصد ایراد خسارت به خود را داشته‌اند جبران نمی‌شود؛ در مقابل، سرنشین وسیله مسبب حادثه نسبت به زیان‌های بدنی ثالث محسوب می‌شود (تبصره ۱ ماده ۲).",topic:"بیمه اجباری"},{q:"شخص «الف» آپارتمانی را از شخص «ب» پیش خرید می کند و با توافق طرفین، خسارت تأخیر در تحویل آپارتمان، روزانه مبلغ ۴ میلیون ریال تعیین می شود. چنانچه موارد مندرج در ماده ۴ قانون پیش فروش ساختمان در قرارداد رسمی پیش فروش تصریح شده باشد، در صورت تأخیر شخص «ب» در تحویل آپارتمان، شخص «الف» مستحق چه میزان خسارت است؟",options:["چهار میلیون ریال، مگر اینکه این مبلغ از اجرت المثل آپارتمان بیشتر باشد.","چهار میلیون ریال، مگر اینکه اجرت المثل آپارتمان بیشتر باشد.","در هر حال، به میزان اجرت المثل آپارتمان","در هر حال، چهار میلیون ریال"],answer:0,why:"تبصره ۱ ماده ۴ قانون پیش‌فروش ساختمان ۱۳۸۹: مبلغ توافقی روزانه معتبر است مگر آنکه از اجرت‌المثل روزانه بنا بیشتر باشد که در این صورت ملاک همان اجرت‌المثل است.",topic:"پیش‌فروش ساختمان"},{q:"کدام مورد در خصوص مسئولیت مدنی دولت صحیح است؟",options:["در اعمال حاکمیتی، دولت همیشه معاف از پرداخت خسارت است.","تمام مؤسسات و نهادهای عمومی غیر دولتی، از قلمرو شمول ماده ۱۱ قانون مسئولیت مدنی خارج هستند.","چنانچه خسارت ناشی از نقص تشکیلات دولت و تقصیر کارمند دولت باشد، مسئولیت آن دو اشتراکی است.","اصولا در صورت تقصیر کارمند دولت، خسارت زیان دیده توسط دولت جبران نخواهد شد، اما در مورد خساراتی که صرفاً ناشی از اشتباه کارمند دولت است، خسارت زیان دیده توسط دولت جبران می شود."],answer:2,why:"بر اساس ماده ۱۱ ق.م.م و ق.مسئولیت مدنی، در اجتماع نقص تشکیلات و تقصیر کارمند، مسئولیت دولت و کارمند مشترک (تضامنی) است؛ ادعای معافیت مطلق دولت در اعمال حاکمیتی یا خروج تمام نهادهای عمومی غیردولتی از ماده ۱۱ نادرست است.",topic:"مسئولیت دولت"},{q:"در صورت رد ترکه توسط ورثه، تکلیف ماترک چیست؟",options:["در حکم اموال بلاوارث است","ترکه متعلق به طلبکاران و مدیر تصفیه ترکه است.","پس از پرداخت دیون متوفی، مابقی متعلق به ورثه است.","پس از پرداخت دیون متوفی، مابقی در صورت درخواست ورثه، متعلق به آنان است"],answer:0,why:"ماده ۸۶۷ ق.م: در صورت رد میراث، ترکه متوفی در حکم اموال بلاوارث است و اداره تصفیه اموال بلاوارث پس از ادای دیون، مابقی را خزانه می‌گیرد.",topic:"رد ترکه"},{q:"« الف» با سند عادی در تاریخ مشخص، آپارتمان خود را به شخص «ب» اجاره می دهد، شخص دیگری با ارائه سند عادی، مدعی است همان آپارتمان را با سند عادی اجاره کرده است. کدام مورد صحیح است؟",options:["قراردادی که تاریخ آن معلوم است، مؤخر فرض می شود.","در همه موارد، قراردادی که تاریخ آن معلوم است، مؤخر فرض می شود.","در همه موارد، قراردادی که تاریخ آن مجهول است، مؤخر فرض می شود.","چنانچه با قرائن و شواهد، تقدم و تأخر هیچ کدام از دو قرارداد مشخص نباشد، قراردادی که تاریخ آن مجهول است، مؤخر فرض می شود."],answer:3,why:"طبق قواعد تعارض اسناد عادی (مواد ۱۳۰۰ و ۱۳۰۳ ق.م)، در فرض عدم امکان تعیین تقدم و تأخر با قرائن، سند مجهول‌التاریخ مؤخر و سند معتبرالتاریخ مقدم فرض می‌شود.",topic:"تعارض اسناد"},{q:"مالک زمینی به موجب قرارداد صلح، به همسایه حق عبور از ملک خود را داده است. کدام مورد صحیح است؟",options:["تغییر مالک، تأثیری در حق عبور ایجاد شده ندارد.","در صورت فوت هر یک از دو همسایه، حق عبور منتفی می شود","چنانچه مالک صریحا عدم رضای خود را به عبور دیگران اعلام کند، حق عبور منتفی می شود.","در صورت فروش هر یک از دو ملک، مالک جدید با توجه به اثر نسبی قرارداد، حق عبور نخواهد داشت."],answer:0,why:"ماده ۴۶ و ۴۷ ق.م: حق ارتفاق تبعاً از ملک منتقل می‌شود؛ تغییر مالک اثری در حق عبور ایجادشده ندارد (قائم‌به‌قائم بودن حق عینی).",topic:"حق ارتفاق"},{q:"زوج ضمن عقد نکاح، به زوجه وکالت داده تا در صورتی که منزل مشترک را بیش از ۶ ماه، به هر دلیل ترک کند، زوجه وکیل در طلاق خود باشد. چنانچه زوج * در نتیجه ابتلا به جنون دائمی، یک سال منزل مشترک را ترک نماید کدام مورد صحیح است؟",options:["چنانچه اذن زوج در طلاق، صرف نظر از وکالت باقی باشد، زوجه می تواند بر اساس آن تقاضای طلاق کند.","زوجه می تواند بر اساس وکالت داده شده تقاضای طلاق کند.","در هر حال، زوجه می تواند تقاضای فسخ نکاح نماید.","عقد نکاح منفسخ می شود."],answer:1,why:"وکالت بلاعزل مشروط به ترک منزل بیش از ۶ ماه «به هر دلیل» تحقق یافته و زوجه وکیل در طلاق خود است؛ ترک ناشی از جنون نیز مصداق شرط است (مواد ۹۵۷ و ۹۵۹ ق.م و ق.وکالت).",topic:"وکالت در طلاق"},{q:"زوج در حال بیماری، همسر خود را طلاق می دهد و ۶ ماه بعد، در نتیجه همان بیماری فوت می کند. زن که ۱۴ ماه پس از طلاق ازدواج کرده است، مطالبه سهم الارث می نماید. کدام مورد، صحیح است؟",options:["زوجه مطلقه، به سبب اینکه در زوجیت مرد دیگری است، ارث نمی برد.","زوجه مطلقه از عین اموال منقول و قیمت اموال غیرمنقول ارث می برد.","زوجه مطلقه بعد از طلاق، به علت قطع رابطه سببی ارث نمی برد.","زوجه مطلقه از اموال منقول و بهای اعیان ارث می برد."],answer:1,why:"ماده ۹۴۳ ق.م: در طلاق بیماری منتهی به فوت، زوجه از شوهر ارث می‌برد هرچند بعد از انقضاء عده ازدواج کرده باشد؛ ارث زوجه از عین اموال منقول و قیمت اموال غیرمنقول است.",topic:"طلاق بیماری"},{q:"شخص « الف» تعهد کرده است تا در موقع برداشت گندم، یک تن گندم ورامین به شخص «ب» تحویل دهد. به فرض اینکه گندم ورامین از حیث کیفیت دارای شش درجه باشد و در قرارداد طرفین، در خصوص درجه ای که باید تسلیم شود، توافقی نشده باشد، در خصوص تحویل مورد معامله، کدام مورد صحیح است؟",options:["بایع باید درجه ۳ تحویل دهد.","بایع می تواند درجه ۱ تا ۶ تحویل دهد.","بایع نمی تواند درجه ۶ تحویل دهد.","بایع نمی تواند درجه ۴، ۵ و ۶ تحویل دهد."],answer:0,why:"ماده ۲۸۱ ق.م: اگر مال کلی به درجات مختلف باشد، انتخاب درجه با بایع است ولی باید از درجه‌ای بفروشد که در بازار معامله می‌شود (درجه متوسط؛ اینجا درجه ۳ از ۶).",topic:"بیع کلی"},{q:"کدام مورد صحیح است؟",options:["اشتباه در وصف اساسی یا ذاتی مورد معامله در فرضی که این وصف شرط شده باشد موجب خیار تخلف شرط است.","اکراه و اشتباه در نوع عقد، در صورت تنفیذ عقد توسط مکره یا مشتبه، مخل به عقد نیست.","اشتباه در جنس مبیع، اگر وصف اساسی آن باشد موجب فسخ است.","اشتباه در وصف اساسی زوج در نکاح، موجب بطلان عقد نیست."],answer:1,why:"ماده ۲۰۶ ق.م و قواعد تنفیذ: اکراه و اشتباه با تنفیذ عقد به وسیله مکره یا مشتبه رفع اثر می‌شود و به صحت عقد خللی نمی‌رساند.",topic:"اکراه و اشتباه"},{q:"چنانچه طلاق به درخواست زوج باشد، در چه صورتی دادگاه حکم طلاق صادر می کند و طلاق ثبت می شود؟",options:["در هر حال، دادگاه می تواند حکم طلاق صادر کند، اما ثبت طلاق منوط به تأدیه کامل حقوق زن با رضایت زوجه یا صدور حکم قطعی دایر بر اعسار زوج یا تقسیط محکوم به است.","تنها در صورتی که مرد تمام حقوق مالی زن را تأدیه نماید یا زوجه رضایت دهد یا حکم قطعی اعسار مرد صادر شده باشد، دادگاه می تواند حکم طلاق صادر کند","ثبت طلاق تنها منوط به این است که مرد تمام حقوق مالی زن را تأدیه کند یا زوجه رضایت دهد.","صدور حکم طلاق و ثبت آن، منوط به تأدیه کامل حقوق زن توسط مرد با رضایت زوجه است."],answer:0,why:"ماده ۳ ق.ح.خ ۱۳۹۱: دادگاه در هر حال می‌تواند حکم طلاق صادر کند اما ثبت طلاق منوط به تأدیه کامل حقوق مالی زن، رضایت زوجه یا گواهی قطعی اعسار از محکومٌ‌به است.",topic:"قانون حمایت خانواده"},{q:"کدام مورد صحیح است؟",options:["مطالبه اجرای تعهد در حقوق ایران، مطلقأ شرط مسئولیت قراردادی نیست.","هر گونه توافق در مورد خسارت تأخیر تأدیه وجه نقد ضمن قرار داد، چنانچه مازاد بر شاخص سالانه بانک مرکزی باشد، باطل و بلا اثر است","درخواست خسارت عدم اجرای تعهد در تعهداتی که موضوع آن وجه نقد یا تسلیم مالی کلی است، منوط به مطالبه اجرای تعهد از سوی متعهد است","تعیین وجه التزام برای جبران خسارت تأخیر تأدیه وجه نقد بیش از شاخص سالانه بانک مرکزی، در صورتی معتبر است که مغایر قوانین و مقررات امری نباشد."],answer:3,why:"تبصره ۱ ماده ۲۳۰۱ ق.م (الحاقی): وجه التزام مازاد بر شاخص سالانه بانک مرکزی فقط در صورتی معتبر است که مغایر قوانین و مقررات امری نباشد؛ ادعای بطلان مطلق تمام توافق‌ها درست نیست.",topic:"وجه التزام"},{q:"اگر موصی بعد از قبول موصی له، مال مورد وصیت را بفروشد، بیع انشاء شده چه حکمی دارد؟",options:["صحت آن، منوط به تنفیذ موصی له است.","معامله در مقابل موصی له، غیر قابل استناد است.","صحیح است.","صحت آن، منوط به تنفیذ ورثه است."],answer:0,why:"ماده ۸۴۷ ق.م: پس از قبول موصی‌له، فروش مال موصی‌به توسط موصی نسبت به او نافذ نیست مگر با تنفیذ او؛ چون مال از لحظه قبول به ملکیت موصی‌له درآمده است.",topic:"وصیت"},{q:"در خصوص حقوق مادی پدید آورنده اثر ادبی و هنری، کدام مورد صحیح است؟",options:["پدید آورنده می تواند، حقوق مادی اثر را بدون ذکر مدت، به دیگری واگذار کند.","منتقل الیه حق مادی پدید آورنده، می تواند تا ۵۰ سال پس از واگذاری، از این حق استفاده کند.","چنانچه پدید آورنده ورثه ای نداشته باشد، استفاده از حقوق مادی پدید آورنده در اختیار عموم قرار می گیرد.","چنانچه حقوق مادی پدید آورنده متعلق به شخص حقوقی باشد، این حقوق از تاریخ نشر یا عرضه، به مدت ۵۰ سال مورد حمایت خواهد بود."],answer:0,why:"ماده ۱۳ ق.ح.م.پ ۱۳۴۸: پدیدآورنده می‌تواند حقوق مادی اثر را با سند کتبی حتی بدون ذکر مدت واگذار کند (انتقال باطل نمی‌شود)؛ گزینه‌های ۵۰ سال با مدت‌های مقرر قانونی (عمر + ۳۰ سال) ناسازگارند.",topic:"حقوق مادی"},{q:"هر گاه در عقد مزارعه، زمین موضوع قرارداد به صورت موقت از قابلیت انتفاع خارج شود، عقد مزارعه چه وضعیتی پیدا می کند؟",options:["طبق مقررات باب مزارعه، برای عامل، حق فسخ ایجاد می شود.","طبق مقررات باب مزارعه، برای مزارع، حق فسخ ایجاد می شود.","منفسخ نمی شود.","منفسخ می شود."],answer:2,why:"ماده ۵۱۲ ق.م: اگر قسمتی از زمین موقتاً از قابلیت انتفاع خارج شود مزارعه منفسخ نمی‌شود؛ انفساخ تنها در تلف کلی و دائمی رخ می‌دهد.",topic:"مزارعه"},{q:"شخص «الف» به سبب باختن در گروبندی، مبلغ ده میلیون تومان به شخص «ب» پرداخت کرده است، در خصوص دعوای استرداد شخص «الف» بابت مبالغ پرداخت شده به «ب»، کدام مورد صحیح است؟",options:["موضوع بستگی به علم یا جهل شخص «ب» نسبت به حکم ماده ۶۵۴ قانون مدنی (باطل بودن قمار و گروبندی و مسموع نبودن دعوای مربوط به آن) دارد.","موضوع بستگی به علم یا جهل شخص «الف» نسبت به حکم ماده ۶۵۴ قانون مدنی (باطل بودن قمار و گروبندی و مسموع نبودن دعوای مربوط به آن) دارد.","با توجه به اینکه قمار و گروبندی باطل و دعوای راجع به آن مسموع نیست، دعوای استرداد پذیرفته نمی شود.","شخص «الف» می تواند تقاضای استرداد مبلغ پرداخت شده را نماید و شخص «ب» مکلف به استرداد آن است."],answer:2,why:"ماده ۶۵۴ ق.م: قمار و گروبندی باطل و دعوای راجع به آن مسموع نیست؛ همین‌طور دعوای راجع به وجوهی که به عنوان باخت داده شده — پس دعوای استرداد پذیرفته نمی‌شود.",topic:"قمار و گروبندی"},{q:"در خصوص حقوق عینی و حقوق دینی، کدام مورد صحیح است؟",options:["حقوق دینی بر خلاف حقوق عینی، ناظر به ما فی الذمه اشخاص هستند، لیکن قابل اسقاط نیستند.","حقوق عینی متضمن حق تعقیب هستند، لیکن حقوق دینی متضمن و موجد حق تعقیب نیستند.","حقوق عینی بر خلاف حقوق دینی، ناظر به اعیان اموال و همچنین تمامی حقوق مالی است.","حقوق عینی و حقوق دینی، در موضوع و متعلق، کاملا یکسان هستند."],answer:1,why:"حق تعقیب مشخصه حقوق عینی است (امکان تعقیب مال در دست هر شخصی)؛ حقوق دینی فقط ناظر به ما فی‌الذمه مدیون است و حق تعقیب را به دنبال ندارد.",topic:"حقوق عینی و دینی"},{q:"یک شرکت کرایه اتومبیل، اتوبوسی را با اوصاف مشخص، به یک شرکت توریستی اجاره می دهد و در زمان مقرر، یک دستگاه اتوبوس تعیین و به شرکت توریستی تحویل می دهد. ولی اتوبوس مذکور به دلیل نقص فنی معیوب بوده و قادر به حرکت نیست. کدام مورد صحیح است؟",options:["شرکت توریستی، حق فسخ ندارد.","موجر بین تسلیم فرد دیگری از افراد کلی یا فسخ اجاره مخیر است","شرکت توریستی، حق فسخ دارد و می تواند پس از آن، استرداد اجاره بها را از موجر درخواست کند.","شرکت کرایه اتومبیل می تواند به دلیل نقص فنی اتوبوس و عدم امکان تهیه وسیله نقلیه جایگزین قرارداد را فسخ کند."],answer:2,why:"در اجاره کلی در معین، فرد تسلیم‌شده باید واجد اوصاف مقرر باشد؛ اتوبوس معیوب و غیرقابل حرکت موجب حق فسخ مستأجر و استرداد اجاره‌بهاست (مواد ۴۷۰ و ۴۸۲ و ۴۸۳ ق.م).",topic:"اجاره"},{q:"کدام مورد صحیح است؟",options:["متولی در صورتی می تواند برای انجام امور تولیت، وکیل بگیرد که در ضمن وقف، شرط شده باشد.","موقوف علیه بعد از حصول منافع موقوفه و تعیین حصه، تنها با اذن متولی، حق تصرف دارد.","وقف بر نفس و وقف بر مصالح عامه، اگر خود واقف مصداق موقوف علیه باشد، باطل است.","چنانچه متولی مال موقوفه مرتکب خیانت شود، حاکم حق عزل او را ندارد."],answer:2,why:"وقف بر نفس باطل است و قاعده معروف فقهی «وقف بر نفس و اگر واقف مصداق موقوف‌علیه باشد» نیز در فرض مذکور حکم به بطلان دارد (مواد ۵۵ تا ۶۳ ق.م؛ وقف بر مصالح عامه در فرض اشتمال بر واقف باطل است مطابق کلید تحلیلی).",topic:"وقف"},{q:"« الف» بعد از خرید یک دستگاه اتومبیل، آن را بلافاصله به «ب» می فروشد. یک سال بعد از معامله اول، «الف» متوجه می شود که در خرید اتومبیل، به غبن فاحش، مغبون شده است. کدام مورد، صحیح است؟",options:["«الف» حق فسخ دارد.","«الف» حق فسخ دارد و پس از فسخ، معامله او با «ب» باطل و مبیع مسترد می شود.","با توجه به اینکه ذوالخیار، در مبیع تصرفات ناقله انجام داده است، خیار او ساقط می شود.","با توجه به عدم امکان استرداد مبیع، «الف» حق فسخ ندارد و صرفا می تواند مطالبه خسارت کند. جهت تهیه و خرید آنلاین کتب حقوقی منبع حقوق مدنی آزمون وکالت کلیک کنید"],answer:2,why:"ماده ۴۰۲ ق.م: انتقال مبیع به غیر توسط مشتری ذوالخیار (به‌جز موارد فرار از دین) موجب سقوط خیار غبن می‌شود؛ الف با فروش اتومبیل تصرف ناقله انجام داده و خیارش ساقط است.",topic:"خیار غبن"}]},{id:"pack-vokalat-osool-98",title:"دفترچهٔ واقعی ۱۳۹۸ — اصول استنباط (تحلیلی)",exam:"آزمون وکالت",examSlug:"vokalat",branch:"اصول فقه",description:"سوالات درس اصول استنباط آزمون وکالت ۱۳۹۸ اسکودا همراه با پاسخ‌های تحلیلی — تزاحم، قیاس اولویت، شهرت، علم اجمالی، قرائن معتبره و شک در حیات — تحلیل به سبک درسنامه.",minutes:25,passMark:60,kind:"mcq",questions:[{q:"در فرض تزاحم دو یا چند حکم معیار ترجیح کدام است؟",options:["تقدم زمان صدور حکم ","تخییر به طور مطلق ","اهمیت حکم ","نزدیک بودن حکم به واقعیت "],answer:2,why:"گزینه ج صحیح است ، منظور از اهمیت همان اهم و مهمی که در باب تزاحم است می باشد .",topic:"اصول عملیه و قیاس"},{q:"در خصوص دو مفهوم «قیاس اولویت» و «قیاس فقهی- حقوقی (تمثیل)؛ کدام مورد صحیح است؟",options:["قیاس اولویت؛ به دلالت لفظی مربوط می شود ولی قیاس فقهی – حقوقی به استنباط ظنی یا قطعی با تکیه برعلت حکم باز می گردد. ","این دو مفهوم؛ دو تعبیر برای یک چیز است که هر دو اعتبار یکسان دارند. ","قیاس اولویت؛ قیاس منصوص العله است ولی قیاس فقهی – حقوقی؛ مستنبط العله می باشد. ","در قیاس فقهی – حقوقی؛ به علت حکم تصریح شده است ولی در قیاس اولویت علت حکم ظنی است. "],answer:0,why:"گزینه الف صحیح است ،گزینه ب علط است چون هر دو یک چیز نیستند گزینه ج غلط است چون منصوص العله با اولویت تفاوت دارد گزینه د هم اشتباه هست چون که قیاس قیاس اولویت علت حکم تصریح شده است .",topic:"اصول عملیه و قیاس"},{q:"بنا بر اینکه مبنای حجیت خبر واحد؛ وثوق به صدور روایت معصوم (ع) باشد؛ کدام یک از انواع شهرت جبران کننده ضعف سند خبر واحد است؟",options:["فتوایی و عملی ","عملی ","فتوایی ","روایی "],answer:3,why:"گزینه د صحیح تر است. برخی از اصولیون معتقدند شهرتی که موجب قطع به صدور روایت می شود شهرت روایی و عملی است با این تفاسیر گزینه ب هم صحیح می باشد .",topic:"اصول عملیه و قیاس"},{q:"اگر معصوم (ع) عملی را ترک کند؛ چه چیزی را می توان از رفتار ایشان استنباط کرد؟",options:["عمل مباح به معنای خاص است. ","عمل مکروه است. ","عمل حرام است. ","عمل واجب نیست. "],answer:3,why:"گزینه د صحیح است. وقتی کاری را معصوم ترک کرد نشان از این است که آن عمل واجب نیست وگرنه انجام می داد .",topic:"اصول عملیه و قیاس"},{q:"به موجب قراردادی یکی از دو شریک مال غیرمنقول سهم خود را به ثالث منتقل می کند ولی نمی دانیم بیع بوده یا صلح معوض؛ چنانچه در مجلس عقد؛ قرارداد مزبور توسط یکی از طرفین فسخ شود؛ کدام مورد صحیح است؟",options:["استصحاب عقد به طور کلی جاری است. ","قرارداد را باید فسخ شده دانست. ","استصحاب عقد صلح معوض جاری است. ","استصحاب عقد بیع جاری است. "],answer:0,why:"گزینه الف صحیح است. عقد یک لفظ کلی است . س ۶- برابر ماده ۶۴۵ق.م.ا؛ به منظور حفظ کیان خانواده؛ ثبت واقعه ازدواج دایم؛ طلاق و رجوع طبق مقررات الزامی است. در خصوص واژه «طلاق» کدام مورد صحیح است؟ الف: شمول واژه «طلاق» نسبت به انواع طلاق؛ مشکوک است و بنابراین بر نوع غالب که طلاق رجعی است حمل می شود. ب: واژه «طلاق» لفظا عام است و همه افراد و انواع «طلاق» را در بر می گیرد. ج: شمول واژه طلاق نسبت به انواع طلاق؛ از باب اطلاق لفظ «طلاق» است. د: واژه طلاق؛ فقط دارای اطلاق احوالی است و فقط ناظر به طلاق در حالت های مختلف است. پاسخ: گزینه ج صحیح است. طلاق مطلق است و شامل تمام مصادیقش می شود . مطلق لفظی است که مفرد باشد و ادات عام نداشته باشد .",topic:"اصول عملیه و قیاس"},{q:"در کدام یک از موارد زیر؛ احتیاط لازم است؟",options:["علم اجمالی؛ به علم تفصیلی به تکلیف و شک بدوی تجزیه می شود. ","بعضی از اطراف علم اجمالی؛ از ابتدای مکلف خارج شود. ","ارتکاب یکی از اطراف علم اجمالی؛ از باب اضطرار لازم باشد. ","بعضی از اطراف علم اجمالی؛ از ابتدای مورد ابتلای مکلف نباشد. "],answer:1,why:"گزینه ب صحیح است.",topic:"اصول عملیه و قیاس"},{q:"در کدام مورد؛ تعارض حتی از نوع غیر مستقر آن نیز وجود ندارد؟",options:["یکی از دو دلیل؛ قطعی و یقینی و دیگری ظنی باشد. ","بین دو دلیل؛ نسبت عام وخاص برقرار باشد. ","بین دو دلیل؛ نسبت مطلق و مقید بر قرار باشد. ","یکی از دو دلیل؛ حاکم یا وارد بر دلیل دیگر باشد. "],answer:0,why:"گزینه الف صحیح است. تعارض غیر مستقر همان تعارض ظاهری است ( ورود حکومت تخصص تخصیص )",topic:"اصول عملیه و قیاس"},{q:"در خصوص جمع دلالی(عرفی) و تبرعی؛ کدام مورد صحیح است؟",options:["جمع تبرعی و عرفی به یک معنی هستند. ","جمع تبرعی؛ مربوط به احکام غیر الزامی و جمع عرفی؛ مربوط به احکام الزامی است. ","کاربرد جمع تبرعی؛ در احکام مدنی و کاربرد جمع دلالی؛ در احکام کیفری است. ","جمع عرفی برخلاف جمع تبرعی،بر پایه ی شاهد و قرینه لفظی صورت می گیرد . "],answer:3,why:"گزینه د صحیح است.( مطابق نظر کانون در سال ۹۷ )",topic:"اصول عملیه و قیاس"},{q:"کدام یک ازعبارت های زیر قابل مفهوم گیری است؟",options:["تدلیس در صلح،موجب خیار فسخ است. ","عقد،محقق می شود به قصد انشا،به شرط مقرون بودن به چیزی که دلالت برقصد کند. ","ضامنی که به قصد تبرع ضمانت کرده باشد،حق رجوع به مضمون عنه ندارد. ","تفریقی که با لعان حاصل می شود،موجب حرمت ابدی است. "],answer:3,why:"گزینه د از نظر حقوقی نادرست است و احتمالا کلید آزمون گزینه ج یا د نمی باشد. گزینه الف هم قابل مفهوم گیری نیست . پس گزینه ب صحیح می باشد .",topic:"اصول عملیه و قیاس"},{q:"در کدام مورد،اجمال مخصص، به عام سرایت نمی کند؟",options:["در شبهه مفهومیه،در موارد دوران میان متباینین،اگر مخصص،منفصل باشد. ","در شبهه مفهومیه،اگر مخصص،منفصل باشد. ","در شبهه مصداقیه،خواه مخصص،متصل باشد یا منفصل. ","در شبهه مفهومیه،در موارد دوران میان اقل و اکثر،اگر مخصص،منفصل باشد. "],answer:3,why:"گزینه د صحیح است(. تنها استثنایی که اجمال مخصص به عام سرایت نمی کند ) ـ در کدام یک از موارد زیر،مطلق را باید بر مقید حمل کرد؟ الف: تدلیس در معامله موجب خیار فسخ است.ـ تدلیس در صلح،موجب خیار فسخ است. ب: تلف کننده مال دیگری،ضامن آن است.ـ تلف کننده مال دیگری به عمد،به حبس محکوم خواهد شد. ج: قتل عمد از موانع ارث است.ـ اگر قتل عمد به حکم قانون یا برای دفاع باشد،مانع ارث نخواهد بود. د: رضای حاصل در نتیجه ی اشتباه یا اکراه،موجب نفوذ معامله نیست.ـ صلح به اکراه،نافذ نیست. پاسخ: گزینه ج صحیح است.( حمل مطلق بر مقید همان تخصیص است اگر با این تکنیک دنبال پاسخ باشید سریع پیدا می کنید )",topic:"اصول عملیه و قیاس"},{q:"در مقایسه میان (تخییر در واجب تخییری)و(تخییر به عنوان اصل عملی)،کدام مورد صحیح است؟",options:["اولی،یک حکم واقعی شرعی است،ولی دومی،یک حکم ظاهری عقلی یا شرعی است. ","تخییر در هر دو،صرفا یک حکم واقعی عقلی یا شرعی است. ","تخییر در هر دو،صرفا یک حکم ظاهری عقلی یا شرعی است. ","اولی،یک حکم ظاهری عقلی یا شرعی است ولی دومی،یک حکم ظاهری عقلی است. "],answer:0,why:"گزینه الف صحیح است.( اقسام اصول عملیه یعنی استصحاب برائت احتیاط و تخییر حکم ظاهری اند غیر از این دیدین بزنید حکم واقعی )",topic:"اصول عملیه و قیاس"},{q:"شخصی انبار فرش دیگری را به عمد آتش می زند. درصورتی که یقینا چند تخته فرش در آن انبار وجود داشته است،ولی اکنون شک داشته باشیم که آیا قبل از وقوع آتش سوزی،فرش های مزبور به انبار دیگری منتقل شده اند یا نه، کدام مورد به کمک استصحاب ثابت می شود؟",options:["بقای فرش ها تا لحظه آتش سوزی،اتلاف آنها،حکم به ضمان و حبس ","فقط بقای فرش ها تا لحظه ی آتش سوزی ","بقای فرش ها و عمدی بودن عمل آتش زننده ","بقای فرش ها تا لحظه آتش سوزی،اتلاف آنها و حکم به ضمان "],answer:3,why:"گزینه د صحیح است( این نظر بر طبق نظر پسندیده کانون در آزمون ۹۷ می باشد ) اما از نظر فقهی فقط آثار شرعی بلا واسطه استصحاب حجت دارد .( گزینه ب هم می تواند مد نظر طراح باشد )",topic:"اصول عملیه و قیاس"},{q:"برابر ماده ۳ قانون مجازات اسلامی:(قوانین جزایی ایران درباره کلیه اشخاصی که در قلمرو حاکمیت زمینی،دریایی و هوایی جمهوری اسلامی ایران مرتکب جرم شوند، اعمال می شود.)،عبارت (کلیه اشخاص) در این ماده،مصداق کدام مورد زیر است؟",options:["اطلاق احوالی ","عام مجموعی ","عام استغراقی ","عام بدلی "],answer:2,why:"گزینه ج صحیح است. اگر کلمات کلیه و همه و تمام آمد عام دیگر بدلی نیست، کلیه اشخاص شامل تک تک افراد ایران می شود پس عام افرادی یا استغراقی است .",topic:"اصول عملیه و قیاس"},{q:"به موجب ماده ۷۱ قانون مجازات اسلامی:(اعمال مجازات های جایگزین حبس،در مورد جرایم علیه امنیت داخلی یا خارجی کشور ممنوع است)،کدام مورد در خصوص حکم مذکور در این ماده،صحیح است؟",options:["از جنس فرمان ارشادی است. ","یک حکم تکلیفی است که ممکن است مستلزم حکم وضعی هم باشد. ","صرفا حکم وضعی است و ماده از بیان حکم تکلیفی ساکت است. ","از آنجا که در قالب صیغه نهی نیست،حکم تکلیفی نیست. "],answer:1,why:"گزینه ب صحیح است. در کتابم این قسمت را در یک نمودار آوردم هر چیزی در غالب حرمت در قانون بیاید ( نباید ، ممنوع است ،حق ندارد و …) حکم تکلیفی می باشد",topic:"اصول عملیه و قیاس"},{q:"دو نسخه متعارض از یک قرارداد در مورد تعهد معینی وجود دارد یکی ازقرارداد ها دلالت روشنی بر موضوع تعهد دارد اما شائبه ی اکراهی بودن آن هم درمیان است.قرارداد دیگر،فاقد شائبه ی اکراهی بودن است اما دلالت آن بر موضوع تعهد مبهم می باشد کدام مورد زیردر خصوص این دو قرارداد صحیح است؟",options:["یکی از قراردادها دارای مرجح جهت صدوری و دیگری دارای مرجح دلالی است. ","هردو قرارداد، مرجح جهت صدوری را دارند ولی یکی از آنها دارای مرجح دلالی نیز هست. ","هردو قرارداد،دارای مرجح مضمونی و جهت صدوری یکسان هستند. ","یکی ازقراردادها دارای مرجح مضمونی و دیگری دارای مرجح سندی است. "],answer:0,why:"گزینه الف صحیح تر است ،اما از طرف دیگر می تواند مضمونی و سندی هم باشد . ۱ ۸ـ شخصی می دان مبلغ دویست میلیون تومان بدهکار است،ولی نمی داند باید این مبلغ را به«الف»بدهد یا «ب»،بنابر حل مسئله با تکیه بر اصول عملی نوع شبهه و اصل جاری در این مورد کدام است؟ الف: «شبهه میان متباینین ـ شبهه موضوعیه»ـ اصل احتیاط ب: «شبهه میان متباینین ـ شبهه حکمیه»ـ اصل تخییر ج: «شبهه میان اقل و اکثراستقلالی ـ شبهه موضوعیه»ـ اصل احتیاط د: «شبهه میان اقل و اکثراستقلالی ـشبهه حکمیه»ـ اصل تخییر پاسخ: گزینه الف صحیح است. شبهه در این سوال از نوع موضوع می باشد .",topic:"اصول عملیه و قیاس"},{q:"هرگاه دادرس در خصوص پرونده ای تردید داشته باشد که آیا رسیدگی به آن در قلمروی صلاحیت قضایی او است یا رسیدگی به آن ممنوع است و درقلمروی صلاحیت او نیست، این امر،مصداق کدام مورد است؟",options:["دوران امر میان متباینین و لزوم احتیاط ","دوران امر میان محذورین ","شبهه تحریمی ناشی از فقدان نص و لزوم احتیاط ","شک در مکلف به و اجرای اصل برائت "],answer:1,why:"گزینه ب صحیح است.( شک بین واجب و حرام است می شود دوران بین محذورین )",topic:"اصول عملیه و قیاس"},{q:"در خصوص«اصاله البرائه» و «اصاله الاباحه»کدام مورد صحیح است؟",options:["هردو،در شبهات تحریمی و وجوبی جاری می شوند. ","هردو، بیانگر حکم ظاهری هستند. ","اولی،درشبهات تحریمی و وجوهی ،دومی،درشبهات وجوبی جاری می شود. ","اولی،مفید حکم ظاهری و دومی،بیانگر حکم واقعی است. "],answer:3,why:"گزینه د صحیح است. به تکنیک پاسخ سوال ۱۳ دقت کنید . برچسب ها آزمون وکالت ۹۸ اصول فقه پاسخنامه تشریحی کپی لینک لینک کپی شد ۱۱ آذر ۱۳۹۸ ۳۰ ۴,۱۱۲ خواندن این مطلب ۷ دقیقه زمان میبرد",topic:"اصول عملیه و قیاس"}]},{id:"pack-tadris-jaza-mcq3",title:"دفترچهٔ تستی — تدریس جزا ۳ (صفحات ۱۰۱ تا ۱۵۰)",exam:"تدریس جزا (غفوری)",examSlug:"tadris-jaza",branch:"حقوق جزا",description:"دفترچهٔ تستی برگرفته از صفحات ۱۰۱ تا ۱۵۰ جزوهٔ تدریس جزا احمد غفوری: احتساب بازداشت و بازداشت بدل از جزای نقدی (مواد ۲۸ و ۲۹ ق.م.ا و ۵۱۵ تا ۵۲۹ ق.آ.د.ک)، محرومیت‌ها و انتشار حکم (مواد ۳۰ تا ۳۶)، تخفیف و معافیت (مواد ۳۷ تا ۳۹ و مادهٔ ۳۲۷ اصلاحی)، تعویق صدور حکم و تعلیق اجرا (مواد ۴۰ تا ۵۵)، نیمه‌آزادی و آزادی مشروط و نظارت الکترونیکی (مواد ۵۶ تا ۶۳) و مجازات‌های جایگزین حبس (مواد ۶۴ تا ۷۵) — با پاسخ‌نامهٔ تشریحی.",minutes:50,passMark:70,kind:"mcq",questions:[{q:"بند الف مادهٔ ۵۱۶ ق.آ.د.ک: هر روز بازداشت قبلی از دورهٔ مراقبت چند روز کسر می‌شود؟",options:["یک روز","دو روز","پنج روز","هفت روز"],answer:2,why:"هر روز بازداشت = یک روز جزای نقدی روزانه یا یک ساعت خدمات عمومی رایگان یا پنج روز دورهٔ مراقبت (مثال ۸۸: دوازده روز بازداشت، چهار ماه از شش ماه اجرا می‌شود).",topic:"احتساب بازداشت"},{q:"شخصی سی روز بازداشت بوده و به ۱۸۰ روز جزای نقدی روزانه محکوم شده است. چند روز اجرا می‌شود؟ (مثال ۸۶)",options:["۱۸۰ روز","۱۶۰ روز","۱۵۰ روز","۱۲۰ روز"],answer:2,why:"هر روز بازداشت یک روز جزای نقدی روزانه کسر می‌کند: ۱۸۰ − ۳۰ = ۱۵۰ روز.",topic:"احتساب بازداشت"},{q:"دو ماه بازداشت قبلی در مجازات «دو سال انفصال موقت» چه اثری دارد؟ (مثال ۸۹)",options:["دو ماه از انفصال کسر می‌شود","بیست و دو ماه اجرا می‌شود","همان دو سال کامل اجرا می‌شود","انفصال به نصف می‌رسد"],answer:2,why:"انفصال جزو مجازات‌های قابل احتساب بازداشت نیست؛ در فرض مثال ۸۹ همان دو سال انفصال اجرا می‌شود.",topic:"احتساب بازداشت"},{q:"۹ روز و ۳ ساعت بازداشت از ۵۰ ضربه شلاق تعزیری چند ضربه کسر می‌کند؟ (مثال ۹۰ و مادهٔ ۲۷ ق.م.ا)",options:["۹ ضربه","۲۷ ضربه","۳۰ ضربه","هیچ"],answer:2,why:"روز ناقص یک روز کامل است (۱۰ روز) و هر روز بازداشت معادل سه ضربه شلاق است: ۱۰ × ۳ = ۳۰ ضربه؛ ۲۰ ضربه اجرا می‌شود.",topic:"احتساب بازداشت"},{q:"بازداشتِ کمتر از بیست و چهار ساعت در احتساب ایام بازداشت چگونه محاسبه می‌شود؟",options:["محاسبه نمی‌شود","نصف روز","یک روز (تبصرهٔ مادهٔ ۵۱۵ ق.آ.د.ک)","دو روز"],answer:2,why:"تبصرهٔ مادهٔ ۵۱۵: مدت تحت نظر یا بازداشتِ کمتر از ۲۴ ساعت یک روز محاسبه می‌شود.",topic:"احتساب بازداشت"},{q:"سه میلیون ریال جزای نقدیِ عجزمحکوم طبق بند الف مادهٔ ۵۲۹ ق.آ.د.ک به چه تبدیل می‌شود؟ (مثال ۹۱)",options:["۵۰ روز حبس","۱۰۰ ساعت خدمات عمومی رایگان","۱۰۰ روز جزای نقدی روزانه","تقسیط سه‌ساله"],answer:1,why:"تا ۱۵ میلیون ریال هر ۳۰ هزار ریال یک ساعت خدمات عمومی است: ۳٬۰۰۰٬۰۰۰ ÷ ۳۰٬۰۰۰ = ۱۰۰ ساعت.",topic:"جزای نقدی"},{q:"تبصرهٔ ۲ مادهٔ ۵۲۹ ق.آ.د.ک: حکم تقسیط یا تبدیل جزای نقدی چه اثری بر وصول مابه‌ازای بخش اجرا نشده از اموالِ بعدی محکوم‌علیه دارد؟ (مثال ۹۷)",options:["وصول را ممنوع می‌کند","وصول را مشروط به رضایت محکوم می‌کند","مانع استیفای آن نیست","فقط در جرایم مالی جاری است"],answer:2,why:"تقسیط یا تبدیل، مانع استیفای مابه‌ازای بخش اجرا نشده از اموالی که بعداً به دست می‌آید نیست — حدود سه میلیارد ریالِ باقی‌ماندهٔ مثال ۹۷ بعداً هم وصول می‌شود.",topic:"جزای نقدی"},{q:"بازداشت بدل از جزای نقدی وقتی توأم با حبس باشد از چه زمانی شروع می‌شود؟ (مادهٔ ۲۹ و مثال ۹۳)",options:["همزمان با حبس","از تاریخ اتمام حبس","قبل از حبس","به تشخیص قاضی اجرای احکام"],answer:1,why:"مادهٔ ۲۹: بازداشت بدل از جزای نقدی از تاریخ اتمام حبس شروع می‌شود.",topic:"بازداشت بدل"},{q:"مجازات جرمی جزای نقدی و شش ماه تا دو سال حبس است. حداکثر بازداشت بدل از جزای نقدی؟ (مثال ۹۴ و نکتهٔ ۶۰)",options:["سه سال","دو سال","شش ماه","یک سال"],answer:1,why:"وقتی حبسِ جرم کمتر از سه سال است، سقف بازداشت بدل به اندازهٔ حداکثر حبس همان جرم یعنی دو سال است.",topic:"بازداشت بدل"},{q:"مجازات جرمی صرفاً جزای نقدی (یا جزای نقدی و شلاق) است. حداکثر بازداشت بدل؟ (مثال ۹۶)",options:["یک سال","دو سال","سه سال","پنج سال"],answer:2,why:"بدون حبس، سقف عمومی مادهٔ ۲۹ جاری است: سه سال.",topic:"بازداشت بدل"},{q:"حداکثر بازداشت بدل از جزای نقدی در جرایم قاچاق کالا و ارز چقدر است؟ (نکتهٔ ۶۱)",options:["سه سال","پنج سال","ده سال","پانزده سال"],answer:3,why:"استثنای سقف سه‌ساله: مادهٔ ۶۰ قانون مبارزه با قاچاق کالا و ارز، ۱۵ سال.",topic:"بازداشت بدل"},{q:"منع از اشتغال به شغل، مستلزم چیست و به چه شرطی؟ (مادهٔ ۳۰)",options:["ابطال گذرنامه؛ در هر جرمی","فسخ حواز کار یا پروانه؛ وقتی جرم به سبب شغل یا با تسهیل آن باشد","ابطال گواهینامه؛ در جرایم شغلی","توقیف محل کسب؛ همیشه"],answer:1,why:"مادهٔ ۳۰: فسخ حواز/پروانه و مشروط بودن به این که جرم به سبب اشتغال به شغل ارتکاب یابد یا با آن تسهیل شود.",topic:"محرومیت‌ها"},{q:"منع از اصدار چک مستلزم چیست؟ (مادهٔ ۳۲)",options:["ابطال برگه‌های چک و ممنوعیت از درخواست مجدد افتتاح حساب جاری","فقط جریمهٔ نقدی","ابطال کارت بانکی","انتشار حکم در روزنامه"],answer:0,why:"مادهٔ ۳۲: ابطال برگه‌های چک + ممنوعیت درخواست مجدد افتتاح حساب جاری.",topic:"محرومیت‌ها"},{q:"اخراج موقت یا دائم بیگانگان محکوم کیفری چگونه انجام می‌شود؟ (مادهٔ ۳۵)",options:["قبل از محاکمه با دستور دادستان","پس از اجرای مجازات و با حکم دادگاه","همزمان با بازداشت","با تصمیم پلیس مهاجرت"],answer:1,why:"مادهٔ ۳۵: اخراج پس از اجرای مجازات و با حکم دادگاه انجام می‌شود.",topic:"محرومیت‌ها"},{q:"حکم محکومیت قطعی جرایم عادی مشمول مادهٔ ۳۶ (حد، محاربه، افساد، تعزیر تا درجهٔ چهار، کلاهبرداری بالای یک میلیارد بدون اخلال) کجا منتشر می‌شود؟",options:["رسانهٔ ملی","روزنامهٔ کثیرالانتشار","یکی از روزنامه‌های محلی در یک نوبت","سامانهٔ قوهٔ قضائیه فقط"],answer:2,why:"مادهٔ ۳۶: رژیم عادی انتشار، روزنامهٔ محلی و یک نوبت است؛ رسانهٔ ملی/کثیرالانتشار مربوط به فهرست الزامی تبصره است.",topic:"انتشار حکم"},{q:"انتشار حکم در رسانهٔ ملی یا روزنامهٔ کثیرالانتشار برای کدام جرایم الزامی است؟ (تبصرهٔ مادهٔ ۳۶)",options:["رشا و ارتشا و اختلاس و پولشویی و جرایم گمرکی و مالیاتی و... با مبلغِ موضوع جرمِ یک میلیارد ریال به بالا","همهٔ جرایم تعزیری درجهٔ پنج","هر جرمی که قاضی تشخیص دهد","فقط جرایم سیاسی"],answer:0,why:"تبصرهٔ مادهٔ ۳۶: فهرست جرایم مالی خاص با مبلغِ موضوع جرمِ ۱ میلیارد ریال یا بیشتر، الزاماً در رسانهٔ ملی یا کثیرالانتشار منتشر می‌شود.",topic:"انتشار حکم"},{q:"نکتهٔ ۶۳: «معاذیر تخفیف‌دهندهٔ قانونی» نمونه‌اش کدام است؟",options:["مادهٔ ۵۰۷ ق.م.ا","تبصرهٔ ۲ مادهٔ ۷۱۹ ق.م.ا","مادهٔ ۳۷۷ ق.آ.د.ک","مادهٔ ۱۱۰ ق.م.ا"],answer:1,why:"نکتهٔ ۶۳: معاذیر تخفیف‌دهنده مانند تبصرهٔ ۲ مادهٔ ۷۱۹ (درمان مصدوم)؛ مادهٔ ۵۰۷ نمونهٔ معاذیر معاف‌کننده است (نکتهٔ ۶۲).",topic:"تخفیف و معافیت"},{q:"انفصال دائم در مقام تخفیف به چه تبدیل می‌شود؟ (جدول مادهٔ ۳۸)",options:["جزای نقدی درجهٔ یک تا چهار","انفصال موقت پنج تا پانزده سال","انفصال موقت یک تا پنج سال","حبس درجهٔ پنج"],answer:1,why:"انفصال دائم ← انفصال موقت ۵ تا ۱۵ سال (بند ت مادهٔ ۳۲۷ هم همین است).",topic:"جدول ماده ۳۸"},{q:"در تخفیف حبس درجهٔ سه، دادگاه به چه چیزی می‌تواند حکم دهد؟",options:["جزای نقدی درجهٔ چهار","شلاق درجهٔ چهار","فقط حبس درجهٔ چهار تا شش","حبس درجهٔ هفت"],answer:2,why:"حبس درجه‌های ۱ تا ۴ فقط تقلیل یک تا سه درجه و فقط داخل حبس؛ تبدیل به نوع دیگر ممکن نیست.",topic:"جدول ماده ۳۸"},{q:"حبس درجهٔ هفت در مقام تخفیف به چه می‌رسد؟",options:["جزای نقدی درجهٔ هفت","جزای نقدی درجهٔ هشت","حبس درجهٔ هشت یا جزای نقدی درجهٔ پنج","شلاق درجهٔ هفت"],answer:0,why:"حبس درجهٔ ۷ فقط به جزای نقدی درجهٔ ۷ تبدیل می‌شود («متناسب با همان درجه» — بند ب مادهٔ ۳۲۷).",topic:"ماده ۳۲۷"},{q:"تست ۳۱ جزوه: جرم با مجازات دو تا پنج سال حبس؛ در تخفیف به کدام نمی‌توان حکم داد؟",options:["سه ماه و یک روز حبس","جزای نقدی درجهٔ پنج","هشت ماه حبس","جزای نقدی درجهٔ شش"],answer:3,why:"حبس درجهٔ ۵ فقط به جزای نقدی درجهٔ ۵ تبدیل می‌شود؛ تقلیل به حبس درجهٔ ۶ یا ۷ هم ممکن است.",topic:"ماده ۳۲۷"},{q:"با اعمال تخفیف عمومی، کدام مجازات قابل تبدیل به نوع دیگر نیست؟ (تست ۳۲ — دکترا ۱۴۰۰)",options:["حبس درجهٔ پنج","حبس درجهٔ چهار","شلاق درجهٔ شش","مصادرهٔ کل اموال شخص حقوقی"],answer:1,why:"بند الف: حبس درجهٔ ۴ و بالاتر فقط تقلیل داخل حبس دارد؛ بقیه گزینه‌ها قابل تبدیل‌اند.",topic:"ماده ۳۲۷"},{q:"تست ۳۳ جزوه: کدام گزینه دربارهٔ تخفیف نادرست است؟",options:["تبدیل حبس درجهٔ شش به جزای نقدی درجهٔ شش","تقلیل انفصال دائم به انفصال موقت پنج سال","تبدیل حبس درجهٔ هفت به جزای نقدی درجهٔ هشت","تقلیل حبس درجهٔ سه به حبس درجهٔ شش"],answer:2,why:"حبس درجهٔ ۷ فقط به جزای نقدی درجهٔ ۷ می‌رسد؛ گزینهٔ ۳ نادرست است.",topic:"ماده ۳۲۷"},{q:"با اجرای تخفیف، حکم به چهل روز حبس صادر شود؛ چه می‌شود؟",options:["همان اجرا می‌شود","به مجازات جایگزین حبس تبدیل می‌شود","به شلاق تبدیل می‌شود","تعدیل می‌شود"],answer:1,why:"تبصرهٔ مادهٔ ۳۲۷ و تبصرهٔ مادهٔ ۳۷: حبسِ تخفیف‌خوردهٔ کمتر از ۹۱ روز به جایگزین حبس تبدیل می‌شود.",topic:"ماده ۳۲۷"},{q:"در جرایم مواد مخدر، تخفیف حداکثر چقدر است؟ (نکتهٔ ۶۴)",options:["تا نصف حداکثر","تا نصف حداقلِ مجازات جرم","تا یک‌سوم حداقل","یک درجه"],answer:1,why:"مادهٔ ۳۸ قانون مبارزه با مواد مخدر: تا نصف حداقل؛ در حبس ابد حداکثر ۱۵ سال.",topic:"تخفیف خاص"},{q:"تخفیف در جرم اسیدپاشی و شروع به آن در چه صورتی ممکن است؟",options:["با هر جهت تخفیف و تا سه درجه","فقط با گذشت شاکی و فقط یک درجه","با جبران خسارت و تا دو درجه","مطلقاً ممکن است"],answer:1,why:"قانون تشدید مجازات اسیدپاشی ۱۳۹۸: فقط با گذشت شاکی نسبت به مجازات تعزیری و فقط یک درجه.",topic:"تخفیف خاص"},{q:"مجازات جرایم علیه آمر به معروف و ناهی از منکر (مادهٔ ۷ قانون حمایت):",options:["قابل تخفیف و تعلیق است","قابل تخفیف و تعلیق نیست","فقط قابل تعلیق است","فقط با گذشت قابل تخفیف است"],answer:1,why:"نکتهٔ ۶۶: این جرایم قابل تخفیف و تعلیق نیستند و حکم قابلیت تجدیدنظر هم ندارد.",topic:"ممنوعیت تخفیف"},{q:"مثال ۱۱۰: رانندهٔ مادهٔ ۷۱۹ مصدوم را به درمان رسانده؛ آیا دوباره با مادهٔ ۳۸ تخفیف می‌گیرد؟",options:["بله؛ تخفیف‌ها جمع می‌شوند","خیر؛ تبصرهٔ ۲ مادهٔ ۳۸ تخفیف دوباره به استناد همان جهت را ممنوع می‌کند","فقط نصف تخفیف","فقط با نظر دادستان"],answer:1,why:"تبصرهٔ ۲ مادهٔ ۳۸: جهتی که در مادهٔ خاص پیش‌بینی شده، دوباره قابل استناد برای تخفیف عمومی نیست.",topic:"ماده ۳۸"},{q:"معافیت از کیفر (مادهٔ ۳۹) در کدام جرایم ممکن است؟",options:["تعزیری درجه‌های یک تا سه","تعزیری درجه‌های هفت و هشت","تعزیری درجه‌های پنج و شش","همهٔ جرایم"],answer:1,why:"مادهٔ ۳۹: درجه‌های ۷ و ۸ با شرایط چهارگانه (جهت تخفیف، پیش‌بینی اصلاح، فقدان سابقهٔ مؤثر، گذشت و جبران).",topic:"معافیت از کیفر"},{q:"نکتهٔ ۷۰: نهادهای تعلیق تعقیب، تعویق، معافیت از کیفر، تعلیق اجرا، مرور زمان و توبه در کدام جرایم اعمال نمی‌شوند؟",options:["جرایم علیه امنیت","جرایم و تخلفات قانون مبارزه با قاچاق کالا و ارز (مادهٔ ۶۳)","جرایم عفت عمومی","جرایم مالیاتی"],answer:1,why:"مادهٔ ۶۳ قانون مبارزه با قاچاق کالا و ارز: هیچ‌یک از این نهادها در جرایم و تخلفات قاچاق اعمال نمی‌شود.",topic:"معافیت از کیفر"},{q:"تعلیق تعقیب (مادهٔ ۸۱ ق.آ.د.ک) در کدام مرحله و به دست چه مرجعی است؟",options:["بعد از حکم؛ دادگاه","قبل از شروع تعقیب؛ دادستان یا دادگاه (نه بازپرس)","موقع اجرا؛ قاضی اجرای احکام","بعد از احراز مجرمیت؛ بازپرس"],answer:1,why:"نکتهٔ ۷۳: تعلیق تعقیب یعنی صرف‌نظر موقت از تعقیب پیش از شروع آن؛ مرجع دادستان یا دادگاه است.",topic:"تعلیق تعقیب"},{q:"تعویق صدور حکم (مادهٔ ۴۰) در جرایم تعزیری کدام درجه‌ها و چه مدت است؟",options:["درجهٔ ۳ تا ۸؛ ۱ تا ۵ سال","درجهٔ ۶ تا ۸؛ ۶ ماه تا ۲ سال","درجهٔ ۵ تا ۷؛ ۲ تا ۵ سال","همهٔ درجه‌ها؛ ۱ سال"],answer:1,why:"مادهٔ ۴۰: جرایم تعزیری درجهٔ ۶ تا ۸ با چهار شرط و به مدت ۶ ماه تا ۲ سال.",topic:"تعویق صدور حکم"},{q:"تعویق اجرای مجازاتِ شلاق در ایام حیض یا استحاضه مستند به چیست؟ (نکتهٔ ۷۶)",options:["مادهٔ ۴۰ ق.م.ا","مادهٔ ۵۰۱ ق.آ.د.ک","مادهٔ ۴۶ ق.م.ا","مادهٔ ۸۱ ق.آ.د.ک"],answer:1,why:"مادهٔ ۵۰۱: تعویق اجرا در بارداری، پس از زایمان تا شش ماه، شیردهی تا دو سالگی و شلاق در ایام حیض/استحاضه؛ مادهٔ ۵۰۲ بیماری.",topic:"تعویق اجرا"},{q:"با صدور قرار تعویق صدور حکم، متهمِ بازداشتی چه می‌شود؟ (تبصرهٔ ۲ مادهٔ ۴۱)",options:["تا پایان تعویق بازداشت می‌ماند","بلافاصله دستور آزادی او صادر می‌شود (با تأمینی که به سلب آزادی نینجامد)","به بازداشت نیمه‌آزاد منتقل می‌شود","فقط با گذشت شاکی آزاد می‌شود"],answer:1,why:"تبصرهٔ ۲ مادهٔ ۴۱: بلافاصله دستور آزادی؛ تأمینِ اخذشده هم نباید به سلب آزادی بینجامد.",topic:"تعویق صدور حکم"},{q:"تعلیق اجرای مجازات (مادهٔ ۴۶) در کدام جرایم و چه مدت ممکن است؟",options:["درجهٔ ۶ تا ۸؛ ۶ ماه تا ۲ سال","درجهٔ ۳ تا ۸؛ ۱ تا ۵ سال","درجهٔ ۱ تا ۴؛ ۲ تا ۱۰ سال","درجهٔ ۷ و ۸؛ تا ۳ سال"],answer:1,why:"مادهٔ ۴۶: جرایم تعزیری درجهٔ ۳ تا ۸ و تعلیقِ تمام یا قسمتی از مجازات برای ۱ تا ۵ سال.",topic:"تعلیق اجرا"},{q:"تخلف از دستورهای دادگاه در دورهٔ تعلیق، بار دوم چه پیامدی دارد؟ (مادهٔ ۵۰)",options:["افزودن یک سال","افزودن دو سال","الغای قرار تعلیق و اجرای مجازات","تبدیل به جزای نقدی"],answer:2,why:"مادهٔ ۵۰: بار اول +۱ تا ۲ سال یا لغو؛ بار دوم لغو و اجرای مجازات.",topic:"تعلیق اجرا"},{q:"کدام گزینه دربارهٔ مادهٔ ۴۷ درست است؟",options:["جرایم علیه امنیت با همکاری مؤثر، تعویق هم می‌پذیرند","رابطهٔ نامشروع (۶۳۸) هم تعویق دارد هم تعلیق","تعلیق جرایم علیه عفت عمومی به‌جز مواد ۶۳۹ و ۶۴۰ بلامانع است","کلاهبرداری در تعویق مطلقاً ممنوع است"],answer:2,why:"تبصرهٔ ۲ مادهٔ ۴۷ و نکته‌های ۷۹ تا ۸۱: امنیتی‌ها فقط تعلیق بخشی با همکاری مؤثر؛ مواد ۶۳۸ و ۶۳۹ تعویق ممنوع ولی تعلیق جایز؛ کلاهبرداری در تعلیق مطلقاً آزاد و در تعویق تا ۱۰۰ میلیون ریال ممکن است.",topic:"ماده ۴۷"},{q:"سایر جرایم اقتصادی (غیر از کلاهبرداری) بالای چه مبلغی غیرقابل تعویق و تعلیق‌اند؟ (نکتهٔ ۸۲)",options:["۵۰ میلیون ریال","یکصد میلیون ریال","پانصد میلیون ریال","یک میلیارد ریال"],answer:1,why:"نکتهٔ ۸۲: بالای ۱۰۰ میلیون ریال غیرقابل تعویق و تعلیق؛ ۱۰۰ میلیون یا کمتر قابل تعویق و تعلیق است.",topic:"ماده ۴۷"},{q:"نکتهٔ ۸۳: ممنوعیت تعلیق در مادهٔ ۱۰ قانون صدور چک (۱۳۷۲) امروز چه وضعی دارد؟",options:["هنوز ممنوع است","با وحدت رویهٔ ۷۷۸ (۱۳۹۸) نسخ ضمنی شده و قابل تعلیق است","فقط برای چک‌های جدید ممنوع است","منوط به نظر بانک است"],answer:1,why:"قوانینِ قبل از ق.م.ا ۹۲ که ممنوعیت داشتند با مادهٔ ۴۷ نسخ ضمنی شده‌اند (رأی وحدت رویهٔ ۷۷۸)؛ ممنوعیت‌های بعد از ۹۲ پابرجاست (نکتهٔ ۸۴).",topic:"وحدت رویه ۷۷۸"},{q:"مثال ۱۱۶: جرم مواد مخدر با حبس ۶ تا ۱۵ سال و حکم به حداقل (۶ سال). نهادهای ارفاقی؟",options:["همه جاری است","همهٔ نهادها به استثنای عفو مقام رهبری ممنوع است","فقط تعلیق ممکن است","فقط آزادی مشروط ممنوع است"],answer:1,why:"تبصرهٔ مادهٔ ۴۵ مواد مخدر: حکم به حداقل در جرایم با حبس بیش از ۵ سال ← همهٔ نهادهای ارفاقی جز عفو رهبری ممنوع.",topic:"مواد مخدر"},{q:"مثال ۱۱۷: همان جرم (۶ تا ۱۵ سال) اما حکم به ۱۰ سال. تعلیق چه وضعی دارد؟",options:["تعلیق کل ممکن است","تعلیق بخشی پس از گذراندن حداقل مجازات قانونی، به مدت ۵ تا ۱۰ سال ممکن است","مطلقاً ممنوع است","فقط پس از نصف ممکن است"],answer:1,why:"حکمِ بالاتر از حداقل ← تعلیقِ بخشی پس از گذراندن حداقل مجازات قانونی به مدت ۵ تا ۱۰ سال؛ تعلیق کل ممنوع.",topic:"مواد مخدر"},{q:"تست ۳۵: حبس چهار ساله از ۱۴۰۵ اجرا می‌شود و جزای نقدیِ تعلیق‌شدهٔ دوساله دارد. پایان تعلیق جزای نقدی؟",options:["۱۴۰۶","۱۴۰۷","۱۴۱۱","۱۴۱۲"],answer:1,why:"مادهٔ ۵۳: مبنای تعلیقِ یکی از مجازات‌ها، زمان اجرای مجازات غیرمعلق (شروع حبس، ۱۴۰۵) است؛ دو سال تا ۱۴۰۷.",topic:"کارگاه تست"},{q:"نیمه‌آزادی (مادهٔ ۵۷) در حبس‌های کدام درجه‌ها از همان ابتدا ممکن است؟",options:["درجه‌های ۱ تا ۳","درجه‌های ۵ تا ۷","درجه‌های ۲ تا ۴","درجه‌های ۶ تا ۸"],answer:1,why:"مادهٔ ۵۷: درجه‌های ۵ تا ۷ از ابتدا؛ درجه‌های ۲ تا ۴ با تبصرهٔ الحاقی و پس از گذراندن یک‌چهارم.",topic:"نیمه‌آزادی"},{q:"آزادی مشروط برای حبس بیش از ده سال پس از تحمل چه کسری ممکن است؟ (مادهٔ ۵۸)",options:["یک‌سوم","نصف","یک‌چهارم","دوسوم"],answer:1,why:"بیش از ده سال ← نصف؛ سایر موارد ← یک‌سوم. و ملاک، مجازات قضایی است (نکتهٔ ۸۵ و مثال ۱۲۲).",topic:"آزادی مشروط"},{q:"کدام مورد تحت هیچ شرایطی امکان آزادی مشروط ندارد؟",options:["حبس درجهٔ پنج","اسیدپاشی و شروع به آن","جزای نقدی","جرم غیرعمدی"],answer:1,why:"مادهٔ ۳ قانون تشدید مجازات اسیدپاشی ۱۳۹۸: اسیدپاشی و شروع به آن تحت هیچ شرایطی آزادی مشروط نمی‌شود.",topic:"آزادی مشروط"},{q:"نظارت الکترونیکی (مادهٔ ۶۲) برای حبس درجه‌های ۲ تا ۴ از کی ممکن است؟",options:["از همان ابتدا","پس از گذراندن یک‌چهارم مجازات حبس (تبصرهٔ ۲)","پس از نصف مجازات","هرگز"],answer:1,why:"تبصرهٔ ۲ مادهٔ ۶۲ (الحاقی ۹۹): درجه‌های ۲ تا ۴ پس از یک‌چهارم؛ درجه‌های ۵ تا ۸ از ابتدا با رضایت محکوم.",topic:"نظارت الکترونیکی"},{q:"دادگاه می‌تواند حداکثر به چند نوع از مجازات‌های جایگزین حبس حکم دهد؟ (تبصرهٔ مادهٔ ۶۴)",options:["یک نوع","دو نوع","سه نوع","بدون محدودیت"],answer:1,why:"تبصرهٔ مادهٔ ۶۴: بیش از دو نوع جایگزین ممکن نیست.",topic:"جایگزین حبس"},{q:"جرم غیرعمدی با حداکثر مجازات قانونی سه سال حبس؛ جایگزین حبس چه وضعی دارد؟ (مادهٔ ۶۸ و مثال ۱۲۶)",options:["الزامی است","اختیاری است؛ در صورت وجود شرایط مادهٔ ۶۴","ممنوع است","فقط دورهٔ مراقبت"],answer:1,why:"غیرعمدی تا حداکثر دو سال الزامی است؛ بالای دو سال، دادگاه در صورت شرایط مادهٔ ۶۴ مخیر است.",topic:"جایگزین حبس"},{q:"مثال ۱۳۱: شلاقِ اجراشدهٔ ۱۴۰۳ (شرب خمر) و جرم جدیدِ ۱۴۰۶ با مجازات یک تا شش ماه حبس. نتیجه؟",options:["جایگزین حبس الزامی است","سابقهٔ مادهٔ ۶۶ مؤثر است و حبس می‌شود","فقط جزای نقدی روزانه","دورهٔ مراقبت الزامی است"],answer:1,why:"شلاق تعزیری از سابقه‌های مادهٔ ۶۶ است و از اجرای ۱۴۰۳ تا ۱۴۰۶ سه سال گذشته (کمتر از پنج سال) ← جایگزین اعمال نمی‌شود.",topic:"ماده ۶۶"},{q:"مثال ۱۳۲: همان فرض اما جرم جدید در ۱۴۰۹ (شش سال پس از اجرا). نتیجه؟",options:["حبس می‌شود","سابقهٔ مؤثر نیست؛ جایگزین حبس الزامی است","اختیاری است","فقط با گذشت شاکی"],answer:1,why:"بیش از پنج سال از اجرای حکم سابق گذشته ← سابقهٔ مادهٔ ۶۶ مؤثر نیست ← جایگزین حبس.",topic:"ماده ۶۶"},{q:"اعمال مجازات جایگزین حبس برای مأمور حفاظتیِ بی‌مبالاتیِ مادهٔ ۵۰۶ (۱ تا ۶ ماه حبس) چه وضعی دارد؟ (مثال ۱۳۹ و مادهٔ ۷۰)",options:["الزامی است","اختیاری است","ممنوع است؛ جرم علیه امنیت است","فقط جزای نقدی روزانه"],answer:2,why:"مادهٔ ۷۰: جرایم علیه امنیت داخلی و خارجی مطلقاً از جایگزین حبس خارج‌اند؛ حتی با مجازات کم.",topic:"جایگزین حبس"},{q:"جرم عمدی با مجازات قانونی بیش از یک سال که با تخفیف به ده ماه حبس حکم شده؛ جایگزین حبس؟ (مادهٔ ۷۳)",options:["ممکن است چون حکم زیر یک سال است","ممکن نیست؛ تخفیفِ زیر یک سال در جرمِ بالای یک سال مجوز جایگزین نمی‌دهد","الزامی است","فقط با گذشت شاکی"],answer:1,why:"مادهٔ ۷۳: در جرایم عمدی بالای یک سال، حتی با تخفیفِ زیر یک سال، جایگزین حبس ممکن نیست.",topic:"جایگزین حبس"},{q:"تعدد جرایم عمدی که مجازات قانونی حداقل یکی از آن‌ها بیش از یک سال حبس است (مادهٔ ۷۲ اصلاحی):",options:["جایگزین حبس ممکن است","مانع صدور حکم به جایگزین حبس است","فقط با رضایت دادستان ممکن است","الزامی است"],answer:1,why:"مادهٔ ۷۲ (اصلاحی ۱۳۹۹/۲/۲۳): تعددِ عمدی با حتی یک جرمِ بالای یک‌ساله، جایگزین حبس را می‌بندد.",topic:"جایگزین حبس"},{q:"مادهٔ ۷۵: همراه بودن سایر مجازات‌ها (مثل شلاق) با حبس چه اثری بر حکم جایگزین حبس دارد؟",options:["ممنوع می‌کند","مانع نیست و حکم همزمان ممکن است","شلاق حذف می‌شود","فقط جزای نقدی روزانه ممکن است"],answer:1,why:"مادهٔ ۷۵: همراهی سایر مجازات‌ها با حبس مانع جایگزین نیست و دادگاه می‌تواند همزمان حکم دهد.",topic:"جایگزین حبس"}]},{id:"pack-tadris-jaza-mcq2",title:"دفترچهٔ تستی — تدریس جزا ۲ (صفحات ۵۱ تا ۱۰۰)",exam:"تدریس جزا (غفوری)",examSlug:"tadris-jaza",branch:"حقوق جزا",description:"دفترچهٔ تستی برگرفته از صفحات ۵۱ تا ۱۰۰ جزوهٔ تدریس جزا احمد غفوری: رأی وحدت رویه، قانون حاکم بر رفتار، قانونی بودن اجرا (مواد ۴۸۵ و ۴۸۶)، مسئولیت شخص حقوقی، تفکیک‌های طلایی، درجات مادهٔ ۱۹، مجازات‌های تبعی و تکمیلی و نحوهٔ اجرا — با پاسخ‌نامهٔ تشریحی.",minutes:35,passMark:70,kind:"mcq",questions:[{q:"بر اساس نکتهٔ ۴۰ جزوه، تحقیقات مقدماتیِ جرم ۱۴۰۰ در ۱۴۰۲ تمام شده و قانونِ حق وکیل در ۱۴۰۳ لازم‌الاجرا شده است. متهم:",options:["می‌تواند تحقیقات را با وکیل تکرار کند","نمی‌تواند تقاضای تکرار تحقیقات با وکیل کند؛ مرحله پیش از قانون جدید بسته شده","فقط در جرم حدی حق وکیل دارد","حق وکیل او از زمان جرم محفوظ بوده است"],answer:1,why:"قوانین ناظر به مراحل رسیدگی فوری‌اند؛ ملاک زمانِ انجام مرحله است (حالت اول نکتهٔ ۴۰). اگر تحقیقات از ۱۴۰۵ آغاز می‌شد، حق وکیل کامل بود.",topic:"اجرای فوری"},{q:"مثال ۵۸: جرم «الف» در ۱۴۰۰ با مرور زمان تعقیب پنج‌ساله؛ قانون ۱۴۰۶ مرور زمان را ده سال کرده. وضعیت در ۱۴۰۸؟",options:["جرم «الف» قابل رسیدگی است چون قانون جدید طولانی‌تر است","جرم «الف» مشمول مرور زمان شده (در ۱۴۰۵ شمول یافته) و قابل رسیدگی نیست","جرم «الف» تا ۱۴۱۰ قابل تعقیب است","برای رسیدگی باید رضایت شاکی باشد"],answer:1,why:"مرور زمان در ۱۴۰۵ — قبل از قانون لاحق — شمول یافته؛ حکم قانون سابق محقق شده و قانون ده‌ساله به آن تعلق نمی‌گیرد (برخلاف جرم «ب» ۱۴۰۲).",topic:"مرور زمان"},{q:"تبصرهٔ ۲ مادهٔ ۲۹۶ ق.آ.د.ک (نکتهٔ ۴۱) دربارهٔ جرمی که قبل از قانون جدید ثبت شده چه می‌گوید؟",options:["صلاحیتش تابع مقررات زمان ثبت است؛ سایر مقررات رسیدگی طبق قانون جدید در همان شعبه انجام می‌شود","صلاحیت و سایر مقررات هر دو تابع قانون جدید است","پرونده موقوف می‌شود","صلاحیت با نظر دیوان عالی تعیین می‌شود"],answer:0,why:"نکتهٔ ۴۱: جرایمِ ثبت‌شده از نظر صلاحیت تابع زمانِ ثبت‌اند؛ سایر مقررات رسیدگی طبق قانون جدید در همان شعب مرتبط اجرا می‌شود.",topic:"صلاحیت"},{q:"جرم «به عادت» در چه صورتی تابع قانون لاحق است؟ (نکتهٔ ۴۲)",options:["همیشه","فقط اگر رفتار تشکیل‌دهندهٔ عادت به اندازهٔ کافی در زمان حکومت قانون لاحق هم تحقق یافته باشد","اگر قانون لاحق مساعد باشد","هرگز"],answer:1,why:"نکتهٔ ۴۲ و مثال ۵۹: پنجاه بار تکدیِ قبل از جرم شدن + یک بار بعد، مجازات نمی‌آورد؛ عادت باید در زمانِ لاحق کامل شود.",topic:"قانون حاکم بر رفتار"},{q:"مثال ۶۰: نگهداری مواد مخدر از ۱۴۰۳ (مجازات ۱ تا ۳ سال) که پس از تغییر قانون در ۱۴۰۵ (۲ تا ۵ سال) ادامه می‌یابد. تابع کدام قانون است؟",options:["قانون سابق؛ چون شروع جرم قبل از تغییر بوده","قانون لاحق؛ چون جرم مستمر در زمان قانون جدید ادامه یافته، چه به نفع و چه به ضرر متهم","قانون مساعد به متهم","با توافق قاضی و متهم"],answer:1,why:"نکتهٔ ۴۲: جرم مستمر با ادامهٔ رفتار تازه می‌شود؛ قانون لاحق مطلقاً اعمال می‌شود.",topic:"قانون حاکم بر رفتار"},{q:"در جرم مرکب (مثال ۶۱: فریب در مرداد، تغییر قانون در شهریور، بردن مال در مهر) مجازات با کدام قانون تعیین می‌شود؟",options:["قانون سابق؛ چون عمل اول قبل از تغییر بوده","قانون لاحق؛ چون آخرین جزء در زمان حاکمیت قانون لاحق ارتکاب یافته — مطلقاً","قانون سابق فقط اگر به نفع متهم باشد","موضوع به نظر دیوان عالی است"],answer:1,why:"نکتهٔ ۴۲: اگر آخرین جزء جرم مرکب در زمان لاحق باشد، مطلقاً — چه به نفع چه به ضرر — قانون لاحق اعمال می‌شود.",topic:"قانون حاکم بر رفتار"},{q:"رأی وحدت رویه در امور حقوقی نسبت به حکم قطعی:",options:["قبل از حکم قطعی مؤثر است و بعد از آن مؤثر نیست","در هر زمان مؤثر است","فقط با تأیید رئیس قوه قضائیه مؤثر است","فقط به نفع محکوم مؤثر است"],answer:0,why:"قاعدهٔ جزوه: در حقوقی، رأی وحدت رویه بعد از حکم قطعی به‌هیچ‌وجه مؤثر نیست (برخلاف کیفری که استثنای «به نفع محکوم» دارد).",topic:"رأی وحدت رویه"},{q:"حالت چهارم مثال ۶۲: حکم قطعی برائت در ۱۴۰۵ و رأی وحدت رویهٔ «جرم بودن» در ۱۴۰۶. نتیجه؟",options:["الف دوباره محاکمه می‌شود","نمی‌توان «الف» را دوباره محاکمه یا مجازات کرد","فقط دیه قابل مطالبه است","پرونده به اعادهٔ دادرسی می‌رود"],answer:1,why:"رأی وحدت رویهٔ بعد از قطعیت و به ضرر محکوم، مؤثر نیست؛ برائتِ قطعی پابرجا می‌ماند.",topic:"رأی وحدت رویه"},{q:"تست ۱۳ (ارشد ۱۴۰۰): فرار از زندان ۱۳۹۷ + توقیف غیرقانونی که تا لحظهٔ دستگیری ادامه داشته؛ قانون لاحق مجازات هر دو را افزایش داده:",options:["هر دو لاحق","هر دو سابق","فرار = سابق (استمراریافته/در حکم آنی)؛ توقیف = لاحق (مستمر و ادامه‌دار)","فرار = لاحق؛ توقیف = سابق"],answer:2,why:"فرار از زندان عنصر مادی لحظه‌ای دارد (نکتهٔ ۹/۳) → قانون زمان وقوع؛ توقیف غیرقانونی مستمر است و تا آزادی ادامه داشته → قانون لاحق.",topic:"کارگاه تست"},{q:"تست ۱۴ (وکلا ۹۸): با تخفیف مجازات در قانون لاحق، محکوم از چه مرجعی تقاضای تخفیف می‌کند؟",options:["دیوان عالی کشور با اعادهٔ دادرسی","دادگاه تجدیدنظر استان","دادگاه صادرکنندهٔ حکم قطعی (بند ب مادهٔ ۱۱)","دادستان کل کشور"],answer:2,why:"بند ب مادهٔ ۱۱: «محکوم نیز می‌تواند از دادگاه صادرکنندهٔ حکم، تخفیف مجازات را تقاضا نماید».",topic:"حکم قطعی"},{q:"تست ۱۵ (ارشد ۹۹): شکایتِ بعد از مرور زمانِ ۳ ساله؛ قانون لاحق مهلت را ۷ سال کرده. مبنا؟",options:["مرتکب قابل تعقیب نیست","اجرای فوری مقررات مرور زمان — مقررات شکلی طبق قانون لاحق اجرا می‌شود","فقط در جرم غیرقابل‌گذشت رسیدگی می‌شود","منوط به ابلاغ رأی سابق است"],answer:1,why:"مرور زمان از مقررات ناظر به رسیدگی است و طبق مادهٔ ۱۱ فوراً اجرا می‌شود؛ شکایت ۴ ساله با قانون ۷ ساله پذیرفته می‌شود.",topic:"کارگاه تست"},{q:"نکتهٔ ۴۳: مادهٔ ۱۲ ق.م.ا به کدام بحث اشاره دارد؟",options:["قانونی بودن اجرای مجازات","درجات مجازات","شخصی بودن مجازات","مسئولیت مدنی قاضی"],answer:0,why:"جزوه می‌گوید مادهٔ ۱۲ به قانونی بودنِ «اجرای» مجازات اشاره دارد: حکم و اجرا باید از طریق دادگاه صالح، به موجب قانون و با رعایت شرایط و کیفیت باشد.",topic:"قانونی بودن"},{q:"طبق مادهٔ ۱۳، هرگونه صدمه و خسارت ناشی از تجاوز به میزان/کیفیت مجازات در صورت نبودِ عمد و تقصیر:",options:["بر عهدهٔ مجری حکم است","از بیت‌المال جبران می‌شود","ساقط است","بر عهدهٔ قاضی صادرکننده است"],answer:1,why:"ذیل مادهٔ ۱۳: عمد یا تقصیر → مسئولیت کیفری یا مدنی؛ در غیر این صورت خسارت از بیت‌المال جبران می‌شود.",topic:"مادهٔ ۱۳"},{q:"در مادهٔ ۴۸۵ اگر آسیب اضافی «مستند به محکوم‌علیه» باشد:",options:["مأمور اجرا به قصاص محکوم می‌شود","ضمان منتفی است (قصاص، دیه و تعزیر ساقط است)","بیت‌المال دیه می‌پردازد","فقط مسئولیت مدنی دارد"],answer:1,why:"ردیف ۳ جدول نکتهٔ ۴۴: آسیبِ ناشی از فعل خودِ محکوم‌علیه ضمان را منتفی می‌کند.",topic:"مادهٔ ۴۸۵"},{q:"در مادهٔ ۴۸۵، آسیب اضافی بدون عمد و تقصیرِ مأمور و بدون استناد به محکوم‌علیه در «تعزیرات»:",options:["ضمان منتفی است","دیه از بیت‌المال پرداخت می‌شود","مأمور نصف دیه می‌پردازد","در قصاص هم دیه از بیت‌المال است"],answer:1,why:"ردیف ۴ نکتهٔ ۴۴: در قصاص و حد ضمان منتفی است ولی در تعزیرات دیه از بیت‌المال پرداخت می‌شود.",topic:"مادهٔ ۴۸۵"},{q:"در مادهٔ ۴۸۶ اگر عدم صحت حکم ثابت شود و قاضی عمد داشته باشد:",options:["فقط دیه از بیت‌المال پرداخت می‌شود","قاضی به قصاص یا تعزیر مقرر در تعزیرات و بازگرداندن دیه به بیت‌المال محکوم می‌شود","قاضی فقط دیه از جیب خود می‌پردازد","ضمان منتفی است"],answer:1,why:"متن مادهٔ ۴۸۶ و ردیف ۱ نکتهٔ ۴۵: قاضیِ عامد ضامن است و به قصاص/تعزیر + بازگرداندن دیه به بیت‌المال محکوم می‌شود.",topic:"مادهٔ ۴۸۶"},{q:"در سؤال آزمونی که مطلقاً گفته صدمه‌ای به محکوم‌علیه وارد شده (بدون ذکر مرحلهٔ صدور یا اجرا)، پاسخ بر اساس نکتهٔ ۴۶ کدام است؟",options:["مادهٔ ۱۳: عمد یا تقصیر → مسئولیت کیفری یا مدنی؛ بدون عمد و تقصیر → دیه از بیت‌المال","همیشه بیت‌المال","همیشه مجری حکم","همیشه قاضی صادرکننده"],answer:0,why:"نکتهٔ ۴۶: صورتِ مطلق سؤال یعنی مادهٔ ۱۳؛ عمد/تقصیر → مسئولیت کیفری یا مدنی، بدون آن‌ها → بیت‌المال.",topic:"مادهٔ ۱۳"},{q:"بر اساس تبصرهٔ مادهٔ ۱۴، نسبت به شخص حقوقی در فرض احراز رابطهٔ علیت:",options:["هیچ مجازاتی قابل اعمال نیست","دیه و خسارت قابل مطالبه است و تعزیر مطابق مادهٔ ۲۰ اعمال می‌شود","فقط حد اعمال می‌شود","فقط قصاص اعمال می‌شود"],answer:1,why:"تبصرهٔ مادهٔ ۱۴: با رابطهٔ علیت، دیه و خسارت قابل مطالبه است؛ مجازات تعزیری شخص حقوقی هم طبق مادهٔ ۲۰ است.",topic:"شخص حقوقی"},{q:"شرط مسئولیت کیفری شخص حقوقی در مادهٔ ۱۴۳ چیست؟",options:["هر عضو آن جرم زند","نمایندهٔ قانونی به نام یا در راستای منافع شخص حقوقی جرم کند؛ مگر ثابت شود تصمیم‌گیری/نظارت با شخص حقیقی دیگری بوده","فقط با سابقهٔ کیفری مدیر","فقط در جرایم مالیاتی"],answer:1,why:"مادهٔ ۱۴۳: جرم باید «به نام یا در راستای منافع» نهاد باشد؛ اثباتِ تصمیم‌گیر واقعیِ دیگر، مسئولیت نهاد را می‌بُرد.",topic:"شخص حقوقی"},{q:"مجازات‌های شخص حقوقی طبق مادهٔ ۲۰:",options:["هر هفت مورد با هم","یک یا دو مورد از فهرست (انحلال، مصادرهٔ کل، ممنوعیت‌ها، جزای نقدی، انتشار حکم)","فقط جزای نقدی","حبس تا پنج سال برای مدیر"],answer:1,why:"مادهٔ ۲۰: به «یک یا دو مورد» از فهرست محکوم می‌شود؛ شدیدترین‌ها انحلال و مصادرهٔ کل (درجهٔ یک) هستند که مادهٔ ۲۲ قیدشان می‌زند.",topic:"شخص حقوقی"},{q:"جزای نقدی شخص حقوقی طبق مادهٔ ۲۱ چه ضریبی دارد؟",options:["نصف تا یک برابر","حداقل دو برابر و حداکثر چهار برابر مبلغِ شخص حقیقی","دقیقاً سه برابر","ده برابر"],answer:1,why:"مادهٔ ۲۱: حداقل دو برابر و حداکثر چهار برابر مبلغی که برای شخص حقیقی در قانون آمده است.",topic:"شخص حقوقی"},{q:"انحلال شخص حقوقی و مصادرهٔ اموال طبق مادهٔ ۲۲ در چه صورتی اعمال می‌شود؟",options:["در هر جرم مهم","اگر برای ارتکاب جرم به وجود آمده یا با انحراف از هدف مشروع، فعالیتش را منحصراً در جهت جرم تغییر داده باشد","فقط با درخواست دادستان","فقط در جرایم رایانه‌ای"],answer:1,why:"مادهٔ ۲۲ و نکته‌های ۵۳-۵۴: انحلال/مصادره مخصوص «نهادِ جرم‌زاده» است؛ در غیر این صورت سایر مجازات‌های مادهٔ ۲۰ اعمال می‌شود.",topic:"شخص حقوقی"},{q:"مثال ۷۳: شعبهٔ اصفهانِ شرکتی با مرکزیت تهران جرم می‌زند. مسئولیت با کیست؟",options:["فقط مرکزیت اصلی","فقط شعبهٔ اصفهان؛ مگر بر اساس تصمیم مرکزیت اصلی باشد که آن‌گاه هر دو مسئول‌اند","هر دو در هر حال","هیچ‌کدام"],answer:1,why:"مادهٔ ۶۹۴ ق.آ.د.ک: مسئولیت با شعبهٔ منتسب است؛ اقدام بر اساس تصمیمِ مرکزیت، مرکزیت را هم مسئول می‌کند.",topic:"شخص حقوقی"},{q:"تفاوت جزای نقدی با ضرر و زیان ناشی از جرم (نکتهٔ ۴۷):",options:["جزای نقدی به بزه‌دیده می‌رسد؛ ضرر و زیان به دولت","جزای نقدی امری جزایی و متعلق به دولت است؛ ضرر و زیان امری حقوقی و جبرانِ خسارتِ بزه‌دیده است","هیچ تفاوتی ندارند","جزای نقدی فقط در جرایم حدی است"],answer:1,why:"نکتهٔ ۴۷: جزای نقدی کیفری و برای دولت است (م ۶۳۵)؛ ضرر و زیان حقوقی و برای بزه‌دیده؛ دیه هم مجازات است هم جبران.",topic:"تفکیک مجازات‌ها"},{q:"رجم (سنگسار) فقط در کدام جرم اعمال می‌شود؟ (نکتهٔ ۴۸)",options:["قتل عمدی","زنای محصنه","محاربه","لواط"],answer:1,why:"رجم فقط در زنای محصنه است؛ قصاص نفس با درخواست اولیای دم است و اعدام برای سایر موارد (زنای به عنف، افساد فی‌الارض، محاربه، لواط و...) بدون نیاز به درخواست شخص.",topic:"تفکیک مجازات‌ها"},{q:"تفاوت توقیف با ضبط و مصادرهٔ اموال (نکتهٔ ۴۹):",options:["توقیف دائم است؛ ضبط موقت","توقیف موقتی است؛ در ضبط و مصادره مالکیت به‌طور دائم سلب و مال متعلق به دولت می‌شود","هر دو دائم‌اند","توقیف فقط برای اشخاص حقوقی است"],answer:1,why:"نکتهٔ ۴۹: کلید تمایز «موقت» بودن توقیف در برابر سلبِ دائمی مالکیت در ضبط و مصادره است.",topic:"تفکیک مجازات‌ها"},{q:"مجازات جرمی «شش ماه تا سه سال حبس» در کدام درجه است؟ (تبصرهٔ ۲ مادهٔ ۱۹)",options:["درجهٔ پنج","درجهٔ چهار؛ چون حداکثر در درجهٔ بالاتر است","درجهٔ شش","درجهٔ سه"],answer:1,why:"تبصرهٔ ۲: حداقل (۶ ماه = درجهٔ ۶) و حداکثر (۳ سال = درجهٔ ۴) ← مجازات از درجهٔ بالاتر یعنی ۴ محسوب می‌شود (مثال ۶۳).",topic:"درجات مجازات"},{q:"رأی وحدت رویهٔ ۷۴۴ (نکتهٔ ۵۱) در مقایسهٔ حبس و جزای نقدی چه می‌گوید؟",options:["جزای نقدی ملاک است","حبس ملاک است؛ در مقایسهٔ سایر مجازات‌ها به درجه توجه می‌شود","هر دو با هم ملاک‌اند","شدیدترین از نظر قاضی ملاک است"],answer:1,why:"نکتهٔ ۵۱: مقایسهٔ حبس و جزای نقدی ← حبس ملاک است (رأی ۷۴۴)؛ مقایسهٔ سایر مجازات‌ها ← درجهٔ بالاتر.",topic:"درجات مجازات"},{q:"مثال ۶۸: جرمی با مجازات ۲۰ تا ۷۴ ضربه شلاق و ۲۰۰ تا ۷۰۰ میلیون ریال جزای نقدی. درجه؟",options:["درجهٔ شش (شلاق)","درجهٔ پنج؛ جزای نقدی ۲۰۰ تا ۷۰۰ میلیون ریال در درجهٔ ۵ است","درجهٔ چهار","بی‌درجه"],answer:1,why:"شلاق ۲۰-۷۴ در درجهٔ ۶ است ولی جزای نقدی ۲۰۰-۷۰۰ میلیون ریال در درجهٔ ۵؛ تبصرهٔ ۳ ← درجهٔ بالاتر یعنی ۵.",topic:"درجات مجازات"},{q:"کدام گزینه جزو مجازات‌های «بی‌درجه» بر اساس رأی وحدت رویهٔ ۷۵۹ (نکتهٔ ۵۲) است؟",options:["شلاق تا ده ضربه","جزای نقدی تا ده میلیون ریال","انفصال موقت، کسر از حقوق و جزای نقدی نسبی","حبس تا سه ماه"],answer:2,why:"انفصال موقت، کسر از حقوق و جزای نقدی نسبی با هیچ بند از بندهای هشت‌گانه مطابقت ندارند (رأی ۷۵۹)؛ گزینه‌های دیگر در درجهٔ ۸ تعریف شده‌اند.",topic:"درجات مجازات"},{q:"حبس ابد هم‌اکنون فقط در کدام موارد ممکن است؟ (مثال ۷۲)",options:["محاربه، افساد فی‌الارض، ارتداد","سرقت حدی در مرتبهٔ سوم (بند پ ۲۷۸)، اکراه در قتل عمدی (۳۷۵)، ممسک در قتل (۱۲۷)","قتل عمد، جاسوسی، اسیدپاشی","هر جرم درجهٔ یک تعزیری"],answer:1,why:"مثال ۷۲: سه مورد = سرقت حدی مرتبهٔ سوم (بند پ مادهٔ ۲۷۸)، اکراه در قتل عمدی (مادهٔ ۳۷۵ و تبصرهٔ ۲)، ممسک در قتل (مادهٔ ۱۲۷ و موازین فقهی).",topic:"حبس ابد"},{q:"مجازات تکمیلی در کدام جرایم تجویز شده است؟ (تست ۱۸)",options:["حدود، قصاص و تمام جرایم عمدی تعزیری","حدود، قصاص و فقط جرایم تعزیری درجهٔ یک تا شش","حدود، قصاص و تمام جرایم تعزیری","حدود، قصاص، دیات و تعزیرات"],answer:2,why:"صدر مادهٔ ۲۳: محکوم به «حد، قصاص یا مجازات تعزیری»؛ دیات ذکری از ماده ندارد.",topic:"مجازات تکمیلی"},{q:"طبق مادهٔ ۲۴، اولین تخلف از مجازات تکمیلی چه پیامدی دارد؟",options:["تبدیل بقیه به حبس","با پیشنهاد قاضی اجرای احکام، مدت تکمیلی تا یک‌سوم افزایش می‌یابد","موقوفی تعقیب","جریمهٔ ثابت"],answer:1,why:"مادهٔ ۲۴ و مثال ۷۷: بار اول + تا یک‌سوم؛ تکرار ← جزای نقدی یا حبس درجهٔ ۷/۸ و اجرای نشدن باقی‌مانده؛ امکان لغو/کاهش هم هست.",topic:"مجازات تکمیلی"},{q:"محکومیت قطعی به حبس درجهٔ چهار، مجازات تبعی چند ساله دارد؟ (مادهٔ ۲۵)",options:["دو سال","سه سال","هفت سال","بدون تبعی"],answer:1,why:"بند ب مادهٔ ۲۵: سه سال برای قطع عضو، قصاص عضو با دیهٔ بیش از نصف، نفی بلد و «حبس تا درجهٔ چهار».",topic:"مجازات تبعی"},{q:"محکوم به دو سال حبس درجهٔ شش (مثلاً کلاهبرداری — تست ۳۰ و ۳۱) چه وضعی در مجازات تبعی دارد؟",options:["دو سال محرومیت","سه سال محرومیت","هیچ محرومیت تبعی ندارد؛ فقط ثبت در پیشینه (تبصرهٔ ۱)","هفت سال محرومیت"],answer:2,why:"مادهٔ ۲۵ فقط تا حبس درجهٔ ۵ را گرفته؛ درجهٔ ۶ به پایین تبعی ندارند و محکومیت فقط در پیشینه ثبت و در گواهی‌ها منعکس نمی‌شود.",topic:"مجازات تبعی"},{q:"در تست ۲۲ (اعدام → عفو به ۶ سال حبس در ۱۴۰۲؛ پایان حبس ۱۴۰۸) محرومیت از حقوق اجتماعی تا کی ادامه دارد؟",options:["تا ۱۴۰۸","تا ۱۴۰۹؛ هفت سال از «زمان عفو» (بند الف)","تا ۱۴۱۲","دائمی"],answer:1,why:"تبصرهٔ ۳ مادهٔ ۲۵: در عفو، مدت تبعی از زمان عفو محاسبه می‌شود؛ مجازات اصلیِ اعدام معادل بند الف (۷ سال) است ← ۱۴۰۲+۷=۱۴۰۹.",topic:"کارگاه تست"},{q:"در تست ۲۷ (تصادف رانندگی «غیرعمدی» با ۳ سال حبس) نتیجه چیست؟",options:["سه سال محرومیت","دو سال محرومیت","هیچ مجازات تبعی ندارد؛ چون مادهٔ ۲۵ فقط جرایم عمدی را می‌گیرد","هفت سال محرومیت"],answer:2,why:"صدر مادهٔ ۲۵: «محکومیت قطعی کیفری در جرایم عمدی»؛ جرم غیرعمدی اصلاً تبعی ندارد.",topic:"کارگاه تست"},{q:"بر اساس تبصرهٔ ۳ مادهٔ ۲۵، در آزادی مشروط اثر تبعی محکومیت:",options:["از لحظهٔ صدور آزادی مشروط رفع می‌شود","پس از اتمام مدت آزادی مشروط رفع می‌شود و در مدت آن هم محکوم محروم است","هرگز رفع نمی‌شود","فقط با گذشت بزه‌دیده رفع می‌شود"],answer:1,why:"تبصرهٔ ۳: رفع اثر پس از اتمام مدت آزادی مشروط؛ و محکوم در مدت آزادی مشروط و زمان اجرای حکم هم از حقوق اجتماعی محروم است.",topic:"مجازات تبعی"},{q:"هر روز بازداشت قبلی برای «شلاق تعزیری» چگونه محاسبه می‌شود؟ (مادهٔ ۲۷)",options:["معادل دو ضربه کسر","معادل یک ضربه کسر","قابل احتساب نیست","نصف روز"],answer:1,why:"مثال ۸۲: ۱۰ روز بازداشت از ۷۰ ضربهٔ تعزیری کسر می‌شود ← ۶۰ ضربه؛ شلاق «حدی» است که اصلاً احتساب نمی‌شود (مثال ۸۴).",topic:"نحوهٔ اجرا"},{q:"بازداشت قبلی برای «شلاق حدی» چه وضعی دارد؟ (مادهٔ ۲۷)",options:["روزبه‌روز کسر می‌شود","قابل احتساب نیست و شلاق کامل اجرا می‌شود","نصف آن محاسبه می‌شود","به جزای نقدی تبدیل می‌شود"],answer:1,why:"مادهٔ ۲۷ و مثال ۸۴: برای شلاق حدی بازداشت قبلی قابل احتساب نیست؛ ۸۰ ضربهٔ حدی کامل اجرا می‌شود.",topic:"نحوهٔ اجرا"},{q:"کدام گزینه فاقد «محکومیت مؤثر کیفری» است؟ (نکتهٔ ۵۸)",options:["کسی که در حال گذراندن مجازات تبعی است","کسی که محکوم شده ولی مجازاتش تبعی ندارد؛ و کسی که مدت تبعی‌اش تمام شده","کسی که حبس او در جریان است","کسی که تبعی او تازه شروع شده"],answer:1,why:"محکومیت مؤثر فقط در «حال گذراندن مجازات تبعی» است؛ محکومِ بی‌تبعی و کسی که مدت تبعی‌اش تمام شده مؤثر ندارند.",topic:"اعادهٔ حیثیت"}]},{id:"pack-tadris-jaza-mcq",title:"دفترچهٔ تستی — تدریس جزا (کلیات جزا)",exam:"تدریس جزا (غفوری)",examSlug:"tadris-jaza",branch:"حقوق جزا",description:"دفترچهٔ تستی جامع برگرفته از جزوهٔ تدریس جزا احمد غفوری (صفحات ۱ تا ۵۰): کلیات قانون مجازات، اصل قانونی بودن، عناصر مادی و روانی جرم، پنج اصل صلاحیت (مواد ۳ تا ۹) و قلمرو زمان (مواد ۱۰ و ۱۱) — با پاسخ‌نامهٔ تشریحی سؤال‌به‌سؤال.",minutes:40,passMark:70,kind:"mcq",questions:[{q:"قانون مجازات اسلامی بر اساس مادهٔ ۱ مشتمل بر چیست؟",options:["فقط جرایم و مجازات‌های آن‌ها","جرایم و مجازات‌ها، شرایط و موانع مسئولیت کیفری و قواعد حاکم بر آن‌ها","فقط حدود و قصاص","جرایم حدی و تعزیری بدون قواعد حاکم"],answer:1,why:"مادهٔ ۱: «قانون مجازات اسلامی مشتمل بر جرایم و مجازات‌ها، شرایط و موانع مسؤولیت کیفری و قواعد حاکم بر آن‌ها است.»",topic:"کلیات"},{q:"کدام گزینه مواعد صحیح پنج کتاب قانون مجازات را نشان می‌دهد؟",options:["کلیات ۱-۲۱۶؛ حدود ۲۱۷-۲۸۸؛ قصاص ۲۸۹-۴۴۷؛ دیات ۴۴۸-۷۲۸؛ تعزیرات ۴۹۸-۷۸۵","کلیات ۱-۲۱۷؛ حدود ۲۱۸-۲۸۹؛ قصاص ۲۹۰-۴۴۸؛ دیات ۴۴۹-۷۲۹؛ تعزیرات ۴۹۹-۷۸۵","کلیات ۱-۲۰۰؛ حدود ۲۰۱-۲۸۸؛ قصاص ۲۸۹-۴۴۷؛ دیات ۴۴۸-۷۴۷؛ تعزیرات ۷۴۸-۷۸۵","کلیات ۱-۱۶۶؛ حدود ۱۶۷-۲۸۸؛ قصاص ۲۸۹-۴۴۷؛ دیات ۴۴۸-۷۲۸؛ تعزیرات ۷۲۹-۷۸۵"],answer:0,why:"طبق جزوه: کلیات ۱ تا ۲۱۶، حدود ۲۱۷ تا ۲۸۸، قصاص ۲۸۹ تا ۴۴۷، دیات ۴۴۸ تا ۷۲۸ و تعزیرات ۴۹۸ تا ۷۸۵ ق.م.ا.ت (۱۳۷۵ و ۱۳۸۸).",topic:"کلیات"},{q:"کدام گزینه جزء سیزده جرم حدی فهرست جزوه نیست؟",options:["تفخیذ","قوادی","بغی","خیانت در امانت"],answer:3,why:"خیانت در امانت جرم تعزیری است (مادهٔ ۶۷۴ ق.م.ا.ت)؛ فهرست ۱۳ جرم حدی: زنا، لواط، تفخیذ، مساحقه، قوادی، قذف، سبّ النبی، مصرف مسکر، سرقت حدی، محاربه، بغی، افساد فی‌الارض، ارتداد.",topic:"حدود"},{q:"بر اساس مادهٔ ۲ ق.م.ا، جرم عبارت است از:",options:["هر رفتاری خلاف شرع","هر رفتاری اعم از فعل یا ترک فعل که در قانون برای آن مجازات تعیین شده است","فقط فعل مثبت دارای مجازات قانونی","رفتاری که دادگاه آن را زیانبار بداند"],answer:1,why:"مادهٔ ۲ صریحاً «اعم از فعل یا ترک فعل» را می‌گیرد؛ شرط، تعیین مجازات در قانون است.",topic:"عنصر قانونی"},{q:"سه نتیجهٔ اصل قانونی بودن جرم و مجازات کدام‌اند؟",options:["تفسیر موسع، عطف به ماسبق شدن، جواز قیاس","تفسیر مضیق، عطف به ماسبق نشدن، ممنوعیت قیاس","تفسیر مضیق، اجرای فوری، شخصی بودن","قضایی بودن، سرزمینی بودن، قانونی بودن"],answer:1,why:"نکتهٔ ۲ جزوه: ۱) تفسیر مضیق (محدود) قوانین جزایی ۲) عطف به ما سبق نشدن قوانین کیفری ۳) ممنوعیت قیاس.",topic:"اصل قانونی بودن"},{q:"بر اساس نکتهٔ ۳ جزوه، تفسیر مضیق یعنی:",options:["گسترش ماده به مصادیق مشابه","شامل کمترین مصادیق ممکن دانستن ماده؛ در شک بین یک یا دو رفتار، فقط یک رفتار جرم است","تفسیر ماده بر اساس هدف قانونگذار","تفسیر ماده با رأی وحدت رویه"],answer:1,why:"نکتهٔ ۳: به کمترین مصادیق ممکن تمسک می‌کنیم؛ مثلاً اگر شک کنیم ماده یک رفتار را جرم دانسته یا دو رفتار را، فرض بر یک رفتار است.",topic:"تفسیر مضیق"},{q:"در مثال ۲ جزوه، برای جرم درجه هفتِ سال ۱۳۹۸ و صدور رأی در ۱۴۰۰، مجازات تکمیلیِ قانون ۱۱ تیر ۹۹:",options:["قابل اعمال است چون مساعد است","قابل اعمال است چون قاضی مختار است","قابل اعمال نیست؛ چون قانون فقط به رفتارهای پس از لازم‌الاجراشدن تعلق می‌گیرد","فقط با رضایت متهم قابل اعمال است"],answer:2,why:"نکتهٔ ۴ و مثال ۲: عطف به ماسبق نشدن؛ امکان مجازات تکمیلی درجات ۷ و ۸ محصول قانون ۱۳۹۹ است و به جرمِ ۱۳۹۸ تعلق نمی‌گیرد.",topic:"عطف به ماسبق"},{q:"قیاس ممنوع در قوانین جزایی (نکتهٔ ۵) یعنی:",options:["مقایسهٔ مجازات دو جرم مشابه","مشمول ساختن رفتاری که در ماده ذکر نشده به استناد اشتراک علت با رفتار ذکرشده","تفسیر مضیق ماده","استناد به فتاوی معتبر در سکوت قانون"],answer:1,why:"نکتهٔ ۵: قیاس یعنی با استناد به اشتراک «علت» حکم، رفتارِ ذکرنشده را هم مشمول ماده بدانیم؛ نمونه: توسعهٔ محاربه (۲۷۹) به هر رفتار ناامن‌کننده.",topic:"ممنوعیت قیاس"},{q:"بر اساس نکتهٔ ۶ جزوه، تفسیر موسع و قیاس و عطف به ماسبق فقط در کدام قوانین مجاز است؟",options:["همهٔ قوانین جزایی","قوانین مساعد به حال متهم یا مجرم و قوانین شکلی و تفسیری","فقط قوانین حدود","فقط قوانین شکلی"],answer:1,why:"دو مورد جواز: ۱) قوانین مساعد به حال متهم/مجرم ۲) قوانین شکلی و تفسیری؛ در قوانین ماهوی کیفری این ابزارها ممنوع‌اند.",topic:"استثناهای اصل قانونی بودن"},{q:"تعریف قوانین مساعد (نکتهٔ ۷) کدام است؟",options:["قوانینی که شرایط رسیدگی را تعیین می‌کنند","قوانینی که باعث مجازات نشدن یا عدم اجرای مجازات یا کاهش مقدار مجازات و... می‌شوند","قوانینی که مادهٔ قبلی را تفسیر می‌کنند","قوانینی که جرایم جدید را تعریف می‌کنند"],answer:1,why:"قانون مساعد وضع مرتکب را بهتر می‌کند: مجازات نشدن، عدم اجرا یا کاهش؛ تعریف قوانین شکلی گزینهٔ (الف) و تفسیری گزینهٔ (ج) است.",topic:"قوانین مساعد"},{q:"در مثال ۵ جزوه، مجازات خیانت در امانت برای جرمِ ۱۳۹۸ که در ۱۴۰۰ رأی صادر می‌شود چگونه تعیین می‌شود؟",options:["طبق قانون سابق: ۶ ماه تا ۳ سال","طبق قانون جدید: ۳ ماه تا ۱.۵ سال؛ چون قانون کاهش‌دهنده مساعد است و عطف به ماسبق می‌شود","میانگین دو قانون","طبق قانون سابق؛ مگر قاضی تخفیف دهد"],answer:1,why:"قوانین مساعد عطف به ماسبق می‌شوند؛ کاهش از ۶ ماه تا ۳ سال به ۳ ماه تا ۱.۵ سال مساعد است و قاضی در ۱۴۰۰ طبق قانون جدید حکم می‌دهد.",topic:"قوانین مساعد"},{q:"مادهٔ ۲۸۰ ق.آ.د.ک در مثال ۶ جزوه چه قاعده‌ای را نشان می‌دهد؟",options:["عنوان کیفرخواست برای دادگاه الزام‌آور است","عنوان اتهامی کیفرخواست مانع تعیین عنوان صحیح قانونی توسط دادگاه نیست — جواز تفسیر موسع در قوانین شکلی","کیفرخواست باید قبل از صدور رأی اصلاح شود","دادستان تعیین‌کنندهٔ نهایی عنوان جرم است"],answer:1,why:"مادهٔ ۲۸۰ شکلی است و دامنهٔ گسترده به دادگاه می‌دهد؛ نمونهٔ جواز تفسیر موسع در قوانین شکلی.",topic:"قوانین شکلی"},{q:"طبق مادهٔ ۴۴۲ ق.آ.د.ک و رأی وحدت رویهٔ ۷۵۶، اسقاط حق تجدیدنظرخواهی با کسر یک‌چهارم مجازات:",options:["فقط حق تجدیدنظر را اسقاط می‌کند","حق فرجام‌خواهی را نیز اسقاط می‌کند","فقط در جرایم حدی ممکن است","نیازمند موافقت دادستان است"],answer:1,why:"مادهٔ ۴۴۲: رسیدگی فوق‌العاده با حضور دادستان و کسر یک‌چهارم مجازات و قطعیت؛ رأی وحدت رویهٔ ۷۵۶ حکم را شامل اسقاط حق فرجام‌خواهی هم می‌داند.",topic:"قوانین شکلی"},{q:"کدام گزینه از انواع «ماهیت رفتار ارتکابی» در نکتهٔ ۹/۱ نیست؟",options:["فعل","ترک فعل","حالت","انگیزه"],answer:3,why:"چهار حالت ماهیت رفتار: فعل، ترک فعل، فعل ناشی از ترک فعل و حالت؛ انگیزه به بحث روانی/مبانی مربوط است.",topic:"عنصر مادی"},{q:"کلاهبرداری در تقسیم‌بندی اجزای تشکیل‌دهنده چه نوع جرمی است؟",options:["ساده","به عادت","مرکب (توسل به وسایل متقلبانه + بردن مال غیر)","حالت"],answer:2,why:"نکتهٔ ۹/۲: جرم مرکب از چند فعل متفاوت ساخته می‌شود؛ کلاهبرداری = توسل به وسایل متقلبانه + بردن مال متعلق به غیر.",topic:"عنصر مادی"},{q:"جرم تکدی‌گری (مادهٔ ۲ ق.م.ا.ت) از نظر اجزای تشکیل‌دهنده چه نوع جرمی است؟",options:["مرکب","به عادت (تکرار یک فعل شبیه هم)","ساده","مطلق مرکب"],answer:1,why:"نکتهٔ ۹/۲: جرم به عادت با تکرار یک فعل شبیه هم محقق می‌شود؛ مثال جزوه تکدی است.",topic:"عنصر مادی"},{q:"کدام گزینه مثال جرم «استمراریافته (در حکم آنی)» جزوه است؟",options:["ترک انفاق","حمل اسلحه","تغییر کاربری اراضی (رأی وحدت رویهٔ ۸۲۲)","نگهداری مواد مخدر"],answer:2,why:"استمراریافته: عنصر مادی یک‌لحظه‌ای ولی نتیجهٔ ادامه‌دار؛ مثال‌ها: تغییر کاربری (رأی ۸۲۲)، ساخت‌وساز غیرمجاز، فرار از زندان. ترک انفاق و نگهداری مواد و حمل اسلحه مستمرند.",topic:"امتداد زمانی"},{q:"جرم مطلق یعنی:",options:["جرمی که مجازاتش حبس است","جرمی که صرف رفتار کافی است و نیاز به تحقق نتیجه ندارد","جرمی که فقط با قصد قابل احراز است","جرمی که در همهٔ کشورها جرم است"],answer:1,why:"نکتهٔ ۹/۴: مطلق = صرف رفتار کافی؛ مقید = علاوه بر فعل، تحقق نتیجه لازم است؛ مثل محاربه با شرط «موجب ناامنی گردد».",topic:"مطلق و مقید"},{q:"مادهٔ ۶۰۸ ق.م.ا.ت (توهین از قبیل فحاشی و الفاظ رکیک) چه نوع جرمی است؟",options:["مقید به نتیجه","مطلق","به عادت","غیرعمدی محض"],answer:1,why:"مثال ۸: صرف توهین (فحاشی و الفاظ رکیک) به‌شرط عدم مشمولیت قذف کافی است؛ عبارت «به نحوی که...» در ماده نیست، پس مطلق است.",topic:"مطلق و مقید"},{q:"در مادهٔ ۷۴۵ (انتشار صوت یا تصویر خصوصی) تحقق جرم به چه چیزی گره خورده است؟",options:["صرف انتشار بدون رضایت","انتشار به نحوی که منجر به ضرر یا عرفاً موجب هتک حیثیت شود","انتشار در فضای مجازی به‌طور خاص","انتشار با قصد کسب درآمد"],answer:1,why:"مثال ۱۳: ماده مقید است — «به نحوی که منجر به ضرر یا عرفاً موجب هتک حیثیت او شود»؛ مجازات: حبس ۹۱ روز تا ۲ سال یا جزای نقدی ۲۰ تا ۱۵۰ میلیون ریال یا هر دو.",topic:"مطلق و مقید"},{q:"سوءنیت عام شامل کدام دو رکن است؟",options:["قصد نتیجه و انگیزه","داشتن اراده هنگام ارتکاب جرم و آگاهی به موضوع جرم","علم به قانونی بودن و قصد تخلف","قصد و رضا"],answer:1,why:"سوءنیت عام = اراده هنگام ارتکاب + آگاهی به موضوع جرم (قسمت اول مادهٔ ۱۴۴).",topic:"سوءنیت عام"},{q:"برداشتن مال دیگری با تصور اینکه مال خود اوست (مثال ۱۵) چه وضعیتی دارد؟",options:["سرقت کامل است چون رفتار مادی هست","سوءنیت عام منتفی است؛ چون آگاهی به موضوع (مالِ غیر بودن) نیست","فقط سوءنیت خاص منتفی است","شبه‌عمد است"],answer:1,why:"رکن «آگاهی به موضوع» در سوءنیت عام نیست؛ تصور مالِ خود، علم به برداشتِ مال غیر را از بین می‌برد.",topic:"سوءنیت عام"},{q:"سوءنیت خاص در کدام جرایم موضوعیت دارد؟",options:["همهٔ جرایم عمدی","فقط جرایم مقید به نتیجه (قصد نتیجه)","فقط جرایم غیرعمدی","جرایم مادی صرف"],answer:1,why:"سوءنیت خاص = قصد نتیجه؛ قسمت انتهایی مادهٔ ۱۴۴: تحقق نتیجه باید ناشی از قصد و رفتار مرتکب باشد.",topic:"سوءنیت خاص"},{q:"در کیس جزوه (کشیدن سلاح برای ارعاب بدهکار که با پخش فیلم همسایه ناامنی شهر در پی داشت) محاربه:",options:["محقق است چون سلاح کشیده شده","محقق است چون ناامنی حاصل شد","محقق نمی‌شود؛ قصد ارعاب مردم/ناامنی نبود و نتیجه ناشی از قصد و رفتار او نبود","فقط به شرط تکرار محقق می‌شود"],answer:2,why:"محاربه مقید است: قصد (جان/مال/ناموس/ارعاب مردم) + نتیجهٔ ناامنی ناشی از قصد و رفتار. ارعابِ بدهکار برای وصول طلب آن قصد را ندارد.",topic:"سوءنیت خاص"},{q:"مصادیق تقصیر در تبصرهٔ مادهٔ ۱۴۵ کدام‌اند؟",options:["فقط قصد نتیجه","بی‌احتیاطی و بی‌مبالاتی؛ مسامحه، غفلت، عدم مهارت و عدم رعایت نظامات دولتی","فقط نقص مهارت","خواب و مستی"],answer:1,why:"تبصرهٔ مادهٔ ۱۴۵: تقصیر اعم از بی‌احتیاطی و بی‌مبالاتی است؛ مسامحه، غفلت، عدم مهارت و عدم رعایت نظامات دولتی از مصادیق آن‌اند.",topic:"جرایم غیرعمدی"},{q:"در مثال ۲۰ جزوه (برف‌پاک‌کن خراب، روز آفتابی، پرش ناگهانی عابر در محل غیرمجاز) چرا جرم غیرعمدی شکل نمی‌گیرد؟",options:["چون تقصیر وجود ندارد","چون رابطهٔ علیت بین تقصیر (خرابی برف‌پاک‌کن) و نتیجه منتفی است","چون راننده مقصر شناخته شده","چون عصر بوده است"],answer:1,why:"نکتهٔ ۱۲: وجود رابطهٔ علیت بین تقصیر و جرم غیرعمدی لازم است؛ خرابی برف‌پاک‌کن علت تصادف نبوده است.",topic:"رابطهٔ علیت"},{q:"بر اساس نکتهٔ ۱۳ و مثال ۲۱، انگیزهٔ انتقام در شلیک قاتل:",options:["قتل را غیرعمدی می‌کند","در تحقق عنوان قتل عمد بی‌تأثیر است؛ انگیزه با سوءنیت خاص متفاوت است","قتل را شبه‌عمد می‌کند","مجازات را قانوناً تشدید می‌کند"],answer:1,why:"انگیزه هدف نهایی مرتکب است و اصولاً در تحقق جرم بی‌تأثیر؛ آنچه قتل عمد را می‌سازد قصد نتیجه است.",topic:"انگیزه"},{q:"در مثال ۲۲ جزوه، «الف» سکه‌های طلای پدرش را با قصد سرقت می‌رباید ولی یک ساعت قبل پدر فوت کرده و وارث اوست. نتیجه؟",options:["سرقت محقق است چون قصد بود","سرقت محقق نمی‌شود؛ عنصر مادی («مال متعلق به غیر») از اساس منتفی است","فقط شروع به سرقت است","خیانت در امانت است"],answer:1,why:"نکتهٔ ۱۴: ابتدا عنصر مادی بررسی می‌شود؛ اموال به وارث رسیده و «مال غیر» نبوده؛ پس جرم شکل نگرفته است.",topic:"ترتیب بررسی عناصر"},{q:"«الف» ساعتی را با تصور مال خود برمی‌دارد و بعداً که می‌فهمد مال «ب» است آن را تصاحب می‌کند (مثال ۲۳). کدام قاعده نقض شده؟",options:["تطابق","تقارن عنصر مادی و روانی","رابطهٔ علیت","سوءنیت خاص"],answer:1,why:"قصد تصاحب با رفتارِ برداشتن هم‌زمان نبوده؛ نکتهٔ ۱۵: مادی و روانی باید هم‌تقارن باشند.",topic:"تقارن"},{q:"معیار تطابق عنصر مادی و روانی (نکتهٔ ۱۶) چیست؟",options:["متن مادهٔ مجازات","عنوان مجرمانه","انگیزهٔ مرتکب","نتیجهٔ حاصل‌شده"],answer:1,why:"نکتهٔ ۱۶: تطابق با «عنوان مجرمانه» سنجیده می‌شود؛ مثال ۲۵: قصد قتل با پرتاب سنگی که فقط تخریب آورد، جرم تخریب را نمی‌سازد.",topic:"تطابق"},{q:"بر اساس مادهٔ ۴، در چه صورتی جرم در حکم واقع‌شده در ایران است؟",options:["فقط اگر تمام جرم در ایران باشد","هرگاه قسمتی از جرم یا نتیجهٔ آن در قلمرو حاکمیت ایران واقع شود","اگر متهم ایرانی باشد","اگر بزه‌دیده ایرانی باشد"],answer:1,why:"مادهٔ ۴: کفایت می‌کند «قسمتی از جرم یا نتیجهٔ آن» در ایران باشد — پایهٔ صلاحیت سرزمینی.",topic:"صلاحیت سرزمینی"},{q:"چهار شرط صلاحیت دادگاه ایران نسبت به جرایم کشتی‌های غیرجنگی شامل کدام مورد است؟",options:["فرود کشتی در بندر ایران","درخواست کمک و رسیدگی از سوی فرماندهٔ کشتی یا نمایندهٔ دیپلماتیک/کنسولی دولت صاحب پرچم","ایرانی بودن ناخدای کشتی","جرم در آب‌های بین‌المللی واقع شده باشد"],answer:1,why:"نکتهٔ ۲۰: شروط: اثرات متوجه ایران؛ مخل نظم عمومی داخلی/دریای سرزمینی؛ درخواست کمک فرمانده یا نمایندهٔ دیپلماتیک/کنسولی؛ ضرورت مبارزه با قاچاق مواد مخدر و روان‌گردان.",topic:"صلاحیت شناور"},{q:"شرط‌های سه‌گانهٔ صلاحیت ایران در هواپیماهای غیرجنگی کدام‌اند؟",options:["جرم مخل انتظامات/امنیت عمومی ایران؛ متهم یا مجنی‌علیه تابع ایران؛ فرود در ایران پس از جرم","ایرانی بودن خلبان؛ پرواز داخلی؛ جرم تعزیری","چهار شرط مانند کشتی‌ها","فقط فرود در ایران"],answer:0,why:"نکتهٔ ۲۱: سه شرط هواپیمای غیرجنگی؛ تفاوتش با کشتی (نکتهٔ ۲۰) را حفظ کنید.",topic:"صلاحیت شناور"},{q:"کدام گزینه از بندهای مادهٔ ۵ ق.م.ا نیست؟",options:["اقدام علیه نظام، امنیت داخلی یا خارجی، تمامیت ارضی یا استقلال ایران","جعل اسکناس رایج یا اسناد تعهدآور بانکی ایران","سرقت مسلحانه از بانک در خارج","جعل آرای مراجع قضایی یا اجرائیه‌ها"],answer:2,why:"سرقت جزو بندهای مادهٔ ۵ نیست؛ بند الف (امنیت)، ت (آرای قضایی) و ث (اسکناس) هستند.",topic:"صلاحیت واقعی"},{q:"در صلاحیت واقعی (مادهٔ ۵) کدام قاعده اجرا می‌شود؟",options:["مجرمیت متقابل","قاعدهٔ احتساب؛ فقط در جرایم تعزیری","منع محاکمه و مجازات مضاعف","شرط یافت یا اعاده به ایران"],answer:1,why:"نکتهٔ ۲۳: فقط قاعدهٔ احتساب (آن هم در تعزیری)؛ ذیل مادهٔ ۵: دادگاه ایران «در تعیین مجازات‌های تعزیری، میزان محکومیت اجراشده را محاسبه می‌کند».",topic:"صلاحیت واقعی"},{q:"سه شرط اصلی صلاحیت شخصی فعال (نکتهٔ ۲۷) کدام‌اند؟",options:["تمام جرم در خارج؛ خارج از جرایم مادهٔ ۵؛ بزهکار ایرانی","تمام جرم در خارج؛ بزه‌دیدهٔ ایرانی؛ جرم حدی","بخشی از جرم در ایران؛ بزهکار ایرانی؛ تعزیری","بزهکار خارجی؛ بزه‌دیدهٔ ایرانی؛ یافت در ایران"],answer:0,why:"فعال: تمام جرم و نتیجه در خارج، جرم از مادهٔ ۵ نباشد، مجرم (بزهکار) ایرانی؛ گزینهٔ آخر منفعل است.",topic:"شخصی فعال"},{q:"طبق نکتهٔ ۲۸/۱، شرط «تبرئه نشدن و اجرا نشدن مجازات در محل وقوع» برای کدام جرایم لازم است؟",options:["همهٔ جرایم","تعزیرات غیرمنصوص؛ در حد، قصاص، دیه و تعزیرات منصوص فقط شرط یافت/اعاده کافی است","فقط جرایم حدی","فقط جرایم مادهٔ ۵"],answer:1,why:"۲۸/۱: در تعزیرات غیرمنصوص هر دو شرط لازم است؛ در سایر جرایم (حد، قصاص، دیه و تعزیرات منصوص) فقط شرط اول (یافت/اعاده).",topic:"شخصی فعال"},{q:"طبق حالت‌های چهارگانهٔ نکتهٔ ۲۸/۲، در کدام فرض متهم در ایران محاکمه می‌شود؟",options:["تبرئه شده در خارج","محکوم و تمام مجازات اجرا شده","محکوم ولی هیچ قسمتی از مجازات (حتی یک روز) اجرا نشده","محکوم و یک سال از حبس اجرا شده"],answer:2,why:"چهار حالت: تبرئه/اجرای کامل/اجرای جزئی → ایران محاکمه نمی‌کند؛ فقط محکومیتِ هیچ‌اجرانشده را ایران می‌گیرد.",topic:"شخصی فعال"},{q:"چهار شرط صلاحیت شخصی منفعل (نکتهٔ ۲۹) کدام‌اند؟",options:["تمام جرم در خارج؛ خارج از مادهٔ ۵؛ بزهکار خارجی؛ بزه‌دیدهٔ ایرانی","تمام جرم در خارج؛ خارج از مادهٔ ۵؛ بزهکار ایرانی؛ بزه‌دیدهٔ خارجی","جرم از مادهٔ ۵؛ بزهکار خارجی؛ بزه‌دیدهٔ ایرانی؛ مجرمیت متقابل","تمام جرم در ایران؛ بزهکار خارجی؛ بزه‌دیدهٔ ایرانی؛ تعزیری"],answer:0,why:"منفعل فقط یک فرق با فعال دارد: بزهکار خارجی + بزه‌دیدهٔ ایرانی (به‌جای بزهکار ایرانی).",topic:"شخصی منفعل"},{q:"مثال ۴۶ جزوه: هندی مرتکب تحصیل مال نامشروع از ایرانی در پاکستان می‌شود و این عمل در پاکستان جرم نیست. نتیجه؟",options:["شخصی منفعل و قابل رسیدگی است","رسیدگی منتفی است؛ جرم تعزیری است و بند ب مادهٔ ۸ جرم بودن در محل وقوع را هم می‌خواهد","صلاحیت واقعی است","فقط با اعادهٔ هندی قابل رسیدگی است"],answer:1,why:"مادهٔ ۸ بند ب: در جرایم موجب تعزیر، رفتار باید به موجب قانون ایران «و قانون محل وقوع» جرم باشد (مجرمیت متقابل).",topic:"شخصی منفعل"},{q:"بر اساس نکتهٔ ۳۲، مجرمیت متقابل در کدام صلاحیت شرط است؟",options:["فقط صلاحیت شخصی منفعل (در جرایم تعزیری غیرمنصوص)","فعال و منفعل","فقط صلاحیت واقعی","همهٔ صلاحیت‌های شخصی"],answer:0,why:"۳۰/۲ و ۳۲: در تعزیرات غیرمنصوص تنها تفاوت فعال و منفعل همین است — مجرمیت متقابل فقط در منفعل شرط است.",topic:"جدول قواعد"},{q:"الگوریتم جزوه برای تشخیص صلاحیت، بعد از صلاحیت سرزمینی ابتدا به چه چیزی نگاه می‌کند؟",options:["تابعیت بزهکار","نوع جرم ارتکابی (فهرست مادهٔ ۵ و قوانین خاص)","تابعیت بزه‌دیده","محل اقامت متهم"],answer:1,why:"ترتیب: محل وقوع (سرزمینی) ← نوع جرم (واقعی) ← تابعیت بزهکار (فعال) ← تابعیت بزه‌دیده (منفعل) ← جهانی.",topic:"الگوریتم تشخیص"},{q:"در تست ۹ جزوه، ساخت سکهٔ بهار آزادی توسط ایرانی در استرالیا مشمول کدام صلاحیت است؟",options:["شخصی فعال با شرط یافت","صلاحیت واقعی؛ بدون هیچ قید و شرطی دادگاه ایران صالح است","شخصی منفعل","صلاحیت ندارد"],answer:1,why:"جعل مسکوکات رایج داخل = بند ث مادهٔ ۵ → صلاحیت واقعی؛ در این صلاحیت حتی شرط یافت/اعاده هم لازم نیست.",topic:"الگوریتم تشخیص"},{q:"در تست ۸ جزوه (زنای به عنف یونانی با زن ایرانی در یونان)، شرط رسیدگی ایران چیست؟",options:["مطلقاً صالح است","یافت یا اعاده به ایران؛ چون جرم حد است و شرط دیگری لازم نیست","یافت/اعاده + تبرئه نشدن در یونان","یافت/اعاده + جرم بودن در یونان"],answer:1,why:"در جرایم حد فقط شرط اول (یافت/اعاده) لازم است؛ شرط‌های تعزیرات غیرمنصوص و مجرمیت متقابل منتفی‌اند.",topic:"الگوریتم تشخیص"},{q:"در تست ۲ (وکالت ۹۸)، نسخ شدن قانون محل وقوع جرم در جریان رسیدگی به ایرانیِ یافت‌شده در ایران:",options:["رسیدگی را موقوف می‌کند","اثری ندارد؛ رسیدگی در هر حال ادامه می‌یابد، چون ملاک فعال قانون ایران است","فقط در تعزیرات اثر دارد","حکم برائت می‌آورد"],answer:1,why:"در صلاحیت شخصی فعال مجرمیت متقابل شرط نیست (۲۸/۳) و بند الف مادهٔ ۷ به قانون ایران نظر دارد؛ سرنوشت قانون محل وقوع بی‌اثر است.",topic:"الگوریتم تشخیص"},{q:"در «اجرای فوری» (نکتهٔ ۳۸)، مصادیقی که حکم قانون سابق در موردشان به‌طور کامل محقق نشده:",options:["با قانون سابق ادامه می‌یابند","طبق قانون جدید رفتار می‌شود","موقوف می‌شوند","برای نظر شورای عالی ارسال می‌شوند"],answer:1,why:"نکتهٔ ۳۸: اگر حکم قانون سابق کامل محقق نشده باشد طبق قانون جدید رفتار می‌شود؛ اگر کامل محقق شده باشد قانون جدید شامل نمی‌شود.",topic:"قلمرو زمان"},{q:"معیار تشخیص شدیدتر شدن مجازات در قانون جدید (نکتهٔ ۳۷) چیست؟",options:["حداقل مجازات","حداکثر مجازات","نوع مجازات","درجهٔ جرم"],answer:1,why:"مثال ۵۱: ۳-۱۰ به ۲-۱۵ یعنی شدیدتر (حداکثر ۱۵ > ۱۰)؛ مثال ۵۲: ۲-۱۵ به ۳-۱۰ یعنی خفیف‌تر.",topic:"قلمرو زمان"},{q:"در مثال ۵۴ (قانون موقت تحریمیِ نگهداری ارز که در ۱۴۰۳ لغو شده و جرم در ۱۴۰۲ بوده):",options:["متهم تبرئه می‌شود","به مجازات قانون زمان وقوع محکوم می‌شود؛ نسخ مؤثر نیست مگر تصریح قانون لاحق","مجازات نصف می‌شود","پرونده موقوف می‌شود"],answer:1,why:"تبصرهٔ مادهٔ ۱۱: قوانین مدت‌معین/موارد خاص با لغو، مگر به تصریح قانون لاحق، به جرایم گذشته اثر نمی‌گذارند.",topic:"قلمرو زمان"},{q:"قوانین مربوط به تشکیلات قضایی و صلاحیت نسبت به جرایم سابق:",options:["عطف به ماسبق نمی‌شوند","فوراً اجرا می‌شوند؛ حتی در جریان رسیدگی، دادگاه قبلی قرار عدم صلاحیت می‌دهد","فقط با موافقت متهم اجرا می‌شوند","فقط پس از قطعیت اعمال می‌شوند"],answer:1,why:"بند الف مادهٔ ۱۱ و مثال ۵۵: تغییر صلاحیت (انقلاب ← کیفری دو) فوری است؛ حتی در میانهٔ رسیدگی پرونده منتقل می‌شود.",topic:"اجرای فوری"},{q:"طبق نکتهٔ ۳۹، پس از صدور حکم قطعی محکومیت با قانون جدید ادلهٔ اثبات، در چه صورتی پرونده مجدداً رسیدگی می‌شود؟",options:["در هر صورت","اگر حکم به‌طور کامل اجرا نشده باشد؛ ولی در حکم برائت رسیدگی مجدد وجود ندارد","فقط با درخواست دادستان","فقط در جرایم حدی"],answer:1,why:"نکتهٔ ۳۹: تا قبل از صدور حکم طبق قانون لاحق؛ بعد از آن فقط محکومیتِ اجرانشدهٔ کامل بازگشایی می‌شود؛ برائت قابل بازگشت نیست.",topic:"ادلهٔ اثبات"},{q:"قاعدهٔ منع محاکمه و مجازات مضاعف یعنی:",options:["اگر مجرم در خارج محاکمه و تبرئه شده یا مجازات شده باشد، دیگر در ایران محاکمه و مجازات نمی‌شود","مجرم در هر دو کشور مجازات می‌شود","مجازات دو برابر می‌شود","محاکمه در ایران ممنوع است"],answer:0,why:"تعریف جزوه: منع محاکمه و مجازات مضاعف = عدم محاکمه و مجازات دوباره در ایران پس از تبرئه یا مجازات در خارج؛ کاربردش در فعال/منفعلِ تعزیری غیرمنصوص است.",topic:"قواعد چهارگانه"}]},{id:"pack-vokalat-madani",title:"دفترچهٔ تستی نمونه — حقوق مدنی",exam:"آزمون وکالت",examSlug:"vokalat",branch:"حقوق مدنی",description:"دفترچهٔ تستی چهارگزینه‌ای از عقود، بیع، اجاره، خیارات، ضمان، غصب، شفعه، وصیت، ارث و نکاح — به سبک آزمون وکالت با پاسخ‌نامهٔ تشریحی سؤال‌به‌سؤال.",minutes:25,passMark:70,kind:"mcq",questions:[{q:"کدام‌یک از شرایط اساسی صحت معامله در مادهٔ ۱۹۰ قانون مدنی ذکر نشده است؟",options:["قصد طرفین و رضای آن‌ها","اهلیت طرفین معامله","مشروعیت جهت معامله","رسمی بودن سند معامله"],answer:3,why:"رسمی بودن سند از شرایط اعتبار معامله نیست؛ شرایط اساسی صحت فقط چهار مورد مادهٔ ۱۹۰ است.",topic:"عقود و شرایط اساسی"},{q:"بیع در قانون مدنی چگونه تعریف شده است؟",options:["تملیک منفعت به عوض معلوم","تملیک عین به عوض معلوم","اجارهٔ عین به عوض معلوم","تملیک عین بدون عوض"],answer:1,why:"مادهٔ ۲۱۴ قانون مدنی: بیع عبارت است از تملیک عین به عوض معلوم؛ تملیک منفعت تعریف اجاره است.",topic:"بیع"},{q:"عقد بیع چه زمانی منعقد می‌شود؟",options:["به محض توافق طرفین در مبیع و ثمن","پس از پرداخت ثمن به بایع","پس از تسلیم مبیع به مشتری","با تنظیم سند رسمی در دفترخانه"],answer:0,why:"مادهٔ ۳۳۹ قانون مدنی: بیع بعد از توافق بایع و مشتری در مبیع و ثمن منعقد می‌شود؛ پرداخت و تسلیم اثر عقد است نه شرط انعقاد.",topic:"بیع"},{q:"خیار مجلس تا چه زمانی باقی است؟",options:["تا سه روز پس از عقد","تا وقتی طرفین در مجلس عقد متفرق نشده‌اند","تا پیش از پرداخت ثمن","تا پیش از تسلیم مبیع"],answer:1,why:"مادهٔ ۳۹۶ بند الف و ۳۹۷: خیار مجلس فقط تا زمانی است که متعاملین در مجلس عقد متفرق نشده‌اند.",topic:"خیارات"},{q:"در بیع حاضر، خیار تأخیر ثمن چند روز است؟",options:["یک روز","سه روز","یک ماه","دو ماه"],answer:1,why:"مادهٔ ۴۰۲ قانون مدنی: در بیع حاضر سه روز و در بیع غیرحاضر یک ماه، مشتری حق فسخ دارد اگر ثمن نپرداخته و ترسید اجناس (کالا) تلف شود.",topic:"خیارات"},{q:"چه مقدار اختلاف (غبن) به‌عرف و عادت فاحش شمرده می‌شود؟",options:["بیش از یک‌دهم","بیش از یک‌پنجم","بیش از یک‌سوم","بستگی به نظر قاضی بدون معیار عرفی"],answer:1,why:"مادهٔ ۴۱۷ قانون مدنی: اگر مقدار غبن بیش از فواید عرفیه یا یک‌پنجم باشد، به فرض فاحش بودن؛ سنجش نهایی با عرف است.",topic:"خیارات"},{q:"در مورد خیار عیب، خریدار پس از اثبات عیب چه حقی دارد؟",options:["فقط فسخ معامله","فقط دریافت خسارت نقدی","فسخ معامله یا اخذ ارش (تفاوت قیمت)","الزام فروشنده به تعویض جنس بدون فسخ"],answer:2,why:"مادهٔ ۴۲۲ قانون مدنی: در خیار عیب، بیع یا فسخ می‌شود یا مبیع به همان حال نگه داشته می‌شود و عوض تفاوت قیمت عاقله (ارش) گرفته می‌شود.",topic:"خیارات"},{q:"تدلیس در قانون مدنی به چه معناست؟",options:["گول زدن با گفتار کذب","عملی که موجب فریب طرف داده شود و بر خلاف واقع چیزی را القا کند","پنهان کردن عیب مبیع بدون فعل","سوگند دروغ در دادگاه"],answer:1,why:"مادهٔ ۴۳۸ قانون مدنی: تدلیس عملی است که موجب فریب طرف داده شود؛ به‌طوری که باور کند بر خلاف واقع چیزی هست یا نیست.",topic:"خیارات"},{q:"اگر مبیع مستحق‌للغیر درآید و در نتیجه بیع باطل باشد، خریدار چه حقی دارد؟",options:["الزام فروشنده به تحویل کالای مشابه","خیار فسخ و استرداد کل ثمن","فقط مطالبهٔ خسارت معنوی","بیع صحیح است و به ملکیت خریدار در می‌آید"],answer:1,why:"مادهٔ ۳۹۰ قانون مدنی: اگر مبیع مستحق‌للغیر درآید، خریدار حق فسخ و استرداد ثمن دارد و اگر مقداری از ثمن پرداخته نشده، از پرداخت آن معاف است.",topic:"بیع"},{q:"طبق مادهٔ ۳۶۱ قانون مدنی، صحت بیع چگونه است؟",options:["صحت آن موکول به نتیجه است","صحت آن موکول به قصد است","صحت آن مشروط به ثبت رسمی است","فقط با اذن دادگاه صحت می‌یابد"],answer:0,why:"مادهٔ ۳۶۱: صحت بیع موکول به نتیجه است؛ یعنی اگر معلوم شود مبیع یا ثمن مال دیگری بوده، عقد باطل و نتیجهٔ فسخ بر آن مترتب می‌شود.",topic:"بیع"},{q:"اگر در عقد بیع شرط شود که فروشنده تا سه ماه حق فسخ داشته باشد، کدام خیار ایجاد شده است؟",options:["خیار شرط","خیار مجلس","خیار تأخیر ثمن","خیار عیب"],answer:0,why:"مادهٔ ۳۹۶ بند ج و ۳۹۹: شرط خیار (شرط ضمن عقد) خیار شرط را ایجاد می‌کند.",topic:"خیارات"},{q:"اصل آزادی قراردادها در قانون مدنی بر پایهٔ کدام ماده بنا شده است؟",options:["مادهٔ ۱۰","مادهٔ ۱۹۰","مادهٔ ۲۱۴","مادهٔ ۲۶۵"],answer:0,why:"مادهٔ ۱۰: قراردادهای خصوصی نسبت به کسانی که آن را منعقد نموده‌اند چون قانون است؛ مبنای آزادی قراردادی.",topic:"عقود و شرایط اساسی"},{q:"عقد اجاره در قانون مدنی چگونه تعریف شده است؟",options:["تملیک عین به عوض معلوم","تملیک منفعت به عوض معلوم","تملیک منفعت به بیع منفعت","اجازهٔ تصرف بدون عوض"],answer:1,why:"مادهٔ ۴۶۶: اجاره عقدی است که به موجب آن منفعت عین معلوم و در مدت معلوم به عوض معلوم تملیک می‌شود.",topic:"اجاره"},{q:"مستأجر اگر مورد اجاره را بدون اذن موجر به غیر بدهد، نتیجهٔ حقوقی چیست؟",options:["اجارهٔ دوم باطل و موجر حق فسخ دارد","اجارهٔ دوم صحیح ولی موجر فقط خسارت می‌گیرد","اجارهٔ دوم صحیح است چون اصل آزادی است","اجارهٔ دوم معلق به رضای موجر است"],answer:0,why:"مادهٔ ۴۹۴: استیجار بدون اذن موجب حق فسخ موجر است؛ اجرت‌المثل دورهٔ تصرف نیز به مستأجر اول تعلق می‌گیرد.",topic:"اجاره"},{q:"ضمان قراردادی در قانون مدنی به چه معناست؟",options:["الحاق ذمه به ذمه به اذن","الحاق ذمه به ذمه به عقد","ضمان به قهری و بدون توافق","تأمین مال به‌عنوان وثیقه"],answer:1,why:"مادهٔ ۶۹۹/۷۰۰: ضمان قراردادی به‌عقد و به اختیار (توافق) واقع می‌شود؛ ضمان قهری به‌حکم قانون بدون توافق است.",topic:"ضمان"},{q:"اگر متعهد، متعهدله را به انجام تعهد مجبور کند (اجبار شخصی)، نتیجهٔ حقوقی چیست؟",options:["چنین اجباری ممکن نیست","پرداخت خسارت ناشی از تأخیر در اجرای تعهد","فسخ قرارداد و استرداد عوض‌ها","الزام با پرداخت جریمهٔ قراردادی"],answer:1,why:"مادهٔ ۲۲۰/۲۲۷: متعهد مجبور نیست ولی در صورت امتناع، خسارت ناشی از تأخیر در اجرای تعهد به او تحمیل می‌شود.",topic:"الزامات قراردادی"},{q:"کدام‌یک از موارد زیر جزو طرق سقوط تعهدات در مادهٔ ۲۶۴ قانون مدنی ذکر نشده است؟",options:["وفاء به عهد","اقالید (اسقاط عوضین)","تبدیل تعهد","خیار فسخ"],answer:3,why:"مادهٔ ۲۶۴: تعهد به شش طریق ساقط می‌شود: وفاء به عهد، اقالید، ابراء، تبدیل تعهد، تهاتر و مالکیت مافی‌الوجب؛ خیار فسخ موجب سقوط «عقد» است نه طریقهٔ سقوط تعهد در این ماده.",topic:"الزامات قراردادی"},{q:"غصب در قانون مدنی چگونه تعریف شده است؟",options:["استیلا بر مال غیر به‌عنوان انتقال ناروا","استیلا بر مال غیر به‌عنوان تصرف بدون اذن","استیلا بر مال غیر با توسل به زور","پنهان کردن مال غیر"],answer:0,why:"مادهٔ ۳۰۸: غصب عبارت است از استیلا بر حق غیر به‌عنوان انتقال ناروا؛ رکن اصلی، استیلا و قصد تملیک نارواست و لازم نیست با توسل به زور باشد.",topic:"غصب"},{q:"غاصب نسبت به منافع مال مندرآمد چه مسئولیتی دارد؟",options:["معاف است چون منفعت سودی برای او نبوده","باید مثل منافع را بدهد مگر عوض آن را بپردازد","فقط خود مال را پس می‌دهد","نصف منافع را می‌پردازد"],answer:1,why:"مادهٔ ۳۲۵: غاصب باید مثل منافع در زمان تصرف را بدهد و اگر عوض منافع را بپردازد از ادای مثل معاف می‌شود.",topic:"غصب"},{q:"منظور از تسبیب در مسئولیت مدنی چیست؟",options:["اتلاف مستقیم مال دیگری","ایجاد واسطهٔ غیر مباشر در تلف مال","غصب مال غیر","تخریب مال خود برای ضرر دیگری"],answer:1,why:"مادهٔ ۳۳۱: تسبیب آن است که انسان مستقیم مال دیگری را تلف نکرده، بلکه واسطه‌ای برای تلف ایجاد کرده است.",topic:"مسئولیت مدنی"},{q:"شفعه در چه حالتی برای شرکا جاری است؟",options:["در بیع هر ملکی","در بیع هر ملکی که شریک در آن ملک مشترک","در بیع هر ملک مسجّل","فقط در املاک مجهول‌المالک"],answer:1,why:"مادهٔ ۸۰۸: مشترک شفیع است در بیع هر ملکی که شریک در آن ملک مشترک. مادهٔ ۸۰۹ برای جار و مادهٔ ۸۲۲ برای املاک مسجّل قواعد خاص دارد.",topic:"شفعه"},{q:"طبق قانون مدنی، پس از ثبت املاک، شفعه در ملک جار چگونه است؟",options:["کاملاً جاری است","کاملاً منتفی است","فقط برای موافق عرف محلی جاری است","فقط با توافق قبلی جاری است"],answer:1,why:"مادهٔ ۸۲۲: در املاکی که موقع ثبت، مجزا بوده و بعداً به هر جهت متصل شده است، حق شفعه جاری نخواهد بود؛ پس شفعهٔ جار پس از ثبت منتفی است.",topic:"شفعه"},{q:"وصیت تملیکی چه وصیتی است؟",options:["وصیتی که مربوط به انجام امری است","وصیتی که تصرف در مال و انتقال آن است","وصیتی که اجرای آن به موصی موکول است","وصیتی که موقوف بر فوت پدر موصی است"],answer:1,why:"مادهٔ ۸۲۸: وصیت تملیکی تصرف در مال است؛ مادهٔ ۸۲۹ وصیت عهدی را تعریف می‌کند (امر و امر بر موصی).",topic:"وصیت"},{q:"اگر موصی به بیش از ثلث مال خود وصیت کند، چه وضعیتی پیش می‌آید؟",options:["وصیت باطل است","وصیت در ثلث صحیح و مازاد به اجازهٔ ورثه موکول است","وصیت صحیح است چون مال خود اوست","وصیت موقوف بر تراضی وارثان است"],answer:1,why:"مادهٔ ۸۴۳: هرکس به بیش از ثلث مال خود وصیت کند، وصیت در ثلث نافذ و مازاد منوط به اجازهٔ ورثه است.",topic:"وصیت"},{q:"حصهٔ زوج (همسر مرد) در ارث زوجه با وجود اولاد چقدر است؟",options:["نصف","ربع","یک‌هشتم","یک‌سوم"],answer:1,why:"مادهٔ ۹۱۳: وجود فرزند، سهم زوج از نصف به ربع کاهش می‌دهد؛ زوجه نیز یک‌هشتم با فرزند و ربع بدون فرزند است.",topic:"ارث"},{q:"«شریک فراش» به چه معناست؟",options:["همسر مشترک در طلاق","فرزندانی که مادرشان یکی است ولی پدر متفاوت","ورثهٔ برادر/خواهر مؤلف","قوم و خویش هم‌سری که فراش دارند"],answer:1,why:"مادهٔ ۹۲۴: کسانی که با ارث می‌برند و مادرشان یکی است ولی پدرشان مختلف است «برادر/خواهر مؤلف» یا شریک فراش نامیده می‌شوند و ارث‌شان محکمهٔ شرع ثابت می‌کند.",topic:"ارث"},{q:"صغیر ممیز در معاملات اموال خود چه وضعیتی دارد؟",options:["کاملاً اهلیت کامل دارد","معاملاتش با رضایت ولی صیحیح است","معاملاتش غیرنافذ است و به رضایت ولی موکول","کاملاً حجر دارد و هیچ معامله‌ای صحیح نیست"],answer:2,why:"مادهٔ ۱۲۱۴: معاملات صغیر ممیز غیرنافذ است؛ مادهٔ ۱۲۱۰ سن رشد پانزده سال شمسی است.",topic:"اهلیت"},{q:"عقد وکالت از کدام دستهٔ عقود است؟",options:["عقد لازم","عقد جایز","عقد مقیّد","عقد خیاری"],answer:1,why:"مادهٔ ۶۷۸: وکالت به فسخ، عزل، استعفا یا فوت موکل/وکیل زایل می‌شود؛ پس جایز است.",topic:"وکالت"},{q:"مورد رهن در قانون مدنی باید چه صفتی داشته باشد؟",options:["مال منقول غیر اهلتی","مال باشد و منفعت گرفتن از آن ممکن","ملک مسجّل حتماً","فقط سکه و طلا"],answer:1,why:"مادهٔ ۷۷۸: مورد رهن باید مال و منفعت گرفتن از آن ممکن باشد.",topic:"رهن"},{q:"حواله در قانون مدنی به چه معناست؟",options:["انتقال دین از متعهد به شخص ثالث","انتقال مال به شخص ثالث","انتقال دین از متعهدله به ثالث","واگذاری حق انتفاع"],answer:0,why:"مادهٔ ۷۲۴: حواله عقدی است که به موجب آن طبیعت از محال‌علیه به محال‌الیه منتقل می‌شود (انتقال دین به ثالث).",topic:"حواله"},{q:"عقد صلح در مورد تسویهٔ امور، از لحاظ لزوم و جواز چه وضعی دارد؟",options:["جایز","لازم (به‌طور کلی)","مطلقاً جایز مگر در مورد خاص","لازم در موارد خاص و جایز در بقیه"],answer:1,why:"مادهٔ ۷۶۰: عقد صلح لازم است؛ مادهٔ ۷۵۹ آن را در مقام تعریف می‌آورد.",topic:"صلح"},{q:"عدهٔ زن مطلقه رجعی چقدر است؟",options:["سه طهر","یک طهر","چهل روز","چهار ماه و ده روز"],answer:0,why:"مادهٔ ۱۱۵۱: عدهٔ طلاق و عدهٔ فسخ نکاح سه طهر است؛ عدهٔ فوت چهار ماه و ده روز (۱۱۵۴).",topic:"نکاح و طلاق"},{q:"اگر در عقد نکاح دائم مهریه ذکر نشده باشد و شوهر زن را طلاق دهد، زن چه حقی دارد؟",options:["هیچ مبلغی نمی‌گیرد","مهرالمثل دریافت می‌کند","یک‌سوم مهرالمثل","مهر السنهٔ مقدر"],answer:1,why:"مواد ۱۰۸۷ و ۱۰۹۰: در عدم ذکر مهر، نکاح صحیح است و پس از دخول، زن مستحق مهرالمثل می‌شود.",topic:"نکاح و طلاق"},{q:"ولادت طفل در مدت زوجیت، ملزم به چه چیزی است؟",options:["نیاز به اثبات نبودن وصال","ملزم به اثبات عدم وصال است","احکام نسب بدون نیاز به هیچ اثباتی جاری است","نیاز به اثبات نسبت از هر دو طرف"],answer:0,why:"مادهٔ ۱۱۵۸: ولادت طفل در مدت زوجیت ملزم به اثبات نبودن وصال است؛ یعنی شرع/قانون طفل را به شوهر ملحق می‌کند مگر شوهر اثبات کند وصالی نبوده است.",topic:"نکاح و طلاق"},{q:"اگر در عقد اجاره مدت اجاره معلوم نباشد، عقد چه حکمی دارد؟",options:["صحیح است","باطل است","غیرنافذ است","موقوف بر رضای موجر است"],answer:1,why:"مادهٔ ۴۶۸: در تعیین مدت اجاره، اجارهٔ بدون معلوم بودن مدت باطل است.",topic:"اجاره"},{q:"خیار حیوان در قانون مدنی تا چند روز است؟",options:["یک روز","سه روز","چهار روز","هفت روز"],answer:1,why:"مادهٔ ۴۱۶ قانون مدنی: خیار حیوان تا سه روز است؛ خریدار می‌تواند حیوان را در این مدت بیازماید و در صورت عیب، بیع را فسخ کند.",topic:"خیارات"}]},{id:"pack-vokalat-jaza",title:"دفترچهٔ تستی نمونه — حقوق جزا",exam:"آزمون وکالت",examSlug:"vokalat",branch:"حقوق جزا",description:"دفترچهٔ تستی از مسئولیت کیفری، قتل‌ها، دیه، قواعد فقهی، دفاع مشروع، سرقت، کلاهبرداری، خیانت در امانت، جعل و محاربه — با توضیح هر پاسخ.",minutes:25,passMark:70,kind:"mcq",questions:[{q:"اطفال کمتر از چند سال قمری فاقد مسئولیت کیفری هستند؟",options:["۹ سال","۱۲ سال","۱۵ سال","۱۸ سال"],answer:0,why:"مادهٔ ۱۴۵: اطفال کمتر از ۹ سال قمری مسئولیت کیفری ندارند؛ اطفال بین ۹ تا ۱۵ سال قمری (مادهٔ ۱۴۴) نیز در صورت احراز مستشعر نبودن از مسئولیت کیفری مستثنا می‌شوند.",topic:"مسئولیت کیفری"},{q:"اصل شخصی بودن مسئولیت کیفری به چه معناست؟",options:["مجازات فقط بر مرتکب اعمال می‌شود","مجازات به ورثهٔ مرتکب منتقل می‌شود","مسئولیت کیفری قابل بیمه است","مسئولیت مدنی جایگزین کیفری می‌شود"],answer:0,why:"مسئولیت کیفری شخصی است و به ورثه یا اشخاص ثالث منتقل نمی‌شود؛ برخلاف دیه و مسئولیت مدنی که در مواردی به اطراف می‌رسد.",topic:"مسئولیت کیفری"},{q:"در قتل عمد، رکن روانیِ لازم شامل چیست؟",options:["عمد در ارتکاب فعل","عمد در وقوع نتیجه (عمد در جرم)","عمد در فعل + عمد در وقوع نتیجه","فقط سوءنیت عام"],answer:2,why:"مادهٔ ۲۹۰: قتل عمد وقتی است که عمد در ارتکاب فعل مسبق (آگاهانه و با اراده)، عمد در وقوع نتیجه (قتل) و مشروعیت فعل مسبق هم‌زمان جمع باشد؛ فقدان هر رکن، عنوان تغییر می‌کند.",topic:"قتل"},{q:"شلیک شکارچی به سمت حیوان که به انسان می‌خورد و او را می‌کشد، چه نوع قتلی است؟",options:["قتل عمد","شبه‌عمد","خطای محض","قتل مشمول مجازات حد"],answer:1,why:"مادهٔ ۲۹۱: قتل در صورتی شبه‌عمد است که عمد در ارتکاب فعل باشد ولی مرتکب عمد در وقوع قتل نداشته و معمولاً قتل را نتیجهٔ فعل خود نمی‌داند؛ مانند شلیک برای شکار.",topic:"قتل"},{q:"قتل خطای محض با کدام عنوان مستوجب دیه است؟",options:["مرتکب قصد قتل داشته ولی مقتول دیگری بوده","مرتکب نه قصد فعل و نه قصد نتیجه داشته","مرتکب قصد فعل داشته و وقوع نتیجه محتمل بوده","در هر قتل بدون رضای ولی دم"],answer:1,why:"مادهٔ ۲۹۲: قتل خطای محض وقتی است که مرتکب نه عمد در فعل و نه عمد در نتیجه دارد؛ دیه آن (مادهٔ ۲۹۵) از محل بودجهٔ دولت پرداخت می‌شود و عاقله ضامن نیست (مادهٔ ۴۹۶).",topic:"قتل"},{q:"دیهٔ نفس کامل معادل چند شتر است؟",options:["۵۰ شتر","۸۰ شتر","۱۰۰ شتر","۲۰۰ شتر"],answer:2,why:"مادهٔ ۴۵۱: دیهٔ نفس کامل، صد شتر یا معادل‌های مذکور در همان ماده (دویست گاو، هزار گوسفند، دویست لباس، هزار دینار...).",topic:"دیه"},{q:"دیگی که در ماه‌های حرام یا در محدودهٔ حرام مکه جنایتی واقع شود، چه میزان است؟",options:["دیهٔ کامل به‌علاوهٔ یک‌سوم","دو برابر دیهٔ کامل","همان دیهٔ کامل بدون تغییر","نصف دیهٔ کامل"],answer:0,why:"مادهٔ ۴۵۰: دیه در ماه‌های حرام یا در حریم مکه، دیهٔ نفس کامل به‌علاوهٔ یک‌سوم است.",topic:"دیه"},{q:"دیهٔ جنین در چه مرحله‌ای «غره» نامیده می‌شود؟",options:["پس از چهل روز از انعقاد","پس از روح دمیدن","پس از چهار ماه","در هر مرحله‌ای از بارداری"],answer:0,why:"مادهٔ ۴۸۸: جنینی که پس از چهل روز از انعقاد سقط شود، دیهٔ آن غره است؛ مراحل بعدی مثله، روح، قلص و کامل‌الخلقه (۴۸۹ به بعد).",topic:"دیه"},{q:"دفاع مشروع در کدام مادهٔ قانون مجازات اسلامی تعریف شده است؟",options:["مادهٔ ۱۵۲","مادهٔ ۱۴۶","مادهٔ ۱۲۲","مادهٔ ۱۸۳"],answer:0,why:"مادهٔ ۱۵۲: دفاع مشروع عبارت است از دفاع از نفس، ناموس، مال، فرزندان و دیگران... در برابر هر تجاوزی؛ شروط آن در مواد ۱۵۳ و ۱۵۴ آمده است.",topic:"دفاع مشروع"},{q:"کدام‌یک از شروط دفاع مشروع نیست؟",options:["تجاوز متجاوز در حال وقوع باشد","دفاع ضرورت داشته باشد","تجاوز واقعاً وجود داشته باشد","دفاع با اجرای مجازات قانونی مقرون باشد"],answer:3,why:"مواد ۱۵۳ و ۱۵۴: دفاع باید در حین تجاوز، بدون امکان مراجعه به مقامات و با ضرورت متناسب باشد؛ اجرای مجازات قانونی به قاضی مربوط است نه به مدافع.",topic:"دفاع مشروع"},{q:"طبق قاعدهٔ دفع، جانی یا ثالثی که در حال دفاع... چه وضعیتی دارد؟",options:["مسئول هیچ‌گونه دیه‌ای نیست","دیه از عاقلهٔ او پرداخت می‌شود","دیه از بیت‌المال پرداخت می‌شود","نصف دیه می‌پردازد"],answer:2,why:"مادهٔ ۱۶: هرکس به‌موجب قاعدهٔ دفع جنایتی را واقع کند یا شخص ثالثی در حال دفاع به دیگری جنایت برساند، عاقله یا جانی ضامن نیست و دولت باید دیهٔ کامل بپردازد.",topic:"قواعد فقهی"},{q:"قاعدهٔ اقوال در کدام حالت جاری است؟",options:["دو جنایت هم‌زمان که یکی ساکت در جنایت دیگر است","جنایت بر جنین","جنایت در ماه حرام","جنایت شوهر بر زن"],answer:0,why:"مادهٔ ۱۷: هرگاه دو جنایت واقع شود و یکی ساکت در جنایت دیگر باشد (مانند قطع طناب)، طبق قاعدهٔ اقوال، اولویت جبران با جنایت صامت است.",topic:"قواعد فقهی"},{q:"قاعدهٔ فراش در جنایت‌های زن و شوهر چه حکمی دارد؟",options:["جنایت هر یک بر دیگری موجب دیه کامل است","دیه‌ها مساوی و بی‌طرفانه اعمال می‌شود","شوهر ضامن جنایت بر زن است ولی زن ضامن نیست","هیچ‌کدام ضامن نیستند"],answer:1,why:"مادهٔ ۲۰: در جنایت‌های واقع‌شده بین زن و شوهر، حکم به قاعدهٔ فراش داده می‌شود و دیه‌ها به‌طور بی‌طرف محاسبه می‌شود.",topic:"قواعد فقهی"},{q:"شروع به جرم در جرایم تعزیری چه مجازاتی دارد؟",options:["معاف از هر مجازاتی است","همان مجازات جرم تام","یک تا دو درجه پایین‌تر از جرم تام","نصف مجازات جرم تام"],answer:2,why:"مادهٔ ۱۲۲: در جرایم عمدی تعزیری، شروع به جرم مستوجب مجازاتی است که قانون برای شروع به جرم مشخص کرده یا در یک تا دو درجهٔ پایین‌تر از جرم تام تعیین می‌شود.",topic:"شروع به جرم"},{q:"کدام‌یک از موارد زیر از مصادیق معاونت در جرم طبق مادهٔ ۱۲۶ است؟",options:["انجام عمل قهرمانی و شرک در مالکیت","تحریک، ترغیب، تهدید، تدارک وسایل و تسهیل","ارائهٔ وسایل بدون آگاهی از قصد","دستور دهندهٔ اصلی ماجرا"],answer:1,why:"مادهٔ ۱۲۶: موارد معاونت شامل تحریک، ترغیب، تهدید یا تطمیع، استفاده از وسایل و... و هرگونه تسهیل در انجام جرم است؛ مجازات معاون یک درجه پایین‌تر از فاعل اصلی است (۱۲۷).",topic:"شروع به جرم"},{q:"شرکت در جرم در کدام حالت محقق است؟",options:["دو یا چند نفر مستقیماً در وقوع جرم مشارکت داشته باشند","یکی جرم را انجام دهد و دیگری بعداً پنهانش کند","دو جرم جداگانه در یک شب رخ دهد","کسی وسایل جرم را تدارک ببیند"],answer:0,why:"مادهٔ ۱۳۰: شرکت در جرم وقتی است که دو یا چند نفر با عمد و مستقیماً در وقوع جرم مشارکت کنند؛ حالت پنهان‌کاری معاونت یا جرم مستقل است.",topic:"شروع به جرم"},{q:"حد سرقت در چه حالتی جاری می‌شود؟",options:["به‌محض ثبوت سرقت در دادگاه","با صبر و استیفا (بازجویی کافی از سارق)","با شکایت صاحب مال","با اقرار سارق در جلسهٔ اول"],answer:1,why:"مادهٔ ۲۶۸: حد سرقت با صبر و استیفا و مطابق شرایط مذکور جاری می‌شود؛ اعتراف یا شهادت در جلسهٔ نخست برای جاری‌شدن حد کافی نیست (مادهٔ ۲۶۹).",topic:"سرقت"},{q:"شرط «حِرز» در حد سرقت به چه معناست؟",options:["مال مالک باید در امانت‌داری امن (حِرز) باشد","سارق حرفه‌ای بوده باشد","سرقت در شب واقع شده باشد","سرقت با شکستن قفل انجام شده باشد"],answer:0,why:"مادهٔ ۲۶۳: مال مسروقه باید در حِرز باشد؛ یعنی در جای مطمئن نگهداری شود و مالک آن‌قدر مراقب باشد که سرقت با شکستن حِرز ممکن باشد.",topic:"سرقت"},{q:"کلاهبرداری در قانون تشدید مجازات... با چه مجازاتی روبه‌رو است؟",options:["فقط جزای نقدی معادل مال مأخوذه","حبس از یک تا هفت سال و جزای نقدی معادل مال مأخوذه و رد مال","حبس از سه ماه تا یک سال","شلاق و حبس همزمان"],answer:1,why:"مادهٔ ۱ قانون تشدید مجازات مرتکبین ارتشا و اختلاس و کلاهبرداری: مرتکب کلاهبرداری به حبس از یک تا هفت سال و جزای نقدی معادل مال مأخوذه محکوم و به رد مال نیز محکوم می‌شود.",topic:"جرایم مالی"},{q:"وجه تمایز کلاهبرداری از فریب (تدلیس) در «وسایل متقلبانه» چیست؟",options:["وسایل متقلبانه فقط برای تطمیع است","توسل به وسایل متقلبانه رکن ویژهٔ کلاهبرداری است","هر دو یکسان‌اند","وسایل متقلبانه فقط در جرایم بین‌المللی است"],answer:1,why:"در کلاهبرداری، مرتکب باید به وسایل متقلبانه متوسل شود و مال دیگری را ببرد؛ فریب ساده بدون این وسایل، مصداق کلاهبرداری قانونی نیست.",topic:"جرایم مالی"},{q:"خیانت در امانت در کدام مادهٔ قانون تعزیرات آمده است؟",options:["مادهٔ ۶۷۴","مادهٔ ۵۲۳","مادهٔ ۶۰۸","مادهٔ ۶۹۷"],answer:0,why:"مادهٔ ۶۷۴ قانون تعزیرات: هرکس مال منقول یا غیرمنقول... به‌عنوان ودیعه یا وکالت یا اجاره... و مثل آن به او سپرده شده به قصد تملک یا استعمال، مال دیگری را تصاحب، تلف یا مفقود کند، به حبس از شش ماه تا سه سال محکوم می‌شود.",topic:"جرایم مالی"},{q:"جعل اسناد غیررسمی در مادهٔ ۵۲۳ با چه مجازاتی همراه است؟",options:["حبس از شش ماه تا دو سال یا جزای نقدی","حبس از یک تا پنج سال","فقط جزای نقدی سنگین","حبس ابد"],answer:0,why:"مادهٔ ۵۲۳: هرکس یکی از اقدامات جعل (تراشیدن، ترمیم، الحاق و مانند آن) را نسبت به اسناد غیررسمی انجام دهد به حبس از شش ماه تا دو سال یا جزای نقدی محکوم می‌شود؛ جعل اسناد رسمی (مادهٔ ۵۲۴) حبس از یک تا پنج سال دارد.",topic:"جعل"},{q:"استفاده از سند مجعول چه مجازاتی دارد؟",options:["معاف است چون جعل کار دیگری بوده","به‌عنوان جرم مستقل سبک‌تر از جعل","به همان مجازات جاعل محکوم می‌شود","فقط رد سند و محرومیت حقوقی"],answer:2,why:"مادهٔ ۵۴۲ قانون تعزیرات: هر کس سند یا نوشتهٔ مجعول را با علم به جعلی بودن آن مورد استفاده قرار دهد، به‌عنوان جاعل به مجازات مقرر در این فصل محکوم می‌شود.",topic:"جعل"},{q:"محاربه در مادهٔ ۱۸۳ چگونه تعریف شده است؟",options:["کشیدن اسلحه به قصد جان افراد، اموال یا به‌منظور ترس و آزادی‌سلبی","هر نوع سوءقصد به جان رئیس‌جمهور","مخالفت با حکومت در انتخابات","تجمع غیرقانونی با اسلحهٔ سرد"],answer:0,why:"مادهٔ ۱۸۳: محاربه عبارت است از کشیدن اسلحه به قصد جان، اموال یا ناموس مردم یا به‌منظور ارعاب و سلب آزادی و امنیت؛ جرایم علیه امنیت مرتبط با این تعریف‌اند.",topic:"جرایم علیه امنیت"},{q:"«علم قاضی» در تشخیص مجرمیت از کدام مواد مستند است؟",options:["مادهٔ ۲۱۱","مادهٔ ۱۶۰","مادهٔ ۳۷","مادهٔ ۲۴۲"],answer:0,why:"مادهٔ ۲۱۱: دادگاه... می‌تواند با استفاده از اوضاع و احوال و مقتضیات با علم و یقین کامل به وقوع جرم... حکم صادر کند؛ علم قاضی از دلایل معتبر شناخته می‌شود.",topic:"دلایل اثبات"},{q:"اصل برائت در کدام مادهٔ قانون مجازات اسلامی ذکر شده است؟",options:["مادهٔ ۳۷","مادهٔ ۴۳","مادهٔ ۱۲۰","مادهٔ ۱۷۸"],answer:0,why:"مادهٔ ۳۷: اصل، برائت است؛ بنابراین اگر به‌هر نحوی که حاصل شده باشد، ظن قوی و مؤثر اثبات وقوع جرم حاصل شود ولی آن اطمینان کامل نباشد، مرتکب تعقیب نمی‌شود.",topic:"دلایل اثبات"},{q:"جرایم تعزیری در قانون مجازات اسلامی به چند درجه تقسیم شده‌اند؟",options:["پنج درجه","شش درجه","هشت درجه","ده درجه"],answer:2,why:"مادهٔ ۱۹: تعزیرات به هشت درجه تقسیم شده‌اند؛ درجهٔ یک سنگین‌ترین (بیش از ۲۵ سال تا اعدام/حبس ابد) و درجهٔ هشت سبک‌ترین است.",topic:"مسئولیت کیفری"},{q:"«جرایم بازدارنده» در قانون مجازات اسلامی ۱۳۹۲ با کدام عنوان یکپارچه شده است؟",options:["تعزیر","حد","دیه","اقدامات تأمینی و تربیتی"],answer:0,why:"قانون ۱۳۹۲ جرایم بازدارندهٔ سابق را در ردیف تعزیر آورد؛ تعزیر در مواد ۱۸ به بعد تعریف و درجه‌بندی شده است.",topic:"مسئولیت کیفری"},{q:"معاون در جرم چه مجازاتی می‌گیرد؟",options:["همان مجازات فاعل اصلی","یک درجه پایین‌تر از فاعل اصلی","دو درجه پایین‌تر از فاعل اصلی","فقط جزای نقدی"],answer:1,why:"مادهٔ ۱۲۷: مجازات معاون جرم، درجهٔ یک پایین‌تر از مجازات فاعل اصلی است.",topic:"شروع به جرم"},{q:"اگر ولیّ دم از قصاص بگذرد ولی سایر شرایط قصاص فراهم باشد، نتیجه چیست؟",options:["قصاص قابل اجرا نیست و دیه جایگزین می‌شود","قصاص با اذن دادگاه اجرا می‌شود","قصاص به بیت‌المال منتقل می‌شود","مجازات حبس تعزیری ابد جایگزین می‌شود"],answer:0,why:"با گذشت ولیّ دم یا استیفای حق قصاص، قصاص منتفی و جنایت به دیه (و تعزیر در صورت جرم‌انگاری خاص) تبدیل می‌شود؛ حق قصاص قابل اسقاط است ولی حق دیه چنین نیست مگر با گذشت.",topic:"قتل"},{q:"دیگی که در جریان دفاع مشروع از سوی مهاجم جنایتی ببیند، از کجا دیه می‌گیرد؟",options:["از مدافع یا عاقلهٔ او","از بیت‌المال","از هیچ منبعی","از محل صندوق تأمین اجتماعی"],answer:1,why:"در دفاع مشروعِ صحیح (مادهٔ ۱۶ در دفاع)، دیه از بیت‌المال پرداخت می‌شود و مدافع یا عاقلهٔ او ضامن نیست.",topic:"دفاع مشروع"},{q:"جرم سیاسی در قانون مجازات اسلامی چگونه تعریف شده است؟",options:["تعریف صریح و کامل در مادهٔ ۱۸","شامل هر جرم با انگیزهٔ سیاسی","جرایمی که با پیش‌داوری قاضی مشخص می‌شوند","فقط جرایم مطبوعاتی"],answer:0,why:"مادهٔ ۱۸ قانون مجازات اسلامی، جرم سیاسی را تعریف کرده است؛ مرتکبان به‌علت ماهیت جرم، از برخی محرومیت‌ها و تشدیدها معاف می‌شوند.",topic:"جرایم علیه امنیت"},{q:"اگر در کلاهبرداری، مأخوذه بازگردانده شود، مرتکب چه وضعیتی دارد؟",options:["معاف از مجازات می‌شود","دیه کفایت می‌کند","مجازات همچنان برقرار است؛ ولی در برخی جرایم مالی، استرداد مال موجب معافیت است","پرونده مختومه اعلامی می‌شود"],answer:2,why:"در جرایم مالی، رد مال شرط تعقیب یا عامل تخفیف است؛ در خیانت در امانت (مادهٔ ۶۷۵ تعزیرات)، استرداد مال پیش از صدور کیفرخواست موجب معافیت از مجازات است؛ ولی در کلاهبرداری، رد مال موضوع حکم است و مختومه‌شدن پرونده را تضمین نمی‌کند.",topic:"جرایم مالی"},{q:"توهین به غیر با شلاق تا چند ضربه یا حبس تا چند ماه مستوجب مجازات است؟",options:["شلاق تا ۷۴ ضربه یا حبس ۳ تا ۶ ماه","فقط جزای نقدی","شلاق تا ۹۹ ضربه","حبس از یک تا سه سال"],answer:0,why:"مادهٔ ۶۰۸ قانون تعزیرات: توجین به هر لفظ یا عملی با سوءقصد یا تعرض به شرف و حیثیت... مستوجب مجازات شلاق تا ۷۴ ضربه یا حبس از سه تا شش ماه است.",topic:"جرایم علیه اشخاص"},{q:"کدام مورد از ارکان حد سرقت نیست؟",options:["مال مسروقه در حِرز بوده باشد","سرقت با شکستن حِرز انجام شده باشد","مال مسروقه حداقل قیمتی معیّن داشته باشد (نصاب)","مال امانی تلف شده باشد (خیانت در امانت)"],answer:3,why:"ارکان حد سرقت: حِرز بودن مال، شکستن حِرز، نصاب معیّن (مادهٔ ۲۶۴ ق.م.ا)، به‌علاوهٔ شرایط مذکور در مواد ۲۶۸ و ۲۶۹؛ اتلاف مال امانی عنوان خیانت در امانت دارد نه سرقت.",topic:"سرقت"},{q:"در جنایت بر انسان غیرمسلمان (ذمی)، دیه چگونه است؟",options:["دیهٔ کامل مثل مسلمان","دیهٔ نصف مسلمان","دیهٔ یک‌سوم","بدون دیه"],answer:1,why:"مادهٔ ۵۵۴: دیهٔ جنایت بر ذمی و مشمولان قانون دیات، دیهٔ مسلمان است؛ ولی در مواد قانون دیات (مادهٔ ۱۲)، دیهٔ غیرمسلمان در مقام تساوی نصف مسلمان در نظر گرفته شده و ملاک عمل حسب مورد است.",topic:"دیه"}]},{id:"pack-vokalat-dadresi",title:"دفترچهٔ تستی نمونه — آیین دادرسی مدنی",exam:"آزمون وکالت",examSlug:"vokalat",branch:"آیین دادرسی مدنی",description:"دفترچهٔ تستی از صلاحیت دادگاه‌ها، دادخواست، ابلاغ، وکالت در دعاوی، دلایل، تجدیدنظر، واخواهی، فرجام و اجرای احکام — با پاسخ‌نامهٔ تشریحی.",minutes:20,passMark:70,kind:"mcq",questions:[{q:"صلاحیت ذاتی دادگاه‌ها در قوانین آیین دادرسی چگونه است؟",options:["قابل توافق طرفین است","قابل توافق نیست و برای دادگاه‌ها از طرف قوانین معین می‌شود","با رضایت رئیس شعبه تغییر می‌کند","فقط در دعاوی مالی قابل توافق است"],answer:1,why:"مادهٔ ۵ ق.آ.د.م: صلاحیت ذاتی دادگاه‌ها به‌وسائلی که مقرر کرده تعیین و برای دادگاه‌ها از طرف قوانین معین می‌شود؛ توافق بر خلاف آن معتبر نیست.",topic:"صلاحیت"},{q:"دعوای مربوط به تاجر نسبت به امور تجاری، در کدام دادگاه اقامه می‌شود؟",options:["محل اقامت خواهان","محل اقامت خوانده","محل انعقاد قرارداد","هر جا که خواهان انتخاب کند"],answer:1,why:"مادهٔ ۱۱: هرکس باید در دادگاهی که محل اقامتگاه خوانده است دعوا کند؛ تبصره ۱ همین ماده: دعوای مربوط به تاجر نسبت به امور تجاری در دادگاه محل اقامتگاه تاجر (اگر ایرانی و دارای اقامتگاه) یا... اقامه می‌شود.",topic:"صلاحیت"},{q:"اگر خوانده در ایران اقامتگاه نداشته باشد، دعوای علیه او کجاست؟",options:["دادگاه محل اقامت خواهان در دعاوی مالی","دادگاه تهران","دادگاه محل وقوع مال","دعوا پذیرفته نمی‌شود"],answer:0,why:"تبصرهٔ ۱ مادهٔ ۱۱: خوانده در صورت معلوم نبودن اقامتگاه، دعاوی او علیه او در دادگاه محل اقامت خواهان در دعاوی مالی... اقامه می‌شود.",topic:"صلاحیت"},{q:"دعاوی راجع به اموال غیرمنقول در کدام دادگاه مطرح می‌شود؟",options:["محل اقامت خوانده","محل وقوع مال غیرمنقول","محل اقامت خواهان","به انتخاب خواهان بین این دو"],answer:1,why:"مادهٔ ۱۲: دعوای مربوط به اموال غیرمنقول اعم از دعاوی مالکیت، مزاحمت، تصرف عدوانی و... در دادگاهی اقامه می‌شود که مال غیرمنقول در حدود آن واقع است.",topic:"صلاحیت"},{q:"در تعدد خواندگان (دعوای علیه چند نفر)، صلاحیت محلی کجاست؟",options:["محل اقامت هر یک از خواندگان","محل اقامت نزدیک‌ترین خوانده به خواهان","محل وقوع مال","دادگاه تهران"],answer:0,why:"مادهٔ ۱۳: هرگاه چند نفر خوانده‌های یک دعوا در یک حوزهٔ قضایی نباشند، دعوا در دادگاهی اقامه می‌شود که یکی از خواندگان در حدود حوزهٔ آن اقامت دارد.",topic:"صلاحیت"},{q:"دعوای متقابل در چه زمانی قابل تقدیم است؟",options:["در جلسهٔ اول تا پایان جلسهٔ دوم رسیدگی","هر وقت که خواهان بخواهد","قبل از جلسهٔ اول فقط","پس از صدور حکم تا مهلت تجدیدنظر"],answer:0,why:"مادهٔ ۱۴۲: خوانده می‌تواند در مقابل دعوای خواهان، دعوایی به‌عنوان متقابل اقامه کند؛ این دعوا باید تا پایان جلسهٔ دوم رسیدگی تقدیر شود و ارتباط کامل با دعوای اصلی داشته باشد.",topic:"دعوای متقابل"},{q:"شرط پذیرش دعوای متقابل چیست؟",options:["ارتباط کامل با دعوای اصلی","ارتباط کامل با دعوای اصلی + تقدیم تا پایان جلسهٔ دوم","مقدار خواستهٔ برابر با دعوای اصلی","رضایت صریح خواهان اصلی"],answer:1,why:"مادهٔ ۱۴۳: دعوای متقابل به دو شرط در دادگاه پذیرفته می‌شود: تقدیم آن تا پایان جلسهٔ دوم و ارتباط کامل با دعوای اصلی.",topic:"دعوای متقابل"},{q:"اعتراض به صلاحیت دادگاه از طرف هر یک از طرفین دعوا در چه زمانی است؟",options:["در جلسهٔ اول تا پایان جلسهٔ دوم","تا پیش از صدور حکم","در هر مرحله‌ای از رسیدگی","فقط در مرحلهٔ تجدیدنظر"],answer:0,why:"مادهٔ ۸۲: طرف دعوا در جلسهٔ اول تا پایان جلسهٔ دوم می‌تواند به صلاحیت دادگاه اعتراض کند؛ پس از آن دادگاه حسب مورد به اعتراض رسیدگی یا رد می‌کند.",topic:"صلاحیت"},{q:"اختلاف در صلاحیت بین دو دادگاه نهایتاً چگونه حل می‌شود؟",options:["با نظر رئیس دادگاه مربوطه","با نظر دیوان عالی کشور","با هیئت مشاور (هیئت ۳ نفره در تهران) طبق مادهٔ ۲۷","با نظر دادستان"],answer:2,why:"مادهٔ ۲۷: دادگاه‌ها در حل اختلاف در صلاحیت، نهایتاً به هیئت مشاور (متشکل از سه قاضی در تهران) مراجعه می‌کنند؛ صدور مجازات یا رد معتبر است.",topic:"صلاحیت"},{q:"اگر دادخواست فاقد یکی از موجبات مقرر در مادهٔ ۵۱ باشد، دادگاه چه می‌کند؟",options:["دادخواست رد می‌شود","نقص را به خواهان ابلاغ می‌کند و ۱۰ روز مهلت رفع نقص می‌دهد","دادخواست بدون تغییر می‌پذیرد","پرونده به دیوان ارجاع می‌شود"],answer:1,why:"مادهٔ ۵۱: اگر دادخواست فاقد یک یا چند مورد مقرر در مادهٔ ۵۱ باشد، دادگاه نقص را با ذکر جزئیات به خواهان ابلاغ می‌کند و از تاریخ ابلاغ ۱۰ روز به او مهلت می‌دهد تا نقص را رفع کند.",topic:"دادخواست"},{q:"فاصلهٔ ابلاغ وقت رسیدگی از روز ابلاغ تا جلسهٔ دادرسی چقدر باید باشد؟",options:["سه روز","پنج روز","ده روز","پانزده روز"],answer:1,why:"مادهٔ ۶۸: وقت رسیدگی باید از روز ابلاغ تا روز جلسه، دست‌کم پنج روز فاصله باشد؛ ابلاغ واقعی (مادهٔ ۶۹) شرط اعتبار آن است.",topic:"ابلاغ"},{q:"ابلاغ واقعی در قانون آیین دادرسی به چه معناست؟",options:["ابلاغ به مدیر دفتر دادگاه","ابلاغ به شخص خوانده به‌طور مستقیم","ابلاغ به کارمند ابلاغ که در محل اقامت ملاقات کند","ابلاغ از طریق پست سفارشی"],answer:1,why:"مادهٔ ۶۹: ابلاغ واقعی یعنی ابلاغ اوراق به شخص خوانده به‌طور مستقیم؛ اگر ممکن نشود، به وکیل، قیم، سرپرست خانواده یا اهل منزل و... ابلاغ قانونی انجام می‌شود.",topic:"ابلاغ"},{q:"وکیل در دعاوی باید چه مدارکی برای حضور در دادگاه ارائه دهد؟",options:["وکالت‌نامهٔ رسمی یا کتبی داخلی + کارت شناسایی","فقط کارت وکالت دادگستری","قرارداد کتبی شفاهی با موکل","وکالت‌نامهٔ رسمی حتماً"],answer:0,why:"مادهٔ ۳۱: وکیل باید وکالت‌نامهٔ خود را که مدت آن معتبر باشد با کارت شناسایی همراه داشته باشد؛ در برخی موارد مادهٔ ۳۳ وکالت‌نامهٔ عادی (کتبی/داخلی) کافی است.",topic:"وکالت در دعاوی"},{q:"وکالت‌نامهٔ «داخلی» برای حضور در دادگاه در چه حالتی کافی است؟",options:["در همهٔ دعاوی","در دعاوی مالی که مبلغ آن کمتر از مقدار معین قانونی است","فقط در دعاوی خانواده","هیچ‌وقت کافی نیست"],answer:1,why:"مادهٔ ۳۳: در دعاوی مالی که مبلغ یا ارزش آن از مقدار معین قانونی کمتر باشد، وکیل می‌تواند با وکالت‌نامهٔ عادی (کتبی داخلی) در دادگاه حاضر شود.",topic:"وکالت در دعاوی"},{q:"ایراد به عدم رعایت موجبات رسیدگی از کدام ماده مستند است؟",options:["مادهٔ ۸۷","مادهٔ ۱۰۲","مادهٔ ۱۴۲","مادهٔ ۲۶"],answer:0,why:"مادهٔ ۸۷: طرف دعوا می‌تواند در مقام دفاع در جلسهٔ اول تا پایان جلسهٔ دوم، ایرادهایی مانند عدم صلاحیت، عدم سمت و... را مطرح کند.",topic:"ایراد"},{q:"بار اثبات دعوا بر عهدهٔ کیست؟",options:["خواهان","خوانده","دادگاه","شاهد"],answer:0,why:"اصل: اثبات بر مدعی و سوگند بر منکر است؛ خواهان باید ادعای خود را اثبات کند و خوانده فقط انکار/تردید دارد و سوگند را می‌پذیرد یا می‌دارد.",topic:"دلایل"},{q:"اقرار در دادخواست چه اثری دارد؟",options:["اعتبار ندارد چون دفاع نیست","هم‌اعتبار اقرار در دادگاه است","فقط اگر شاهد شود وگرنه بی‌اثر","اعتبارش در حکم شهادت است"],answer:1,why:"مادهٔ ۱۲۷۹ قانون مدنی و مواد ۲۰۳ به بعد ق.آ.د: اقرار کتبی در دادخواست یا لوایح در حکم اقرار شفاهی است.",topic:"دلایل"},{q:"کارشناسی در امور فنی به درخواست چه کسی صورت می‌گیرد؟",options:["فقط خواهان","خواهان یا خوانده با نظر دادگاه","دادگاه حسب مورد اقدام می‌کند (خواهان/خوانده/رئیس دادگاه)","فقط با موافقت هر دو طرف"],answer:2,why:"مادهٔ ۲۶۰: در هر مورد که تشخیص امور فنی یا به‌کارگیری کارشناس لازم باشد، دادگاه حسب مورد به درخواست طرف‌های دعوا یا رئیس دادگاه اقدام می‌کند.",topic:"دلایل"},{q:"سوگند تکمیلی در آیین دادرسی مدنی به چه معناست؟",options:["سوگندی که برای تکمیل اثبات، به هر دو طرف داده می‌شود","سوگندی که به‌درخواست خواهان برای ادای کامل دعوا به خوانده داده می‌شود","سوگند در دعاوی خانواده","سوگند در دعاوی مالی بیشتر از مقدار معین"],answer:1,why:"سوگند تکمیلی، سوگندی است که برای تکمیل اقامهٔ دعوا (ادای کامل ادعای خواهان یا خوانده) به طرف مقابل داده می‌شود؛ مکمل سایر ادله است.",topic:"دلایل"},{q:"دعوای ثالث (جلب شخص ثالث) در چه زمانی است؟",options:["تا پایان جلسهٔ دوم رسیدگی","در هر مرحله‌ای از رسیدگی","فقط در مرحلهٔ تجدیدنظر","تا صدور حکم قطعی"],answer:0,why:"مادهٔ ۱۳۴: جلب شخص ثالث باید در جلسهٔ اول تا پایان جلسهٔ دوم اقامه شود (مانند دعوای متقابل).",topic:"دعوای ثالث"},{q:"مهلت تجدیدنظرخواهی از احکام دادگاه بدوی چقدر است؟",options:["ده روز از ابلاغ","بیست روز از ابلاغ","یک ماه از صدور","دو ماه از ابلاغ"],answer:1,why:"مادهٔ ۳۳۶: مهلت تجدیدنظرخواهی برای اشخاص ساکن ایران ۲۰ روز و برای اشخاص مقیم خارج ۲ ماه از تاریخ ابلاغ یا انقضای مهلت اعتراض واخواهی است.",topic:"تجدیدنظر"},{q:"در کدام دعوا حکم دادگاه بدوی قطعاً قابل تجدیدنظرخواهی است؟",options:["دعوای راجع به اصل نکاح","دعوایی که خواستهٔ آن از حد معین قانونی کمتر است","دعوای راجع به اموال عمومی (مستثنی‌ها)","امور حسبی"],answer:0,why:"مادهٔ ۳۳۴: احکام بدوی قابل تجدیدنظر است مگر استثناهای مقرر (اموال عمومی و مستثنی‌ها، دعاوی که خواستهٔ آن از حد معین کمتر است، امور حسبی و...)؛ احکام اصل نکاح و طلاق قابل تجدیدنظر و فرجام‌خواهی است.",topic:"تجدیدنظر"},{q:"واخواهی نسبت به چه حکمی است؟",options:["حکم قطعی","حکم غیابی","حکم قراردادی","حکم اجرایی"],answer:1,why:"مادهٔ ۳۰۵: احکام غیابی... محکوم‌علیه غایب می‌تواند به آن اعتراض (واخواهی) کند؛ مهلت واخواهی ۲۰ روز از ابلاغ واقعی است.",topic:"واخواهی"},{q:"دادخواست تجدیدنظر به کدام دادگاه تقدیم می‌شود؟",options:["دادگاه تجدیدنظر مستقیماً","دادگاه بدوی صادرکنندهٔ حکم","دادستان محل","دفتر دادگاه محل اقامت تجدیدنظرخواه"],answer:1,why:"مادهٔ ۳۳۷: تجدیدنظرخواهی با تقدیم دادخواست به دادگاه صادرکنندهٔ حکم بدوی شروع می‌شود؛ سپس پرونده به دادگاه تجدیدنظر ارسال می‌گردد.",topic:"تجدیدنظر"},{q:"مهلت فرجام‌خواهی چقدر است؟",options:["ده روز از ابلاغ","بیست روز از ابلاغ","چهل روز از صدور","دو ماه از ابلاغ"],answer:1,why:"مادهٔ ۳۶۷: مهلت فرجام‌خواهی ۲۰ روز از تاریخ ابلاغ است (برای مقیم خارج ۲ ماه).",topic:"فرجام"},{q:"کدام حکم فرجام‌خواهی می‌شود؟",options:["حکم راجع به اصل نکاح، طلاق، نسب، وقف، ثلث، وصیت و حبس","حکم غیابی","حکم دادگاه بدوی صادرشده با تجدیدنظر","حکم داوری"],answer:0,why:"مادهٔ ۳۷۱: احکام راجع به اصل نکاح و فسخ آن، طلاق، نسب، وقف، ثلث، وصیت و تولیت... و جبران... قابل فرجام‌خواهی است.",topic:"فرجام"},{q:"اجرای احکام با درخواست چه کسی شروع می‌شود؟",options:["به درخواست محکوم‌له","خودکار پس از قطعیت","با دستور دادستان","با اطلاع رئیس دفتر دادگاه"],answer:0,why:"مادهٔ ۱۴۳: صدور حکم یا اجرای آن (اجرای احکام مدنی) به درخواست محکوم‌له شروع می‌شود.",topic:"اجرای احکام"},{q:"تأمین خواسته در چه زمانی قابل تقاضا است؟",options:["همراه دادخواست یا پس از آن","قبل از تقدیم دادخواست","پس از صدور حکم","فقط در مرحلهٔ اجرا"],answer:0,why:"مادهٔ ۳۱۵: درخواست تأمین خواسته باید هم‌زمان با تقدیم دادخواست یا پس از آن باشد؛ تأمین مقدم بر دادخواست ممکن نیست.",topic:"تأمین"},{q:"دستور موقت در کدام موارد صادر می‌شود؟",options:["جلوگیری از خطر ضرر و زیان یا به‌دست آوردن دلیل","در هر دعوای مالی","فقط در دعاوی خانواده","در دعاوی غیرمالی فقط"],answer:0,why:"مواد ۳۱۰ به بعد: دستور موقت برای جلوگیری از خطر ضرر و زیانی است که مدعی در حق خود از خوانده تهدید می‌بیند یا حفظ وضعیت موجود؛ برخلاف تأمین خواسته که مقدم بر رسیدگی ماهوی است.",topic:"تأمین"},{q:"داوری با توافق طرفین در چه حالت معتبر است؟",options:["قبل از دعوا یا در جریان رسیدگی","بعد از صدور حکم قطعی","فقط با معرفی دادگاه","فقط در دعاوی تجاری"],answer:0,why:"مادهٔ ۴۵۴: هرگاه طرفین... توافق کنند که اختلاف خود را به داوری... ارجاع کنند، توافق‌نامهٔ کتبی آنان معتبر است؛ داوری قبل از دعوا یا در جریان رسیدگی ممکن است.",topic:"داوری"},{q:"هزینهٔ دادرسی در دعاوی مالی چگونه محاسبه می‌شود؟",options:["ثابت و مستقل از خواسته","بر مبنای بهای خواسته","بر مبنای تعداد جلسات","بر مبنای ساعات رسیدگی"],answer:1,why:"مادهٔ ۶۳ و تبصره‌های آن: هزینهٔ دادرسی دعاوی مالی بر مبنای بهای خواسته محاسبه می‌شود.",topic:"هزینهٔ دادرسی"}]},{id:"pack-desc-madani",title:"دفترچهٔ تشریحی — حقوق مدنی",exam:"نمونه سوالات تشریحی",examSlug:"tashrihi",branch:"حقوق مدنی",description:"۱۲ پرسش تشریحی از شرایط اعتبار عقد، بیع، خیارات، غبن، غصب، شفعه، وصیت، ارث و مسئولیت مدنی — با پاسخ نمونهٔ مکتوب و کلیدواژه‌های نمره‌آور.",minutes:60,kind:"descriptive",questions:[{q:"شرایط اساسی صحت معامله را نام برده و هر یک را توضیح دهید.",keywords:["قصد","رضا","اهلیت","موضوع معین","مشروعیت جهت"],answer:"طبق مادهٔ ۱۹۰ قانون مدنی چهار شرط اساسی صحت معامله عبارت است از: ۱) قصد طرفین و رضای آن‌ها؛ قصد یعنی عالمانه بودن عمل و رضا یعنی خواستن با اختیار و بدون اکراه. ۲) اهلیت طرفین؛ یعنی رسیدن به سن بلوغ و رشد و عاقل بودن. ۳) موضوع معین؛ یعنی معامله باید مال یا امری معین باشد که قابل انعقاد است. ۴) مشروعیت جهت معامله؛ یعنی غایت و انگیزهٔ معامله نامشروع نباشد. فقدان هر یک موجب بطلان معامله است.",topic:"عقود و شرایط اساسی"},{q:"ارکان عقد بیع را توضیح داده و تفاوت بیع نقد و نسیه را بیان کنید.",keywords:["بایع","مشتری","مبیع","ثمن","منجز"],answer:"ارکان بیع (مادهٔ ۳۳۸): بایع (فروشنده)، مشتری (خریدار)، مبیع (مال مورد بیع) و ثمن (عوض معلوم). بیع عبارت است از تملیک عین به عوض معلوم (مادهٔ ۲۱۴). در مادهٔ ۳۳۹ گفته شده بیع بعد از توافق در مبیع و ثمن منعقد می‌شود. بیع نقد بیعی است که مبیع و ثمن هر دو منجز باشند و تسلیم و پرداخت فوری است؛ بیع نسیه بیعی است که ثمن مؤجل (مدت‌دار) باشد. هرگاه مبیع مؤجل باشد بیع «سلف/سلم» نامیده می‌شود.",topic:"بیع"},{q:"خیارات را تعریف کرده و دسته‌بندی آن‌ها را بیان کنید.",keywords:["خیار","اختیار","مجلس","غبن","عیب","تدلیس"],answer:"خیار عبارت است از اختیار فسخ یا ابقای عقد (مادهٔ ۳۹۶). خیارات دو دسته‌اند: خیارات برخاسته از ارادهٔ طرفین (خیار شرط) و خیارات برخاسته از قانون. خیارات قانونی شامل: خیار مجلس، خیار حیوان، خیار تأخیر ثمن، خیار رویت و کالاشنیده، خیار غبن، خیار عیب، خیار تدلیس، خیار تخلف از شرط و خیار عدم تسلیم. هنگام برخورد خیارات، درجهٔ بندی مادهٔ ۴۵۲ حاکم است (خیار تدلیس بر خیار عیب و هر دو بر خیار مجلس و...).",topic:"خیارات"},{q:"قاعدهٔ غبن و شرایط قابل استناد بودن آن را توضیح دهید.",keywords:["غبن","فاحش","یک‌پنجم","عرف","عدم اطلاع"],answer:"غبن یعنی زیاد بودن قیمت معامله از قیمت واقعی. طبق مادهٔ ۴۱۶ هرگاه قیمت معامله به قدر فاحش کمتر از قیمت واقعی باشد بایع خیار فسخ دارد (و به قرینهٔ مادهٔ ۴۰۱ خریدار هم اگر غبنیه متوجه او باشد). مادهٔ ۴۱۷ غبن را فاحش می‌داند اگر به‌عرف بیش از یک‌پنجم باشد. قابل استناد بودن غبن مشروط است به اینکه فروشنده از قیمت واقعی بی‌اطلاع بوده باشد (مادهٔ ۴۱۸) و در ضمن عرف محل، معاملهٔ غبنی معمول بوده باشد (مادهٔ ۴۱۹).",topic:"خیارات"},{q:"آثار بیعی که مبیع آن مستحق‌للغیر درآمده را توضیح دهید.",keywords:["مستحق‌للغیر","فسخ","استرداد ثمن","خسارت","منفعت"],answer:"اگر مبیع مستحق‌للغیر درآید و در نتیجه بیع باطل باشد، خریدار (طبق مادهٔ ۳۹۰) حق فسخ و استرداد کل ثمن دارد؛ اگر ثمن را نپرداخته معاف از پرداخت است. اگر مبیع منفعت هم برده باشد، فروشنده مانند مستأجر (مادهٔ ۳۹۲) اجاره‌بهای مدت استفاده را به خریدار بدهکار است. مبیع در حالت استرداد به حالت اولش (مادهٔ ۳۹۳) بازمی‌گردد.",topic:"بیع"},{q:"تفاوت ضمان قهری و ضمان قراردادی را با ذکر مثال توضیح دهید.",keywords:["ضمان قهری","ضمان عهدی","الحاق ذمه","اتلاف","غصب"],answer:"ضمان قراردادی (عهدی) عبارت است از الحاق ذمهٔ ضامن به ذمهٔ مدیون به‌عنوان ملتزم؛ یعنی کسی با اراده و توافق، دین دیگری را بر ذمهٔ خود می‌گیرد (مواد ۶۹۹ و ۷۰۰). ضمان قهری به‌حکم قانون و بدون توافق واقع می‌شود؛ مانند ضمان ناشی از اتلاف، تسبیب، غصب و استیفا؛ در این موارد مالک یا متضرر به‌طور قانونی بر متضرر حق دارد و متضامن هیچ توافقی نداشته است.",topic:"ضمان"},{q:"تعریف غصب و مسئولیت‌های غاصب نسبت به عین، منافع و مال مستغلات را بیان کنید.",keywords:["استیلا","تملیک ناروا","مثل مثل","عواید","نقص"],answer:"غصب (مادهٔ ۳۰۸) عبارت است از استیلا بر حق غیر به‌عنوان تملیک ناروا. آثار: غاصب باید مال مصلوب را به حالت اولش (اعم از عین) برگرداند و اگر عین تغییر کند یا تلف شود، مثل یا قیمت آن را بدهد (مادهٔ ۳۱۴). نسبت به منافع: اگر منفعت مندرآمد باشد باید مثل آن را بدهد و اگر عوض منفعت را بپردازد از ادای مثل معاف است (مادهٔ ۳۲۵). اگر مال با نصاب‌الزل به نقص برسد، غاصب ضامن است و باید خسارت را جبران کند.",topic:"غصب"},{q:"شفعه را تعریف کنید و شرایط جریان آن و وضعیت آن در املاک مسجّل را بیان نمایید.",keywords:["مشترک شفیع","جار","ملک مسجّل","ثبت","جزء جزء"],answer:"شفعه عبارت است از حق پیش‌خرید مشتری. مشترک شفیع است در بیع هر ملکی که شریک در آن ملک مشترک (مادهٔ ۸۰۸)؛ شفعهٔ جار نیز در ملک جار جاری است (مادهٔ ۸۰۹). شفعه فقط در ملک و فقط در بیع است؛ نه در اجاره، نه در هبه. در املاکی که موقع ثبت مجزا بوده و بعداً متصل شده (مادهٔ ۸۲۲) شفعهٔ جار جاری نیست؛ پس در املاک مسجّل عملاً شفعهٔ جار منتفی است. مشترک باید هرچه زودتر حق خود را اجرا کند.",topic:"شفعه"},{q:"تفاوت وصیت تملیکی و عهدی را بیان و حکم وصیت به بیش از ثلث را توضیح دهید.",keywords:["تملیکی","عهدی","ثلث","اجازهٔ ورثه","موصی"],answer:"وصیت تملیکی (مادهٔ ۸۲۸) تصرف در مال است؛ موصی مال خود را به دیگری تملیک می‌کند مانند وصیت به پرداخت ثلث به مؤسسهٔ خیریه. وصیت عهدی (مادهٔ ۸۲۹) امری است بر موصی؛ مانند وصیت به ادای دین یا نگهداری فرزند. اگر موصی به بیش از ثلث وصیت کند، وصیت در ثلث نافذ و مازاد به اجازهٔ ورثه موکول است (مادهٔ ۸۴۳)؛ پس ورثهٔ نابالغ هم حق رد یا قبول دارند و اجازهٔ ولی شرط است.",topic:"وصیت"},{q:"سهم زوج و زوجه از ارث یکدیگر را در فرض وجود و نبود فرزند بیان کنید.",keywords:["زوج","زوجه","ربع","نصف","یک‌هشتم","یک‌چهارم"],answer:"زوج (مرد) از ماتریس زن با وجود فرزند ربع و بدون فرزند نصف می‌برد (مادهٔ ۹۱۳). زوجه از ماتریک شوهر با وجود فرزند یک‌هشتم و بدون فرزند یک‌چهارم می‌برد (مادهٔ ۹۱۳ و ۹۰۶). وجود فرزند، سهم هر دو را کم می‌کند؛ فرزند شامل اولاد و اولادِ اولاد در صورتی که فرزند مستقیم نباشد.",topic:"ارث"},{q:"مسئولیت مدنی ناشی از اتلاف و تسبیب را توضیح دهید.",keywords:["اتلاف","تسبیب","مستقیم","واسطه","ضمان"],answer:"اتلاف (مادهٔ ۳۲۸) تلف کردن مال دیگری به‌طور مستقیم است؛ مانند شکستن شیشهٔ دیگری. در اتلاف مال مضمون است و متضرر می‌تواند مثل یا قیمت را بخواهد. تسبیب (مادهٔ ۳۳۱) آن است که انسان مستقیم مال دیگری را تلف نکرده بلکه واسطه‌ای برای تلف ایجاد کرده؛ مانند شکستن بند و ریزش اجسام. در تسبیب نیز مضمون است مگر مالک در نگاهداری مال خود کوتاهی کرده باشد (مادهٔ ۳۳۲).",topic:"مسئولیت مدنی"},{q:"عقد وکالت را تعریف کرده و علل زوال آن را نام ببرید.",keywords:["جایز","عزل","استعفا","فسخ","فوت","جنون"],answer:"وکالت (مادهٔ ۶۵۶) عقدی است که به‌موجب آن یکی از طرفین، طرف دیگر را برای انجام امری نایب خود می‌کند. وکالت عقدی جایز است؛ یعنی هر دو طرف در هر زمان می‌توانند آن را بر هم بزنند. علل زوال وکالت (مادهٔ ۹۵۴ ق.م. و مواد مربوط): فوت، جنون یا سفه وکیل یا موکل، عزل موکل، استعفای وکیل و فسخ یا فسخ عقد. وکالت بلاعزل نیز در واقع وکالت مقید به شرط ضمن عقد لازم است.",topic:"وکالت"}]},{id:"pack-desc-jaza",title:"دفترچهٔ تشریحی — حقوق جزا",exam:"نمونه سوالات تشریحی",examSlug:"tashrihi",branch:"حقوق جزا",description:"۱۰ پرسش تشریحی از سن مسئولیت، انواع قتل، دفاع مشروع، شروع به جرم و معاونت، جرایم مالی، حد سرقت، دیه و قواعد فقهی — با پاسخ نمونهٔ منظم.",minutes:50,kind:"descriptive",questions:[{q:"سنّ مسئولیت کیفری در قانون مجازات اسلامی را توضیح دهید.",keywords:["۹ سال","مستشعر","۱۸ سال","تعزیر","جایگزین"],answer:"طبق مادهٔ ۱۴۵، اطفال کمتر از ۹ سال قمری فاقد مسئولیت کیفری‌اند و صرفاً اقدامات تربیتی/تأمینی دربارهٔ آن‌ها اعمال می‌شود. اطفال ۹ تا ۱۵ سال قمری (مادهٔ ۱۴۴) نیز در صورت احراز نداشتن «مستشعر بودن» (تعلق قلبی به جرم) از مسئولیت کیفری مستثنا می‌شوند. نوجوانان کمتر از ۱۸ سال در جرایم تعزیری، به‌جای مجازات اصلی، از مجازات‌های جایگزین حبس و تدابیر مادهٔ ۸۸ استفاده می‌کنند و برای جرایم تعزیرات درجهٔ یک تا سه نیز قواعد خاص دارند.",topic:"مسئولیت کیفری"},{q:"تفاوت قتل عمد، شبه‌عمد و خطای محض را با مثال توضیح دهید.",keywords:["عمد در فعل","عمد در نتیجه","شکار","دیه","قصاص"],answer:"قتل عمد (مادهٔ ۲۹۰) وقتی است که عمد در ارتکاب فعل مسبق، عمد در وقوع نتیجه (قتل) و مشروعیت فعل مسبق جمع باشد؛ مثال: ضربت زدن با قصد کشتن. شبه‌عمد (مادهٔ ۲۹۱) وقتی است که عمد در فعل هست ولی عمد در نتیجه نیست و مرتکب معمولاً قتل را نتیجهٔ فعل خود نمی‌داند؛ مثال: شلیک شکارچی به سمت حیوان که به انسان می‌خورد. خطای محض (مادهٔ ۲۹۲) وقتی است که نه عمد در فعل و نه عمد در نتیجه وجود دارد؛ مثال: ریزش اجسام بدون سهل‌انگاری. قتل عمد موجب قصاص (با شرایط آن) و دو مورد دیگر موجب دیه است؛ در خطای محض دیه از بیت‌المال و در شبه‌عمد از عاقله پرداخت می‌شود.",topic:"قتل"},{q:"شرایط دفاع مشروع را بیان کنید.",keywords:["تجاوز","ضرورت","متناسب بودن","حین تجاوز","عدم امکان مراجعه"],answer:"دفاع مشروع در مادهٔ ۱۵۲ تعریف شده و شروط آن در مواد ۱۵۳ و ۱۵۴ آمده است: ۱) تجاوز متجاوز واقعاً وجود داشته باشد (تجاوز واقعی یا موجه)، ۲) تجاوز عمدی یا در حکم عمدی باشد، ۳) دفاع در حین تجاوز صورت گیرد، ۴) دفاع ضرورت داشته باشد یعنی عدم امکان مراجعه به مقامات یا عدم امکان دسترسی به‌موقع آنها، ۵) دفاع به اندازهٔ لازم باشد (متناسب بودن). اگر همهٔ شرایط جمع باشد، مدافع و حتی شخص ثالثی که کمک کند مسئولیت کیفری ندارد.",topic:"دفاع مشروع"},{q:"شروع به جرم و معاونت در جرم را تعریف کنید و تفاوت آن‌ها را بیان نمایید.",keywords:["اقدام لازم","شرع","درجهٔ پایین‌تر","تحریک","تسهیل"],answer:"شروع به جرم (مادهٔ ۱۲۱) عبارت است از شروع به اجرای جرم با قصد ارتکاب آن، که به هر دلیلی مقدم بر حصول نتیجه متوقف بماند؛ مانند شلیک با قصد قتل که به هدف نمی‌خورد. مجازات شروع به جرم در جرایم تعزیری (مادهٔ ۱۲۲) یک تا دو درجه پایین‌تر از جرم تام است. معاونت (مادهٔ ۱۲۶) عبارت است از کمک بدون مشارکت مستقیم در وقوع جرم؛ از قبیل تحریک، ترغیب، تهدید، تطمیع، تدارک وسایل و تسهیل عمل؛ مجازات معاون یک درجه پایین‌تر از فاعل است (مادهٔ ۱۲۷). تفاوت: در شروع به جرم، مرتکب مستقیماً در اجرای جرم می‌کوشد ولی نتیجه حاصل نمی‌شود؛ در معاونت، جرم توسط فاعل اصلی کامل می‌شود و معاون صرفاً مساعدت داشته است.",topic:"شروع به جرم"},{q:"ارکان جرم کلاهبرداری را توضیح دهید.",keywords:["توسل به وسایل متقلبانه","بردن مال","وسایل","خسارت","رد مال"],answer:"ارکان کلاهبرداری: ۱) رکن مادی: توسل به وسایل متقلبانه (مقالهٔ دروغ، عناوین ساختگی، اختراع ابزار و مانند آن)، بردن مال دیگری و توسل به وسایل متقلبانه برای بردن مال؛ ۲) رکن روانی: عمد و سوءنیت برای بردن مال؛ ۳) رکن قانونی: مادهٔ ۱ قانون تشدید مجازات مرتکبین ارتشا، اختلاس و کلاهبرداری. مجازات حبس از یک تا هفت سال و جزای نقدی معادل مال مأخوذه است و مرتکب به رد مال نیز محکوم می‌شود. وجه تمایز از فریب ساده، وجود وسایل متقلبانه است.",topic:"جرایم مالی"},{q:"خیانت در امانت را تعریف کرده و آن را از کلاهبرداری متمایز کنید.",keywords:["امانت","استعمال","تلف","مفقود کردن","وسایل متقلبانه"],answer:"خیانت در امانت (مادهٔ ۶۷۴ قانون تعزیرات) آن است که کسی مال منقول یا غیرمنقولی را که به‌نحوی از انحاء (ودیعه، وکالت، اجاره، امانت و...) به او سپرده شده، به قصد استعمال یا تملک یا مفقود کردن، مورد استفاده یا تلف قرار دهد؛ مجازات آن حبس از شش ماه تا سه سال است. تفاوت با کلاهبرداری: در خیانت در امانت، مال به‌صورت امانی و با رضایت صاحب مال به مرتکب رسیده و سپس مورد خیانت واقع می‌شود؛ ولی در کلاهبرداری، مال از ابتدا با توسل به وسایل متقلبانه و فریب از صاحب مال گرفته می‌شود. در خیانت در امانت، استرداد مال پیش از صدور کیفرخواست موجب معافیت از مجازات است (مادهٔ ۶۷۵).",topic:"جرایم مالی"},{q:"شرایط حد سرقت را بیان کنید.",keywords:["حِرز","شکستن","نصاب","صبر و استیفا","بی‌خطر بودن"],answer:"شرایط حد سرقت: ۱) مال مسروقه در حِرز (محل مطمئن) بوده باشد، ۲) سرقت با شکستن حِرز (کلید یا...) انجام شده باشد، ۳) مال مسروقه دارای حداقل قیمت معیّن (نصاب) باشد، ۴) مال از مالک بدون رضایت او گرفته شده باشد و مالک آن را فروخته باشد (مادهٔ ۲۶۶ به بعد). جریان حد مشروط به صبر و استیفا و مطابق مواد ۲۶۸ و ۲۶۹ است؛ یعنی اعتراف یا شهادت در جلسهٔ نخست برای جریان حد کافی نیست و جانی باید در جلسهٔ دوم مجازات شود. اگر شرایط حد جمع نشود، سرقت غیرحدی (تعزیری) خواهد بود.",topic:"سرقت"},{q:"دیه و شرایط پرداخت آن را توضیح دهید.",keywords:["جنایت","قصد","عاقله","بیت‌المال","نسبت"],answer:"دیه مال‌ای است که به سبب جنایت به غیر نفس یا جنایت بر نفس (به‌جز موارد قصاص) به مجنی‌علیه یا ولیّ او داده می‌شود. دیه در جنایت‌های مختلف برحسب نوع جنایت و اینکه عمدی، شبه‌عمد یا خطای محض باشد، به‌ترتیب از جانی، عاقله یا بیت‌المال پرداخت می‌شود. دیهٔ نفس کامل (مادهٔ ۴۵۱) معادل صد شتر یا معادل‌های آن است؛ در ماه‌های حرام و در محدودهٔ حرام مکه، دیه با افزودن یک‌سوم افزایش می‌یابد (مادهٔ ۴۵۰). دیه با وحدت مال و جبران خسارت معنوی متفاوت است.",topic:"دیه"},{q:"قواعد دفع و احتراز را توضیح دهید.",keywords:["دفع","ردع","احتراز","بیت‌المال","دیگی"],answer:"قاعدهٔ دفع و ردع (مادهٔ ۱۶): هرکس به‌موجب قاعدهٔ دفع یا ردع، جنایتی را واقع کند یا شخص ثالثی در حال دفاع به دیگری جنایت برساند، عاقله یا جانی ضامن نیست و دولت باید دیهٔ کامل را بپردازد. قاعدهٔ احتراز (مادهٔ ۱۶۶): هرکس وسیله‌ای داشته باشد که اجرای آن موجب جنایت دیگری شود و به‌موجب احتراز جنایت واقع شود، عاقله یا جانی ضامن نیست (مانند جلوگیری از انتقال بیماری). در هر دو قاعده، دیه از بیت‌المال پرداخت می‌شود.",topic:"قواعد فقهی"},{q:"جعل مادی و معنوی اسناد را تعریف کنید.",keywords:["مادی","معنوی","الحاق","ساخت","رسمی","غیررسمی"],answer:"جعل مادی آن است که سند یا نوشتهٔ دیگری را بدون رضایت او تراشیدن، ترمیم، الحاق، تحصیل یا امضا به‌طور متقلبانه تغییر دهند یا سند ساختگی بسازند (مادهٔ ۵۲۳ قانون تعزیرات). جعل معنوی آن است که در یک سند حقیقی، مطالب خلاف واقع یا با تلریغ فریبنده درج شود یا مضمون حقیقی تغییر داده شود (مانند تغییر تاریخ یا نام). جعل اسناد غیررسمی حبس از شش ماه تا دو سال و جعل اسناد رسمی حبس از یک تا پنج سال دارد (مادهٔ ۵۲۴). استفاده از سند مجعول نیز با علم به جعلی بودن، همان مجازات جاعل را دارد (مادهٔ ۵۴۲).",topic:"جعل"}]},{id:"pack-desc-dadresi",title:"دفترچهٔ تشریحی — آیین دادرسی مدنی",exam:"نمونه سوالات تشریحی",examSlug:"tashrihi",branch:"آیین دادرسی مدنی",description:"۱۰ پرسش تشریحی از صلاحیت دادگاه‌ها، دادخواست، دعوای متقابل، ادلهٔ اثبات، تجدیدنظر، واخواهی، فرجام و اجرای احکام — با پاسخ نمونهٔ کامل.",minutes:50,kind:"descriptive",questions:[{q:"انواع صلاحیت دادگاه‌ها (ذاتی، محلی، شخصی) را توضیح دهید.",keywords:["ذاتی","محلی","شخصی","توافق","اعتراض"],answer:"صلاحیت ذاتی: تعیین اینکه چه مرجعی (دادگاه عمومی/صدر/کیفری و...) صالح است؛ از طرف قوانین معین می‌شود و قابل توافق نیست (مادهٔ ۵). صلاحیت محلی: تعیین اینکه دادگاهی از نظر مکانی صالح است؛ اساس آن اقامتگاه خوانده است (مادهٔ ۱۱) و در اموال غیرمنقول، محل وقوع مال (مادهٔ ۱۲). صلاحیت شخصی: مربوط به سمت و مرجع رسیدگی به اشخاص خاص (مانند کارکنان نظامی) است. در صلاحیت محلی، طرفین در موارد خاص می‌توانند تراضی کنند ولی در صلاحیت ذاتی چنین حقی ندارند.",topic:"صلاحیت"},{q:"مفاد دادخواست و موجبات پذیرش آن را بیان کنید.",keywords:["خواسته","بهای خواسته","دلایل","پیوست","رفع نقص"],answer:"دادخواست باید مطابق مادهٔ ۵۱ شامل: نام و نام خانوادگی و نشانی خواهان و خوانده، خواسته و بهای آن، دلایل و منضمات، امضا و تاریخ، و دعوای اصلی و طاری باشد. اگر دادخواست فاقد یکی از موجبات باشد، دادگاه نقص را به خواهان ابلاغ و ۱۰ روز برای رفع نقص می‌دهد (مادهٔ ۵۱)؛ در صورت عدم رفع، دادخواست رد می‌شود. بهای خواسته مبنای هزینهٔ دادرسی دعاوی مالی است.",topic:"دادخواست"},{q:"دعوای متقابل را تعریف کنید و شرایط پذیرش آن را بیان نمایید.",keywords:["خوانده","ارتباط کامل","جلسهٔ دوم","اصل دعوا"],answer:"دعوای متقابل دعوایی است که خوانده در مقابل دعوای خواهان اقامه می‌کند. شرایط پذیرش (مادهٔ ۱۴۳): ۱) تقدیم آن تا پایان جلسهٔ دوم رسیدگی، ۲) ارتباط کامل با دعوای اصلی، ۳) دعوای متقابل در دادگاه همان صالحی است که دعوای اصلی را رسیدگی می‌کند. دعوای متقابل برای رسیدن به نتیجهٔ واحد و جلوگیری از تعارض احکام است؛ اگر شرایط نباشد، باید به‌عنوان دعوای مستقل در دادگاه صالح اقامه شود.",topic:"دعوای متقابل"},{q:"ادلهٔ اثبات دعوا در قانون آیین دادرسی مدنی را نام برده و هر یک را توضیح دهید.",keywords:["اقرار","سوگند","شهادت","کارشناسی","مستندات"],answer:"ادلهٔ اثبات (مواد ۱۹۴ به بعد): ۱) اقرار: اعتراف صریح یا ضمنیِ طرف به وقوع موضوع دعوا؛ اقرار قاطع دعواست. ۲) اسناد و مستندات کتبی. ۳) شهادت گواه: گواهی شهود در موارد مقرر. ۴) سوگند: اثبات بر مدعی و سوگند بر منکر است؛ سوگند حافظ و سوگند تکمیلی از اقسام آن‌اند. ۵) کارشناسی: در امور فنی که تشخیص قاضی از آن کافی نیست. ۶) معاینهٔ محل. بار اثبات بر مدعی است و منکر با سوگند دفاع می‌کند.",topic:"دلایل"},{q:"اقرار و آثار آن را توضیح دهید.",keywords:["صریح","ضمنی","قاطع دعوا","در دادخواست","قابل تجزیه"],answer:"اقرار عبارت است از خبر دادن به وقوع امری بر زبان، اعم از صریح یا ضمنی (مادهٔ ۱۲۵۹ قانون مدنی). اقسام: اقرار در دادگاه، اقرار در دادخواست یا لوایح، اقرار خارج از دادگاه. اقرار قاطع دعواست و نیازی به اقامهٔ دلیل دیگر نیست؛ اگر اقرار قابل تجزیه نباشد، تمام آن لازم‌العمل است (نمی‌توان جزئی را انکار کرد). اقرار ضمنی نیز وقتی است که اظهارات طرف بر اساس ظواهر، معرف وقوع امر باشد.",topic:"دلایل"},{q:"شهادت گواه و شرایط گواه را بیان کنید.",keywords:["مطالعه","مستقیم","عدم منفعت","احراز هویت","تعارف"],answer:"شهادت عبارت است از خبر دادن شاهد به وقوع امری مطابق مشاهده یا استماع مستقیم. شرایط گواه: بلوغ، عقل، صحت چشم و گوش، عدم منفعت و عدم دشمنی با طرفی که علیه او گواهی می‌دهد و آگاهی مستقیم از موضوع. شهادت باید در جلسهٔ دادرسی ادا شود و احراز هویت شاهد لازم است. شهادت شاهد باید مطابق مادهٔ ۲۱۹ به بعد از آن‌ها استماع شود و در صورتی معتبر است که سوءظن به آن نباشد.",topic:"دلایل"},{q:"شرایط و مهلت تجدیدنظرخواهی را توضیح دهید.",keywords:["۲۰ روز","ابلاغ","دادخواست","دادگاه بدوی","غیرقابل تجدیدنظر"],answer:"تجدیدنظرخواهی درخواست بازنگری حکم بدوی است. مهلت آن برای اشخاص ساکن ایران ۲۰ روز و برای اشخاص مقیم خارج ۲ ماه از تاریخ ابلاغ یا انقضای مهلت اعتراض واخواهی است (مادهٔ ۳۳۶). دادخواست تجدیدنظر باید به دادگاه صادرکنندهٔ حکم بدوی تقدیم شود (مادهٔ ۳۳۷) و در آن درخواست و دلایل ذکر شود. احکام قطعی مثل حکم در دعوای با خواستهٔ کمتر از حد معین و امور حسبی قابل تجدیدنظر نیست.",topic:"تجدیدنظر"},{q:"واخواهی را تعریف کرده و تفاوت آن با تجدیدنظرخواهی را بیان کنید.",keywords:["حکم غیابی","محکوم‌علیه غایب","۲۰ روز","ابلاغ واقعی","تجدیدنظر"],answer:"واخواهی اعتراض محکوم‌علیه غایب به حکم غیابی است. محکوم‌علیه غایب می‌تواند ۲۰ روز پس از ابلاغ واقعی، واخواهی کند (مادهٔ ۳۰۵). تفاوت با تجدیدنظر: واخواهی فقط برای محکوم‌علیه غایب و نسبت به حکم غیابی است و به همان دادگاه صادرکننده سپرده می‌شود و دادگاه مجدداً رسیدگی می‌کند؛ ولی تجدیدنظر به دادگاه بالاتر می‌رود و نسبت به حکم حضوری است. پس از واخواهی، دادگاه می‌تواند حکم را رد یا تعدیل کند.",topic:"واخواهی"},{q:"فرجام‌خواهی را تعریف کرده و موارد قابل فرجام‌خواهی بودن را بیان کنید.",keywords:["قطعی","نقض","اصل نکاح","۲۰ روز","دیوان عالی"],answer:"فرجام‌خواهی درخواست بازنگری حکم قطعی است. مهلت آن ۲۰ روز از ابلاغ است (مادهٔ ۳۶۷). همهٔ احکام فرجام‌خواهی نیست؛ طبق مادهٔ ۳۷۱، احکام زیر قابل فرجام‌خواهی‌اند: احکام راجع به اصل نکاح و فسخ آن، طلاق، نسب، وقف، ثلث، وصیت، تولیت، و جبران ضرر و زیان‌های معنوی. فرجام‌خواهی فقط برای نقض قانون است و دادگاه فرجام به ماهیت نمی‌پردازد مگر نقض لازم باشد.",topic:"فرجام"},{q:"اجرای احکام مدنی را توضیح دهید.",keywords:["محکوم‌له","درخواست","اجرای احکام","قطعیت","توقیف اموال"],answer:"اجرای حکم با درخواست محکوم‌له شروع می‌شود (مادهٔ ۱۴۳). برای اجرا، حکم باید قطعی یا قابل اجرا باشد. مرجع اجرا، واحد اجرای احکام دادگاه است. محکوم‌علیه مکلف به اجرای اختیاری است و در صورت امتناع، اجرا از طریق توقیف اموال، پرداخت از محل توقیفی‌ها و در صورت لزوم جلب انجام می‌شود. مکانیسم‌های اجرایی مانند دستور موقت و تأمین خواسته نیز ابزارهای مقدم بر اجرا هستند.",topic:"اجرای احکام"}]},{id:"pack-tadris-jaza-desc",title:"دفترچهٔ تشریحی — تدریس جزا (کلیات جزا)",exam:"نمونه سوالات تشریحی",examSlug:"tashrihi",branch:"حقوق جزا",description:"۲۹ پرسش تشریحی برگرفته از جزوهٔ تدریس جزا احمد غفوری (صفحات ۱ تا ۵۰): اصل قانونی بودن و استثناهایش، عناصر مادی و روانی جرم، تقارن و تطابق، چهار قاعده و پنج اصل صلاحیت، جدول قواعد، الگوریتم تشخیص صلاحیت و قلمرو زمان — با پاسخ نمونهٔ کامل و کلیدواژه‌های نمره‌آور.",minutes:90,kind:"descriptive",questions:[{q:"تقسیم‌بندی پنج‌گانهٔ قانون مجازات اسلامی را همراه با مواعد هر کتاب بیان کنید.",keywords:["کلیات","حدود","قصاص","دیات","تعزیرات","۱۳۷۵ و ۱۳۸۸"],answer:"بر اساس مادهٔ ۱، قانون مجازات مشتمل بر جرایم و مجازات‌ها، شرایط و موانع مسئولیت کیفری و قواعد حاکم است و پنج کتاب دارد: ۱) کلیات (جزای عمومی): مواد ۱ تا ۲۱۶ — مباحث کلی، نه جرم خاص؛ ۲) حدود: مواد ۲۱۷ تا ۲۸۸ — سیزده جرم حدی از قبیل زنا، لواط، تفخیذ، مساحقه، قوادی، قذف، سبّ النبی، مصرف مسکر، سرقت حدی، محاربه، بغی، افساد فی‌الارض و ارتداد؛ ۳) قصاص: مواد ۲۸۹ تا ۴۴۷؛ ۴) دیات: مواد ۴۴۸ تا ۷۲۸؛ ۵) تعزیرات: مواد ۴۹۸ تا ۷۸۵ ق.م.ا.ت مصوب ۱۳۷۵ و الحاقی ۱۳۸۸.",topic:"کلیات"},{q:"عنصر قانونی جرم را تعریف کرده و مستندات قانونی اصل قانونی بودن جرم و مجازات را بیان کنید.",keywords:["مادهٔ ۲","مادهٔ ۱۲","اصل ۱۶۷","مادهٔ ۲۲۰","فعل یا ترک فعل"],answer:"عنصر قانونی یعنی رفتار پیش از ارتکاب در قانون عام و مکتوب جرم شناخته و برایش مجازات تعیین شده باشد. مستندها: مادهٔ ۲ ق.م.ا («هر رفتاری اعم از فعل یا ترک فعل که در قانون برای آن مجازات تعیین شده است جرم محسوب می‌شود»)، مادهٔ ۱۲ (حکم به مجازات و اقدام تأمینی و تربیتی و اجرای آن باید از طریق دادگاه صالح، به موجب قانون و با رعایت شرایط و کیفیت مقرر باشد)، اصل ۱۶۷ قانون اساسی (حکم از قوانین مدونه؛ در سکوت، نقص، اجمال یا تعارض، حکم به موجب منابع معتبر اسلامی یا فتاوی معتبر) و مادهٔ ۲۲۰ (در حدود ذکرنشده طبق اصل ۱۶۷ عمل می‌شود).",topic:"عنصر قانونی"},{q:"سه نتیجهٔ اصل قانونی بودن جرم و مجازات را نام برده و هر یک را با مثال توضیح دهید.",keywords:["تفسیر مضیق","عطف به ماسبق نشدن","ممنوعیت قیاس","مادهٔ ۵۱۳","مادهٔ ۲۷۹"],answer:"۱) تفسیر مضیق: ماده را به کمترین مصادیق ممکن می‌فهمیم؛ در شک، فرض بر یک رفتار است. مثال: مادهٔ ۵۱۳ (اهانت به مقدسات) — پرسش اینکه انجیل و توراتِ تحریف‌شده جزء مقدسات اسلام است با تفسیر مضیق به نفع متهم حل می‌شود. ۲) عطف به ماسبق نشدن: قانون فقط رفتارهای پس از لازم‌الاجراشدن را می‌گیرد؛ مثال: مجازات تکمیلی جرایم درجات ۷ و ۸ که محصول قانون ۱۱ تیر ۱۳۹۹ است به جرم درجه هفتِ سال ۱۳۹۸ تعلق نمی‌گیرد. ۳) ممنوعیت قیاس: نمی‌توان با استناد به اشتراک «علت»، رفتار ذکرنشده در ماده را مشمول آن کرد؛ مثال: توسعهٔ محاربهٔ مادهٔ ۲۷۹ به هر رفتار ناامن‌کننده.",topic:"اصل قانونی بودن"},{q:"استثناهای اصل قانونی بودن (موارد جواز قیاس، تفسیر موسع و عطف به ماسبق) را توضیح دهید.",keywords:["قوانین مساعد","قوانین شکلی","مادهٔ ۳۸","مادهٔ ۲۸۰","مادهٔ ۴۴۲","رأی ۷۵۶"],answer:"دو مورد است: ۱) قوانین مساعد به حال متهم یا مجرم — قوانینی که موجب مجازات نشدن، عدم اجرا یا کاهش مجازات می‌شوند؛ در آن‌ها تفسیر موسع و عطف به ماسبق مجاز است. مثال: مادهٔ ۳۸ (جهات تخفیف؛ «کوشش متهم» حتی غیرمؤثر با تفسیر موسع پذیرفته می‌شود) و کاهش مجازات خیانت در امانت از ۶ ماه-۳ سال به ۳ ماه-۱.۵ سال که به جرم ۱۳۹۸ هم اعمال می‌شود. ۲) قوانین شکلی و تفسیری — قوانین شکلی شکل رسیدگی را تعیین می‌کنند و تفسیری مادهٔ موجود را تفسیر می‌کنند؛ در آن‌ها قیاس و تفسیر موسع مجاز است. مثال: مادهٔ ۲۸۰ ق.آ.د.ک (عنوان کیفرخواست مانع تعیین عنوان صحیح نیست) و مادهٔ ۴۴۲ ق.آ.د.ک (اسقاط حق تجدیدنظر با کسر یک‌چهارم مجازات) که طبق رأی وحدت رویهٔ ۷۵۶ شامل اسقاط حق فرجام‌خواهی هم می‌شود.",topic:"استثناهای اصل قانونی بودن"},{q:"تقسیم‌بندی جرایم بر اساس ماهیت رفتار و اجزای تشکیل‌دهندهٔ عنصر مادی را با مثال بیان کنید.",keywords:["فعل","ترک فعل","فعل ناشی از ترک فعل","حالت","مرکب","به عادت","ساده","کلاهبرداری","تکدی"],answer:"ماهیت رفتار چهار حالت دارد: ۱) فعل (زدن، بردن)؛ ۲) ترک فعل (ترک انفاق)؛ ۳) فعل ناشی از ترک فعل؛ ۴) حالت (نگهداری مواد مخدر، حمل اسلحه). اجزای تشکیل‌دهنده سه گروه است: ۱) مرکب: چند فعل متفاوت، مثل کلاهبرداری (توسل به وسایل متقلبانه + بردن مال غیر)؛ ۲) به عادت: تکرار یک فعل شبیه هم، مثل تکدی‌گری (مادهٔ ۲ ق.م.ا.ت)؛ ۳) ساده: یک بار ارتکاب فعل، مثل جعل و سرقت.",topic:"عنصر مادی"},{q:"تقسیم‌بندی جرایم بر اساس طول زمان (امتداد عنصر مادی) را با مثال و نقش رأی وحدت رویهٔ ۸۲۲ توضیح دهید.",keywords:["آنی","مستمر","استمراریافته","تغییر کاربری","فرار از زندان","ترک انفاق"],answer:"۱) آنی: عنصر مادی در یک لحظه محقق می‌شود (مانند قتل آدمی)؛ ۲) مستمر: عنصر مادی در طول زمان تکرار می‌شود؛ مثال‌ها: ترک انفاق، پوشیدن لباس نظامی، نگهداری مواد مخدر، حمل اسلحه؛ ۳) استمراریافته (در حکم آنی): عنصر مادی در یک لحظه است ولی نتایج آن ادامه دارد؛ مثال‌ها: تغییر کاربری اراضی، ساخت‌وساز غیرمجاز، فرار از زندان. رأی وحدت رویهٔ ۸۲۲ تصریح می‌کند تغییر کاربری اراضی عنصر مادی یک‌باره دارد و ادامهٔ وضعیت، تکرار جرم نیست؛ یعنی جرم در حکم آنی است.",topic:"امتداد زمانی"},{q:"جرایم مطلق و مقید به نتیجه را تعریف کنید و با استناد به مواد ۶۰۸، ۲۷۹ و ۵۶۰ توضیح دهید.",keywords:["صرف رفتار","موجب ناامنی","خرابی یا لطمه","۶۰۸","۲۷۹","۵۶۰"],answer:"جرم مطلق: صرف رفتار برای تحقق کافی است و نیازی به نتیجه ندارد؛ نمونه: توهین مادهٔ ۶۰۸ ق.م.ا.ت (فحاشی و الفاظ رکیک به شرط عدم مشمولیت قذف). جرم مقید: علاوه بر فعل، تحقق نتیجه لازم است؛ نمونه‌ها: محاربهٔ مادهٔ ۲۷۹ («به نحوی که موجب ناامنی در محیط گردد») و مادهٔ ۵۶۰ (عملیات در حریم آثار تاریخی که «سبب تزلزل بنیان شود یا خرابی یا لطمه وارد آید» با الزام به رفع آثار تخلف و پرداخت خسارات، علاوه بر حبس ۱ تا ۳ سال). عبارت «به نحوی که موجب/منجر به ...» نشانهٔ مقید بودن است؛ مادهٔ ۷۴۵ (انتشار خصوصی) هم با شرط «منجر به ضرر یا هتک حیثیت» مقید است.",topic:"مطلق و مقید"},{q:"سوءنیت عام و سوءنیت خاص را تعریف کرده و با مثال‌های جزوه تفاوت آن‌ها را بیان کنید.",keywords:["اراده","آگاهی","قصد نتیجه","مادهٔ ۱۴۴","مال خود","خواب","مستی"],answer:"سوءنیت عام: داشتن اراده هنگام ارتکاب جرم و آگاهی به موضوع جرم (قسمت اول مادهٔ ۱۴۴) و در همهٔ جرایم عمدی لازم است؛ مثال‌های نقض: برداشتن مال دیگری با تصور مال خود (فقدان آگاهی)، تخریب در حال خواب و سرقت در مستیِ کلاً مسلوب‌الاراده (فقدان اراده). سوءنیت خاص: قصد نتیجه در جرایم مقید به نتیجه (قسمت انتهایی مادهٔ ۱۴۴)؛ نتیجه باید ناشی از قصد و رفتار مرتکب باشد؛ مثال: قصد اضرار در تشویش اذهان (۶۹۸) و در کیس جزوه، کشیدن سلاح برای ارعاب بدهکار (نه مردم) که با پخش فیلم توسط همسایه ناامنی شهر در پی داشت — محاربه محقق نمی‌شود چون قصد و نتیجهٔ ناشی از قصد نیست.",topic:"عنصر روانی"},{q:"تقصیر در جرایم غیرعمدی را تعریف کرده، مصادیق آن را بر اساس تبصرهٔ مادهٔ ۱۴۵ بیان و شرط رابطهٔ علیت را با مثال توضیح دهید.",keywords:["بی‌احتیاطی","بی‌مبالاتی","مسامحه","غفلت","عدم مهارت","نظامات دولتی","برف‌پاک‌کن"],answer:"مادهٔ ۱۴۵: تحقق جرایم غیرعمدی منوط به احراز تقصیر مرتکب است و در جنایات غیرعمدی (شبه‌عمد و خطای محض) مقررات کتاب قصاص و دیات اعمال می‌شود. تبصره: تقصیر اعم از بی‌احتیاطی و بی‌مبالاتی است و مسامحه، غفلت، عدم مهارت و عدم رعایت نظامات دولتی از مصادیق آن‌اند. نکتهٔ ۱۲: بین تقصیر و جرم باید رابطهٔ علیت باشد. مثال ۲۰: راننده با برف‌پاک‌کن خراب در روز آفتابی با رعایت مقررات، با عابری که در محل غیرمجاز ناگهانی جلوی ماشین می‌پرد تصادف می‌کند؛ خرابی برف‌پاک‌کن علت تصادف نبوده، پس علیت منتفی و جرم غیرعمدی شکل نمی‌گیرد.",topic:"جرایم غیرعمدی"},{q:"تفاوت انگیزه با سوءنیت خاص را توضیح داده و با مثال بیان کنید که انگیزه چه اثری در تحقق جرم دارد.",keywords:["هدف نهایی","بی‌تأثیر","انتقام","قصد نتیجه"],answer:"انگیزه، هدف نهایی و «چرایی» رفتار مرتکب است؛ سوءنیت خاص، قصد نتیجهٔ مجرمانهٔ مقرر در ماده است. طبق نکتهٔ ۱۳ جزوه، انگیزهٔ مرتکب در تحقق جرم اصولاً بی‌تأثیر است. مثال ۲۱: «الف» به «ب» توهین کرده و «ب» برای انتقام با قصد قتل تیری به مغز «الف» می‌زند و «الف» می‌میرد؛ انگیزهٔ انتقام نه قتل را منتفی می‌کند و نه آن را تغییر می‌دهد؛ آنچه قتل عمد را می‌سازد قصد نتیجه (مرگ) در شلیک است.",topic:"انگیزه"},{q:"قواعد تقارن و تطابق عنصر مادی و روانی را با مثال‌های جزوه (۲۲ تا ۲۷) توضیح دهید.",keywords:["اول عنصر مادی","هم‌زمانی","عنوان مجرمانه","دفن زنده","پرتاب سنگ"],answer:"نکتهٔ ۱۴: ابتدا عنصر مادی و سپس عنصر روانی بررسی می‌شود؛ مثال ۲۲: ربودن سکه‌های پدر که یک ساعت قبل فوت کرده و وارث اوست — «مال غیر» منتفی است و هرچند قصد بود، جرم شکل نمی‌گیرد. نکتهٔ ۱۵ (تقارن): قصد و رفتار باید هم‌زمان جمع شوند؛ مثال ۲۳: برداشتن ساعت با تصور مالِ خود و تصاحبِ بعدی (سرقت نیست)؛ مثال ۲۴: ضرب چوب با قصد قتل که نتیجه نگرفت و سپس دفنِ زنده با تصور جسد — قصد قتل با رفتارِ مسبب مرگ هم‌زمان نبود. نکتهٔ ۱۶ (تطابق): معیار، «عنوان مجرمانه» است؛ مثال ۲۵: پرتاب سنگ با قصد قتل که فقط تخریب آورد، تخریب را نمی‌سازد؛ ولی مثال ۲۶ و ۲۷ نشان می‌دهند خطای هدف (اصابت به مال علی به‌جای حسن) تطابق عنوان تخریب را نمی‌شکند.",topic:"تقارن و تطابق"},{q:"چهار قاعدهٔ کلیدی قلمرو مکان (شرط یافت/اعاده، مجرمیت متقابل، منع محاکمه و مجازات مضاعف، قاعدهٔ احتساب) را تعریف کنید.",keywords:["یافت","اعاده","دو کشور","تبرئه","کسر مجازات"],answer:"۱) شرط یافت یا اعاده به ایران: «یافت» یعنی مرتکب در ایران پیدا شود؛ «اعاده» یعنی دولت خارجی او را به ایران تسلیم کند. ۲) مجرمیت متقابل: رفتار هم در ایران و هم در کشور محل وقوع جرم باشد. ۳) قاعدهٔ منع محاکمه و مجازات مضاعف: اگر مجرم در خارج محاکمه و تبرئه شده یا مجازات شده باشد، دیگر در ایران محاکمه و مجازات نمی‌شود. ۴) قاعدهٔ احتساب: اگر مجرم در خارج محاکمه و مجازات شده بود، در ایران مجازات می‌شود اما میزان مجازات تحمل‌شده در خارج از محکومیت کسر می‌شود؛ مثال جزوه: سرقت با مجازات ایرانی ۵ سال که در انگلیس ۲ سال اجرا شده — طبق احتساب در ایران ۳ سال باقی می‌ماند.",topic:"قواعد چهارگانه"},{q:"صلاحیت سرزمینی را با مستند قانونی تعریف کنید و توضیح دهید چرا در این صلاحیت هیچ‌یک از قواعد چهارگانه رعایت نمی‌شود.",keywords:["مواد ۳ و ۴","بخشی از عملیات","نتیجه","نکتهٔ ۱۸"],answer:"صلاحیت سرزمینی (مواد ۳ و ۴): تمام یا بخشی از عملیات مادی جرم یا نتیجهٔ جرم در قلمرو حاکمیت ایران واقع شود؛ مادهٔ ۴ می‌گوید «قسمتی از جرم یا نتیجهٔ آن» کافی است. مثال‌ها: توسل به وسایل متقلبانه در ایران و بردن مال در ترکیه (۳۳)؛ شلیک در عراق و فوت در ایران (۳۴)؛ نوشتن نام در شناسنامهٔ جعلی در ایران و تکمیل در آلمان (۳۵)؛ خرید دستگاه چاپ اسکناس در ایران و جعل در ترکیه (۳۶). نکتهٔ ۱۸: در این صلاحیت هیچ‌یک از قواعد (مجرمیت متقابل، یافت/اعاده، احتساب، منع مضاعف) رعایت نمی‌شود؛ چون جرم عملاً «در ایران» رخ داده است و این قواعد فقط برای جرایم خارجی طراحی شده‌اند.",topic:"صلاحیت سرزمینی"},{q:"صلاحیت شناور را توضیح داده و شروط رسیدگی دادگاه ایران نسبت به کشتی‌ها و هواپیماهای غیرجنگی خارجی را بنویسید.",keywords:["کشتی و هواپیما","چهار شرط","سه شرط","قاچاق مواد مخدر","فرود در ایران"],answer:"نکتهٔ ۱۹: جرایم در کشتی و هواپیمای ایرانی هر کجای دنیا، در حکم جرم ارتکابی در ایران است (صلاحیت سرزمینی شناور)؛ مثل مثال ۳۸ (هواپیمای ایرانی در فراز آسمان فرانسه). کشتی غیرجنگی خارجی — چهار شرط (نکتهٔ ۲۰): ۱) اثرات و عواقب جرم متوجه جمهوری اسلامی ایران گردد؛ ۲) جرم مخل صلح و نظام و آرامش داخلی یا نظم عمومی دریای سرزمینی باشد؛ ۳) فرماندهٔ کشتی یا نمایندهٔ دیپلماتیک یا کنسولی دولت صاحب پرچم تقاضای کمک و رسیدگی نماید؛ ۴) رسیدگی و تعقیب برای مبارزه با قاچاق مواد مخدر و روان‌گردان ضروری باشد. هواپیمای غیرجنگی — سه شرط (نکتهٔ ۲۱): ۱) جرم مخل انتظامات یا امنیت عمومی ایران باشد؛ ۲) متهم یا مجنی‌علیه تابع ایران باشد؛ ۳) هواپیما بعد از وقوع جرم در ایران فرود آید. نکتهٔ ۲۲: شریکِ داخل و شریکِ خارج هر دو سرزمینی؛ معاونِ خارجیِ مباشرِ ایرانی هر دو سرزمینی؛ معاونِ ایرانیِ مباشرِ خارجی فقط رسیدگی به معاون (نه مباشر) و به شرط جرم بودن رفتار مباشر در ایران، طبق صلاحیت سرزمینی.",topic:"صلاحیت شناور"},{q:"اصل صلاحیت واقعی (حمایتی/حفاظتی) را تعریف کرده و بندهای مادهٔ ۵ ق.م.ا را نام ببرید.",keywords:["مادهٔ ۵","امنیت","جعل دستخط","آرای قضایی","اسکناس","ایرانی یا غیر ایرانی"],answer:"شرط‌ها: ۱) تمام جرم (تمام عملیات مادی و نتیجه) خارج از ایران؛ ۲) جرم از جرایم مادهٔ ۵ یا جرایم قوانین خاص؛ تابعیت مرتکب و بزه‌دیده بی‌اثر است («هر شخص ایرانی یا غیر ایرانی»). بندهای مادهٔ ۵: الف) اقدام علیه نظام، امنیت داخلی یا خارجی، تمامیت ارضی یا استقلال ایران؛ ب) جعل مهر، امضا، حکم، فرمان یا دستخط مقام رهبری یا استفاده از آن؛ پ) جعل مهر و دستخط رئیس‌جمهور، رئیس قوهٔ قضائیه، رئیس و نمایندگان مجلس، رئیس مجلس خبرگان، رئیس دیوان عالی، دادستان کل، اعضای شورای نگهبان، رئیس و اعضای مجمع تشخیص، وزرا یا معاونان رئیس‌جمهور؛ ت) جعل آرای مراجع قضایی یا اجرائیه‌ها؛ ث) جعل اسکناس رایج، اسناد تعهدآور بانکی، اسناد خزانه، اوراق مشارکت و مسکوکات رایج داخل. مثال: جعل دستخط رسمی رئیس‌جمهور در فرانسه (مثال ۳۰).",topic:"صلاحیت واقعی"},{q:"جرایم علیه امنیتِ فهرست‌شده در نکتهٔ ۲۴ جزوه را با شمارهٔ ماده بنویسید.",keywords:["۴۹۸ تا ۵۱۲","جاسوسی","اطلاعات طبقه‌بندی","بمب‌گذاری","مادهٔ ۶۱۰"],answer:"جرایم مواد ۴۹۸ تا ۵۱۲ ق.م.ا.ت: تشکیل یا ادارهٔ دسته یا جمعیت برای برهم زدن امنیت کشور (۴۹۸)؛ عضویت در دستهٔ امنیت‌شکن (۴۹۹)؛ فعالیت تبلیغی به نفع گروه‌ها و سازمان‌های مخالف نظام (۵۰۰)؛ مطلع کردن اشخاص فاقد صلاحیت از اسرار (۵۰۱)؛ جرایم جاسوسی به نفع دولت بیگانه و به ضرر دولت بیگانهٔ دیگر در قلمرو ایران (۵۰۲)؛ ورود به اماکن ممنوعه برای کسب اطلاعات، عکسبرداری، فیلم‌برداری یا نقشه‌برداری غیرمجاز (۵۰۳)؛ تحریک مؤثر نیروهای رزمنده به فرار (۵۰۴)؛ جمع‌آوری اطلاعات طبقه‌بندی‌شده (۵۰۵)؛ بی‌مبالاتی در حفظ اطلاعات طبقه‌بندی‌شده (۵۰۶)؛ همکاری با دولت متخاصم خارجی (۵۰۸)؛ مخفی نمودن جاسوسان (۵۱۰) و شناسایی و معرفی جاسوسان به کشور بیگانه (تبصرهٔ ۵۱۰)؛ تهدید یا ادعای بمب‌گذاری در کشتی، هواپیما یا وسایل نقلیهٔ عمومی (۵۱۱)؛ تحریک مردم به جنگ و کشتار با یکدیگر (۵۱۲)؛ و تبانی در جرم علیه امنیت (مادهٔ ۶۱۰ ق.م.ا.ت). جزوه یادآور می‌شود مواد ۷۱، ۷۹ و ۱۰۹ ق.م.ا نیز به جرایم امنیتی اشاره دارند.",topic:"جرایم علیه امنیت"},{q:"قواعد حاکم بر صلاحیت واقعی را بنویسید و دو قانون خاصِ مطرح‌شده در نکته‌های ۲۵ و ۲۶ و محتوای مادهٔ ۶ را توضیح دهید.",keywords:["احتساب تعزیری","تأمین مالی تروریسم","قاچاق انسان","مستخدمان دولت","مصونیت سیاسی"],answer:"نکتهٔ ۲۳: در صلاحیت واقعی فقط قاعدهٔ احتساب (آن هم در جرایم تعزیری) رعایت می‌شود؛ مجرمیت متقابل، شرط یافت یا اعاده و منع محاکمه و مجازات مضاعف رعایت نمی‌شوند. نکتهٔ ۲۵: تبصرهٔ ۲ مادهٔ ۱ قانون مبارزه با تأمین مالی تروریسم — تعقیب تأمین‌کنندهٔ مالی تروریسم علیه افراد حقیقی و حقوقی، صرف‌نظر از محل ارتکاب جرم، تابعیت و محل اقامت مجرم. نکتهٔ ۲۶: مادهٔ ۷ قانون قاچاق انسان — هر تبعهٔ ایرانی که در خارج مرتکب جرایم این قانون شود مشمول مقررات آن است. مادهٔ ۶ ق.م.ا: به جرایم مستخدمان دولت (ایرانی یا غیرایرانی) در رابطه با شغل و وظیفه در خارج و جرایم مأموران سیاسی و کنسولی و وابستگان دولت ایران با مصونیت سیاسی، طبق قوانین ایران رسیدگی می‌شود.",topic:"صلاحیت واقعی"},{q:"شرط‌های صلاحیت شخصی فعال را بیان کنید و چهار حالتِ محاکمهٔ قبلی در خارج را توضیح دهید.",keywords:["سه شرط","یافت یا اعاده","تعزیرات غیرمنصوص","تبرئه","اجرانشده"],answer:"نکتهٔ ۲۷: ۱) تمام جرم و نتیجه در خارج؛ ۲) جرم از جرایم مادهٔ ۵ نباشد؛ ۳) بزهکار ایرانی. نکتهٔ ۲۸: شرط اول (در تمامی جرایم) یافت یا اعاده به ایران؛ شرط دوم در تعزیرات غیرمنصوص: تبرئه نشدن و اجرا نشدن کلاً یا بعضاً مجازات در محل وقوع. ۲۸/۱: در جرایم حد، قصاص، دیه و تعزیرات منصوص فقط شرط اول. چهار حالت (۲۸/۲): تبرئه در خارج → ایران محاکمه نمی‌کند؛ محکومیت با اجرای کامل → محاکمه نمی‌کند؛ محکومیت با اجرای بخشی (حتی یک روز) → محاکمه نمی‌کند؛ محکومیت با هیچ اجرایی → ایران محاکمه و مجازات می‌کند. ۲۸/۳: مجرمیت متقابل شرط نیست؛ صرف جرم بودن طبق قانون ایران کافی است (مثال شرب خمر در آلمان).",topic:"شخصی فعال"},{q:"شرط‌های صلاحیت شخصی منفعل را بنویسید و تنها تفاوت آن با صلاحیت شخصی فعال را توضیح دهید.",keywords:["چهار شرط","بزه‌دیدهٔ ایرانی","مجرمیت متقابل","تعزیرات غیرمنصوص","۳۰/۲"],answer:"نکتهٔ ۲۹: ۱) تمام جرم و نتیجه در خارج؛ ۲) جرم از جرایم مادهٔ ۵ نباشد؛ ۳) بزهکار خارجی؛ ۴) بزه‌دیدهٔ ایرانی. نکتهٔ ۳۰: شرط اول (همهٔ جرایم) یافت/اعاده؛ شرط دوم در تعزیرات غیرمنصوص: تبرئه/اجرانشدن؛ شرط سوم در تعزیرات غیرمنصوص: مجرمیت متقابل. طبق ۳۰/۱ در جرایم حد، قصاص، دیه و تعزیرات منصوص فقط شرط اول لازم است. ۳۰/۲: در جرایم حد، دیه و تعزیر منصوص هیچ تفاوتی بین فعال و منفعل نیست؛ در تعزیرات غیرمنصوص تنها تفاوت این است که مجرمیت متقابل فقط در منفعل شرط است و در فعال نیست. مبنای قانونی: بند ب مادهٔ ۸ («رفتار ارتکابی در جرایم موجب تعزیر به موجب قانون ایران و قانون محل وقوع، جرم باشد») در برابر مادهٔ ۷ که چنین شرطی ندارد.",topic:"شخصی منفعل"},{q:"مثال‌های ۴۳ تا ۴۶ جزوه را تحلیل کنید (برزیلی/زنای به عنف، هندی/خیانت در امانت به مال کانادایی، ارمنستانی/سرقت از ایرانی، هندی/تحصیل مال نامشروع).",keywords:["حد","صلاحیت ندارد","اجرا نشدن مجازات","مجرمیت متقابل"],answer:"مثال ۴۳: برزیلی در برزیل زنای به عنف با زن ایرانی؛ در برزیل جرم نیست — منفعل است و چون جرم «حد» است مجرمیت متقابل لازم نیست؛ کافی است در ایران یافت یا اعاده شود. مثال ۴۴: هندی در پاکستان خیانت در امانت نسبت به مال کانادایی — نه فعال (بزهکار ایرانی نیست) و نه منفعل (بزه‌دیدهٔ ایرانی نیست)؛ صلاحیت ایران منتفی است. مثال ۴۵: ارمنستانی در قزاقستان سرقت از ایرانی با حکم ۴ سالِ اجرانشده — منفعل تعزیری؛ چون هیچ بخشی از مجازات اجرا نشده، رسیدگی در ایران ممکن است. مثال ۴۶: هندی در پاکستان تحصیل مال نامشروع از ایرانی که در پاکستان جرم نیست — منفعل تعزیری بدون مجرمیت متقابل؛ بند ب مادهٔ ۸ جرم بودن در محل وقوع را هم می‌خواهد؛ رسیدگی منتفی است.",topic:"شخصی منفعل"},{q:"جدول کاربرد قواعد در اصول صلاحیت (نکته‌های ۳۱ و ۳۲) را کامل بنویسید.",keywords:["احتساب","منع مضاعف","مجرمیت متقابل","یافت یا اعاده","جهانی"],answer:"۱) سرزمینی: هیچ‌یک از قواعد رعایت نمی‌شود. ۲) واقعی: فقط قاعدهٔ احتساب، فقط در جرایم تعزیری. ۳) شخصی فعال: شرط یافت/اعاده در کلیهٔ جرایم؛ قاعدهٔ منع محاکمه و مجازات مضاعف در جرایم تعزیری غیرمنصوص؛ مجرمیت متقابل ندارد. ۴) شخصی منفعل: یافت/اعاده در کلیهٔ جرایم؛ منع مضاعف و مجرمیت متقابل در جرایم تعزیری غیرمنصوص. ۵) جهانی: فقط به «یافت شدن» در ایران اشاره شده است. (نکتهٔ ۳۲ به اختصار همین جدول را می‌دهد و تست ۱۲ مستقیماً از آن طرح می‌شود: مجرمیت متقابل فقط در شخصی منفعل.)",topic:"جدول قواعد"},{q:"الگوریتم تشخیص صلاحیت در تست‌ها (ترتیب بررسی) را توضیح داده و برای تست ۴ جزوه حل کامل ارائه کنید.",keywords:["محل وقوع","نوع جرم","تابعیت بزهکار","تابعیت بزه‌دیده","نکتهٔ ۲۲","سرزمینی"],answer:"ترتیب: ابتدا به محل وقوع جرم (سرزمینی)، سپس به جرم ارتکابی (واقعی)، سپس به تابعیت بزهکار (فعال)، سپس به تابعیت بزه‌دیده (منفعل) و در نهایت صلاحیت جهانی. تست ۴: «الف» ترکیه‌ای در تبریز با وسایل متقلبانه «ب» ایرانی را فریب داده و «ج» ترکیه‌ای در ترکیه مال را می‌گیرد. مرحلهٔ سرزمینی: بخشی از عملیات مادی (فریب) در ایران است؛ بنابر مادهٔ ۴ جرم در حکم واقع‌شده در ایران است و طبق نکتهٔ ۲۲ (شریک در ایران، شریک در خارج: هر دو سرزمینی) رسیدگی به «الف» و «ج» هر دو طبق صلاحیت سرزمینی است. پاسخ: سرزمینی – سرزمینی (گزینهٔ ۲).",topic:"الگوریتم تشخیص"},{q:"سه اصطلاح «عطف به ماسبق نشدن»، «عطف به ماسبق شدن» و «اجرای فوری» را با مثال ۴۷ جزوه توضیح دهید.",keywords:["قانون سابق","قانون لاحق","بیست متهم تخریب","تحقق کامل"],answer:"مثال ۴۷: ۲۰ نفر در سال‌های ۱۴۰۰ تا ۱۴۰۳ مرتکب تخریب شده‌اند و در ۱۴۰۶ قانون حاکم بر تخریب تغییر می‌کند؛ رسیدگی در ۱۴۰۸ است. عطف به ماسبق نشدن: قاضی برای همهٔ مصادیق طبق قانونِ زمانِ وقوعِ رفتار (سابق یا لاحقِ هر جرم) حکم می‌دهد. عطف به ماسبق شدن: قاضی برای همه طبق قانون لاحق (۱۴۰۶) حکم می‌دهد. اجرای فوری: مختلط است — برای برخی سابق و برای برخی لاحق؛ معیار (نکتهٔ ۳۸): اگر حکم قانون سابق به‌طور کامل محقق شده باشد قانون جدید شامل نمی‌شود و اگر کامل محقق نشده باشد طبق قانون جدید رفتار می‌شود.",topic:"قلمرو زمان"},{q:"قاعدهٔ حاکم بر قوانین سخت‌گیرانه و مساعد در قلمرو زمان را با مستند مادهٔ ۱۰ و نکته‌های ۳۵ و ۳۶ توضیح دهید.",keywords:["مقررات و نظامات دولتی","حد، قصاص، دیه و تعزیرات منصوص","تا صدور حکم قطعی","مثال ۴۸"],answer:"مادهٔ ۱۰: در مقررات و نظامات دولتی، مجازات و اقدام تأمینی و تربیتی باید به موجب قانونی باشد که قبل از وقوع جرم مقرر شده است. نکتهٔ ۳۵: در سایر مجازات‌ها یعنی حد، قصاص، دیه و تعزیرات منصوص، قانون مطلقاً عطف به ماسبق نمی‌شود و نمی‌توان رفتارِ قبل از قانون را با آن مجازات کرد. نکتهٔ ۳۶: قانون به ضرر متهم مطلقاً عطف نمی‌شود؛ قانون به نفع متهم عطف به ماسبق می‌شود و اگر قبل از صدور حکم قطعی لازم‌الاجرا شده باشد قاضی طبق آن حکم می‌دهد؛ مثال ۴۸: جرم ۱۴۰۰، قانون مساعد ۱۴۰۱، رأی ۱۴۰۲ → حکم طبق قانون ۱۴۰۱.",topic:"قلمرو زمان"},{q:"اگر پس از صدور حکم قطعی، رفتار دیگر جرم شناخته نشود یا مجازات تخفیف یابد، چه می‌شود؟ (بندهای الف و ب مادهٔ ۱۱ با مثال‌های ۴۹ و ۵۰)",keywords:["موقوفی اجرا","اصلاح حکم","قاضی اجرای احکام","لباس نظامی","سه تا ده سال"],answer:"بند الف: اگر رفتارِ جرمِ گذشته در قانون لاحق جرم شناخته نشود، حکم قطعی اجرا نمی‌شود و اگر در جریان اجراست موقوف می‌شود؛ مثال ۴۹: استفادهٔ غیرمجاز از لباس نظامی محکوم‌شده در ۱۴۰۰ که در ۱۴۰۲ جرم‌زدایی شد → قاضی اجرای احکام قرار موقوفی اجرا صادر می‌کند. بند ب: اگر مجازات در قانون لاحق تخفیف یابد، قاضی اجرای احکام قبل یا حین اجرا از دادگاه صادرکنندهٔ حکم قطعی اصلاح را می‌خواهد و محکوم هم می‌تواند تقاضا کند؛ دادگاه با لحاظ قانون لاحق مجازات قبلی را تخفیف می‌دهد (در اقدامات تأمینی و تربیتی اطفال هم جاری است)؛ مثال ۵۰: محکوم به ۶ سال از دامنهٔ ۳-۱۰ که دامنه به ۱-۷ تبدیل شده → اصلاح حکم.",topic:"حکم قطعی"},{q:"معیار سنجش شدیدتر شدن مجازات در قانون جدید چیست؟ با مثال‌های ۵۱ تا ۵۳ توضیح دهید.",keywords:["حداکثر مجازات","سه تا ده سال","دو تا پانزده سال"],answer:"نکتهٔ ۳۷: معیار، «حداکثر مجازات» است. مثال ۵۱: از ۳ تا ۱۰ سال به ۲ تا ۱۵ سال → حداکثر از ۱۰ به ۱۵ رسیده؛ شدیدتر؛ عطف به ماسبق نمی‌شود. مثال ۵۲: از ۲ تا ۱۵ سال به ۳ تا ۱۰ سال → حداکثر کاهش؛ خفیف‌تر؛ مساعد. مثال ۵۳: از ۲ تا ۱۵ سال به ۱ تا ۱۰ سال → خفیف‌تر. پس فقط کاهشِ حداقل، قانون را مساعد نمی‌کند؛ بیشینهٔ دامنه ملاک است.",topic:"معیار شدت"},{q:"قاعدهٔ قوانین مدت‌معین یا وضع‌شده برای موارد خاص را با مثال ۵۴ (تحریم نگهداری ارز) توضیح دهید.",keywords:["تبصرهٔ مادهٔ ۱۱","لغو قانون","تصریح قانون لاحق","یک تا پنج سال"],answer:"تبصرهٔ مادهٔ ۱۱: مقررات فوق (تخفیف و جرم‌زداییِ ناظر به گذشته) در مورد قوانینی که برای مدت معین و یا موارد خاص وضع شده، مگر به تصریح قانون لاحق، اعمال نمی‌شود. مثال ۵۴: در ۱۴۰۰ در اوج تحریم‌ها نگهداری هر مقدار ارز مجازات ۱ تا ۵ سال یافت؛ در ۱۴۰۳ قانون لغو و نگهداری ارز آزاد شد؛ «الف» در ۱۴۰۲ ارز نگه داشته و در ۱۴۰۴ محاکمه می‌شود: به یک تا پنج سال حبس محکوم می‌شود و نسخ قانون در حق او مؤثر نیست؛ مگر در قانون جدید تصریح شده باشد که نسخ، در حق مرتکبانِ قبل مؤثر است.",topic:"قوانین موقت"},{q:"اجرای فوری قوانین تشکیلات قضایی و صلاحیت را با مثال ۵۵ (انقلاب ← کیفری دو) توضیح دهید.",keywords:["بند الف مادهٔ ۱۱","سه حالت","قرار عدم صلاحیت"],answer:"بند الف مادهٔ ۱۱: قوانین مربوط به تشکیلات قضایی و صلاحیت فوراً نسبت به جرایم سابق اجرا می‌شوند. مثال ۵۵: جرمِ ۱۴۰۰ در صلاحیت دادگاه انقلاب که در ۱۴۰۲ به کیفری دو منتقل شده: حالت اول: حکم پنج سال انقلاب در ۱۴۰۱ قطعی شده → در ۱۴۰۳ رسیدگی مجدد در کیفری دو ممکن نیست (حکم کامل شد). حالت دوم: تعقیب از ۱۴۰۴ → پرونده طبق قانون لاحق به کیفری دو می‌رود و استناد به صلاحیت انقلابِ زمان جرم مسموع نیست. حالت سوم: رسیدگی در ۱۴۰۲ در انقلاب در جریان است و قانون عوض می‌شود → انقلاب باید قرار عدم صلاحیت صادر و پرونده را به کیفری دو بفرستد.",topic:"اجرای فوری"},{q:"قاعدهٔ اجرای فوری قوانین ادلهٔ اثبات دعوی را با نکتهٔ ۳۹ و مثال ۵۶ توضیح دهید.",keywords:["بند ب مادهٔ ۱۱","شهادت شهود","حکم قطعی","برائت"],answer:"بند ب مادهٔ ۱۱: قوانین مربوط به ادلهٔ اثبات دعوی تا پیش از اجرای حکم فوراً اجرا می‌شوند؛ تبصره: اگر حکم قطعی صادر شده باشد پرونده برای بررسی به دادگاه صادرکنندهٔ حکم قطعی ارسال می‌شود. نکتهٔ ۳۹: تا قبل از صدور حکم طبق قانون لاحق عمل می‌شود؛ پس از صدور حکم محکومیت، اگر حکم کامل اجرا نشده باشد پرونده مجدداً رسیدگی می‌شود؛ ولی در مورد حکم برائت رسیدگی مجدد وجود ندارد. مثال ۵۶: جرمِ ۱۴۰۰ قابل اثبات با شهادت شهود که در ۱۴۰۴ با قانون لاحق این ادله کفایت نمی‌کند: اگر در ۱۴۰۵ محاکمه شود، دادگاه نمی‌تواند به استناد شهادت شهود حکم محکومیت بدهد؛ اگر در ۱۴۰۲ به پنج سال محکوم شده باشد و اجرا کامل نشده، پرونده به دادگاه صادرکننده ارسال و مجدداً رسیدگی می‌شود.",topic:"ادلهٔ اثبات"}]},{id:"pack-tadris-jaza-desc2",title:"دفترچهٔ تشریحی — تدریس جزا ۲ (صفحات ۵۱ تا ۱۰۰)",exam:"نمونه سوالات تشریحی",examSlug:"tashrihi",branch:"حقوق جزا",description:"۱۹ پرسش تشریحی برگرفته از صفحات ۵۱ تا ۱۰۰ جزوهٔ تدریس جزا احمد غفوری: رأی وحدت رویه، قانون حاکم بر رفتار، ماده‌های ۴۸۵ و ۴۸۶، شخص حقوقی (مواد ۱۴۳ و ۲۰ تا ۲۲)، درجات مادهٔ ۱۹، مجازات تبعی و محاسبهٔ محرومیت و احتساب بازداشت — با پاسخ نمونهٔ کامل و کلیدواژه‌های نمره‌آور.",minutes:80,kind:"descriptive",questions:[{q:"قاعدهٔ حاکم بر جرایم «به عادت»، «مستمر» و «مرکب» نسبت به قانون لاحق را با مثال‌های ۵۹ تا ۶۱ جزوه توضیح دهید.",keywords:["رفتار کافی","ادامهٔ رفتار","آخرین جزء","تکدی","مواد مخدر","کلاهبرداری"],answer:"نکتهٔ ۴۲: ۱) جرایم به عادت فقط وقتی تابع قانون لاحق‌اند که رفتار تشکیل‌دهندهٔ عادت به اندازهٔ کافی در زمان حکومت قانون لاحق هم تحقق یافته باشد؛ مثال ۵۹: پنجاه بار تکدی در ۱۴۰۲ (قبل از جرم شدن) + یک بار بعد از جرم شدن ← مجازات نمی‌شود. ۲) جرایم مستمر هرگاه رفتار در زمان قانون جدید ادامه یابد تابع لاحق‌اند، چه به نفع چه به ضرر متهم؛ مثال ۶۰: نگهداری مواد از ۱۴۰۳ با ادامه در ۱۴۰۵ ← قانون جدید (۲ تا ۵ سال). ۳) جرایم مرکب اگر آخرین جزء در زمان لاحق ارتکاب یابد مطلقاً تابع لاحق‌اند؛ مثال ۶۱: فریب در مرداد ۱۴۰۱ و بردن مال در مهر ← قانونِ پس از شهریور.",topic:"قانون حاکم بر رفتار"},{q:"قاعدهٔ عطف به ماسبق رأی وحدت رویه در امور حقوقی و کیفری را بیان و پنج حالت مثال ۶۲ را توضیح دهید.",keywords:["حکم قطعی","به نفع محکوم","تبرئه","مادهٔ ۱۰","تجدیدنظر"],answer:"حقوقی: رأی وحدت رویه قبل از حکم قطعی مؤثر است و بعد از آن مؤثر نیست. کیفری: قبل از حکم قطعی مؤثر است (چه به نفع چه به ضرر متهم) و بعد از آن مؤثر نیست مگر به نفع محکوم. مثال ۶۲: ۱) رأی «جرم نیست» قبل از محاکمهٔ ۱۴۰۶ ← تبرئه؛ ۲) رأی «جرم است» قبل از محاکمه ← محکومیت؛ ۳) برائت بدوی + در جریان تجدیدنظر رأی «جرم است» ← محکومیت در تجدیدنظر (هنوز قطعی نشده)؛ ۴) حکم قطعی برائت سپس رأی «جرم است» ← دوباره محاکمه ممکن نیست؛ ۵) حکم قطعی محکومیت سپس رأی «جرم نیست» ← طبق مادهٔ ۱۰ حبس اجرا نمی‌شود (به نفع محکوم مؤثر است).",topic:"رأی وحدت رویه"},{q:"قاعدهٔ حاکم بر مرور زمان نسبت به قانون لاحق را با مثال ۵۸ جزوه توضیح دهید.",keywords:["شمول مرور زمان","حکم قانون سابق","ده سال","۱۴۰۵"],answer:"اگر مرور زمان قبل از لازم‌الاجراشدن قانون لاحق شمول یافته باشد، قانونِ طولانی‌کنندهٔ جدید به آن تعلق نمی‌گیرد (حکم قانون سابق محقق شده)؛ اگر هنوز محقق نشده باشد، قانون لاحق عطف می‌شود (نکتهٔ ۳۸). مثال ۵۸: جرم «الف» ۱۴۰۰ با مرور زمان ۵ ساله — در ۱۴۰۵ شمول یافته و با قانونِ ۱۴۰۶ (۱۰ ساله) در ۱۴۰۸ قابل رسیدگی نیست؛ جرم «ب» ۱۴۰۲ — در ۱۴۰۶ فقط ۴ سال گذشته بود، قانون جدید اعمال و جرم در ۱۴۱۲ مشمول مرور زمان می‌شود.",topic:"مرور زمان"},{q:"ضمانت اجرای مادهٔ ۴۸۵ (صدمهٔ بیش از مجازات در مرحلهٔ اجرای حکم) را در چهار حالت بیان کنید.",keywords:["عمد مأمور","تقصیر","مستند به محکوم‌علیه","قصاص و حد","تعزیرات","مادهٔ ۵۷۹"],answer:"نکتهٔ ۴۴: ۱) اگر عمد مأمور اجرای حکم باشد ← مأمور به قصاص و تعزیر مقرر در مادهٔ ۵۷۹ ق.م.ا.ت محکوم می‌شود؛ ۲) اگر عمل به دلیل تقصیر مأمور باشد ← مأمور به پرداخت دیه محکوم می‌شود؛ ۳) اگر آسیب اضافه مستند به محکوم‌علیه باشد ← ضمان منتفی است (قصاص، دیه و تعزیر ساقط)؛ ۴) اگر هیچ‌یک از حالات فوق نباشد ← در قصاص و حد ضمان منتفی است و در تعزیرات دیه از بیت‌المال پرداخت می‌شود.",topic:"مادهٔ ۴۸۵"},{q:"ضمانت اجرای مادهٔ ۴۸۶ (حکمِ نادرست به شخص بی‌گناه یا مجازات اضافی در مرحلهٔ صدور حکم) را در سه حالت بیان کنید.",keywords:["قاضی عمد","تقصیر قاضی","بیت‌المال","بازگرداندن دیه"],answer:"نکتهٔ ۴۵: ۱) اگر قاضی عمد باشد ← دیه از بیت‌المال پرداخت شده و قاضی به قصاص یا تعزیر مقرر در تعزیرات و بازگرداندن دیه به بیت‌المال محکوم می‌شود؛ ۲) اگر قاضی تقصیر کرده باشد ← دیه از بیت‌المال پرداخت شده و قاضی به پرداخت دیه به بیت‌المال محکوم می‌شود؛ ۳) اگر قاضی نه عمد داشته و نه تقصیر ← دیه از بیت‌المال پرداخت می‌شود و برخلاف ردیف ۴ جدول مادهٔ ۴۸۵، فرقی بین قصاص و حد و تعزیر نیست؛ در هر حال دیه پرداخت می‌شود. و نکتهٔ ۴۶: سؤال مطلقِ بدون ذکر مرحله ← مادهٔ ۱۳ (عمد/تقصیر ← مسئولیت کیفری یا مدنی؛ بدون آن ← بیت‌المال).",topic:"مادهٔ ۴۸۶"},{q:"چهار قسم مجازات را طبق مادهٔ ۱۴ ق.م.ا با تعریف هر یک (مواد ۱۵ تا ۱۸) بیان کنید.",keywords:["شرع مقدس","جنایات عمدی","مقدر و غیرمقدر","محرمات شرعی","مقررات حکومتی"],answer:"مادهٔ ۱۴: مجازات‌ها چهار قسم است: ۱) حد — مجازاتی که موجب، نوع، میزان و کیفیت اجرای آن در شرع مقدس تعیین شده (م ۱۵)؛ ۲) قصاص — مجازات اصلی جنایات عمدی بر نفس، اعضا و منافع (م ۱۶)؛ ۳) دیه — مالی اعم از مقدر و غیرمقدر برای جنایت غیرعمدی بر نفس/اعضا/منافع یا جنایت عمدیِ بدون قصاص (م ۱۷)؛ ۴) تعزیر — مجازاتی که مشمول عنوان حد، قصاص یا دیه نیست و در موارد ارتکاب محرمات شرعی یا نقض مقررات حکومتی به موجب قانون تعیین می‌شود (م ۱۸). تبصرهٔ مادهٔ ۱۴: با رابطهٔ علیت، دیه و خسارتِ شخص حقوقی قابل مطالبه و تعزیر آن مطابق مادهٔ ۲۰ است.",topic:"چهار قسم مجازات"},{q:"چهار ملاحظهٔ دادگاه در صدور حکم تعزیری (مادهٔ ۱۸) و محتوای تبصرهٔ الحاقی ۱۳۹۹/۲/۲۳ را بنویسید.",keywords:["انگیزه","شیوهٔ ارتکاب","اقدامات پس از جرم","سوابق","بیش از حداقل","انتظامی درجهٔ چهار"],answer:"مادهٔ ۱۸: دادگاه موارد زیر را ملاک قرار می‌دهد: الف) انگیزهٔ مرتکب و وضعیت ذهنی و روانی وی حین ارتکاب جرم؛ ب) شیوهٔ ارتکاب جرم، گسترهٔ نقش و وظیفه و نتایج زیان‌بار آن؛ پ) اقدامات مرتکب پس از ارتکاب جرم؛ ت) سوابق و وضعیت فردی، خانوادگی و اجتماعی مرتکب. تبصرهٔ ۱۳۹۹: اگر دادگاه حبس را بیش از حداقلِ مقرر قانونی تعیین کند باید مبتنی بر بندهای همین ماده و سایر جهات قانونی، علتش را در حکم ذکر کند؛ عدم رعایت، موجب مجازات انتظامی درجهٔ چهار است.",topic:"مادهٔ ۱۸"},{q:"اصل شخصی بودن مسئولیت کیفری و استثنائات سه‌گانهٔ آن را با مستندات توضیح دهید.",keywords:["مادهٔ ۱۴۱","مادهٔ ۱۴۲","عاقله","قانون مطبوعات","قانون کار"],answer:"مادهٔ ۱۴۱: مسئولیت کیفری شخصی است. استثنائات: ۱) مادهٔ ۱۴۲ — مسئولیت رفتار دیگری وقتی ثابت است که شخص به‌طور قانونی مسئول اعمال دیگری باشد «یا» در رابطه با نتیجهٔ رفتار دیگری مرتکب تقصیر شود (وجود یکی کافی است)؛ ۲) در برخی موارد عاقله مسئول پرداخت دیه است؛ ۳) قوانین خاص: تبصرهٔ ۷ مادهٔ ۹ قانون مطبوعات (مسئولیت مقالات بر عهدهٔ مدیر مسئول؛ نافی مسئولیت نویسنده نیست) و مواد ۸۵ و ۹۵ قانون کار (مسئولیت کیفری و حقوقی کارفرما در عدم رعایت دستورالعمل‌های حفاظت فنی و بهداشت و وقوع حادثه).",topic:"شخصی بودن مسئولیت"},{q:"شرایط مسئولیت کیفری شخص حقوقی (مادهٔ ۱۴۳) و مجازات‌های مادهٔ ۲۰ را بنویسید.",keywords:["نمایندهٔ قانونی","به نام یا در راستای منافع","انحلال","مصادرهٔ کل","یک یا دو مورد"],answer:"مادهٔ ۱۴۳: اصل، مسئولیت شخص حقیقی است؛ شخص حقوقی وقتی مسئول است که نمایندهٔ قانونی او «به نام یا در راستای منافع» شخص حقوقی جرم کند، مگر ثابت شود دستور، تصمیم‌گیری یا نظارت با شخص حقیقی دیگری بوده است. مادهٔ ۲۰: با توجه به شدت جرم و نتایج زیان‌بار، به یک یا دو مورد از این‌ها محکوم می‌شود: انحلال شخص حقوقی (درجهٔ ۱)؛ مصادرهٔ کل اموال (درجهٔ ۱)؛ ممنوعیت از یک یا چند فعالیت شغلی یا اجتماعی دائم یا حداکثر پنج سال (درجهٔ ۵ یا ۶)؛ ممنوعیت از دعوت عمومی برای افزایش سرمایه (درجهٔ ۵ یا ۶)؛ ممنوعیت از صدور برخی اسناد تجاری حداکثر پنج سال (درجهٔ ۶)؛ جزای نقدی؛ انتشار حکم محکومیت با رسانه‌ها (درجهٔ ۶). تبصره: نسبت به اشخاص حقوقی دولتی/عمومی غیردولتی هنگام اعمال حاکمیت، این مجازات‌ها اعمال نمی‌شود.",topic:"شخص حقوقی"},{q:"قواعد جزای نقدی شخص حقوقی (مادهٔ ۲۱) و شروط انحلال و مصادره (مادهٔ ۲۲) را توضیح دهید.",keywords:["دو برابر","چهار برابر","جرم‌زاده","انحراف از هدف مشروع"],answer:"مادهٔ ۲۱: جزای نقدی شخص حقوقی حداقل دو برابر و حداکثر چهار برابر مبلغی است که برای شخص حقیقی در قانون تعیین شده. مادهٔ ۲۲: انحلال شخص حقوقی و مصادرهٔ اموال فقط وقتی اعمال می‌شود که شخص حقوقی برای ارتکاب جرم به وجود آمده باشد یا با انحراف از هدف مشروع نخستین، فعالیتش را منحصراً در جهت ارتکاب جرم تغییر داده باشد. نکته‌های ۵۳ و ۵۴ جزوه همین تفکیک را تمرین می‌کنند؛ در غیر این حالت‌ها فقط سایر مجازات‌های مادهٔ ۲۰ ممکن است.",topic:"شخص حقوقی"},{q:"مسئولیت کیفری شعب متعدد شخص حقوقی را با مستند مادهٔ ۶۹۴ ق.آ.د.ک و مثال ۷۳ توضیح دهید.",keywords:["شعبه","واحد زیرمجموعه","مرکزیت اصلی","تصمیم مرکزیت"],answer:"مادهٔ ۶۹۴ ق.آ.د.ک: اگر شخص حقوقی شعب یا واحدهای زیرمجموعهٔ متعدد داشته باشد، مسئولیت کیفری فقط متوجه شعبه یا واحدی است که جرم به او منتسب شده؛ اما اگر شعبه بر اساس تصمیمِ مرکزیت اصلیِ شخص حقوقی اقدام کرده باشد، مسئولیت کیفری متوجه مرکزیت اصلی نیز هست. مثال ۷۳: شرکت با مرکزیت تهران و شعب متعدد — اگر شعبهٔ اصفهان جرم زند فقط شعبهٔ اصفهان مجازات می‌شود؛ مگر بر اساس تصمیم مرکزیت اصلی بوده باشد که آن‌گاه مرکزیت اصلی هم مسئولیت کیفری دارد.",topic:"شخص حقوقی"},{q:"تفاوت جزای نقدی، ضرر و زیان ناشی از جرم و دیه را (نکتهٔ ۴۷) با مثال توضیح دهید.",keywords:["دولت","بزه‌دیده","ماهیت جزایی","ماهیت حقوقی","هم مجازات هم جبران"],answer:"شباهت: هر سه پرداختِ پولی از سوی مجرم است. جزای نقدی: در جرایم تعزیری، پرداخت مبلغی به دولت؛ امری جزایی است و متعلق به دولت است (نه بزه‌دیده)؛ مثال: مادهٔ ۶۳۵ ق.م.ا.ت — دفن خلاف نظامات یا مخفی کردن جنازه ← جزای نقدی ۴ تا ۳۰ میلیون ریال. ضرر و زیان ناشی از جرم: امری حقوقی است؛ جبران خسارت مالی بزه‌دیده؛ مثال: تخریب اتومبیل سه‌میلیاردی ← پرداخت همان مبلغ به مالک. دیه: در غالب موارد دربارهٔ جنایتی که قصاص ندارد؛ مجرم مبلغی به بزه‌دیده (مجنی‌علیه) می‌پردازد؛ «هم مجازات است و هم جبران خسارت».",topic:"تفکیک مجازات‌ها"},{q:"تفاوت اعدام، قصاص نفس و رجم (سنگسار) را بنویسید (نکتهٔ ۴۸).",keywords:["زنای محصنه","اولیای دم","گذشت","دار"],answer:"رجم (سنگسار): مجرم در گودال گذاشته و تا مرگ سنگ خورده می‌شود؛ فقط در جرم زنای محصنه اعمال می‌شود. قصاص نفس: دربارهٔ قتل عمدی است؛ با درخواست اولیای دم اجرا می‌شود و در صورت گذشت آنان قابل اعمال نیست. اعدام: در سایر موارد پیش‌بینی‌شده در قانون (غیر از زنای محصنه و قتل عمد) مانند زنای به عنف، افساد فی‌الارض، محاربه، لواط و... است؛ طبق رویه با دار زدن اجرا می‌شود و نیازی به درخواست شخص خاصی ندارد.",topic:"تفکیک مجازات‌ها"},{q:"جدول هشت درجهٔ مجازات تعزیری (مادهٔ ۱۹) را با مواعد حبس و جزای نقدی هر درجه بنویسید.",keywords:["سه ماه","شش ماه","دو سال","پنج سال","ده سال","پانزده سال","بیست و پنج سال","انفصال دائم"],answer:"درجهٔ ۱: حبس بیش از ۲۵ سال؛ جزای نقدی بیش از ۲ میلیارد ریال. درجهٔ ۲: بیش از ۱۵ تا ۲۵ سال؛ بیش از ۱ میلیارد تا ۲.۸ میلیارد ریال. درجهٔ ۳: بیش از ۱۰ تا ۱۵ سال؛ بیش از ۵۰۰ میلیون تا ۱ میلیارد ریال. درجهٔ ۴: بیش از ۵ تا ۱۰ سال؛ بیش از ۲۰۰ تا ۵۰۰ میلیون ریال + انفصال دائم از خدمات دولتی و عمومی. درجهٔ ۵: بیش از ۲ تا ۵ سال؛ بیش از ۸۰ تا ۲۰۰ میلیون ریال. درجهٔ ۶: بیش از ۶ ماه تا ۲ سال؛ شلاق ۳۱ تا ۹۹ ضربه؛ بیش از ۲۰ تا ۸۰ میلیون ریال. درجهٔ ۷: بیش از ۳ تا ۶ ماه؛ شلاق ۱۱ تا ۳۰ ضربه؛ بیش از ۱۰ تا ۲۰ میلیون ریال. درجهٔ ۸: تا ۳ ماه؛ تا ۱۰ ضربه؛ تا ۱۰ میلیون ریال.",topic:"درجات مجازات"},{q:"تبصره‌های ۲ و ۳ مادهٔ ۱۹ و نقش رأی‌های وحدت رویهٔ ۷۴۴ و ۷۵۹ را با مثال‌های ۶۳ و ۶۸ توضیح دهید.",keywords:["درجهٔ بالاتر","حبس ملاک","بی‌درجه","انفصال موقت","جزای نقدی نسبی"],answer:"تبصرهٔ ۲: اگر حداقل مجازات منطبق بر یک درجه و حداکثر منطبق بر درجهٔ بالاتر باشد، مجازات از درجهٔ بالاتر محسوب می‌شود؛ مثال ۶۳: ۶ ماه تا ۳ سال حبس ← درجهٔ ۴. تبصرهٔ ۳: در تعدد مجازات‌ها، مجازات شدیدتر ملاک است و اگر تشخیص ممکن نبود درجهٔ بالاتر. نکتهٔ ۵۱ (رأی ۷۴۴): در مقایسهٔ حبس و جزای نقدی، حبس ملاک است؛ سایر مجازات‌ها با درجه سنجیده می‌شوند؛ مثال ۶۸: شلاق ۲۰-۷۴ (درجهٔ ۶) + جزای نقدی ۲۰۰-۷۰۰ میلیون (درجهٔ ۵) ← درجهٔ ۵. نکتهٔ ۵۲ (رأی ۷۵۹): انفصال موقت، کسر از حقوق و جزای نقدی نسبی با هیچ بند مطابقت ندارند و بی‌درجه‌اند.",topic:"درجات مجازات"},{q:"جزای نقدی «مقدر» و «نسبی» را با مثال‌های ۶۹ تا ۷۱ توضیح دهید.",keywords:["مادهٔ ۶۳۵","مادهٔ ۶۷۷","دو برابر خسارت","کاربری اراضی","بهای زمین"],answer:"جزای نقدی دو حالت دارد: ۱) مقدر — مبلغ مشخص در ماده؛ مثال ۶۹: مادهٔ ۶۳۵ (دفن خلاف نظامات جنازه یا مخفی کردن آن) ← جزای نقدی از ۴ تا ۳۰ میلیون ریال. ۲) نسبی — نسبت به یک مبدأ محاسبه می‌شود؛ مثال ۷۰: مادهٔ ۶۷۷ (اصلاحی ۱۳۹۹) — تخریب عمدی اشیای منقول/غیرمنقول تا خسارت ۱۰۰ میلیون ریال ← جزای نقدی تا دو برابر معادل خسارت وارده؛ مثال ۷۱: مادهٔ ۳ قانون کاربری اراضی ← جزای نقدی از یک تا سه برابر بهای اراضی زراعی و باغ‌ها به قیمت روزِ زمین با کاربری جدید. طبق نکتهٔ ۵۲ و رأی ۷۵۹، جزای نقدی نسبی با هیچ درجه مطابقت ندارد (بی‌درجه است).",topic:"جزای نقدی"},{q:"مجازات تبعی مادهٔ ۲۵ را با سه مدت و مصادیق آن بنویسید و بگویید کدام جرایم مشمول تبعی نیستند.",keywords:["هفت سال","سه سال","دو سال","جرایم عمدی","درجهٔ شش","غیرعمدی"],answer:"مادهٔ ۲۵: محکومیت قطعی کیفری «در جرایم عمدی» پس از اجرای حکم یا شمول مرور زمان، محکوم را از حقوق اجتماعی محروم می‌کند: الف) هفت سال در محکومیت به مجازات‌های سالب حیات و حبس ابد (از تاریخ توقف اجرای حکم اصلی)؛ ب) سه سال در محکومیت به قطع عضو، قصاص عضو با دیهٔ بیش از نصف، نفی بلد و حبس تا درجهٔ ۴؛ پ) دو سال در محکومیت به شلاق حدی، قصاص عضو با دیهٔ نصف یا کمتر و حبس درجهٔ ۵. مشمولینِ تبعی‌ندارند: جرایم غیرعمدی و حبس درجهٔ ۶ به پایین (فقط ثبت در پیشینه — تبصرهٔ ۱).",topic:"مجازات تبعی"},{q:"قاعدهٔ رفع اثر تبعی در «عفو» و «آزادی مشروط» و «لغو آزادی مشروط» را توضیح دهید و برای تست ۲۲ (اعدام ← عفو به ۶ سال حبس در ۱۴۰۲؛ پایان حبس ۱۴۰۸) پایان محرومیت را محاسبه کنید.",keywords:["زمان عفو","اتمام آزادی مشروط","هفت سال","۱۴۰۹"],answer:"تبصرهٔ ۳ مادهٔ ۲۵: در عفو، اثر تبعی پس از گذشت مدت‌های ۷/۳/۲ ساله از «زمان عفو» رفع می‌شود؛ در آزادی مشروط پس از اتمام مدت آزادی مشروط رفع می‌شود؛ و محکوم در مدت آزادی مشروط و زمان اجرای حکم هم محروم است. لغو آزادی مشروط یعنی ادامهٔ اجرای حکم و ادامهٔ محرومیت تا پایان اجرا و سپس مدت جدولی. تست ۲۲: محکومیت اصلی اعدام (معادل بند الف) ← هفت سال از زمان عفو (۱۴۰۲) یعنی تا ۱۴۰۹؛ و در مدت حبس (تا ۱۴۰۸) هم محروم است ← پایان محرومیت ۱۴۰۹.",topic:"کارگاه تست"},{q:"چرا در تست ۲۷ (تصادف رانندگی غیرعمدی با ۳ سال حبس) و تست‌های ۳۰ و ۳۱ (کلاهبرداری با ۲ سال حبس درجهٔ ۶) هیچ مجازات تبعی‌ای وجود ندارد؟",keywords:["جرایم عمدی","حبس تا درجهٔ پنج","پیشینهٔ کیفری","تبصرهٔ ۱"],answer:"صدر مادهٔ ۲۵ فقط «محکومیت قطعی کیفری در جرایم عمدی» را مشمول محرومیت از حقوق اجتماعی می‌کند؛ پس جرم غیرعمدی (تست ۲۷) اصلاً تبعی ندارد. همچنین بندهای مادهٔ ۲۵ فقط تا «حبس درجهٔ پنج» را گرفته‌اند؛ حبس درجهٔ ۶ به پایین (مثل کلاهبرداری با ۲ سال حبس — درجهٔ ۶) تبعی ندارد و طبق تبصرهٔ ۱ مراتب محکومیت فقط در پیشینهٔ کیفری درج و در گواهی‌های عادی منعکس نمی‌شود (مگر به درخواست مراجع قضایی برای تعیین یا بازنگری مجازات).",topic:"کارگاه تست"},{q:"قواعد احتساب بازداشت قبلی در مادهٔ ۲۷ را برای حبس، شلاق تعزیری، جزای نقدی و شلاق حدی با مثال‌های ۸۱ تا ۸۴ توضیح دهید.",keywords:["یک روز","یک ضربه","سی هزار ریال","شلاق حدی"],answer:"مادهٔ ۲۷: برای «حبس» هر یک روز بازداشت معادل یک روز کسر می‌شود (مثال ۸۱: ۱ ماه بازداشت + ۶ ماه حبس ← ۵ ماه اجرا). برای «شلاق تعزیری» هر روز معادل یک ضربه کسر می‌شود (مثال ۸۲: ۱۰ روز بازداشت + ۷۰ ضربه ← ۶۰ ضربه). برای «جزای نقدی» هر روز معادل ۳۰.۰۰۰ ریال کسر می‌شود (مثال ۸۳: ۲۰ روز + ۸۰ میلیون ریال ← کسر ۶۰۰.۰۰۰ ریال). برای «شلاق حدی» بازداشت قبلی قابل احتساب نیست (مثال ۸۴: ۲۰ روز بازداشت + ۸۰ ضربهٔ حدی ← ۸۰ ضربهٔ کامل). در تعدد مجازات‌ها به ترتیبِ مجازات‌های حکم اجرا می‌شود (مثال ۸۵).",topic:"نحوهٔ اجرا"}]},{id:"pack-tadris-jaza-desc3",title:"دفترچهٔ تشریحی — تدریس جزا ۳ (صفحات ۱۰۱ تا ۱۵۰)",exam:"نمونه سوالات تشریحی",examSlug:"tashrihi",branch:"حقوق جزا",description:"۲۱ پرسش تشریحی برگرفته از صفحات ۱۰۱ تا ۱۵۰ جزوهٔ تدریس جزا احمد غفوری: احتساب بازداشت و بازداشت بدل از جزای نقدی، محرومیت‌ها و انتشار حکم، تخفیف و معافیت (مادهٔ ۳۲۷ اصلاحی و مادهٔ ۳۹)، تعویق صدور حکم و تعلیق اجرا و مادهٔ ۴۷، نیمه‌آزادی و آزادی مشروط و نظارت الکترونیکی و مجازات‌های جایگزین حبس — با پاسخ نمونهٔ کامل و کلیدواژه‌های نمره‌آور.",minutes:85,kind:"descriptive",questions:[{q:"نرخ‌های احتساب بازداشت قبلی در مجازات‌های جایگزین حبس را با مستند بنویسید و بگویید بازداشت در «انفصال» چه وضعی دارد.",keywords:["بند الف ماده ۵۱۶","یک روز جزای نقدی روزانه","یک ساعت خدمات عمومی","پنج روز دوره مراقبت","انفصال مستثنا","تبصره ماده ۵۱۵"],answer:"طبق بند الف مادهٔ ۵۱۶ ق.آ.د.ک به ازای هر روز بازداشت: یک روز از جزای نقدی روزانه، یک ساعت از خدمات عمومی رایگان و پنج روز از دورهٔ مراقبت کسر می‌شود (مثال‌های ۸۶ تا ۸۸). بازداشت در انفصال اثری ندارد و انفصال به همان اندازهٔ حکم اجرا می‌شود (مثال ۸۹). در شلاق تعزیری، هر روز بازداشت معادل سه ضربه است (مادهٔ ۲۷ ق.م.ا؛ مثال ۹۰). بازداشتِ کمتر از ۲۴ ساعت هم یک روز محاسبه می‌شود (تبصرهٔ مادهٔ ۵۱۵).",topic:"احتساب بازداشت"},{q:"تبدیل جزای نقدی عجزمحکوم را بر اساس مادهٔ ۵۲۹ ق.آ.د.ک توضیح دهید و خروجی مثال ۹۱ را حساب کنید.",keywords:["بند الف: هر ۳۰ هزار ریال یک ساعت خدمات","بند ب: هر ۶۰ هزار ریال یک روز حبس","سقف ۱۵ میلیون ریال","تبصره ۲: تقسیط مانع وصول نیست"],answer:"بند الف: در جزای نقدی تا ۱۵ میلیون ریال، هر ۳۰ هزار ریال به یک ساعت خدمات عمومی رایگان تبدیل می‌شود. بند ب: در جزای نقدی بالای ۱۵ میلیون ریال یا عدم شرایط بند الف، هر ۶۰ هزار ریال به یک روز حبس تبدیل می‌شود. مثال ۹۱: سه میلیون ریال ÷ ۳۰٬۰۰۰ = صد ساعت خدمات عمومی رایگان. طبق تبصرهٔ ۲، صدور حکم تقسیط یا تبدیل، مانع استیفای مابه‌ازای بخش اجرا نشده از اموال بعدی محکوم‌علیه نیست (مثال ۹۷).",topic:"جزای نقدی"},{q:"قواعد «شروع» و «سقف» بازداشت بدل از جزای نقدی را با ذکر مادهٔ ۲۹ و نکته‌های ۶۰ و ۶۱ بیان کنید.",keywords:["از تاریخ اتمام حبس","حداکثر حبس همان جرم","سقف سه سال","قاچاق: ۱۵ سال","مثال‌های ۹۴ تا ۹۶"],answer:"شروع: اگر بازداشت بدل توأم با حبس باشد، از تاریخ اتمام حبس شروع می‌شود (مادهٔ ۲۹؛ مثال ۹۳). سقف: مدت بازداشت بدل از حداکثر حبسِ مقرر در قانون برای همان جرم بیشتر نیست و در هر حال از سه سال تجاوز نمی‌کند؛ اگر حبسِ جرم کمتر از سه سال باشد، سقف به اندازهٔ حداکثر همان حبس است (نکتهٔ ۶۰؛ مثال‌های ۹۴ تا ۹۶). استثنا: جرایم قاچاق کالا و ارز با سقف ۱۵ سال (نکتهٔ ۶۱؛ مادهٔ ۶۰ قانون مبارزه با قاچاق). بازداشت بدل مانع وصول مابه‌ازای بخش اجرا نشده از اموال بعدی هم نیست.",topic:"بازداشت بدل"},{q:"چهار محرومیت از محرومیت‌های مواد ۳۱ تا ۳۴ را با «مستلزم اجرایی» هر یک نام ببرید.",keywords:["ابطال گواهینامه","ابطال برگه‌های چک و حساب جاری","ابطال پروانه و توقیف سلاح","ابطال گذرنامه"],answer:"منع از رانندگی و تصدی وسیلهٔ نقلیه ← ابطال گواهینامه و ممنوعیت درخواست مجدد (۳۱)؛ منع از اصدار چک ← ابطال برگه‌های چک و ممنوعیت درخواست مجدد افتتاح حساب جاری (۳۲)؛ منع از حمل اسلحهٔ مجاز ← ابطال پروانهٔ حمل و توقیف سلاح (۳۳)؛ منع از خروج اتباع ایران ← ابطال گذرنامه و ممنوعیت درخواست مجدد (۳۴). همچنین منع از شغل مستلزم فسخ حواز/پروانه است و مشروط به سببیت شغلی جرم (۳۰).",topic:"محرومیت‌ها"},{q:"دو رژیم «انتشار حکم محکومیت» (مادهٔ ۳۶ و تبصرهٔ آن) را مقایسه کنید.",keywords:["روزنامهٔ محلی یک نوبت","حد و محاربه و افساد و تعزیر تا درجه ۴","کلاهبرداری بالای یک میلیارد بدون اخلال","رسانهٔ ملی یا کثیرالانتشار","فهرست جرایم مالی با مبلغ یک میلیارد"],answer:"رژیم عادی (مادهٔ ۳۶): جرایم موجب حد، محاربه و افساد فی‌الارض، تعزیر تا درجهٔ چهار و کلاهبرداری بیش از یک میلیارد ریالِ بدون اخلال در نظام یا امنیت ← انتشار در یکی از روزنامه‌های محلی در یک نوبت. رژیم الزامی (تبصره): در جرایم رشا و ارتشا، اختلاس، اعمال نفوذ برخلاف حق، تصرف غیرقانونی در اموال دولتی، معاملات دولتی، تبانی، تعدیات مأموران، جرایم گمرکی، مالیاتی، پولشویی و اخلال در نظام اقتصادی، هرگاه مبلغِ موضوع جرم یک میلیارد ریال یا بیشتر باشد ← انتشار الزامی در رسانهٔ ملی یا یکی از روزنامه‌های کثیرالانتشار.",topic:"انتشار حکم"},{q:"فرق «معاذیر معاف‌کننده» و «معاذیر تخفیف‌دهنده» را با نمونهٔ هر کدام توضیح دهید (نکته‌های ۶۲ و ۶۳).",keywords:["معاف‌کننده: ماده ۵۰۷","تخفیف‌دهنده: تبصره ۲ ماده ۷۱۹","صفر شدن مجازات","کم/تبدیل شدن"],answer:"معاذیر معاف‌کننده قانونی موجب سقوط کامل مجازات می‌شوند؛ نمونه: مادهٔ ۵۰۷ ق.م.ا (نکتهٔ ۶۲). معاذیر تخفیف‌دهنده فقط مقدار یا نوع مجازات را تغییر می‌دهند؛ نمونه: تبصرهٔ ۲ مادهٔ ۷۱۹ ق.م.ا که برای راننده‌ای که مصدوم را به درمان می‌رساند تخفیف مقرر می‌کند (نکتهٔ ۶۳). مثال‌های ۹۸ و ۹۹ جزوه (تقلیل سه تا ده سال به یک سال؛ تبدیل دو تا پنج سال به جزای نقدی) هر دو از جنس تخفیف‌اند.",topic:"تخفیف و معافیت"},{q:"جدول مادهٔ ۳۸ را برای «حبس درجه‌های یک تا هفت» به‌طور کامل بازنویسی کنید.",keywords:["درجه ۱ تا ۴: تقلیل ۱ تا ۳ درجه فقط داخل حبس","درجه ۵: حبس ۶ یا ۷ یا جزای نقدی درجه ۵","درجه ۶: حبس ۷ یا ۸ یا جزای نقدی درجه ۶","درجه ۷: جزای نقدی درجه ۷","تبصره ماده ۲۷: حبس زیر ۹۱ روز"],answer:"حبس درجهٔ ۱ تا ۴: فقط تقلیل یک تا سه درجه داخل حبس؛ تبدیل به جزای نقدی یا شلاق ممکن نیست (تخفیف حبس درجهٔ ۳ ← حبس درجهٔ ۴ تا ۶). حبس درجهٔ ۵: حبس درجهٔ ۶ یا ۷ یا جزای نقدی درجهٔ ۵. حبس درجهٔ ۶: حبس درجهٔ ۷ یا ۸ یا جزای نقدی درجهٔ ۶. حبس درجهٔ ۷: فقط جزای نقدی درجهٔ ۷. هرگاه حکم به حبس درجهٔ ۸ برسد، طبق تبصرهٔ مادهٔ ۲۷ به جایگزین حبس تبدیل می‌شود. همچنین مصادرهٔ کل ← جزای نقدی درجهٔ ۱ تا ۴ و انفصال دائم ← انفصال موقت ۵ تا ۱۵ سال.",topic:"جدول ماده ۳۸"},{q:"بندهای پنج‌گانهٔ مادهٔ ۳۲۷ (اصلاحی ۱۳۹۹/۲/۲۳) را نام ببرید و جواب مثال‌های ۱۰۵ و ۱۰۶ را بگویید.",keywords:["الف: تقلیل ۱ تا ۳ درجه در درجه ۴ به بالا","ب: تقلیل ۱ تا ۲ درجه یا جزای نقدی همان درجه","پ: مصادره کل","ت: انفصال دائم","ث: سایر مجازات‌ها"],answer:"الف) تقلیل حبس یک تا سه درجه در مجازات‌های درجهٔ ۴ و بالاتر؛ ب) تقلیل حبس درجهٔ ۵ و ۶ به یک تا دو درجه یا تبدیل این مجازات و حبس درجهٔ ۷ به جزای نقدی متناسب با همان درجه؛ پ) تبدیل مصادرهٔ کل اموال به جزای نقدی درجهٔ ۱ تا ۴؛ ت) تقلیل انفصال دائم به انفصال موقت ۵ تا ۱۵ سال؛ ث) تقلیل سایر مجازات‌های تعزیری یک یا دو درجه یا تبدیل به مجازات دیگر از همان درجه یا یک درجه پایین‌تر. مثال ۱۰۵ (شلاق درجهٔ ۶): شلاق درجهٔ ۷ یا ۸ یا جزای نقدی درجهٔ ۶ یا ۷. مثال ۱۰۶ (محرومیت از حقوق اجتماعی درجهٔ ۵): محرومیت درجهٔ ۶ یا ۷ یا جزای نقدی درجهٔ ۵ یا ۶.",topic:"ماده ۳۲۷"},{q:"تخفیف در «قوانین خاص» را با سه نرخ و مستند توضیح دهید (نکتهٔ ۶۴).",keywords:["مواد مخدر: نصف حداقل","نیروهای مسلح: یک‌سوم حداقل","اسیدپاشی: فقط گذشت + یک درجه","حبس ابد: ۱۵ سال"],answer:"مادهٔ ۳۸ قانون مبارزه با مواد مخدر: با جهات مخففه، مجازات تعزیری تا نصفِ حداقلِ مجازات جرم تخفیف می‌یابد و اگر مجازات فاقد حداقل باشد همان مجازات تا نصف؛ در حبس ابد حداکثر ۱۵ سال (مثال ۱۰۷: چهار تا ده سال ← تا دو سال). مواد ۳ تا ۵ قانون جرایم نیروهای مسلح: کاهش تا یک‌سومِ حداقل (مثال ۱۰۹: سه تا ده سال ← تا یک سال). اسیدپاشی و شروع به آن: تخفیف فقط در صورت گذشت شاکی و فقط یک درجه تقلیل مجازات تعزیری — سایر جهات مادهٔ ۳۸ کافی نیست.",topic:"تخفیف خاص"},{q:"سه ممنوعیت تخفیف را که جزوه در نکتهٔ ۶۶ آورده، با مستند بنویسید.",keywords:["ماده ۷۱۹: دوسوم حداکثر","ماده ۷ حمایت از آمران به معروف","تبصره ۵ ماده ۲ اخلالگران اقتصادی","اعدام و جزاهای مالی و محرومیت و انفصال دائم"],answer:"۱) مادهٔ ۷۱۹ ق.م.ا: راننده‌ای که با وجود امکان، مصدوم را رها کرده و محل حادثه را ترک کند به بیش از دوسوم حداکثر مجازات مواد ۷۱۴ تا ۷۱۶ محکوم می‌شود و دادگاه نمی‌تواند در مورد این ماده کیفیات مخففه اعمال کند. ۲) مادهٔ ۷ قانون حمایت از آمران به معروف و ناهیان از منکر: مجازات جرایم علیه آمر به معروف و ناهی از منکر قابل تخفیف و تعلیق نیست. ۳) تبصرهٔ ۵ مادهٔ ۲ قانون مجازات اخلالگران در نظام اقتصادی: اعدام و جزاهای مالی و محرومیت و انفصال دائم از خدمات دولتی و نهادها از طریق محاکم قابل تخفیف یا تقلیل نیست. (نکتهٔ ۶۵: در جرایم اطفال، مادهٔ ۹۳ تا نصف حداقل تقلیل و تبدیل اقدامات تأمینی و تربیتی را ممکن می‌کند.)",topic:"ممنوعیت تخفیف"},{q:"جهات هفت‌گانهٔ تخفیف مادهٔ ۳۸ را فهرست کنید و حکم تبصرهٔ ۲ آن را با مثال ۱۱۰ توضیح دهید.",keywords:["گذشت","همکاری مؤثر","اوضاع و احوال خاص","اعلام/اقرار","ندامت و وضع خاص","کوشش برای جبران","خفیف بودن زیان و مداخله ضعیف شریک","تخفیف دوگانه ممنوع"],answer:"الف) گذشت شاکی یا مدعی خصوصی؛ ب) همکاری مؤثر در شناسایی شرکا/معاونان، تحصیل ادله یا کشف اموال؛ پ) اوضاع و احوال خاص (تحریک بزه‌دیده یا انگیزهٔ شرافتمندانه)؛ ت) اعلام متهم قبل از تعقیب یا اقرار مؤثر؛ ث) ندامت، حسن سابقه یا وضع خاص (کهولت، بیماری)؛ ج) کوشش برای تخفیف آثار جرم یا جبران زیان؛ ح) خفیف بودن زیان یا نتایج جرم و مداخلهٔ ضعیف شریک یا معاون. تبصرهٔ ۱: قید جهات در حکم الزامی است. تبصرهٔ ۲: اگر همان جهت در مادهٔ خاصی آمده باشد، تخفیفِ دوباره با مادهٔ ۳۸ ممنوع است — مثال ۱۱۰: درمان‌رساندن مصدوم در مادهٔ ۷۱۹ خودش تخفیف دارد و دیگر با همان جهت مادهٔ ۳۸ قابل استناد مجدد نیست.",topic:"ماده ۳۸"},{q:"شرایط معافیت از کیفر (مادهٔ ۳۹) و دامنهٔ آن را بنویسید و بگویید نکتهٔ ۷۰ چه محدودیتی ایجاد می‌کند.",keywords:["درجه‌های ۷ و ۸","جهات تخفیف","پیش‌بینی اصلاح","فقدان سابقه مؤثر","گذشت و جبران","ماده ۶۳ قاچاق"],answer:"در جرایم تعزیری درجه‌های ۷ و ۸، در صورت احراز جهات تخفیف و پیش‌بینی دادگاه از اصلاح مرتکب با جبران ضرر و زیان یا برقراری ترتیبات جبران، به شرط فقدان سابقهٔ کیفری مؤثر و گذشت شاکی و جبران ضرر یا برقراری ترتیبات آن، دادگاه می‌تواند حکم به معافیت از کیفر بدهد. طبق نکتهٔ ۷۰ (مادهٔ ۶۳ قانون مبارزه با قاچاق کالا و ارز) تمام این نهادها — تعلیق تعقیب، تعویق صدور حکم، معافیت از کیفر، تعلیق اجرای مجازات، مرور زمان، توبه و بایگانی پرونده — در جرایم و تخلفات قاچاق اعمال نمی‌شود.",topic:"معافیت از کیفر"},{q:"چهار نهاد «مکث» در فرآیند کیفری را روی خط زمان مقایسه کنید (نکته‌های ۷۳ تا ۷۶).",keywords:["تعلیق تعقیب: قبل از تعقیب، دادستان/دادگاه","تعویق صدور حکم: پس از احراز مجرمیت","تعلیق اجرا: بعد از حکم","تعویق اجرا: قاضی اجرای احکام، بارداری و شیردهی و بیماری"],answer:"تعلیق تعقیب (مادهٔ ۸۱ ق.آ.د.ک): پیش از شروع تعقیب، توسط دادستان یا دادگاه (نه بازپرس) برای جرایم جزای‌نقدی درجهٔ ۶ تا ۸ با گذشت/جبران و فقدان سابقهٔ مؤثر، ۶ ماه تا ۲ سال. تعویق صدور حکم (مواد ۴۰ تا ۴۵): پس از احراز مجرمیت و قبل از صدور حکم، در درجهٔ ۶ تا ۸ با چهار شرط، ۶ ماه تا ۲ سال. تعلیق اجرای مجازات (مادهٔ ۴۶ به بعد): پس از حکم، اجرای تمام/بخشی برای ۱ تا ۵ سال. تعویق اجرای مجازات (مواد ۵۰۱ و ۵۰۲ ق.آ.د.ک): موقع اجرا و به دستور قاضی اجرای احکام در بارداری، پس از زایمان تا شش ماه، شیردهی تا دو سالگی، شلاق در ایام حیض/استحاضه و بیماریِ تشدیدشونده.",topic:"تعویق و تعلیق"},{q:"پیامدهای «جرم سنگین» و «تخلف از دستور» در دورهٔ تعویق صدور حکم را با مواد ۴۲ و ۴۳ بیان کنید.",keywords:["حد/قصاص/دیه عمدی/تعزیر تا درجه ۷: لغو و حکم","تخلف از دستور: تمدید تا نصف یک‌بار","تبصره: پس از لغو، تعلیق ممنوع","دستورهای ماده ۴۲"],answer:"مادهٔ ۴۲ دستورهای تعویق مراقبتی (حرفه‌آموزی، درمان و ترک اعتیاد، نفقه، خودداری از تصدی وسایل نقلیه، ترک فعالیت مرتبط با جرم، قطع ارتباط با شرکا، دوره‌های آموزشی، کمک به بزه‌دیده) را تعیین می‌کند. طبق مادهٔ ۴۳: ارتکاب جرم عمدیِ حد، قصاص، جنایات عمدی موجب دیه یا تعزیر تا درجهٔ ۷ در دورهٔ تعویق ← لغو قرار و صدور حکم محکومیت؛ صرف عدم اجرای دستورها ← یک‌بار تمدید تا نصف مدت یا صدور حکم. طبق تبصرهٔ مادهٔ ۴۳، پس از الغای تعویق و صدور حکم محکومیت، صدور قرار تعلیق اجرای مجازات ممنوع است. پایان تعویق هم به تعیین کیفر یا معافیت از کیفر می‌انجامد (مادهٔ ۴۵).",topic:"تعویق صدور حکم"},{q:"فهرست مادهٔ ۴۷ و دو «درِ تبصره» آن را توضیح دهید و حکم نکته‌های ۷۸ تا ۸۲ را برای کلاهبرداری و جرایم اقتصادی بنویسید.",keywords:["امنیت","سازمان‌یافته/سرقت مسلحانه/آدم‌ربایی/اسیدپاشی","چاقو و عفت و مراکز فساد","قاچاق عمده","تعزیر بدل از قصاص و معاونت در قتل و محاربه","اقتصادی بالای ۱۰۰ میلیون","همکاری مؤثر: تعلیق بخشی","عفت به‌جز ۶۳۹ و ۶۴۰"],answer:"تعویق و تعلیق در شروع هم ممنوع است در: الف) جرایم علیه امنیت و خرابکاری در تأسیسات؛ ب) جرایم سازمان‌یافته، سرقت مسلحانه یا مقرون به آزار، آدم‌ربایی، اسیدپاشی؛ پ) قدرت‌نمایی با چاقو/سلاح، جرایم عفت عمومی، تشکیل یا ادارهٔ مراکز فساد و فحشا؛ ت) قاچاق عمدهٔ سلاح و مهمات/رویان/مشروبات و قاچاق انسان؛ ج) تعزیر بدل از قصاص نفس، معاونت در قتل عمدی، محاربه و افساد؛ ج) جرایم اقتصادی بالای ۱۰۰ میلیون ریال. تبصرهٔ ۱: در امنیتی‌ها با همکاری مؤثر در کشف جرم و شناسایی سایر مرتکبان، تعلیق «بخشی» بلامانع است (تعویق مطلقاً ممنوع — نکتهٔ ۷۸). تبصرهٔ ۲: تعلیق جرایم عفت عمومی به‌جز مواد ۶۳۹ و ۶۴۰ بلامانع است؛ بنابراین مواد ۶۳۸ و ۶۳۹ تعویق ممنوع ولی تعلیق جایز دارند (نکتهٔ ۷۹) و مواد ۶۳۹ و ۶۴۰ هر دو ممنوع‌اند (نکتهٔ ۸۰). کلاهبرداری: مطلقاً قابل تعلیق و تا ۱۰۰ میلیون ریال قابل تعویق (نکتهٔ ۸۱)؛ سایر جرایم اقتصادی تا ۱۰۰ میلیون هر دو، بالاتر هیچ‌کدام (نکتهٔ ۸۲).",topic:"ماده ۴۷"},{q:"نقش رأی وحدت رویهٔ ۷۷۸ در ممنوعیت‌های تعلیق را با دو نمونه و حکم نکتهٔ ۸۴ توضیح دهید.",keywords:["نسخ ضمنی قوانین قبل از ۹۲","ماده ۱۰ قانون صدور چک","تبصره ۵ ماده ۱ اخلالگران","قوانین بعد از ۹۲ پابرجا","آمران به معروف","تبصره ماده ۴۵ مواد مخدر"],answer:"نکتهٔ ۸۳: قوانین خاصِ مصوب «قبل از» ق.م.ا ۱۳۹۲ که تعلیق را ممنوع کرده بودند، با مادهٔ ۴۷ ق.م.ا نسخ ضمنی شده‌اند (مستنبط از رأی وحدت رویهٔ ۷۷۸ مورخ ۱۳۹۸/۳/۲۹)؛ مانند مادهٔ ۱۰ قانون صدور چک ۱۳۷۲ و تبصرهٔ ۵ مادهٔ ۱ قانون اخلالگران اقتصادی — امروز قابل تعلیق‌اند. نکتهٔ ۸۴: اما ممنوعیت‌های قوانینِ مصوب «بعد از» ۶ خرداد ۱۳۹۲ پابرجاست؛ مانند مادهٔ ۷ قانون حمایت از آمران به معروف (تخفیف و تعلیق ممنوع)، تبصرهٔ مادهٔ ۴۵ قانون مبارزه با مواد مخدر، قاچاق مشروبات الکلی (اصلاحی ۱۴۰۰) و تبصرهٔ مادهٔ ۲ قانون تحصیل مال نامشروع.",topic:"وحدت رویه ۷۷۸"},{q:"تبصرهٔ مادهٔ ۴۵ قانون مبارزه با مواد مخدر را با سه مثال ۱۱۵ تا ۱۱۷ جزوه تحلیل کنید.",keywords:["حبس بیش از ۵ سال","حکم به حداقل: همهٔ نهادها جز عفو ممنوع","حکم بالاتر از حداقل: تعلیق بخشی پس از حداقل، ۵ تا ۱۰ سال","مثال ۱۱۵: خارج از شمول"],answer:"در جرایم مواد مخدر با مجازات حبس بیش از پنج سال: اگر حکم به «حداقل» مجازات قانونی صادر شود، مرتکب جز عفو مقام رهبری از تعلیق اجرا، آزادی مشروط و سایر نهادهای ارفاقی بهره‌مند نمی‌شود (مثال ۱۱۶: شش تا پانزده سال و حکم به شش سال). اگر حکم «بالاتر از حداقل» باشد، دادگاه می‌تواند بخشی از حبس را پس از گذراندن حداقل مجازات قانونی، پنج تا ده سال تعلیق کند و تعلیقِ کل ممنوع است (مثال ۱۱۷: حکم به ده سال). اگر جرم اصلاً حبسِ بیش از پنج سال نداشته باشد (مثال ۱۱۵: دو تا پنج سال)، تبصره شمول ندارد و همهٔ نهادها جاری‌اند.",topic:"مواد مخدر"},{q:"نظام نیمه‌آزادی (مواد ۵۶ و ۵۷ و تبصره) را با شرایط و مثال‌های ۱۱۹ تا ۱۲۱ توضیح دهید.",keywords:["درجه ۵ تا ۷ از ابتدا","درجه ۲ تا ۴ پس از یک‌چهارم","گذشت شاکی + تأمین + تعهد به فعالیت + رضایت محکوم","مثال ۱۲۱: از ابتدا"],answer:"نیمه‌آزادی یعنی انجام فعالیت‌های حرفه‌ای، آموزشی، حرفه‌آموزی و درمانی در خارج از زندان زیر نظر مراکز نیمه‌آزادی سازمان زندان‌ها (مادهٔ ۵۶). در حبس تعزیری درجه‌های ۵ تا ۷ دادگاه می‌تواند مشروط به گذشت شاکی، تأمین مناسب و تعهد به فعالیت مؤثر و با رضایت محکوم، حکم نیمه‌آزادی بدهد (مادهٔ ۵۷). طبق تبصرهٔ الحاقی، مقررات ماده در درجه‌های ۲ تا ۴ پس از گذراندن یک‌چهارم مدت حبس قابل اعمال است. مثال ۱۱۹: محکومیت پانزده‌ساله (درجهٔ دو) در ابتدای حبس ← نمی‌توان حکم داد. مثال ۱۲۰ جزوه حسابِ یک‌چهارم را تمرین می‌کند (یک‌چهارمِ چهار سال = یک سال) و مثال ۱۲۱: محکومیت سه‌ساله (درجهٔ پنج) ← از همان ابتدا.",topic:"نیمه‌آزادی"},{q:"شرایط و کسرهای آزادی مشروط را با مادهٔ ۵۸، نکتهٔ ۸۵ و مثال ۱۲۲ و ممنوعیت‌های جزوه بنویسید.",keywords:["بیش از ۱۰ سال: نصف","بقیه: یک‌سوم","ملاک مجازات قضایی","شرایط الف تا ت","اسیدپاشی مطلقاً ممنوع","بازداشت بدل و تبعید"],answer:"آزادی مشروط: در حبس تعزیریِ بیش از ده سال پس از تحمل نصف و سایر موارد پس از یک‌سوم، به پیشنهاد دادستان یا قاضی اجرای احکام با چهار شرط (حسن اخلاق مستمر، پیش‌بینی عدم تکرار، پرداخت یا ترتیب پرداخت ضرر، عدم استفادهٔ قبلی از آزادی مشروط). نکتهٔ ۸۵: ملاک «مجازات قضایی» است؛ در مثال ۱۲۲ با حکمِ شش‌ساله، یک‌سوم یعنی دو سال. مدت آزادی مشروط شامل بقیهٔ مجازات است و بین یک تا پنج سال است مگر باقی‌مانده کمتر از یک سال باشد (مادهٔ ۵۹). ممنوعیت‌ها: اسیدپاشی و شروع به آن تحت هیچ شرایطی؛ جرایم مواد مخدرِ تبصرهٔ مادهٔ ۴۵ با حکم به حداقل؛ محکومِ تخلف از مجازات تکمیلی؛ بازداشت بدل از جزای نقدی؛ تبعید و اقامت اجباری.",topic:"آزادی مشروط"},{q:"چهار حالتِ «الزامی» مجازات جایگزین حبس را بر اساس جدول جزوه بنویسید و شرایط سابقهٔ مادهٔ ۶۶ را بیان کنید.",keywords:["تا ۳ ماه هر نوعی","عمدی ۹۱ روز تا ۶ ماه بدون سابقه","غیرعمدی تا ۲ سال","تعزیر تعیین‌نشده (ماده ۶۹)","سابقهٔ سبک: حبس تا ۶ ماه یا جزای نقدی بالای ۱۰ میلیون یا شلاق","سابقهٔ سنگین: حبس بیش از ۶ ماه یا حد/قصاص یا یک‌پنجم دیه","پنج سال از اجرا"],answer:"الزامی‌ها: ۱) مجازات دادنامه تا سه ماه (۹۰ روز) حبس — عمدی یا غیرعمدی، مستقل از حداکثر قانونی (مادهٔ ۶۵ و تبصرهٔ مادهٔ ۳۷)؛ ۲) جرایم عمدی با حداکثر ۹۱ روز تا شش ماه در صورت فقدان سابقهٔ مادهٔ ۶۶؛ ۳) جرایم غیرعمدی با حداکثر تا دو سال حبس (مادهٔ ۶۸)؛ ۴) جرایمی که نوع یا میزان تعزیرشان تعیین نشده (مادهٔ ۶۹). سابقهٔ مادهٔ ۶۶ دو صورت دارد: یک فقره محکومیت قطعی به حبس تا شش ماه یا جزای نقدی بیش از ده میلیون ریال یا شلاق تعزیری (سبک) و یک فقره محکومیت به حبس بیش از شش ماه یا حد یا قصاص یا پرداخت بیش از یک‌پنجم دیه (سنگین) — به شرط آن که از اجرای آن پنج سال نگذشته باشد؛ مثال‌های ۱۳۱ و ۱۳۲ همین پنج‌ساله را می‌سنجند (۱۴۰۳ تا ۱۴۰۶ ← حبس می‌شود؛ ۱۴۰۳ تا ۱۴۰۹ ← جایگزین).",topic:"جایگزین حبس"},{q:"ممنوعیت‌های مجازات‌های جایگزین حبس (مواد ۷۰ تا ۷۳) را با مثال ۱۳۹ توضیح دهید.",keywords:["ماده ۷۰: امنیت","ماده ۷۱: قوانین خاص و اسیدپاشی و تبصره ۴۵ و نیروهای مسلح","ماده ۷۲: تعدد با جرم بالای یک سال","ماده ۷۳: تخفیف زیر یک سال","مثال ۱۳۹: ماده ۵۰۶"],answer:"مادهٔ ۷۰: جرایم علیه امنیت داخلی و خارجی مطلقاً از جایگزین حبس ممنوع‌اند — مثال ۱۳۹: بی‌مبالاتی مأموران حفاظتیِ طبقه‌بندی‌شده (مادهٔ ۵۰۶ با مجازات یک تا شش ماه) با وجود کم‌بودن مجازات، جرم امنیتی است و جایگزین نمی‌پذیرد. مادهٔ ۷۱: در قوانین خاص، جرایمی که حکم قضایی‌شان بیش از یک سال حبس است و نیز اسیدپاشی، جرایم تبصرهٔ مادهٔ ۴۵ مواد مخدر و جرایم نیروهای مسلح ممنوع‌اند. مادهٔ ۷۲ (اصلاحی): تعدد جرایم عمدی با حتی یک جرمِ بالای یک سال، مانع جایگزین است. مادهٔ ۷۳: در جرایم عمدی بالای یک سال، تخفیف به زیر یک سال هم مجوز جایگزین نمی‌دهد (مثال ۱۳۸: حکمِ سه‌ماهه به استناد تبصرهٔ مادهٔ ۳۷ به جایگزین تبدیل می‌شود). در مقابل، مادهٔ ۷۵ هم‌زمانی جایگزین با سایر مجازات‌ها را مجاز می‌داند.",topic:"جایگزین حبس"}]}];function i(o){return s.find(s=>s.id===o)??null}function t(){let o=new Map;for(let i of s){let s=o.get(i.examSlug);s?s.count+=1:o.set(i.examSlug,{slug:i.examSlug,label:i.exam,count:1})}return[...o.values()]}function n(o){return o.questions.length}let w=new Set;function p(o){if(!o?.id||s.some(s=>s.id===o.id&&!w.has(s.id)))return!1;if(w.has(o.id)){let i=s.findIndex(s=>s.id===o.id);i>=0&&s.splice(i,1)}return w.add(o.id),s.push(o),!0}function e(o){if(!w.has(o))return;let i=s.findIndex(s=>s.id===o);i>=0&&s.splice(i,1),w.delete(o)}function a(o){return w.has(o)}o.s(["VOKALAT_SLUG",0,"vokalat","examPacks",0,s,"examTypes",()=>t,"getExamPack",()=>i,"isDynamicPack",()=>a,"packQuestionCount",()=>n,"registerDynamicExamPack",()=>p,"unregisterDynamicExamPack",()=>e],36267)}]);