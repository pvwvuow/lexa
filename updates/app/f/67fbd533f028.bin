 "matchPercent": number,        // ۰ تا ۱۰۰ — میزان تطابق گفته‌های factual کاربر با متن جزوه؛ نه شدت اعتراض او
 "needsChange": boolean,        // آیا اصلاحی در تدریس/محتوا لازم است؟
