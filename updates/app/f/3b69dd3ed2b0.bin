{"id":"jg-188","v":"5b4c7dd3","sections":[{"id":"s1","type":"intro","title":"هدف جلسه","body":"ورود به بحث «خسارت‌های دیه» با سه مادهٔ پرتست: مادهٔ ۵۲۳ (واردشونده با اذن، آسیب ببیند؛ اذن‌دهنده ضامن است) و دو مادهٔ مربوط به حیوانات: مادهٔ ۵۲۴ (متوقف‌کردن حیوان سوار در معابر عمومی و محل‌های غیرمجاز) و مادهٔ ۵۲۵ (ترساندن یا تحریک حیوان). کلید این جلسه، تبصرهٔ مادهٔ ۵۲۳ است که فرض «آسیب مستند به مصدوم» را می‌سازد."},{"id":"s2","type":"law","title":"مادهٔ ۵۲۳ و تبصرهٔ آن","law":[{"no":"۵۲۳","source":"قانون مجازات اسلامی","text":"هرگاه شخصی با اذن کسی که حق اذن دارد، وارد منزل یا محلی که در تصرف اوست گردد و از ناحیهٔ [شیء یا حیوانِ آن محل] آسیب ببیند، اذن‌دهنده ضامن است؛ خواه آن شیء با حیوان قبل از اذن در آن محل بوده یا بعداً در آن قرار گرفته باشد و خواه اذن‌دهنده نسبت به آسیب‌رسانی آن علم داشته باشد، خواه نداشته باشد."},{"no":"تبصرهٔ ۵۲۳","source":"قانون مجازات اسلامی","text":"در مواردی که آسیب مستند به مصدوم باشد، مانند آنکه واردشونده بداند حیوان مزبور خطرناک است و اذن‌دهنده از آن آگاه نباشد یا قادر به رفع خطر نباشد، اذن‌دهنده ضامن نیست."}],"body":"فرمول مادهٔ ۵۲۳: اذنِ مشروعِ مالک + ورود + آسیب در آن محل ← ضمان با اذن‌دهنده است. اذن‌دهنده حتی اگر از خطر بودن حیوان بی‌خبر بوده باشد هم ضامن است (ضمان مطلق). استثنا فقط در تبصره است: وقتی آسیب مستند به خود مصدوم باشد — یعنی واردشونده خطرناک بودن حیوان را بداند ولی اذن‌دهنده از آن آگاه نباشد یا نتواند خطر را رفع کند ← ضمان از اذن‌دهنده برداشته می‌شود."},{"id":"s3","type":"law","title":"مواد ۵۲۴ و ۵۲۵؛ ضمانِ مرتبط با حیوان","law":[{"no":"۵۲۴","source":"قانون مجازات اسلامی","text":"هرگاه کسی که سوار حیوان است، آن را در معابر عمومی یا دیگر محل‌های غیرمجاز متوقف نماید، در مورد تمام خسارت‌هایی که آن حیوان وارد می‌کند و مستند به فعل شخص مزبور می‌باشد، ضامن است و چنانچه مهار حیوان در دست دیگری باشد، مهارکننده ضامن است."},{"no":"۵۲۵","source":"قانون مجازات اسلامی","text":"هرگاه شخصی عملی انجام دهد که موجب شود حیوان در اثر تحریک یا وحشت وارد [جنایت و خسارت] شود، ضامن است، مگر آنکه عمل مزبور مصداق دفاع مشروع باشد."}],"body":"دو ضامن بالقوه در مادهٔ ۵۲۴: توقف‌کنندهٔ حیوان در محل غیرمجاز (برای خسارت‌های مستند به فعل او) و مهارکننده (هرگاه مهار در دست او باشد). مادهٔ ۵۲۵ ضمانِ «ترساندن حیوان» را می‌سازد: تحریک یا وحشت دادن حیوان ← عاملِ جنایتِ حیوان ضامن است؛ استثنای یکتا: دفاع مشروع (مثلاً دفع حملهٔ سگ با رفتاری که حیوان را وحشت‌زده می‌کند)."},{"id":"s4","type":"compare","title":"جدول ضمان در مواد ۵۲۳ تا ۵۲۵","table":{"headers":["فرض","عامل","حکم"],"rows":[["ورود با اذن و آسیب‌دیدن از شیء/حیوان محل","اذن‌دهنده","ضامن است (حتی بدون علم به خطر)"],["واردشونده خطرناک بودن حیوان را بداند و اذن‌دهنده آگاه نباشد/نتواند رفع خطر کند (تبصره)","مصدوم","آسیب مستند به او ← اذن‌دهنده ضامن نیست"],["توقف حیوان سوار در معابر عمومی/محل غیرمجاز","توقف‌کننده یا مهارکننده","ضامن خسارت‌های مستند به فعل اوست"],["تحریک/وحشت دادن حیوان","ترساندن‌کننده","ضامن است؛ مگر در دفاع مشروع"]]}},{"id":"s5","type":"notes","title":"ریزه‌کاری‌های تست","bullets":["کلید مادهٔ ۵۲۳: «علم یا عدم علم اذن‌دهنده به خطر، اثر ندارد» — ضمان مطلق است؛ فقط تبصره آن را می‌شکند.","در تبصره دو رکن: ۱) آگاهی مصدوم به خطرناک بودن حیوان ۲) آگاه نبودن یا ناتوانی اذن‌دهنده در رفع خطر؛ هر دو با هم لازم‌اند.","مادهٔ ۵۲۴: مهار در دست دیگری باشد ← ضمان به مهارکننده منتقل می‌شود (سوئیچ ضمان).","استثنای مادهٔ ۵۲۵ فقط «دفاع مشروع» است؛ دقت کنید ترساندن حیوانِ مهاجم در قلمرو دفاع مشروع ضمان ندارد.","عبارت «خواه قبل از اذن بوده یا بعداً» یعنی زمانِ به‌وجودآمدن خطر تفاوتی در ضمان اذن‌دهنده نمی‌سازد."]},{"id":"s6","type":"summary","title":"جمع‌بندی","bullets":["مادهٔ ۵۲۳: ورود با اذن و آسیب‌دیدن ← اذن‌دهنده ضامن؛ بدون توجه به علم او.","تبصرهٔ ۵۲۳: آسیب مستند به مصدوم (آگاهی مصدوم + بی‌اطلاعی/ناتوانی اذن‌دهنده) ← ضمان منتفی.","مادهٔ ۵۲۴: توقف حیوان در معابر عمومی/محل غیرمجاز ← توقف‌کننده یا مهارکننده ضامن.","مادهٔ ۵۲۵: تحریک/وحشت حیوان ← ضمان، مگر دفاع مشروع."]},{"id":"s7","type":"notes","title":"منبع و مستندات این جلسه","bullets":["جزوهٔ تدریس رایگان کلاس جزا (احمد غفوری)، صفحات ۵۵۱ — مادهٔ ۵۲۳ و تبصرهٔ آن، مواد ۵۲۴ و ۵۲۵.","قانون مجازات اسلامی ۱۳۹۲: مواد ۵۲۳ تا ۵۲۵ (خسارت‌های دیه — ضمان اذن‌دهنده و حیوانات)."]}],"quiz":[{"q":"مطابق مادهٔ ۵۲۳، اگر شخصی با اذن به محلی وارد شود و از ناحیهٔ حیوانِ آن محل آسیب ببیند، چه کسی ضامن است؟","options":[{"key":"a","text":"اذن‌دهنده، خواه از خطر علم داشته باشد یا نداشته باشد"},{"key":"b","text":"فقط اگر اذن‌دهنده از خطر علم داشته باشد"},{"key":"c","text":"هیچ‌کس؛ ورود با اذن بوده است"},{"key":"d","text":"واردشونده به‌صورت مطلق"}],"answer":"a","explanation":"مادهٔ ۵۲۳: اذن‌دهنده ضامن است، خواه علم داشته باشد خواه نداشته باشد.","topic":"مادهٔ ۵۲۳"},{"q":"تبصرهٔ مادهٔ ۵۲۳ در چه صورتی اذن‌دهنده را از ضمان خارج می‌کند؟","options":[{"key":"a","text":"هرگاه حیوان قبل از اذن در محل بوده باشد"},{"key":"b","text":"وقتی آسیب مستند به مصدوم باشد؛ مانند آنکه واردشونده خطرناک بودن حیوان را بداند و اذن‌دهنده آگاه نباشد یا نتواند رفع خطر کند"},{"key":"c","text":"فقط در شب"},{"key":"d","text":"وقتی حیوان گربه باشد"}],"answer":"b","explanation":"تبصرهٔ ۵۲۳: استناد آسیب به مصدوم ← ضمان اذن‌دهنده منتفی.","topic":"تبصرهٔ ۵۲۳"},{"q":"اگر حیوانِ خطرناک «بعد از صدور اذن» به محل آورده شود، ضمان اذن‌دهنده چه وضعی دارد؟","options":[{"key":"a","text":"منتفی است"},{"key":"b","text":"مادهٔ ۵۲۳ تصریح دارد: خواه قبل از اذن بوده یا بعداً قرار گرفته باشد؛ اذن‌دهنده ضامن است"},{"key":"c","text":"فقط نصف ضمان دارد"},{"key":"d","text":"به عاقله منتقل می‌شود"}],"answer":"b","explanation":"متن ماده: «خواه آن شیء یا حیوان قبل از اذن بوده یا بعداً در آن قرار گرفته باشد».","topic":"مادهٔ ۵۲۳"},{"q":"در مادهٔ ۵۲۴، اگر مهار حیوانِ متوقف‌شده در دست دیگری باشد، چه کسی ضامن است؟","options":[{"key":"a","text":"فقط توقف‌کننده"},{"key":"b","text":"مهارکننده"},{"key":"c","text":"هیچ‌کس"},{"key":"d","text":"هر دو به‌طور مساوی"}],"answer":"b","explanation":"مادهٔ ۵۲۴: چنانچه مهار حیوان در دست دیگری باشد، مهارکننده ضامن است.","topic":"مادهٔ ۵۲۴"},{"q":"مادهٔ ۵۲۴ مربوط به توقف حیوان سوار در کدام مکان‌هاست؟","options":[{"key":"a","text":"فقط داخل منازل"},{"key":"b","text":"معابر عمومی یا دیگر محل‌های غیرمجاز"},{"key":"c","text":"هر جایی حتی محل مجاز"},{"key":"d","text":"فقط اتوبان"}],"answer":"b","explanation":"متن مادهٔ ۵۲۴: توقف در معابر عمومی یا محل‌های غیرمجاز.","topic":"مادهٔ ۵۲۴"},{"q":"ترساندن حیوان که موجب جنایت حیوان می‌شود، چه زمانی ضمان ندارد؟","options":[{"key":"a","text":"هرگز"},{"key":"b","text":"هرگاه عمل مصداق دفاع مشروع باشد"},{"key":"c","text":"اگر شب باشد"},{"key":"d","text":"اگر حیوان سگ باشد"}],"answer":"b","explanation":"مادهٔ ۵۲۵: ضمان دارد مگر عمل مصداق دفاع مشروع باشد.","topic":"مادهٔ ۵۲۵"},{"q":"«الف» «ب» را به کارگاهش دعوت می‌کند؛ «ب» از شیلنگِ معیوبِ بی‌خبر، برق‌گرفته می‌شود. تحلیل درست کدام است؟","options":[{"key":"a","text":"طبق مادهٔ ۵۲۳ اذن‌دهنده (الف) ضامن است حتی اگر از خطر علم نداشته"},{"key":"b","text":"هیچ‌کس ضامن نیست"},{"key":"c","text":"فقط مالک ساختمان ضامن است"},{"key":"d","text":"طبق تبصره، آسیب مستند به مصدوم است و ضمان منتفی است"}],"answer":"a","explanation":"تبصره فقط در آگاهی مصدوم به خطر و بی‌اطلاعی/ناتوانی اذن‌دهنده جاری است؛ اینجا تبصره صدق نمی‌کند ← ضمان مادهٔ ۵۲۳.","topic":"مادهٔ ۵۲۳"},{"q":"کدام گزینه دربارهٔ مادهٔ ۵۲۳ درست است؟","options":[{"key":"a","text":"ضمان اذن‌دهنده مشروط به علم او به خطر است"},{"key":"b","text":"ضمان اذن‌دهنده مطلق است و علم یا عدم علم او اثری ندارد"},{"key":"c","text":"فقط برای حیوانات اهلی است"},{"key":"d","text":"فقط در منازل مسکونی جاری است"}],"answer":"b","explanation":"مادهٔ ۵۲۳ ضمان را مطلق کرده؛ علم/جهل اذن‌دهنده مؤثر نیست.","topic":"مادهٔ ۵۲۳"},{"q":"اگر واردشونده بداند حیوان خطرناک است و اذن‌دهنده هم از خطر آگاه باشد و بتواند خطر را رفع کند، حکم چیست؟","options":[{"key":"a","text":"تبصره جاری است و ضمان منتفی است"},{"key":"b","text":"اذن‌دهنده ضامن است؛ تبصره نیازمند بی‌اطلاعی یا ناتوانی اذن‌دهنده در رفع خطر است"},{"key":"c","text":"هر دو ضامن‌اند"},{"key":"d","text":"دیه نصف می‌شود"}],"answer":"b","explanation":"تبصرهٔ ۵۲۳: اگر اذن‌دهنده آگاه و قادر به رفع خطر باشد، استثنا منتفی است ← ضمان برقرار است.","topic":"تبصرهٔ ۵۲۳"}]}